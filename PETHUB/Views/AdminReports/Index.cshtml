@model PETHUB.ViewModels.PaginationViewModel<PETHUB.Models.UserReport>

@{
    ViewData["Title"] = "Reports";

    var reportFilters =
        ViewData["ReportFilters"]
        as PETHUB.ViewModels.FilterBarViewModel;

    var pendingAppealReportIds =
        ViewData["PendingAppealReportIds"] as HashSet<int>
        ?? new HashSet<int>();
}

<div class="admin-report-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="admin-report-header">

        <div class="admin-report-header-text">

            <h1 class="admin-report-title">
                Reports
            </h1>

            <p class="admin-report-subtitle">
                Review and manage reports submitted by PETHUB members.
            </p>

        </div>

    </div>


    <!-- =====================================================
         REPORT STATISTICS
    ====================================================== -->

    <div class="admin-report-stats">

        <!-- PENDING -->

        <div class="admin-report-stat-card">

            <div class="admin-report-stat-indicator admin-report-stat-pending">
                <i data-lucide="clock-3"></i>
            </div>

            <div class="admin-report-stat-content">

                <div class="admin-report-stat-top">
                    <span class="admin-report-stat-label">
                        Pending
                    </span>
                </div>

                <div class="admin-report-stat-count">
                    @Model.Items.Count(r =>
                        r.Status == PETHUB.Models.UserReportStatus.Pending &&
                        !pendingAppealReportIds.Contains(r.UserReportId))
                </div>

            </div>

        </div>


        <!-- UNDER APPEAL -->

        <div class="admin-report-stat-card">

            <div class="admin-report-stat-indicator admin-report-stat-appeal">
                <i data-lucide="scale"></i>
            </div>

            <div class="admin-report-stat-content">

                <div class="admin-report-stat-top">
                    <span class="admin-report-stat-label">
                        Under Appeal
                    </span>
                </div>

                <div class="admin-report-stat-count">
                    @pendingAppealReportIds.Count
                </div>

            </div>

        </div>


        <!-- RESOLVED -->

        <div class="admin-report-stat-card">

            <div class="admin-report-stat-indicator admin-report-stat-resolved">
                <i data-lucide="circle-check"></i>
            </div>

            <div class="admin-report-stat-content">

                <div class="admin-report-stat-top">
                    <span class="admin-report-stat-label">
                        Resolved
                    </span>
                </div>

                <div class="admin-report-stat-count">
                    @Model.Items.Count(r =>
                        r.Status == PETHUB.Models.UserReportStatus.Resolved &&
                        !pendingAppealReportIds.Contains(r.UserReportId))
                </div>

            </div>

        </div>


        <!-- DISMISSED -->

        <div class="admin-report-stat-card">

            <div class="admin-report-stat-indicator admin-report-stat-dismissed">
                <i data-lucide="circle-x"></i>
            </div>

            <div class="admin-report-stat-content">

                <div class="admin-report-stat-top">
                    <span class="admin-report-stat-label">
                        Dismissed
                    </span>
                </div>

                <div class="admin-report-stat-count">
                    @Model.Items.Count(r =>
                        r.Status == PETHUB.Models.UserReportStatus.Dismissed &&
                        !pendingAppealReportIds.Contains(r.UserReportId))
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         FILTER BAR
    ====================================================== -->
    @if (reportFilters != null)
    {
        <div class="admin-report-filter-card">

            <div class="admin-report-filters">

                @foreach (var filter in reportFilters.Filters)
                {
                    var selectedValue =
                        filter.SelectedValue ?? filter.DefaultValue;

                    <div class="admin-report-filter"
                         data-filter-dropdown>

                        <span class="admin-report-filter-label">
                            @filter.Label
                        </span>

                        <button type="button"
                                class="admin-report-filter-button"
                                data-dropdown-button
                                aria-haspopup="true"
                                aria-expanded="false">

                            <span>
                                @(filter.Options.FirstOrDefault(
                                    x => x.Value == selectedValue
                                )?.Label
                                ?? filter.Options.FirstOrDefault()?.Label)
                            </span>

                            <i data-lucide="chevron-down"></i>

                        </button>


                        <div class="admin-report-filter-menu"
                             data-dropdown-menu
                             role="menu">

                            @foreach (var option in filter.Options)
                            {
                                var query =
                                    Context.Request.Query.ToDictionary(
                                        item => item.Key,
                                        item => item.Value.ToString()
                                    );

                                if (string.IsNullOrEmpty(option.Value))
                                {
                                    query.Remove(filter.ParameterName);
                                }
                                else
                                {
                                    query[filter.ParameterName] =
                                        option.Value;
                                }

                                var queryString =
                                    string.Join(
                                        "&",
                                        query.Select(
                                            item =>
                                                $"{item.Key}={Uri.EscapeDataString(item.Value)}"
                                        )
                                    );

                                var baseUrl =
                                    Context.Request.Path.ToString();

                                var optionUrl =
                                    string.IsNullOrEmpty(queryString)
                                        ? baseUrl
                                        : $"{baseUrl}?{queryString}";

                                var isSelected =
                                    option.Value == selectedValue;

                                <a href="@optionUrl"
                                   class="admin-report-filter-option @(isSelected ? "selected" : "")"
                                   role="menuitem">

                                    @option.Label

                                </a>
                            }

                        </div>

                    </div>
                }

            </div>


            <span class="admin-report-total">
                @Model.TotalItems
                @(Model.TotalItems == 1 ? "report" : "reports")
            </span>

        </div>
    }


    <!-- =====================================================
         REPORT LIST
    ====================================================== -->
    @if (!Model.Items.Any())
    {
        <div class="admin-report-empty">

            <div class="admin-report-empty-icon">
                <i data-lucide="flag"></i>
            </div>

            <h3 class="admin-report-empty-title">
                No Reports Found
            </h3>

            <p class="admin-report-empty-text">
                There are no reports matching the selected filters.
            </p>

        </div>
    }
    else
    {
        <div class="admin-report-list">

            @foreach (var report in Model.Items)
            {
                <a asp-controller="Reports"
                   asp-action="Details"
                   asp-route-id="@report.UserReportId"
                   class="admin-report-card">

                    <div class="admin-report-card-content">

                        <!-- REASON + STATUS -->

                        <div class="admin-report-main-row">

                            <div class="admin-report-reason">

                                @if (report.Reason ==
                                     PETHUB.Models.UserReportReason.Other &&
                                     !string.IsNullOrWhiteSpace(report.OtherReason))
                                {
                                    @report.OtherReason
                                }
                                else
                                {
                                    @report.Reason
                                }

                            </div>


                            <!-- STATUS -->
                            @if (pendingAppealReportIds.Contains(
                                                report.UserReportId))
                            {
                                <span class="admin-report-status-badge admin-report-status-appeal">
                                    <span class="admin-report-status-dot"></span>
                                    Under Appeal
                                </span>
                            }

                            @if (!pendingAppealReportIds.Contains(
                                report.UserReportId) &&
                                report.Status ==
                                PETHUB.Models.UserReportStatus.Pending)
                            {
                                <span class="admin-report-status-badge admin-report-status-pending">
                                    <span class="admin-report-status-dot"></span>
                                    Pending
                                </span>
                            }

                            @if (!pendingAppealReportIds.Contains(
                                report.UserReportId) &&
                                report.Status ==
                                PETHUB.Models.UserReportStatus.Dismissed)
                            {
                                <span class="admin-report-status-badge admin-report-status-dismissed">
                                    <span class="admin-report-status-dot"></span>
                                    Dismissed
                                </span>
                            }

                            @if (!pendingAppealReportIds.Contains(
                                report.UserReportId) &&
                                report.Status ==
                                PETHUB.Models.UserReportStatus.Resolved)
                            {
                                <span class="admin-report-status-badge admin-report-status-resolved">
                                    <span class="admin-report-status-dot"></span>
                                    Resolved
                                </span>
                            }

                        </div>


                        <!-- REPORTER + DATE -->

                        <div class="admin-report-meta">

                            <div class="admin-report-meta-row">

                                <span class="admin-report-meta-label">
                                    Reported by:
                                </span>

                                <span class="admin-report-meta-value">
                                    @(report.Reporter == null
                                        ? "Unknown"
                                        : $"{report.Reporter.FirstName} {report.Reporter.LastName}")
                                </span>

                            </div>


                            <div class="admin-report-meta-row">

                                <span class="admin-report-meta-label">
                                    Date:
                                </span>

                                <span class="admin-report-meta-value">
                                    @(report.DateCreated
                                        .ToLocalTime()
                                        .ToString("MMM dd, yyyy"))
                                </span>

                            </div>

                        </div>

                    </div>

                </a>
            }

        </div>
    }


    <!-- =====================================================
         PAGINATION
    ====================================================== -->

    <partial name="_Pagination" model="Model" />

</div>


@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            if (typeof lucide !== "undefined") {
                lucide.createIcons();
            }

        });
    </script>
}