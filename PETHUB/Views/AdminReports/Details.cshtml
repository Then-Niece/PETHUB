@model PETHUB.ViewModels.AdminReportDetailsViewModel

@{
    ViewData["Title"] = "Review Report";
}

<div class="admin-report-details-page">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <div class="admin-report-details-top">

        <a asp-controller="Reports"
           asp-action="Index"
           class="admin-report-back">

            <i data-lucide="arrow-left"></i>

            Back to Reports

        </a>

    </div>


    <div class="admin-report-details-header">

        <div>

            <h1 class="admin-report-details-title">
                Review Report
            </h1>

            <p class="admin-report-details-subtitle">
                Review the report and the content submitted for moderation.
            </p>

        </div>


        <!-- REPORT STATUS -->

        <div class="admin-report-details-status">

            @if (Model.Appeal != null &&
                 Model.Appeal.Status ==
                 PETHUB.Models.AppealStatus.Pending)
            {
                <span class="admin-report-status-badge admin-report-status-pending">
                    <span class="admin-report-status-dot"></span>
                    Pending
                </span>
            }
            else if (Model.Report.Status ==
                     PETHUB.Models.UserReportStatus.Pending)
            {
                <span class="admin-report-status-badge admin-report-status-pending">
                    <span class="admin-report-status-dot"></span>
                    Pending
                </span>
            }
            else if (Model.Report.Status ==
                     PETHUB.Models.UserReportStatus.Dismissed)
            {
                <span class="admin-report-status-badge admin-report-status-dismissed">
                    <span class="admin-report-status-dot"></span>
                    Dismissed
                </span>
            }
            else if (Model.Report.Status ==
                     PETHUB.Models.UserReportStatus.Resolved)
            {
                <span class="admin-report-status-badge admin-report-status-resolved">
                    <span class="admin-report-status-dot"></span>
                    Resolved
                </span>
            }

        </div>

    </div>


    <!-- =========================================================
         FIRST ROW
    ========================================================== -->

    <div class="admin-report-details-grid">


        <!-- =====================================================
             REPORT INFORMATION
        ====================================================== -->

        <div class="admin-report-details-card">

            <div class="admin-report-details-card-header">

                <div class="admin-report-details-card-icon admin-report-info-main-icon">

                    <i data-lucide="flag"></i>

                </div>

                <h2>
                    Report Information
                </h2>

            </div>


            <div class="report-info-list">


                <!-- REPORT TYPE -->

                <div class="report-info-row">

                    <div class="report-info-row-icon">
                        <i data-lucide="file-text"></i>
                    </div>

                    <div class="report-info-row-content">

                        <span class="report-info-row-label">
                            Report Type
                        </span>

                        <span class="report-info-row-value">

                            @if (Model.Report.ContentType ==
                                 PETHUB.Models.ReportedContentType.Listing)
                            {
                                @:Marketplace Listing
                            }
                            else if (Model.Report.ContentType ==
                                     PETHUB.Models.ReportedContentType.LostFound)
                            {
                                @:Lost &amp; Found
                            }

                        </span>

                    </div>

                </div>


                <!-- REASON -->

                <div class="report-info-row">

                    <div class="report-info-row-icon">
                        <i data-lucide="triangle-alert"></i>
                    </div>

                    <div class="report-info-row-content">

                        <span class="report-info-row-label">
                            Reason
                        </span>

                        <span class="report-info-row-value">

                            @if (Model.Report.Reason ==
                                 PETHUB.Models.UserReportReason.Other &&
                                 !string.IsNullOrWhiteSpace(
                                     Model.Report.OtherReason))
                            {
                                @Model.Report.OtherReason
                            }
                            else
                            {
                                @Model.Report.Reason
                            }

                        </span>

                    </div>

                </div>


                <!-- DATE REPORTED -->

                <div class="report-info-row">

                    <div class="report-info-row-icon">
                        <i data-lucide="clock-3"></i>
                    </div>

                    <div class="report-info-row-content">

                        <span class="report-info-row-label">
                            Date Reported
                        </span>

                        <span class="report-info-row-value">

                            @(Model.Report.DateCreated
                                .ToLocalTime()
                                .ToString("MMM d, yyyy · h:mm tt"))

                        </span>

                    </div>

                </div>


                <!-- REPORTED BY -->

                <div class="report-info-row">

                    <div class="report-info-row-icon">
                        <i data-lucide="user-round"></i>
                    </div>

                    <div class="report-info-row-content">

                        <span class="report-info-row-label">
                            Reported By
                        </span>

                        <span class="report-info-row-value">

                            @(Model.Report.Reporter == null
                                ? "Unknown"
                                : $"{Model.Report.Reporter.FirstName} {Model.Report.Reporter.LastName}")

                        </span>

                    </div>

                </div>


                <!-- POST OWNER -->

                <div class="report-info-row">

                    <div class="report-info-row-icon">
                        <i data-lucide="user-round"></i>
                    </div>

                    <div class="report-info-row-content">

                        <span class="report-info-row-label">
                            Post Owner
                        </span>

                        <span class="report-info-row-value">

                            @if (Model.Report.ContentType ==
                                 PETHUB.Models.ReportedContentType.Listing)
                            {
                                if (Model.Report.Listing?.Member != null)
                                {
                                    @($"{Model.Report.Listing.Member.FirstName} {Model.Report.Listing.Member.LastName}")
                                }
                                else
                                {
                                    @:Unknown
                                }
                            }
                            else if (Model.Report.ContentType ==
                                     PETHUB.Models.ReportedContentType.LostFound)
                            {
                                if (Model.Report.LostFound?.User != null)
                                {
                                    @($"{Model.Report.LostFound.User.FirstName} {Model.Report.LostFound.User.LastName}")
                                }
                                else
                                {
                                    @:Unknown
                                }
                            }

                        </span>

                    </div>

                </div>


                <!-- REPORT DESCRIPTION -->

                <div class="report-info-description">

                    <span class="report-info-description-label">
                        Report Description
                    </span>

                    @if (string.IsNullOrWhiteSpace(
                        Model.Report.Description))
                    {
                        <p class="report-info-description-text report-info-muted">
                            No additional description was provided.
                        </p>
                    }
                    else
                    {
                        <p class="report-info-description-text">
                            @Model.Report.Description
                        </p>
                    }

                </div>

            </div>

        </div>


        <!-- =====================================================
             REPORTED CONTENT
        ====================================================== -->

        <div class="admin-report-details-card">

            <div class="admin-report-details-card-header">

                <div class="admin-report-details-card-icon">

                    <i data-lucide="file-text"></i>

                </div>

                <h2>
                    Reported Content
                </h2>

            </div>


            <!-- MARKETPLACE -->
            @if (Model.Report.ContentType ==
                             PETHUB.Models.ReportedContentType.Listing)
            {
                @if (Model.Report.Listing == null)
                {
                    <div class="admin-report-content-unavailable">

                        <i data-lucide="image-off"></i>

                        <span>
                            The reported Marketplace listing is no longer available.
                        </span>

                    </div>
                }
                else
                {
                    <div class="admin-report-content-preview">


                        <!-- IMAGE -->

                        <div class="admin-report-content-image-wrapper">

                            @if (Model.Report.Listing.Images != null &&
                                 Model.Report.Listing.Images.Any())
                            {
                                <img src="@Model.Report.Listing.Images.First().ImagePath"
                                     class="admin-report-content-image"
                                     alt="Reported listing image" />
                            }
                            else
                            {
                                <div class="admin-report-content-no-image">

                                    <i data-lucide="image-off"></i>

                                    <span>
                                        No image available
                                    </span>

                                </div>
                            }

                        </div>


                        <!-- TYPE -->

                        <p class="admin-report-content-type">
                            Marketplace Listing
                        </p>


                        <!-- TITLE -->

                        <h3 class="admin-report-content-title">
                            @Model.Report.Listing.Title
                        </h3>


                        <!-- VIEW DETAILS -->

                        <a asp-controller="Marketplace"
                           asp-action="Details"
                           asp-route-id="@Model.Report.Listing.ListingId"
                           class="admin-report-view-post">

                            View Details

                            <i data-lucide="arrow-right"></i>

                        </a>

                    </div>
                }
            }


            <!-- LOST & FOUND -->
            @if (Model.Report.ContentType ==
                             PETHUB.Models.ReportedContentType.LostFound)
            {
                @if (Model.Report.LostFound == null)
                {
                    <div class="admin-report-content-unavailable">

                        <i data-lucide="image-off"></i>

                        <span>
                            The reported Lost &amp; Found post is no longer available.
                        </span>

                    </div>
                }
                else
                {
                    <div class="admin-report-content-preview">


                        <!-- IMAGE -->

                        <div class="admin-report-content-image-wrapper">

                            @if (Model.Report.LostFound.Images != null &&
                                 Model.Report.LostFound.Images.Any())
                            {
                                <img src="@Model.Report.LostFound.Images.First().ImagePath"
                                     class="admin-report-content-image"
                                     alt="Reported Lost &amp; Found image" />
                            }
                            else
                            {
                                <div class="admin-report-content-no-image">

                                    <i data-lucide="image-off"></i>

                                    <span>
                                        No image available
                                    </span>

                                </div>
                            }

                        </div>


                        <!-- TYPE -->

                        <p class="admin-report-content-type lost-found">
                            Lost &amp; Found
                        </p>


                        <!-- TITLE -->

                        <h3 class="admin-report-content-title">
                            @Model.Report.LostFound.Title
                        </h3>


                        <!-- VIEW DETAILS -->

                        <a asp-controller="LostFound"
                           asp-action="Details"
                           asp-route-id="@Model.Report.LostFound.LostFoundId"
                           class="admin-report-view-post">

                            View Details

                            <i data-lucide="arrow-right"></i>

                        </a>

                    </div>
                }
            }

        </div>

    </div>


    <!-- =========================================================
         SECOND ROW
    ========================================================== -->

    <div class="admin-report-details-grid">


        <!-- =====================================================
             REPORTS FOR THIS POST
        ====================================================== -->

        <div class="admin-report-details-card">

            <div class="admin-report-details-card-header">

                <div class="admin-report-details-card-icon">

                    <i data-lucide="files"></i>

                </div>

                <h2>
                    Reports for This Post
                </h2>

            </div>


            <p class="admin-report-related-summary">

                @Model.RelatedReports.Count
                report@(Model.RelatedReports.Count == 1 ? "" : "s")
                submitted for this post.

            </p>


            <div class="admin-report-related-list">

                @foreach (var relatedReport in Model.RelatedReports)
                {
                    <div class="admin-report-related-item">


                        <!-- TOP ROW -->

                        <div class="admin-report-related-top">

                            <div>

                                <div class="admin-report-related-reporter">

                                    @(relatedReport.Reporter == null
                                        ? "Unknown"
                                        : $"{relatedReport.Reporter.FirstName} {relatedReport.Reporter.LastName}")

                                </div>

                                <div class="admin-report-related-date">

                                    Submitted
                                    @(relatedReport.DateCreated
                                        .ToLocalTime()
                                        .ToString("MMM d, yyyy · h:mm tt"))

                                </div>

                            </div>


                            <!-- STATUS -->
                            @if (relatedReport.Status ==
                                                             PETHUB.Models.UserReportStatus.Pending)
                            {
                                <span class="admin-report-status-badge admin-report-status-pending">

                                    <span class="admin-report-status-dot"></span>

                                    Pending

                                </span>
                            }
                            else if (relatedReport.Status ==
                                     PETHUB.Models.UserReportStatus.Dismissed)
                            {
                                <span class="admin-report-status-badge admin-report-status-dismissed">

                                    <span class="admin-report-status-dot"></span>

                                    Dismissed

                                </span>
                            }
                            else if (relatedReport.Status ==
                                     PETHUB.Models.UserReportStatus.Resolved)
                            {
                                <span class="admin-report-status-badge admin-report-status-resolved">

                                    <span class="admin-report-status-dot"></span>

                                    Resolved

                                </span>
                            }

                        </div>


                        <!-- REPORT REASON -->

                        <div class="admin-report-related-reason">

                            @if (relatedReport.Reason ==
                                 PETHUB.Models.UserReportReason.Other &&
                                 !string.IsNullOrWhiteSpace(
                                     relatedReport.OtherReason))
                            {
                                @relatedReport.OtherReason
                            }
                            else
                            {
                                @relatedReport.Reason
                            }

                        </div>


                        <!-- REPORTER'S NOTE -->

                        <div class="admin-report-related-note">

                            <span class="admin-report-related-note-label">
                                Reporter's Note
                            </span>

                            @if (string.IsNullOrWhiteSpace(
                                relatedReport.Description))
                            {
                                <span>
                                    No additional description was provided.
                                </span>
                            }
                            else
                            {
                                <span>
                                    @relatedReport.Description
                                </span>
                            }

                        </div>

                    </div>
                }

            </div>

        </div>


        <!-- =====================================================
             REVIEW ACTIONS
        ====================================================== -->

        <div class="admin-report-details-card">

            <div class="admin-report-details-card-header">

                <div class="admin-report-details-card-icon">

                    <i data-lucide="gavel"></i>

                </div>

                <h2>
                    Review Actions
                </h2>

            </div>


            <p class="admin-report-actions-description">

                Review the report and the reported content before deciding
                whether the report should be dismissed or the reported
                content should be removed.

            </p>


            @if (Model.Report.Status ==
                 PETHUB.Models.UserReportStatus.Pending)
            {
                <div class="admin-report-action-buttons">


                    <!-- DISMISS -->

                    <form asp-controller="Reports"
                          asp-action="Dismiss"
                          method="post"
                          onsubmit="return confirm('Are you sure you want to dismiss this report?');">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Report.UserReportId" />

                        <button type="submit"
                                class="admin-report-action-button admin-report-action-dismiss">

                            Dismiss Report

                        </button>

                    </form>


                    <!-- CONFIRM VIOLATION -->

                    <button type="button"
                            class="admin-report-action-button admin-report-action-remove"
                            data-bs-toggle="modal"
                            data-bs-target="#confirmViolationModal">

                        Confirm Violation &amp; Remove Post

                    </button>

                </div>
            }
            else
            {
                <div class="admin-report-action-completed">

                    <i data-lucide="circle-check"></i>

                    <span>
                        This report has already been reviewed.
                    </span>

                </div>
            }

        </div>

    </div>


    <!-- =========================================================
         OWNER'S APPEAL
    ========================================================== -->
    @if (Model.Appeal != null)
    {
        <div class="admin-report-appeal-card">


            <!-- APPEAL HEADER -->

            <div class="admin-report-appeal-header">

                <div class="admin-report-appeal-title-wrapper">

                    <div class="admin-report-appeal-icon">

                        <i data-lucide="scale"></i>

                    </div>

                    <div>

                        <h2>
                            Owner's Appeal
                        </h2>

                        <p>
                            The owner submitted an explanation regarding
                            the removal of this post.
                        </p>

                    </div>

                </div>


                <!-- APPEAL STATUS -->
                @if (Model.Appeal.Status ==
                                     PETHUB.Models.AppealStatus.Pending)
                {
                    <span class="admin-report-status-badge admin-report-status-pending">

                        <span class="admin-report-status-dot"></span>

                        Pending

                    </span>
                }
                else if (Model.Appeal.Status ==
                         PETHUB.Models.AppealStatus.Approved)
                {
                    <span class="admin-report-status-badge admin-report-status-resolved">

                        <span class="admin-report-status-dot"></span>

                        Approved

                    </span>
                }
                else if (Model.Appeal.Status ==
                         PETHUB.Models.AppealStatus.Rejected)
                {
                    <span class="admin-report-status-badge admin-report-status-dismissed">

                        <span class="admin-report-status-dot"></span>

                        Rejected

                    </span>
                }

            </div>


            <!-- APPEAL MESSAGE -->

            <div class="admin-report-appeal-message">

                <p>
                    "@Model.Appeal.AppealMessage"
                </p>

            </div>


            <!-- ADMIN RESPONSE -->
            @if (!string.IsNullOrWhiteSpace(
                            Model.Appeal.AdminActionReason))
            {
                <div class="admin-report-appeal-response">

                    <span class="admin-report-information-label">
                        Admin Response
                    </span>

                    <p>
                        @Model.Appeal.AdminActionReason
                    </p>

                </div>
            }


            <!-- APPEAL ACTIONS -->
            @if (Model.Appeal.Status ==
                             PETHUB.Models.AppealStatus.Pending)
            {
                <div class="admin-report-appeal-actions">


                    <!-- CONFIRM APPEAL -->

                    <form asp-controller="Reports"
                          asp-action="ConfirmAppeal"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="appealId"
                               value="@Model.Appeal.AppealId" />

                        <button type="submit"
                                class="admin-report-appeal-confirm"
                                onclick="return confirm('Are you sure you want to confirm this appeal and restore the post?');">

                            <i data-lucide="check"></i>

                            Confirm Appeal &amp; Restore Post

                        </button>

                    </form>


                    <!-- REJECT APPEAL -->

                    <button type="button"
                            class="admin-report-appeal-reject"
                            data-bs-toggle="modal"
                            data-bs-target="#rejectAppealModal">

                        Reject Appeal

                    </button>

                </div>
            }

        </div>
    }


    <!-- =========================================================
     CONFIRM VIOLATION MODAL
========================================================= -->

    <div class="modal fade"
         id="confirmViolationModal"
         tabindex="-1"
         aria-labelledby="confirmViolationModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered admin-report-confirm-dialog">

            <div class="modal-content admin-report-confirm-modal">


                <!-- =================================================
                 HEADER
            ================================================== -->

                <div class="admin-report-confirm-header">

                    <div class="admin-report-confirm-title">

                        <i data-lucide="triangle-alert"></i>

                        <h2 id="confirmViolationModalLabel">
                            Confirm Violation
                        </h2>

                    </div>


                    <p class="admin-report-confirm-subtitle">
                        Review the report information before removing the post.
                    </p>

                </div>


                <!-- =================================================
                 BODY
            ================================================== -->

                <div class="admin-report-confirm-body">


                    <!-- REPORT SUMMARY -->

                    <div class="admin-report-confirm-summary">


                        <!-- REPORT REASON -->

                        <div class="admin-report-confirm-field">

                            <span class="admin-report-confirm-label">
                                Report Reason
                            </span>

                            <div class="admin-report-confirm-value">

                                @if (Model.Report.Reason ==
                                     PETHUB.Models.UserReportReason.Other &&
                                     !string.IsNullOrWhiteSpace(
                                         Model.Report.OtherReason))
                                {
                                    @Model.Report.OtherReason
                                }
                                else
                                {
                                    @Model.Report.Reason
                                }

                            </div>

                        </div>


                        <!-- REPORTER'S NOTE -->

                        <div class="admin-report-confirm-field">

                            <span class="admin-report-confirm-label">
                                Reporter's Note
                            </span>

                            @if (string.IsNullOrWhiteSpace(
                                Model.Report.Description))
                            {
                                <div class="admin-report-confirm-note muted">
                                    No additional description was provided.
                                </div>
                            }
                            else
                            {
                                <div class="admin-report-confirm-note">
                                    @Model.Report.Description
                                </div>
                            }

                        </div>

                    </div>


                    <!-- =================================================
                     ADMIN REASON
                ================================================== -->

                    <form asp-controller="Reports"
                          asp-action="ConfirmViolation"
                          method="post"
                          class="admin-report-confirm-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Report.UserReportId" />


                        <div class="admin-report-confirm-input-group">

                            <label for="adminActionReason"
                                   class="admin-report-confirm-input-label">

                                Reason for Removing This Post

                            </label>


                            <textarea id="adminActionReason"
                                      name="adminActionReason"
                                      class="admin-report-confirm-textarea"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Explain why this post violates PETHUB community standards and why it is being removed."
                                      required></textarea>


                            <span class="admin-report-confirm-help">
                                This reason will be shown to the post owner so they know what needs to be corrected or considered during an appeal.
                            </span>

                        </div>


                        <!-- =================================================
                         ACTION BUTTONS
                    ================================================== -->

                        <div class="admin-report-confirm-actions">

                            <button type="button"
                                    class="admin-report-confirm-cancel"
                                    data-bs-dismiss="modal">

                                Cancel

                            </button>


                            <button type="submit"
                                    class="admin-report-confirm-submit">

                                Confirm Violation

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
     REJECT APPEAL MODAL
========================================================= -->
    @if (Model.Appeal != null &&
         Model.Appeal.Status ==
         PETHUB.Models.AppealStatus.Pending)
    {
        <div class="modal fade"
             id="rejectAppealModal"
             tabindex="-1"
             aria-labelledby="rejectAppealModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered admin-report-reject-dialog">

                <div class="modal-content admin-report-reject-modal">


                    <!-- =================================================
                     HEADER
                ================================================== -->

                    <div class="admin-report-reject-header">

                        <div class="admin-report-reject-title">

                            <i data-lucide="triangle-alert"></i>

                            <h2 id="rejectAppealModalLabel">
                                Reject Appeal
                            </h2>

                        </div>


                        <p class="admin-report-reject-subtitle">
                            Review the appeal before rejecting the owner's request.
                        </p>

                    </div>


                    <!-- =================================================
                     BODY
                ================================================== -->

                    <div class="admin-report-reject-body">


                        <!-- APPEAL SUMMARY -->

                        <div class="admin-report-reject-summary">


                            <!-- OWNER'S APPEAL -->

                            <div class="admin-report-reject-field">

                                <span class="admin-report-reject-label">
                                    Owner's Appeal
                                </span>

                                <div class="admin-report-reject-value">

                                    @if (string.IsNullOrWhiteSpace(
                                        Model.Appeal.AppealMessage))
                                    {
                                        <span class="admin-report-reject-muted">
                                            No appeal explanation was provided.
                                        </span>
                                    }
                                    else
                                    {
                                        @Model.Appeal.AppealMessage
                                    }

                                </div>

                            </div>


                            <!-- POST STATUS -->

                            <div class="admin-report-reject-field">

                                <span class="admin-report-reject-label">
                                    Post Status
                                </span>

                                <div class="admin-report-reject-value">
                                    Removed
                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                         ADMIN RESPONSE FORM
                    ================================================== -->

                        <form asp-controller="Reports"
                              asp-action="RejectAppeal"
                              method="post"
                              class="admin-report-reject-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="appealId"
                                   value="@Model.Appeal.AppealId" />


                            <div class="admin-report-reject-input-group">

                                <label for="appealAdminActionReason"
                                       class="admin-report-reject-input-label">

                                    Reason for Rejecting This Appeal

                                </label>


                                <textarea id="appealAdminActionReason"
                                          name="adminActionReason"
                                          class="admin-report-reject-textarea"
                                          rows="4"
                                          maxlength="2000"
                                          placeholder="Explain why the owner's appeal is being rejected."
                                          required></textarea>


                                <span class="admin-report-reject-help">
                                    This response will be shown to the post owner so they understand why the appeal was rejected.
                                </span>

                            </div>


                            <!-- =================================================
                             ACTION BUTTONS
                        ================================================== -->

                            <div class="admin-report-reject-actions">

                                <button type="button"
                                        class="admin-report-reject-cancel"
                                        data-bs-dismiss="modal">

                                    Cancel

                                </button>


                                <button type="submit"
                                        class="admin-report-reject-submit">

