@model PETHUB.ViewModels.PaginationViewModel<PETHUB.Models.AuditLog>

@{
    ViewData["Title"] =
        User.IsInRole("Admin")
            ? "Admin Logs"
            : "My Logs";


    // =========================================================
    // ADMIN USERS
    // =========================================================
    //
    // The controller sends a dictionary containing the
    // ApplicationUser records for Admins shown in the table.
    //
    // This lets the view display:
    // - Full name
    // - Profile picture
    // - Initials fallback
    // =========================================================

    var adminUsers =
        ViewBag.AdminUsers
        as Dictionary<string, PETHUB.Models.ApplicationUser>;


    // =========================================================
    // CURRENT FILTER VALUES
    // =========================================================

    var currentSearch =
        ViewBag.Search as string ?? "";

    var currentCategory =
        ViewBag.Category as string ?? "";

    var currentMonth =
        ViewBag.Month as string ?? "";


    // =========================================================
    // PAGINATION
    // =========================================================

    var totalPages =
        Model.PageSize > 0
            ? (int)Math.Ceiling(
                Model.TotalItems /
                (double)Model.PageSize)
            : 0;
}


<div class="logs-page">


    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <div class="logs-header">

        @if (User.IsInRole("Admin"))
        {
            <h1>
                Admin Logs
            </h1>

            <p>
                View and review administrator activity.
            </p>
        }
        else
        {
            <h1>
                My Logs
            </h1>

            <p>
                View your account activity and actions.
            </p>
        }

    </div>



    <!-- =========================================================
         SEARCH / FILTER / TOTAL
    ========================================================== -->

    <form asp-controller="MyLogs"
          asp-action="Index"
          method="get"
          class="logs-toolbar">


        <div class="logs-toolbar-left">


            <!-- =================================================
                 SEARCH
            ================================================== -->

            <div class="logs-search">

                <i data-lucide="search"
                   class="logs-search-icon">
                </i>


                <input type="text"
                       name="search"
                       value="@currentSearch"
                       class="logs-search-input"
                       placeholder="Search admin or action..." />

            </div>



            <!-- =================================================
                 CATEGORY FILTER
            ================================================== -->

            <div class="logs-filter-field">


                <div class="pethub-select-wrapper">


                    <!-- REAL SELECT -->

                    <select name="category"
                            id="logsCategorySelect"
                            class="pethub-select-native">

                        <option value=""
                                selected="@(string.IsNullOrWhiteSpace(currentCategory))">
                            All Activity
                        </option>

                        <option value="logged"
                                selected="@(currentCategory == "logged")">
                            Logged
                        </option>

                        <option value="posts"
                                selected="@(currentCategory == "posts")">
                            Posts
                        </option>

                        <option value="reports"
                                selected="@(currentCategory == "reports")">
                            Reports
                        </option>

                    </select>


                    <!-- VISIBLE CUSTOM SELECT -->

                    <button type="button"
                            class="pethub-select-trigger logs-category-trigger"
                            data-select-target="logsCategorySelect">

                        <span class="pethub-select-text">
                            All Activity
                        </span>

                        <i data-lucide="chevron-down"></i>

                    </button>


                    <!-- CUSTOM MENU -->

                    <div class="pethub-select-menu"
                         data-menu-for="logsCategorySelect">
                    </div>


                </div>


            </div>



            <!-- =================================================
                 MONTH FILTER
            ================================================== -->

            <div class="logs-month-filter">

                <i data-lucide="calendar-days"></i>


                <input type="month"
                       name="month"
                       value="@currentMonth"
                       class="logs-month-input" />

            </div>



            <!-- =================================================
                 APPLY FILTER
            ================================================== -->

            <button type="submit"
                    class="logs-apply-filter">

                <i data-lucide="sliders-horizontal"></i>

                <span>
                    Apply
                </span>

            </button>



            <!-- =================================================
                 CLEAR FILTER
            ================================================== -->

            @if (
                !string.IsNullOrWhiteSpace(currentSearch)
                ||
                !string.IsNullOrWhiteSpace(currentCategory)
                ||
                !string.IsNullOrWhiteSpace(currentMonth)
            )
            {
                <a asp-controller="MyLogs"
                   asp-action="Index"
                   class="logs-clear-filter">

                    Clear

                </a>
            }


        </div>



        <!-- =====================================================
             TOTAL
        ====================================================== -->

        <div class="logs-total">

            <span class="logs-total-number">
                @Model.TotalItems
            </span>

            <span class="logs-total-label">
                total
            </span>

        </div>


    </form>



    <!-- =========================================================
         LOG TABLE
    ========================================================== -->

    @if (!Model.Items.Any())
    {

        <!-- =====================================================
             EMPTY RESULT
        ====================================================== -->

        <div class="logs-empty-card">

            <p>

                @if (
                    !string.IsNullOrWhiteSpace(currentSearch)
                    ||
                    !string.IsNullOrWhiteSpace(currentCategory)
                    ||
                    !string.IsNullOrWhiteSpace(currentMonth)
                )
                {
                    @:No logs match the selected search or filters.
                }
                else if (User.IsInRole("Admin"))
                {
                    @:There are no administrator activity logs yet.
                }
                else
                {
                    @:You don't have any activity logs yet.
                }

            </p>

        </div>

    }
    else
    {

        <!-- =====================================================
             TABLE CARD
        ====================================================== -->

        <div class="logs-card">


            <div class="logs-table-wrapper">


                <table class="logs-table">


                    <!-- =============================================
                         TABLE HEADER
                    ============================================== -->

                    <thead>

                        <tr>


                            @if (User.IsInRole("Admin"))
                            {
                                <th class="logs-admin-column">
                                    Admin
                                </th>
                            }


                            <th class="logs-action-column">
                                Action
                            </th>


                            <th class="logs-date-column">
                                Date
                            </th>


                            <th class="logs-time-column">
                                Time
                            </th>


                        </tr>

                    </thead>



                    <!-- =============================================
                         TABLE BODY
                    ============================================== -->

                    <tbody>


                        @foreach (var log in Model.Items)
                        {

                            <tr>


                                <!-- =================================
                                     ADMIN
                                ================================== -->

                                @if (User.IsInRole("Admin"))
                                {

                                    <td class="logs-admin-cell">


                                        <div class="logs-admin">


                                            <!-- =============================
                                                 PROFILE PICTURE
                                            ============================== -->

                                            <div class="logs-avatar">


                                                @if (
                                                    adminUsers != null
                                                    &&
                                                    adminUsers.TryGetValue(
                                                        log.UserId,
                                                        out var avatarAdmin)
                                                )
                                                {

                                                    @if (
                                                        !string.IsNullOrWhiteSpace(
                                                            avatarAdmin.ProfilePicturePath)
                                                    )
                                                    {

                                                        <img src="@avatarAdmin.ProfilePicturePath"
                                                             alt="@avatarAdmin.FirstName"
                                                             class="logs-avatar-image" />

                                                    }
                                                    else
                                                    {

                                                        <span>

                                                            @(
                                                                $"{avatarAdmin.FirstName?.FirstOrDefault()}{avatarAdmin.LastName?.FirstOrDefault()}"
                                                            )

                                                        </span>

                                                    }

                                                }
                                                else
                                                {

                                                    <span>
                                                        ?
                                                    </span>

                                                }


                                            </div>



                                            <!-- =============================
                                                 ADMIN NAME
                                            ============================== -->

                                            <div class="logs-admin-name">


                                                @if (
                                                    adminUsers != null
                                                    &&
                                                    adminUsers.TryGetValue(
                                                        log.UserId,
                                                        out var adminUser)
                                                )
                                                {

                                                    @(
                                                        $"{adminUser.FirstName} {adminUser.MiddleName} {adminUser.LastName}"
                                                            .Replace(
                                                                "  ",
                                                                " ")
                                                            .Trim()
                                                    )

                                                }
                                                else
                                                {

                                                    @("Unknown Admin")

                                                }


                                            </div>


                                        </div>


                                    </td>

                                }



                                <!-- =================================
                                     ACTION
                                ================================== -->

                                <td class="logs-action-cell">

                                    <span class="logs-action">
                                        @log.Action
                                    </span>

                                </td>



                                <!-- =================================
                                     DATE
                                ================================== -->

                                <td class="logs-date-cell">

                                    @(
                                        log.CreatedAt
                                            .ToLocalTime()
                                            .ToString("MMM dd, yyyy")
                                    )

                                </td>



                                <!-- =================================
                                     TIME
                                ================================== -->

                                <td class="logs-time-cell">

                                    @(
                                        log.CreatedAt
                                            .ToLocalTime()
                                            .ToString("hh:mm tt")
                                    )

                                </td>


                            </tr>

                        }


                    </tbody>


                </table>


            </div>


        </div>

    }



    <!-- =========================================================
         PAGINATION
    ========================================================== -->

    @if (totalPages > 1)
    {

        <div class="pagination-container">


            <!-- =====================================================
                 PAGE SUMMARY
            ====================================================== -->

            <div class="pagination-summary">

                Page

                <strong>
                    @Model.CurrentPage
                </strong>

                of

                <strong>
                    @totalPages
                </strong>

            </div>



            <!-- =====================================================
                 PAGE CONTROLS
            ====================================================== -->

            <div class="pagination-controls">


                <!-- PREVIOUS -->

                @if (Model.CurrentPage > 1)
                {

                    <a asp-controller="MyLogs"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-search="@currentSearch"
                       asp-route-category="@currentCategory"
                       asp-route-month="@currentMonth"
                       class="pagination-button">

                        &lsaquo;

                    </a>

                }
                else
                {

                    <span class="pagination-button disabled">
                        &lsaquo;
                    </span>

                }



                <!-- =================================================
                     PAGE NUMBERS
                ================================================== -->

                @{
                    var startPage =
                        Math.Max(
                            1,
                            Model.CurrentPage - 2);

                    var endPage =
                        Math.Min(
                            totalPages,
                            Model.CurrentPage + 2);
                }


                @if (startPage > 1)
                {

                    <a asp-controller="MyLogs"
                       asp-action="Index"
                       asp-route-page="1"
                       asp-route-search="@currentSearch"
                       asp-route-category="@currentCategory"
                       asp-route-month="@currentMonth"
                       class="pagination-button">

                        1

                    </a>


                    @if (startPage > 2)
                    {

                        <span class="pagination-ellipsis">
                            ...
                        </span>

                    }

                }


                @for (
                    var i = startPage;
                    i <= endPage;
                    i++
                )
                {

                    <a asp-controller="MyLogs"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@currentSearch"
                       asp-route-category="@currentCategory"
                       asp-route-month="@currentMonth"
                       class="pagination-button @(i == Model.CurrentPage ? "active" : "")">

                        @i

                    </a>

                }


                @if (endPage < totalPages)
                {

                    @if (endPage < totalPages - 1)
                    {

                        <span class="pagination-ellipsis">
                            ...
                        </span>

                    }


                    <a asp-controller="MyLogs"
                       asp-action="Index"
                       asp-route-page="@totalPages"
                       asp-route-search="@currentSearch"
                       asp-route-category="@currentCategory"
                       asp-route-month="@currentMonth"
                       class="pagination-button">

                        @totalPages

                    </a>

                }



                <!-- NEXT -->

                @if (Model.CurrentPage < totalPages)
                {

                    <a asp-controller="MyLogs"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-search="@currentSearch"
                       asp-route-category="@currentCategory"
                       asp-route-month="@currentMonth"
                       class="pagination-button">

                        &rsaquo;

                    </a>

                }
                else
                {

                    <span class="pagination-button disabled">
                        &rsaquo;
                    </span>

                }


            </div>


        </div>

    }


</div>



@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                // Re-render Lucide icons.
                if (typeof lucide !== "undefined") {

                    lucide.createIcons();

                }

            }
        );

    </script>

}