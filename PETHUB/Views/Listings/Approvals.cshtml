@model PETHUB.ViewModels.ApprovalDashboardViewModel
@{ ViewData["Title"] = "Approvals"; var selected = Context.Request.Query["queue"].ToString(); if (string.IsNullOrEmpty(selected)) { selected = "marketplace"; } }
<h1 class="text-center mb-3">Approval Center</h1>
<!-- Toggle keeps both moderation queues on one page. -->
<div class="d-flex justify-content-center mb-3 gap-2"><a class="btn @(selected == "marketplace" ? "btn-primary" : "btn-outline-primary")" asp-action="Approvals" asp-route-queue="marketplace">Marketplace approvals</a><a class="btn @(selected == "lostfound" ? "btn-primary" : "btn-outline-primary")" asp-action="Approvals" asp-route-queue="lostfound">Lost &amp; Found approvals</a></div>
<form method="get" class="row justify-content-center g-2 mb-4"><input type="hidden" name="queue" value="@selected" /><div class="col-sm-3"><select name="statusFilter" class="form-select"><option value="">All approval statuses</option><option>Pending</option><option>Approved</option><option>Rejected</option></select></div><div class="col-sm-3"><select name="petTypeFilter" class="form-select"><option value="">Dogs and cats</option><option>Dog</option><option>Cat</option></select></div><div class="col-sm-auto"><button class="btn btn-dark">Filter</button></div></form>
@if (selected == "marketplace") { <div class="row">@foreach (var item in Model.Listings) { <div class="col-md-6 mb-3"><div class="card h-100"><div class="card-body"><h5>@item.Title <span class="badge bg-@(item.Status == ListApprovalStatus.Approved ? "success" : item.Status == ListApprovalStatus.Rejected ? "danger" : "secondary")">@item.Status</span></h5><p>@item.PetType · @item.Type · Posted by @(item.Member?.UserName ?? "Unknown member")</p><a asp-action="Details" asp-route-id="@item.ListingId" class="btn btn-sm btn-outline-primary">View</a>@if (item.Status == ListApprovalStatus.Pending) { <form asp-action="Approve" asp-route-id="@item.ListingId" method="post" class="d-inline"><button class="btn btn-sm btn-success">Approve</button></form><form asp-action="Reject" asp-route-id="@item.ListingId" method="post" class="d-inline"><button class="btn btn-sm btn-danger">Reject</button></form> }</div></div></div> }</div> }
else { <div class="row">@foreach (var item in Model.LostFounds) { <div class="col-md-6 mb-3"><div class="card h-100"><div class="card-body"><h5>@item.Title <span class="badge bg-@(item.Status == ApprovalStatus.Approved ? "success" : item.Status == ApprovalStatus.Rejected ? "danger" : "secondary")">@item.Status</span></h5><p>@item.PetType · @item.Type · Reported by @(item.User?.UserName ?? item.ClientName ?? "Anonymous client")</p><a asp-controller="LostFounds" asp-action="Details" asp-route-id="@item.LostFoundId" class="btn btn-sm btn-outline-primary">View</a>@if (item.Status == ApprovalStatus.Pending) { <form asp-controller="LostFounds" asp-action="Approve" asp-route-id="@item.LostFoundId" method="post" class="d-inline"><button class="btn btn-sm btn-success">Approve</button></form><form asp-controller="LostFounds" asp-action="Reject" asp-route-id="@item.LostFoundId" method="post" class="d-inline"><button class="btn btn-sm btn-danger">Reject</button></form> }</div></div></div> }</div> }
