@model PETHUB.Models.Listing

@{
    ViewData["Title"] = "Create Listing";
}

<h1>Create Listing</h1>

<form asp-action="Create" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Title" class="control-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="control-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price" class="control-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <!-- File upload for images -->
    <div class="form-group">
        <label>Upload Images</label>
        <input type="file" id="imageInput" name="ImageFiles" multiple class="form-control" />
        <small class="form-text text-muted">You can select multiple files.</small>
    </div>

    <!-- Preview container -->
    <div id="imagePreviewContainer" class="d-flex flex-wrap gap-2 mt-3"></div>

    <div class="form-group mb-3">
        <label asp-for="Location" class="control-label"></label>
        <input asp-for="Location" class="form-control" placeholder="Enter city or area" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>

    <div class="form-group d-flex gap-2">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");

        <script src="~/js/imagePreviewHelper.js"></script>
        <script>
            setupImagePreview("imageInput", "imagePreviewContainer");
        </script>


    }
}
