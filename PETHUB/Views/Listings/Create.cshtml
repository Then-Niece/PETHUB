@model PETHUB.Models.Listing

@{
    ViewData["Title"] = "Create Listing";

}



<div class="container py-5">

    <!-- ==========================================
         FORM 1 - CHOOSE LISTING TYPE
    =========================================== -->
    <div id="listingSelection">
        <div class="listing-form-card">
            <div class="text-center mb-5">
                <h2>Create Marketplace Listing</h2>
                <p class="text-muted">
                    Choose the type of listing you want to create.
                </p>
            </div>

            <div class="row justify-content-center">
                <div class="col-md-5 mb-3">
                    <div class="listing-type-card" onclick="showAdoptionForm()">
                        <i data-lucide="heart-handshake"></i>
                        <h5 class="mt-3">For Adoption</h5>
                        <small>Help your pet find a loving home.</small>
                    </div>
                </div>

                <div class="col-md-5 mb-3">
                    <div class="listing-type-card" onclick="showSaleForm()">
                        <i data-lucide="badge-dollar-sign"></i>
                        <h5 class="mt-3">For Sale</h5>
                        <small>Sell your pet responsibly.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==========================================
         FORM 2 - CREATE LISTING
    =========================================== -->
    <div id="listingForm" style="display:none;">
        <div class="listing-form-card">
            <div class="mb-4">
                <h2 id="formTitle"></h2>
                <p id="formSubtitle" class="text-muted"></p>
            </div>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Hidden Listing Type Dropdown -->
                <div class="d-none">
                    <select asp-for="Type"
                            id="typeSelect"
                            asp-items="Html.GetEnumSelectList<PETHUB.Models.ListType>()">
                    </select>
                </div>

                <div class="row">
                    <!-- ======================================
                         LEFT SIDE - INPUT FIELDS
                    ====================================== -->
                    <div class="col-lg-8">
                        <!-- Title -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" placeholder="Enter listing title" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" rows="3" class="form-control" placeholder="Tell people about your pet..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- Price (HTML Entity &#8369; used for Peso sign to fix encoding issues) -->
                    <div class="mb-3" id="priceGroup">
                        <label asp-for="Price" class="form-label"></label>

                        <div class="price-input">
                            <span class="peso-sign" id="pesoSign">₱</span>

                            <input asp-for="Price"
                                   type="number"
                                   class="form-control"
                                   min="0"
                                   step="1"
                                   placeholder="0"
                                   onkeydown="return event.key !== '.' &&
                                                      event.key !== ',' &&
                                                      event.key !== 'e' &&
                                                      event.key !== 'E';" />
                        </div>

                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                        <!-- Pet Type -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Pet Type</label>
                            <div class="d-flex gap-4">
                                <div class="form-check">
                                    <input asp-for="PetType" class="form-check-input" type="radio" value="Dog" id="dog" />
                                    <label class="form-check-label" for="dog">Dog</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="PetType" class="form-check-input" type="radio" value="Cat" id="cat" />
                                    <label class="form-check-label" for="cat">Cat</label>
                                </div>
                            </div>
                            <span asp-validation-for="PetType" class="text-danger"></span>
                        </div>

                        <!-- Pet Sex -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Pet Sex</label>
                            <div class="d-flex gap-4 flex-wrap">
                                <div class="form-check">
                                    <input asp-for="PetSex" class="form-check-input" type="radio" value="Male" id="male" />
                                    <label class="form-check-label" for="male">Male</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="PetSex" class="form-check-input" type="radio" value="Female" id="female" />
                                    <label class="form-check-label" for="female">Female</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="PetSex" class="form-check-input" type="radio" value="Unknown" id="unknown" />
                                    <label class="form-check-label" for="unknown">Unknown</label>
                                </div>
                            </div>
                            <span asp-validation-for="PetSex" class="text-danger"></span>
                        </div>

                        <!-- Breed -->

                        <div class="mb-3">

                            <label asp-for="Breed" class="form-label"></label>

                            <input asp-for="Breed"
                                   class="form-control"
                                   placeholder="Breed" />

                            <span asp-validation-for="Breed"
                                  class="text-danger"></span>


                               

                        </div>

                          <!-- Address Fields -->
    <partial name="Components/_AddressFields" />
                </div>

                     

   

                    <!-- ======================================
                         RIGHT SIDE - PHOTO UPLOAD
                    ====================================== -->
                    <div class="col-lg-4">

                        <div class="photo-upload-card">

                            <h5 class="mb-3">
                                Photos
                            </h5>


                            <div class="mb-3">

                                <label class="form-label">
                                    Upload Images
                                </label>


                                <div class="photo-upload-control">

                                    <input type="file"
                                           id="imageInput"
                                           name="ImageFiles"
                                           multiple
                                           hidden
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />


                                    <button type="button"
                                            class="photo-upload-button"
                                            id="addPhotosButton">

                                        <i data-lucide="image-plus"></i>

                                        Add Photos

                                    </button>


                                    <span class="photo-upload-count"
                                          id="photoUploadCount">

                                        0 / 5 photos

                                    </span>

                                </div>


                                <small class="photo-upload-help">

                                    Upload up to 5 photos.
                                    JPG, PNG or WEBP only.
                                    Maximum 5 MB each.

                                </small>


                                <div id="imageUploadError"
                                     class="text-danger mt-2">
                                </div>

                            </div>


                            <div id="imagePreviewContainer"
                                 class="image-preview-grid"
                                 data-count="0">
                            </div>

                        </div>

                    </div>
                </div>

                <!-- Form Actions -->
                <hr class="my-4" />
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" onclick="cancelCreate()">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-success">
                        Post Listing
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>





<script>

    const ADOPTION = "0";
    const SALE = "1";

    function showAdoptionForm() {

        document.getElementById("listingSelection").style.display = "none";
        document.getElementById("listingForm").style.display = "block";

        document.getElementById("formTitle").textContent =
            "Create Adoption Listing";

        document.getElementById("formSubtitle").textContent =
            "Complete the information below to help your pet find a loving home.";

        document.getElementById("typeSelect").value = ADOPTION;

        togglePriceField();

    }

    function showSaleForm() {

        document.getElementById("listingSelection").style.display = "none";
        document.getElementById("listingForm").style.display = "block";

        document.getElementById("formTitle").textContent =
            "Create Sale Listing";

        document.getElementById("formSubtitle").textContent =
            "Complete the information below to list your pet responsibly for sale.";

        document.getElementById("typeSelect").value = SALE;

        togglePriceField();

    }

    function togglePriceField() {

        const typeSelect = document.getElementById("typeSelect");
        const priceGroup = document.getElementById("priceGroup");
        const priceInput = document.getElementById("Price");

        if (typeSelect.value === ADOPTION) {

            priceGroup.style.display = "none";
            priceInput.value = 0;

            if (priceInput.hasAttribute("data-val-required") &&
                !priceInput.dataset.originalRequired) {

                priceInput.dataset.originalRequired =
                    priceInput.getAttribute("data-val-required");

            }

            priceInput.removeAttribute("required");
            priceInput.removeAttribute("data-val-required");

        }
        else {

            priceGroup.style.display = "block";

            if (priceInput.dataset.originalRequired) {

                priceInput.setAttribute(
                    "data-val-required",
                    priceInput.dataset.originalRequired
                );

            }

        }

    }

    function cancelCreate() {

        document.querySelector("#listingForm form").reset();

        document.getElementById("listingForm").style.display = "none";
        document.getElementById("listingSelection").style.display = "block";

        document.getElementById("imagePreviewContainer").innerHTML = "";
        document.getElementById("imageInput").value = "";

    }

</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/imagePreviewHelper.js"></script>
   

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                setupImagePreview(
                    "imageInput",
                    "imagePreviewContainer",
                    {
                        multiple: true,

                        maxFiles: 5,

                        maxFileSize:
                            5 * 1024 * 1024,

                        allowedTypes: [
                            "image/jpeg",
                            "image/png",
                            "image/webp"
                        ],

                        previewWidth: null,
                        previewHeight: null,

                        countId:
                            "photoUploadCount",

                        errorId:
                            "imageUploadError"
                    }
                );


                const imageInput =
                    document.getElementById(
                        "imageInput"
                    );

                const addPhotosButton =
                    document.getElementById(
                        "addPhotosButton"
                    );


                if (
                    imageInput &&
                    addPhotosButton
                ) {

                    addPhotosButton.addEventListener(
                        "click",
                        function () {

                            imageInput.click();

                        }
                    );

                }

            }
        );
        

    </script>

    <script>
    

        document.addEventListener("DOMContentLoaded", function () {

            const form = document.querySelector(
                '#listingForm form'
            );

            if (!form) {
                return;
            }

            form.addEventListener("keydown", function (event) {

                if (event.key !== "Enter") {
                    return;
                }

                if (event.target.tagName === "TEXTAREA") {
                    return;
                }

              
                if (
                    event.target.tagName === "BUTTON" ||
                    event.target.tagName === "SELECT"
                ) {
                    return;
                }

               
                event.preventDefault();

            });

        });


});
    </script>

    <script src="~/js/address-helper.js"
            asp-append-version="true"></script>
}



