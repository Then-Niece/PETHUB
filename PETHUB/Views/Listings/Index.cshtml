@model IEnumerable<PETHUB.Models.Listing>

@{
    ViewData["Title"] = "Marketplace Approval";
}

<h1>Marketplace Approval</h1>

<div class="mb-3">

    <a asp-action="Index"
       class="btn btn-secondary">
        All
    </a>

    <a asp-action="Index"
       asp-route-status="Pending"
       class="btn btn-warning">
        Pending
    </a>

    <a asp-action="Index"
       asp-route-status="Approved"
       class="btn btn-success">
        Approved
    </a>

    <a asp-action="Index"
       asp-route-status="Rejected"
       class="btn btn-danger">
        Rejected
    </a>

</div>

<div class="container">
        @foreach (var item in Model)
        {
            string borderColor = "#6c757d"; //

            if (item.Status == ListApprovalStatus.Pending)
            {
                borderColor = "#ffc107"; //yellow
            }
            else if (item.Status == ListApprovalStatus.Approved)
            {
                borderColor = "#198754"; //green
            }
            else if (item.Status == ListApprovalStatus.Rejected)
            {
                borderColor = "#dc3545"; //red
            }

            <div class="card mb-2 shadow-sm"
                 style="border-left:5px solid @borderColor;">
            <div class="row g-0 align-items-center">

                <!-- Thumbnail -->
                <div class="col-auto">
                    @if (item.Images != null && item.Images.Any())
                    {
                        <img src="@Url.Content(item.Images.First().ImagePath)"
                             alt="Listing image"
                             class="img-thumbnail"
                             style="width:100px;height:100px;object-fit:cover;">
                    }
                    else
                    {
                        <img src="@Url.Content("~/images/no-image.png")"
                             alt="No image"
                             class="img-thumbnail"
                             style="width:100px;height:100px;object-fit:cover;">
                    }
                </div>

                <!-- Details -->
                <div class="col">
                    <div class="card-body py-2">
                        <h6 class="card-title mb-1">@item.Title</h6>
                        <p class="mb-1 text-muted small">@item.Description</p>

                        <p class="mb-0">
                            <span class="badge bg-@(item.Type == ListType.For_Adoption ? "primary" : "warning text-dark")">@item.Type</span>
                            <small class="text-muted"> | @item.DatePosted.ToString("MMM dd, yyyy")</small>
                            <small class="text-muted"> | @(string.IsNullOrEmpty(item.Location) ? "No location" : item.Location)</small>
                        </p>
                    </div>
                </div>

                <!-- Actions -->
                <div class="col-auto pe-3">
                    <a asp-action="Details" asp-route-id="@item.ListingId" class="btn btn-sm btn-outline-primary">View</a>
                </div>

                <!-- Footer -->
                <div class="card-footer text-end">
                    @if (item.Status == ListApprovalStatus.Pending)
                    {
                        <span class="badge bg-warning">Pending</span>
                    }
                    else if (item.Status == ListApprovalStatus.Approved)
                    {
                        <span class="badge bg-success">Approved</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Rejected</span>
                    }
                </div>
            </div>
        </div>
    }
</div>
