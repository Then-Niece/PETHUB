@model PETHUB.Models.Listing

@{
    ViewData["Title"] = "Listing Details";
}

<div class="marketplace-details-page">

    <!-- ==========================================================
         BACK TO MARKETPLACE
    =========================================================== -->

    <div class="mb-3">
        <a asp-action="Marketplace"
           class="text-decoration-none">
            ← Back to Marketplace
        </a>
    </div>


    <!-- ==========================================================
         MAIN LISTING LAYOUT
         LEFT  = IMAGE GALLERY
         RIGHT = LISTING INFORMATION
    =========================================================== -->

    <div class="listing-details-layout">


        <!-- ======================================================
             LEFT SIDE - IMAGE GALLERY
        ======================================================= -->

        <div class="listing-gallery">

            @if (Model.Images != null && Model.Images.Any())
            {
                <!-- ==================================================
                     MAIN IMAGE CAROUSEL
                =================================================== -->

                <div id="listingCarousel"
                     class="carousel slide listing-main-image"
                     data-bs-ride="carousel">

                    <div class="carousel-inner">

                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            var img = Model.Images.ElementAt(i);

                            <div class="carousel-item @(i == 0 ? "active" : "")">

                                <img src="@img.ImagePath"
                                     class="d-block w-100"
                                     alt="Listing Image @(i + 1)" />

                            </div>
                        }

                    </div>


                    <!-- Previous Button -->

                    <button class="carousel-control-prev"
                            type="button"
                            data-bs-target="#listingCarousel"
                            data-bs-slide="prev">

                        <span class="carousel-control-prev-icon"></span>

                        <span class="visually-hidden">
                            Previous
                        </span>

                    </button>


                    <!-- Next Button -->

                    <button class="carousel-control-next"
                            type="button"
                            data-bs-target="#listingCarousel"
                            data-bs-slide="next">

                        <span class="carousel-control-next-icon"></span>

                        <span class="visually-hidden">
                            Next
                        </span>

                    </button>

                </div>


                <!-- ==================================================
                     IMAGE THUMBNAILS
                =================================================== -->

                <div class="listing-thumbnail-grid">

                    @for (int i = 0; i < Model.Images.Count; i++)
                    {
                        var img = Model.Images.ElementAt(i);

                        <button type="button"
                                class="listing-thumbnail @(i == 0 ? "active" : "")"
                                data-bs-target="#listingCarousel"
                                data-bs-slide-to="@i"
                                aria-label="View image @(i + 1)">

                            <img src="@img.ImagePath"
                                 alt="Listing Image @(i + 1)" />

                        </button>
                    }

                </div>
            }
            else
            {
                <!-- ==================================================
                     NO IMAGE
                =================================================== -->

                <div class="listing-no-image">

                    <span>
                        No images uploaded.
                    </span>

                </div>
            }

        </div>


        <!-- ======================================================
             RIGHT SIDE - LISTING INFORMATION
        ======================================================= -->

        <div class="listing-info-panel">


            <!-- ==================================================
                 PROFILE
            =================================================== -->

            <div class="listing-profile">

                <div class="listing-profile-main">

                    <div class="listing-profile-avatar">

                        @if (!string.IsNullOrWhiteSpace(Model.Member?.ProfilePicturePath))
                        {
                            <img src="@Model.Member.ProfilePicturePath"
                                 class="rounded-circle border"
                                 style="width:44px;height:44px;object-fit:cover;" />
                        }
                        else
                        {
                            <img src="~/images/default_profile.jpg"
                                 class="rounded-circle border"
                                 style="width:44px;height:44px;object-fit:cover;" />
                        }


                    </div>

                    <div class="listing-profile-details">

                        <div class="listing-profile-name">
                            @Model.Member?.FirstName
                            @Model.Member?.LastName
                        </div>

                        <div class="listing-profile-meta">

                            <span>
                                @Model.DatePosted.ToString("MMMM dd, yyyy")
                            </span>

                            <span>·</span>

                            <span>
                                @(Model.Type == ListType.For_Adoption
                                    ? "For Adoption"
                                    : "For Sale")
                            </span>

                        </div>

                    </div>

                </div>


                <!-- THREE DOTS -->

                <div class="listing-more-menu">

                    <button type="button"
                            class="listing-more-btn"
                            aria-label="More options"
                            onclick="this.parentElement.classList.toggle('show')">

                        <i data-lucide="more-horizontal"></i>

                    </button>


                    <div class="listing-more-dropdown">

                        <button type="button">
                            <i data-lucide="link"></i>
                            <span>Copy Link</span>
                        </button>

                        <button type="button">
                            <i data-lucide="share-2"></i>
                            <span>Share Listing</span>
                        </button>

                        <div class="menu-divider"></div>

                        @if (User.IsInRole("Member") &&
                             Model.MemberId != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                        {
                            <!-- Opens the shared Report modal for this Marketplace listing.
                                 The server-side controller still verifies ownership before accepting
                                 the submitted report. -->
                            <button type="button"
                                    class="danger-action"
                                    data-bs-toggle="modal"
                                    data-bs-target="#reportModal"
                                    data-report-type="Listing"
                                    data-report-id="@Model.ListingId"
                                    data-report-title="@Model.Title">

                                <i data-lucide="flag"></i>

                                <span>Report Listing</span>

                            </button>
                        }
                    </div>

                </div>

            </div>


            <!-- ==================================================
                 PROFILE DIVIDER
            =================================================== -->

            <div class="listing-profile-divider"></div>


            <!-- ==================================================
                 TITLE
            =================================================== -->

            <div class="listing-title-section">

                <h1>
                    @Model.Title
                </h1>

                @if (Model.Type == PETHUB.Models.ListType.For_Sale)
                {
                    <div class="listing-price">
                        ₱@Model.Price.ToString("N2")
                    </div>
                }

            </div>

         



            <!-- ==================================================
                 ABOUT THIS PET
            =================================================== -->

            <section class="listing-info-section">

               

                <h3>
                    About This Pet 
                </h3>

                <p class="listing-description">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description provided."
                        : Model.Description)
                </p>

            </section>


            <!-- ==================================================
                 PET INFORMATION
            =================================================== -->

            <section class="listing-info-section">

                <h3>
                    Pet Information
                </h3>


                <div class="pet-information-list">


                    <!-- Pet Type -->

                    <div class="pet-information-item">

                        <span class="pet-information-label">

                            <i data-lucide="paw-print"></i>

                            Pet Type

                        </span>

                        <span class="pet-information-value">
                            @Model.PetType
                        </span>

                    </div>


                    <!-- Breed -->

                    <div class="pet-information-item">

                        <span class="pet-information-label">

                            <i data-lucide="tag"></i>

                            Breed

                        </span>

                        <span class="pet-information-value">
                            @Model.Breed
                        </span>

                    </div>


                    <!-- Sex -->

                    <div class="pet-information-item">

                        <span class="pet-information-label">

                            <i data-lucide="venus-and-mars"></i>

                            Sex

                        </span>

                        <span class="pet-information-value">
                            @Model.PetSex
                        </span>

                    </div>

                </div>

            </section>


            <!-- ==================================================
                 LOCATION
            =================================================== -->

            <section class="listing-info-section">

                <h3>

                    <i data-lucide="map-pin"></i>

                    WHERE TO FIND

                </h3>


                <div class="listing-location-grid">


                    <!-- Street Address -->

                    <div class="listing-location-item">

                        <span class="listing-location-label">
                            Street Address
                        </span>

                        <span class="listing-location-value">
                            @(string.IsNullOrWhiteSpace(Model.StreetAddress)
                                ? "Not specified"
                                : Model.StreetAddress)
                        </span>

                    </div>


                    <!-- Barangay -->

                    <div class="listing-location-item">

                        <span class="listing-location-label">
                            Barangay
                        </span>

                        <span class="listing-location-value">
                            @(string.IsNullOrWhiteSpace(Model.Barangay)
                                ? "Not specified"
                                : Model.Barangay)
                        </span>

                    </div>


                    <!-- City -->

                    <div class="listing-location-item">

                        <span class="listing-location-label">
                            City
                        </span>

                        <span class="listing-location-value">
                            @(string.IsNullOrWhiteSpace(Model.City)
                                ? "Not specified"
                                : Model.City)
                        </span>

                    </div>


                    <!-- Province -->

                    <div class="listing-location-item">

                        <span class="listing-location-label">
                            Province
                        </span>

                        <span class="listing-location-value">
                            @(string.IsNullOrWhiteSpace(Model.Province)
                                ? "Not specified"
                                : Model.Province)
                        </span>

                    </div>

                </div>

            </section>


            <!-- ==================================================
                 CONTACT NUMBER
            =================================================== -->

            <section class="listing-info-section listing-contact-section">

                <h3>

                    <i data-lucide="phone"></i>

                    Contact Number

                </h3>

                <p class="listing-contact-number">

                  

                    @(string.IsNullOrWhiteSpace(Model.Member?.ContactNumber)
                        ? "Not Available"
                        : Model.Member.ContactNumber)

                </p>

            </section>


            <!-- ==================================================
                 ACTION BUTTONS
            =================================================== -->

            <div class="listing-actions">


                <!-- Message -->

                <button type="button"
                        class="btn listing-message-btn">

                    <i data-lucide="message-circle"></i>

                    <span>
                        Message Me
                    </span>

                </button>


                <!-- Favorite -->

                <button type="button"
                        class="btn listing-favorite-btn"
                        aria-label="Add to favorites">

                    <i data-lucide="heart"></i>

                </button>

            </div>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function() {

        const moreMenu =
            document.querySelector(".listing-more-menu");

        const infoPanel =
            document.querySelector(".listing-info-panel");


        /* ==================================================
           CLOSE WHEN CLICKING OUTSIDE
        ================================================== */

        document.addEventListener("click", function(event) {

            if (!moreMenu) {
                return;
            }

            if (!event.target.closest(".listing-more-menu")) {

                moreMenu.classList.remove("show");

            }

        });


        /* ==================================================
           CLOSE WHEN RIGHT PANEL IS SCROLLED
        ================================================== */

        if (infoPanel && moreMenu) {

            infoPanel.addEventListener("scroll", function() {

                moreMenu.classList.remove("show");

            });

        }

    });

</script>