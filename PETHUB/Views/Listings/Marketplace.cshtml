@model PETHUB.ViewModels.PaginationViewModel<PETHUB.Models.Listing>

@{
    ViewData["Title"] = "Marketplace Client";

    // =========================================================
    // MARKETPLACE FILTERS
    // =========================================================

    var marketplaceFilters = PETHUB.Helpers.FilterBarHelper.Create(
        PETHUB.Helpers.FilterBarHelper.ListingType(
            Context.Request.Query["listingType"].ToString()
        ),
        PETHUB.Helpers.FilterBarHelper.PetType(
            Context.Request.Query["petType"].ToString()
        )
    );


    // =========================================================
    // MARKETPLACE LISTING COUNT
    // =========================================================

    var listingCount = Model.TotalItems;

    var selectedPetType =
        Context.Request.Query["petType"].ToString();


    // =========================================================
    // MARKETPLACE COUNT LABEL
    // =========================================================

    var countLabel = "Listings";

    if (!string.IsNullOrEmpty(selectedPetType))
    {
        if (selectedPetType.Equals(
                "dog",
                StringComparison.OrdinalIgnoreCase) ||
            selectedPetType.Equals(
                "dogs",
                StringComparison.OrdinalIgnoreCase))
        {
            countLabel = "Dogs";
        }
        else if (selectedPetType.Equals(
                     "cat",
                     StringComparison.OrdinalIgnoreCase) ||
                 selectedPetType.Equals(
                     "cats",
                     StringComparison.OrdinalIgnoreCase))
        {
            countLabel = "Cats";
        }
        else
        {
            countLabel = selectedPetType;
        }
    }
}



<!-- =========================================================
     MARKETPLACE HERO
========================================================== -->

<section class="marketplace-hero"
         style="background-image: url('@Url.Content("~/images/hero_banner.jpg")');">

    <div class="marketplace-hero-overlay"></div>


    <div class="marketplace-hero-content">

        <h1 class="marketplace-hero-title">

            Find Your New Best Friend

        </h1>


        <p class="marketplace-hero-description">

            Discover pets looking for loving homes
            and pets available for sale.

        </p>

    </div>

</section>



<!-- =========================================================
     MARKETPLACE FILTER

     The filter overlaps the bottom of the hero.
========================================================== -->

<div class="marketplace-filter-container">

    <div class="marketplace-filter-bar">


 
        <!-- SEARCH -->
        <form method="get" class="marketplace-search">
            <div class="marketplace-search-wrapper">

                <i data-lucide="search"
                   class="marketplace-search-icon"></i>

                <input type="text"
                       name="search"
                       value="@Context.Request.Query["search"]"
                       class="marketplace-search-input"
                       placeholder="Search listings..." />

            </div>
        </form>




        <!-- =====================================================
             FILTER CONTROLS
        ====================================================== -->

        <div class="marketplace-filter-controls">

            @foreach (var filter in marketplaceFilters.Filters)
            {
                var selectedValue =
                    filter.SelectedValue ?? filter.DefaultValue;


                var filterIcon =
                    filter.ParameterName == "listingType"
                        ? "tag"
                        : "paw-print";


                // =================================================
                // BUILD OPTION URLS
                // =================================================

                var filterOptions = new List<dynamic>();

                foreach (var option in filter.Options)
                {
                    var query = Context.Request.Query
                        .ToDictionary(
                            item => item.Key,
                            item => item.Value.ToString()
                        );


                    // Replace only the current filter.

                    if (string.IsNullOrEmpty(option.Value))
                    {
                        query.Remove(filter.ParameterName);
                    }
                    else
                    {
                        query[filter.ParameterName] = option.Value;
                    }


                    // Build query string.

                    var queryString = string.Join(
                        "&",
                        query.Select(
                            item =>
                                $"{item.Key}={Uri.EscapeDataString(item.Value)}"
                        )
                    );


                    var baseUrl =
                        Context.Request.Path.ToString();


                    var optionUrl =
                        string.IsNullOrEmpty(queryString)
                            ? baseUrl
                            : $"{baseUrl}?{queryString}";


                    var isSelected =
                        option.Value == selectedValue;


                    filterOptions.Add(new
                    {
                        Label = option.Label,
                        Value = option.Value,
                        Url = optionUrl,
                        IsSelected = isSelected
                    });
                }



                <!-- =================================================
                     DETERMINE MARKETPLACE DISPLAY LABEL
                ================================================== -->
                var selectedOption =
                                    filterOptions.FirstOrDefault(
                                        x => x.IsSelected
                                    );


                var displayLabel =
                    selectedOption?.Label;


                // Marketplace-specific default names.

                if (string.IsNullOrEmpty(selectedValue))
                {
                    displayLabel =
                        filter.ParameterName == "listingType"
                            ? "All Listings"
                            : "All Pets";
                }


                if (string.IsNullOrEmpty(displayLabel))
                {
                    displayLabel =
                        filter.ParameterName == "listingType"
                            ? "All Listings"
                            : "All Pets";
                }



                <!-- =================================================
                     DROPDOWN
                ================================================== -->

                <div class="marketplace-filter-item marketplace-dropdown"
                     data-filter-dropdown>


                    <!-- DROPDOWN BUTTON -->

                    <button type="button"
                            class="marketplace-filter-select marketplace-dropdown-button"
                            data-dropdown-button
                            aria-haspopup="true"
                            aria-expanded="false">

                        <span class="marketplace-dropdown-button-content">

                            <i data-lucide="@filterIcon"
                               class="marketplace-filter-select-icon"></i>

                            <span class="marketplace-dropdown-current">

                                @displayLabel

                            </span>

                        </span>


                        <i data-lucide="chevron-down"
                           class="marketplace-dropdown-chevron"></i>

                    </button>



                    <!-- =================================================
                         DROPDOWN MENU
                    ================================================== -->

                    <div class="marketplace-dropdown-menu"
                         data-dropdown-menu
                         role="menu">

                        @foreach (var option in filterOptions)
                        {
                            <a href="@option.Url"
                               class="marketplace-dropdown-item @(option.IsSelected ? "active" : "")"
                               role="menuitem">

                                <span class="marketplace-dropdown-item-content">

                                    @if (filter.ParameterName == "listingType")
                                    {
                                        @if (option.Label == "For Adoption")
                                        {
                                        }
                                        else if (option.Label == "For Sale")
                                        {
                                        }
                                        else
                                        {
                                        }
                                    }
                                    else
                                    {
                                        @if (option.Label == "Dogs")
                                        {
                                        }
                                        else if (option.Label == "Cats")
                                        {
                                        }
                                        else
                                        {
                                        }
                                    }


                                    <span>

                                        @if (filter.ParameterName == "listingType" &&
                                             string.IsNullOrEmpty(option.Value))
                                        {
                                            @:All Listings
                                        }
                                        else if (filter.ParameterName == "petType" &&
                                                 string.IsNullOrEmpty(option.Value))
                                        {
                                            @:All Pets
                                        }
                                        else
                                        {
                                            @option.Label
                                        }

                                    </span>

                                </span>

                            </a>
                        }

                    </div>

                </div>
            }

        </div>



        <!-- =====================================================
             MARKETPLACE LISTING COUNT
        ====================================================== -->

        <div class="marketplace-filter-count">

            <strong>
                @listingCount
            </strong>

            <span>
                @countLabel
            </span>

        </div>

    </div>

</div>



<!-- =========================================================
     MARKETPLACE LISTING CARDS
========================================================== -->

<div class="row mt-4 marketplace-card-grid">

    @foreach (var item in Model.Items)
    {
        <div class="col-md-3 mb-4">


            <!-- =================================================
                 MARKETPLACE CARD
            ================================================== -->

            <div class="marketplace-card h-100">


                <!-- =================================================
                     CARD LINK

Existing programmer navigation preserved.
                ================================================== -->

                <a asp-action="MarketplaceDetails"
                   asp-route-id="@item.ListingId"
                   class="marketplace-card-link">


                    <!-- =================================================
                         IMAGE
                    ================================================== -->

                    <div class="marketplace-card-image-wrapper">

                        @if (item.Images != null && item.Images.Any())
                        {
                            <img src="@item.Images.First().ImagePath"
                                 class="marketplace-card-image"
                                 alt="Listing image" />
                        }
                        else
                        {
                            <img src="/images/no-image.png"
                                 class="marketplace-card-image"
                                 alt="No image" />
                        }


                       



                        <!-- =================================================
                             LISTING TYPE BADGE
                        ================================================== -->
                        @if (item.Type == ListType.For_Adoption)
                        {
                            <span class="marketplace-listing-badge marketplace-listing-badge-adoption">

                                <i data-lucide="paw-print"></i>

                                Adoption

                            </span>
                        }
                        else
                        {
                            <span class="marketplace-listing-badge marketplace-listing-badge-sale">

                                <i data-lucide="paw-print"></i>

                                For Sale

                            </span>
                        }



                        <!-- =================================================
                             PRICE BADGE

Only shown for listings that are for sale.
                        ================================================== -->
                        @if (item.Type != ListType.For_Adoption)
                        {
                            <span class="marketplace-price-badge">

                                ₱ @item.Price.ToString("N0")

                            </span>
                        }

                    </div>



                    <!-- =================================================
                         CARD BODY
                    ================================================== -->

                    <div class="marketplace-card-body">


                        <!-- =================================================
                             TITLE
                        ================================================== -->

                        <h5 class="marketplace-card-title">

                            @item.Title

                        </h5>



                        <!-- =================================================
                             LOCATION
                        ================================================== -->

                        <div class="marketplace-card-location-row">

                            <i data-lucide="map-pin"></i>

                            <span>

                                @(string.IsNullOrEmpty(item.City)
                                    ? "Not specified"
                                    : item.City + ", " + item.Province)

                            </span>

                        </div>



                        <!-- =================================================
                             DESCRIPTION
                        ================================================== -->

                        <p class="marketplace-card-description">

                            @item.Description

                        </p>



                        <!-- =================================================
                             CARD FOOTER
                        ================================================== -->

                        <div class="marketplace-card-footer">

                            <span class="marketplace-card-date">

                                <i data-lucide="calendar"></i>

                                @item.DatePosted.ToString("MMM dd, yyyy")

                            </span>

                        </div>

                    </div>

                </a>



                <!-- =================================================
                     REPORT BUTTON

Kept as a comment so the original programmer
                     logic is not deleted.
                ================================================== -->
                @*
                @if (User.IsInRole("Member") &&
                     item.MemberId != User.FindFirst(
                         System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                {
                    <button type="button"
                            class="btn btn-sm btn-light shadow-sm report-card-button position-absolute top-0 end-0 m-2"
                            style="z-index:2;"
                            data-bs-toggle="modal"
                            data-bs-target="#reportModal"
                            data-report-type="Listing"
                            data-report-id="@item.ListingId"
                            data-report-title="@item.Title"
                            aria-label="Report @item.Title">

                        <i data-lucide="flag"></i>

                    </button>
                }
                *@

            </div>

        </div>
    }

</div>

<partial name="_Pagination" model="Model" />



<!-- =========================================================
     FLOATING ADD LISTING BUTTON

========================================================== -->
@if (User.IsInRole("Member"))
{
    <a asp-controller="Listings"
       asp-action="Create"
       class="marketplace-floating-add">

        <i data-lucide="plus"></i>

        <span>
            Create Listing
        </span>

    </a>
}
else if (User.IsInRole("Admin"))
{
    //Admin Cannot add a Marketplace Listing
}
else
{
    <button type="button"
            class="marketplace-floating-add"
            data-bs-toggle="modal"
            data-bs-target="#guestActionModal">

        <i data-lucide="plus"></i>

        <span>
            Create Listing
        </span>

    </button>
}



<!-- =========================================================
     GUEST MODAL
========================================================== -->

<div class="modal fade"
     id="guestActionModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-body text-center p-5">

                <img src="~/images/PETHUB-LOGO.png"
                     asp-append-version="true"
                     style="width:80px;"
                     class="mb-4"
                     alt="PetHub Logo" />

                <span class="badge rounded-pill px-3 py-2 mb-3"
                      style="background:#EAF8E6;color:#4F8D42;">

                    MEMBERS ONLY

                </span>

                <h3 class="fw-bold mb-3"
                    style="color:#2D3748;">

                    Join the PetHub Community

                </h3>

                <p class="text-muted mb-4"
                   style="line-height:1.8;">

                    Creating listings and submitting reports are exclusive
                    to registered members. Create a free account or sign in
                    to continue.

                </p>

                <div class="d-grid gap-3">

                    <a asp-controller="UserAccount"
                       asp-action="Register"
                       class="btn btn-lg text-white rounded-pill"
                       style="background:#8ACE79;">

                        Become a Member

                    </a>

                    <a asp-controller="UserAccount"
                       asp-action="Login"
                       class="btn btn-light rounded-pill">

                        Already have an account? Login

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>



@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            if (typeof lucide !== "undefined") {

                lucide.createIcons();

            }

        });

    </script>

}