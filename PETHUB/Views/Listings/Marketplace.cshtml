@model IEnumerable<PETHUB.Models.Listing>

@{
    ViewData["Title"] = "Marketplace Client";
}


<!-- Add Listing Button -->
@if (User.IsInRole("Member"))
{
    <a asp-controller="Listings"
       asp-action="Create"
       class="btn  btn-lg rounded-pill" style="background-color:#8ACE79; color:white;">
        Add Listing
    </a>
}
else if(User.IsInRole("Admin"))
{
    //Admin Cannot add a Marketplace Listing
}
else{
    <button class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#createListingModal">

        Add Listing

    </button>
}

<div class="row mt-4">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <a asp-action="MarketplaceDetails" asp-route-id="@item.ListingId" class="text-decoration-none text-dark">
                <div class="card h-100 shadow-sm">

                    @if (item.Images != null && item.Images.Any())
                    {
                        <img src="@item.Images.First().ImagePath"
                             class="card-img-top"
                             alt="Listing image"
                             style="height:200px;object-fit:cover;" />
                    }
                    else
                    {
                        <img src="/images/no-image.png"
                             class="card-img-top"
                             alt="No image"
                             style="height:200px;object-fit:cover;" />
                    }

                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>

                        <p class="card-text text-muted">
                            @item.Description
                        </p>

                        <p class="card-text">
                            <strong>₱@item.Price</strong>
                        </p>

                        <p class="card-text">
                            <small>
                                Posted @item.DatePosted.ToString("MMM dd, yyyy")
                            </small>
                        </p>

                        <p class="card-text">
                            <small class="text-muted">
                                Location:
                                @(string.IsNullOrEmpty(item.City)
                                    ? "Not specified"
                                    : item.City + ", " + item.Province)
                            </small>
                        </p>
                    </div>

                </div>
            </a>
        </div>
    }
</div>

<!-- Guest Modal -->
<div class="modal fade"
     id="guestActionModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-body text-center p-5">

                <img src="~/images/PETHUB-LOGO.png"
                     asp-append-version="true"
                     style="width:80px;"
                     class="mb-4"
                     alt="PetHub Logo" />

                <span class="badge rounded-pill px-3 py-2 mb-3"
                      style="background:#EAF8E6;color:#4F8D42;">

                    MEMBERS ONLY

                </span>

                <h3 class="fw-bold mb-3"
                    style="color:#2D3748;">

                    Join the PetHub Community

                </h3>

                <p class="text-muted mb-4"
                   style="line-height:1.8;">

                    Creating listings and submitting reports are exclusive
                    to registered members. Create a free account or sign in
                    to continue.

                </p>

                <div class="d-grid gap-3">

                    <a asp-controller="UserAccount"
                       asp-action="Register"
                       class="btn btn-lg text-white rounded-pill"
                       style="background:#8ACE79;">

                        Become a Member

                    </a>

                    <a asp-controller="UserAccount"
                       asp-action="Login"
                       class="btn btn-light rounded-pill">

                        Already have an account? Login

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>