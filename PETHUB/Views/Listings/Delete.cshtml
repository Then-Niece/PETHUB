@model PETHUB.Models.Listing

@{
    ViewData["Title"] = "Delete Listing";
}

<h1 class="mb-4">Delete Listing</h1>

<div class="alert alert-danger">
    <strong>Warning:</strong> Are you sure you want to delete this listing? This action cannot be undone.
</div>

<div class="row justify-content-center">
    <!-- Left side: image -->
    <div class="col-md-6">
        @if (Model.Images != null && Model.Images.Any())
        {
            <img src="@Model.Images.First().ImagePath" class="img-fluid rounded shadow-sm" alt="Listing image" style="height:400px;object-fit:cover;" />
        }
        else
        {
            <div class="bg-light text-center py-5 rounded shadow-sm">
                <p class="text-muted">No images uploaded for this listing.</p>
            </div>
        }
    </div>

    <!-- Right side: info -->
    <div class="col-md-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h3 class="fw-bold">@Model.Title</h3>
                <p class="text-muted mb-1">Posted on @Model.DatePosted.ToString("MMMM dd, yyyy")</p>
                <p class="mb-3">@Model.Description</p>
                <p><strong>Price:</strong> ₱@Model.Price</p>
                <p>
                    <strong>Location:</strong>
                    @if (string.IsNullOrEmpty(Model.City))
                    {
                        <span>Not specified</span>
                    }
                    else
                    {
                        <br />
                        @if (!string.IsNullOrEmpty(Model.StreetAddress))
                        {
                            <span>@Model.StreetAddress<br /></span>
                        }
                        <span>@Model.Barangay<br />@Model.City<br />@Model.Province</span>
                    }
                </p>
                <p><strong>User:</strong> @(Model.MemberId ?? "—")</p>
            </div>
            <div class="card-footer d-flex justify-content-center gap-3">
                <!-- ✅ Matches DeleteConfirmed POST action -->
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ListingId" />
                    <button type="submit" class="btn btn-danger px-4">Yes, Delete</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                </form>

            </div>
        </div>
    </div>
</div>
