@model PETHUB.Models.Listing

@{
    ViewData["Title"] = "Listing Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">

        <!-- Left Side: Image Gallery -->
        <div class="col-md-6">
            @if (Model.Images != null && Model.Images.Any())
            {
                <div id="listingCarousel" class="carousel slide shadow-sm" data-bs-ride="carousel">
                    <div class="carousel-inner rounded">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            var img = Model.Images.ElementAt(i);

                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@img.ImagePath"
                                     class="d-block w-100"
                                     alt="Listing Image"
                                     style="height:400px; object-fit:cover;">
                            </div>
                        }
                    </div>

                    <button class="carousel-control-prev"
                            type="button"
                            data-bs-target="#listingCarousel"
                            data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>

                    <button class="carousel-control-next"
                            type="button"
                            data-bs-target="#listingCarousel"
                            data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            }
            else
            {
                <div class="bg-light rounded shadow-sm d-flex justify-content-center align-items-center"
                     style="height:400px;">
                    <p class="text-muted mb-0">No images uploaded.</p>
                </div>
            }
        </div>

        <!-- Right Side: Listing Details -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <h2 class="fw-bold">@Model.Title</h2>

                    <p class="text-muted">
                        Posted on @Model.DatePosted.ToString("MMMM dd, yyyy")
                    </p>

                    <hr />

                    <h5>Description</h5>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "No description provided."
                            : Model.Description)
                    </p>

                    <hr />

                    <h5>Listing Information</h5>

                    <p>
                        <strong>Listing Type:</strong>
                        @(Model.Type == PETHUB.Models.ListType.For_Adoption
                            ? "For Adoption"
                            : "For Sale")
                    </p>

                    @if (Model.Type == PETHUB.Models.ListType.For_Adoption)
                    {
                        <p>
                            <strong>Price:</strong>
                            <span class="text-success fw-bold">Free for Adoption</span>
                        </p>
                    }
                    else
                    {
                        <p>
                            <strong>Price:</strong>
                            ₱@Model.Price
                        </p>
                    }

                    <p>
                        <strong>Pet Type:</strong>
                        @Model.PetType
                    </p>

                    <p>
                        <strong>Pet Sex:</strong>
                        @Model.PetSex
                    </p>

                    <p>
                        <strong>Breed:</strong>
                        @Model.Breed
                    </p>

                    <p>
                        <strong>Location:</strong>
                        @Model.Location
                    </p>

                    <hr/>

                </div>
                
                <!-- This part is for the member's valid ID photo and the name of the member will be shown in the card details aswell -->
                <div class="card-body">
                    <p><strong>Posted by:</strong> @Model.Member?.FirstName @Model.Member?.LastName</p>

                    <div class="mt-3">
                        <h6 class="fw-bold mb-2">Member Valid ID Photo</h6>
                        @if (!string.IsNullOrEmpty(Model.Member?.IdPhotoPath))
                        {
                            <div class="d-flex justify-content-center">
                                <img src="@Model.Member.IdPhotoPath"
                                     alt="Member ID Photo"
                                     class="border rounded shadow-sm"
                                     style="max-width:250px; height:auto;" />
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No ID photo uploaded.</p>
                        }
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-center gap-3">

                    @if (Model.Status == ListApprovalStatus.Pending)
                    {
                        <form asp-action="Approve" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@Model.ListingId" />

                            <button type="submit" class="btn btn-success">
                                Approve
                            </button>
                        </form>

                        <form asp-action="Reject" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@Model.ListingId" />

                            <button type="submit" class="btn btn-danger">
                                Reject
                            </button>
                        </form>
                    }

                    <a asp-action="Index" class="btn btn-secondary px-4">
                        ← Back to Listings
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>
