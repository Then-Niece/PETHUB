@model PETHUB.Models.ApplicationUser

@{
    ViewData["Title"] = "Member Details";
}

<div class="container mt-4">
    <h2>Member Details</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">UserName</dt>
        <dd class="col-sm-9">@Model.UserName</dd>

        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.FirstName</dd>

        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.LastName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Contact Number</dt>
        <dd class="col-sm-9">@Model.ContactNumber</dd>

        <dt class="col-sm-3">Address</dt>
        <dd class="col-sm-9">@Model.Address</dd>

        <dt class="col-sm-3">Gender</dt>
        <dd class="col-sm-9">
            <span class="badge @(Model.Gender == "Male" ? "bg-primary" : "bg-pink")">
                @Model.Gender
            </span>
        </dd>


        <dt class="col-sm-3">Birthdate</dt>
        <dd class="col-sm-9">@Model.Birthdate?.ToString("MMM dd, yyyy")</dd>

        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9">
            <span class="badge bg-info">@ViewBag.MemberRoles[Model.Id]</span>
        </dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-secondary")">
                @(Model.Status == "Active" ? "✔ Active" : "✖ Inactive")
            </span>
        </dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
