@model PETHUB.ViewModels.AdminDashboardViewModel

@{
    // Set the page title used by the shared layout.
    // This helps identify the current page in the browser/tab title.
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- =========================================================
         WELCOME HEADER
         =========================================================
         This section gives the administrator a simple introduction
         before showing the dashboard information.
         ========================================================= -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Welcome back, Admin!</h2>
        <p class="text-muted mb-0">
            Here's an overview of what's happening in PETHUB.
        </p>
    </div>


    <!-- =========================================================
         MAIN DASHBOARD ROW
         =========================================================
         Bootstrap's grid system divides the dashboard into two
         columns:
         - col-lg-4 = approximately 30% of the row
         - col-lg-8 = approximately 70% of the row

         On smaller screens, the columns automatically stack.
         ========================================================= -->
    <div class="row g-4">

        <!-- =====================================================
             LEFT COLUMN - STATISTICS
             =====================================================
             This column contains the five platform-wide statistics.
             ===================================================== -->
        <div class="col-lg-4">

            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-bar-chart-fill me-2"></i>
                        Statistics
                    </h5>

                    <!-- Total Members -->
                    <div class="d-flex justify-content-between align-items-center
                        border-bottom py-3">
                        <div>
                            <small class="text-muted d-block">
                                Total Members
                            </small>
                            <span class="fs-4 fw-bold">
                                @Model.TotalMembers
                            </span>
                        </div>

                        <i class="bi bi-people-fill fs-3 text-primary"></i>
                    </div>

                    <!-- Total Administrators -->
                    <div class="d-flex justify-content-between align-items-center
                        border-bottom py-3">
                        <div>
                            <small class="text-muted d-block">
                                Total Admins
                            </small>
                            <span class="fs-4 fw-bold">
                                @Model.TotalAdmins
                            </span>
                        </div>

                        <i class="bi bi-shield-fill-check fs-3 text-success"></i>
                    </div>

                    <!-- Total Marketplace Listings -->
                    <div class="d-flex justify-content-between align-items-center
                        border-bottom py-3">
                        <div>
                            <small class="text-muted d-block">
                                Marketplace Listings
                            </small>
                            <span class="fs-4 fw-bold">
                                @Model.TotalMarketplaceListings
                            </span>
                        </div>

                        <i class="bi bi-shop fs-3 text-warning"></i>
                    </div>

                    <!-- Total Lost & Found Reports -->
                    <div class="d-flex justify-content-between align-items-center
                        border-bottom py-3">
                        <div>
                            <small class="text-muted d-block">
                                Lost &amp; Found Reports
                            </small>
                            <span class="fs-4 fw-bold">
                                @Model.TotalLostFoundReports
                            </span>
                        </div>

                        <i class="bi bi-search-heart fs-3 text-danger"></i>
                    </div>

                    <!-- Total PetFeed Posts -->
                    <div class="d-flex justify-content-between align-items-center
                        pt-3">
                        <div>
                            <small class="text-muted d-block">
                                PetFeed Posts
                            </small>
                            <span class="fs-4 fw-bold">
                                @Model.TotalPetFeedPosts
                            </span>
                        </div>

                        <i class="bi bi-newspaper fs-3 text-info"></i>
                    </div>

                </div>
            </div>

        </div>


        <!-- =====================================================
             RIGHT COLUMN - PLATFORM SUMMARY + APPROVAL QUEUE
             ===================================================== -->
        <div class="col-lg-8">

            <!-- =================================================
                 PLATFORM SUMMARY
                 ================================================= -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-pie-chart-fill me-2"></i>
                        Platform Summary
                    </h5>

                    <div class="row">

                        <!-- Marketplace Pie Chart -->
                        <div class="col-md-6 text-center">

                            <h6 class="fw-semibold mb-3">
                                Marketplace
                            </h6>
                            <!--
                                This canvas will later be used by the
                                chart library to render the Marketplace
                                approval-status pie chart.
                            -->
                            <div class="position-relative mx-auto"
                                 style="max-width: 280px;">
                                <canvas id="marketplaceChart"
                                        data-approved="@Model.MarketplaceApproved"
                                        data-pending="@Model.MarketplacePending"
                                        data-rejected="@Model.MarketplaceRejected">
                                </canvas>
                            </div>

                            <div class="mt-3 small text-muted">
                                <span class="me-3">
                                    Approved:
                                    <strong>@Model.MarketplaceApproved</strong>
                                </span>

                                <span class="me-3">
                                    Pending:
                                    <strong>@Model.MarketplacePending</strong>
                                </span>

                                <span>
                                    Rejected:
                                    <strong>@Model.MarketplaceRejected</strong>
                                </span>
                            </div>

                        </div>


                        <!-- Lost & Found Pie Chart -->
                        <div class="col-md-6 text-center">

                            <h6 class="fw-semibold mb-3">
                                Lost &amp; Found
                            </h6>

                            <!--
                                This canvas will later be used by the
                                chart library to render the Lost & Found
                                approval-status pie chart.
                            -->
                            <div class="position-relative mx-auto"
                                 style="max-width: 280px;">
                                <canvas id="lostFoundChart"
                                        data-approved="@Model.LostFoundApproved"
                                        data-pending="@Model.LostFoundPending"
                                        data-rejected="@Model.LostFoundRejected">
                                </canvas>
                            </div>

                            <div class="mt-3 small text-muted">
                                <span class="me-3">
                                    Approved:
                                    <strong>@Model.LostFoundApproved</strong>
                                </span>

                                <span class="me-3">
                                    Pending:
                                    <strong>@Model.LostFoundPending</strong>
                                </span>

                                <span>
                                    Rejected:
                                    <strong>@Model.LostFoundRejected</strong>
                                </span>
                            </div>

                        </div>

                    </div>

                </div>
            </div>


            <!-- =================================================
                 APPROVAL QUEUE
                 ================================================= -->
            <div class="card shadow-sm">

                <div class="card-body">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-clock-history me-2"></i>
                        Approval Queue
                    </h5>

                    <div class="row g-3">

                        <!-- Marketplace Approval -->
                        <div class="col-md-6">

                            <div class="border rounded p-4 h-100">

                                <div class="d-flex justify-content-between
                                    align-items-start">

                                    <div>
                                        <h6 class="fw-bold mb-1">
                                            Marketplace
                                        </h6>

                                        <p class="text-muted small mb-3">
                                            Listings waiting for administrator
                                            approval.
                                        </p>
                                    </div>

                                    <span class="badge bg-warning text-dark fs-6">
                                        @Model.MarketplacePending
                                    </span>

                                </div>

                                <!--
                                    This button does NOT approve or reject
                                    anything. It simply redirects the
                                    administrator to the existing Marketplace
                                    approval/management page.
                                -->
                                <a asp-controller="Listings"
                                   asp-action="Index"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-arrow-right-circle me-1"></i>
                                    Review Listings
                                </a>

                            </div>

                        </div>


                        <!-- Lost & Found Approval -->
                        <div class="col-md-6">

                            <div class="border rounded p-4 h-100">

                                <div class="d-flex justify-content-between
                                    align-items-start">

                                    <div>
                                        <h6 class="fw-bold mb-1">
                                            Lost &amp; Found
                                        </h6>

                                        <p class="text-muted small mb-3">
                                            Reports waiting for administrator
                                            approval.
                                        </p>
                                    </div>

                                    <span class="badge bg-warning text-dark fs-6">
                                        @Model.LostFoundPending
                                    </span>

                                </div>

                                <!--
                                    This button only redirects the admin to
                                    the existing Lost & Found approval page.
                                    The actual Approve and Reject actions
                                    remain inside LostFoundsController.
                                -->
                                <a asp-controller="LostFounds"
                                   asp-action="Index"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-arrow-right-circle me-1"></i>
                                    Review Reports
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     CHART SCRIPT
     =============================================================
     Chart.js will be used to render the two pie graphs.

     The values are taken directly from the ViewModel, so the charts
     automatically reflect the current database values.
     ============================================================= -->
@section Scripts {

    <!--
        Chart.js provides the built-in Chart object used below.
        If the project already loads Chart.js globally, this script
        reference should not be duplicated.
    -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/admin-dashboard.js"></script>
}