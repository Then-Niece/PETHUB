@model PETHUB.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}


<div class="admin-dashboard-page">


    <!-- ==========================================================
         ADMIN DASHBOARD HEADER
         ========================================================== -->

    <div class="admin-dashboard-heading">

        <div>

            <h2>
                Admin Dashboard
            </h2>

            <p>
                Overview of the PETHUB platform
            </p>

        </div>

    </div>


    <!-- ==========================================================
         PLATFORM STATISTICS
         ========================================================== -->

    <div class="admin-dashboard-statistics">


        <!-- ======================================================
             TOTAL MEMBERS
             ====================================================== -->

        <div class="admin-dashboard-stat-card">

            <div class="admin-dashboard-stat-icon members">
                <i data-lucide="users"></i>
            </div>

            <div class="admin-dashboard-stat-content">

                <span class="admin-dashboard-stat-label">
                    Total Members
                </span>

                <strong class="admin-dashboard-stat-value">
                    @Model.TotalMembers
                </strong>

            </div>

        </div>


        <!-- ======================================================
             TOTAL ADMINS
             ====================================================== -->

        <div class="admin-dashboard-stat-card">

            <div class="admin-dashboard-stat-icon admins">
                <i data-lucide="shield-check"></i>
            </div>

            <div class="admin-dashboard-stat-content">

                <span class="admin-dashboard-stat-label">
                    Total Admins
                </span>

                <strong class="admin-dashboard-stat-value">
                    @Model.TotalAdmins
                </strong>

            </div>

        </div>


        <!-- ======================================================
             MARKETPLACE LISTINGS
             ====================================================== -->

        <div class="admin-dashboard-stat-card">

            <div class="admin-dashboard-stat-icon marketplace">
                <i data-lucide="store"></i>
            </div>

            <div class="admin-dashboard-stat-content">

                <span class="admin-dashboard-stat-label">
                    Marketplace Listings
                </span>

                <strong class="admin-dashboard-stat-value">
                    @Model.TotalMarketplaceListings
                </strong>

            </div>

        </div>


        <!-- ======================================================
             LOST & FOUND REPORTS
             ====================================================== -->

        <div class="admin-dashboard-stat-card">

            <div class="admin-dashboard-stat-icon lost-found">
                <i data-lucide="search"></i>
            </div>

            <div class="admin-dashboard-stat-content">

                <span class="admin-dashboard-stat-label">
                    Lost &amp; Found Reports
                </span>

                <strong class="admin-dashboard-stat-value">
                    @Model.TotalLostFoundReports
                </strong>

            </div>

        </div>


        <!-- ======================================================
             PETFEED POSTS
             ====================================================== -->

        <div class="admin-dashboard-stat-card">

            <div class="admin-dashboard-stat-icon petfeed">
                <i data-lucide="newspaper"></i>
            </div>

            <div class="admin-dashboard-stat-content">

                <span class="admin-dashboard-stat-label">
                    PetFeed Posts
                </span>

                <strong class="admin-dashboard-stat-value">
                    @Model.TotalPetFeedPosts
                </strong>

            </div>

        </div>


    </div>


    <!-- ==========================================================
         MAIN DASHBOARD CONTENT
         ========================================================== -->

    <div class="admin-dashboard-main">


        <!-- ======================================================
             PLATFORM SUMMARY
             ====================================================== -->

        <div class="admin-dashboard-summary-card">

            <div class="admin-dashboard-card-header">

                <div>

                    <h3>
                       
                        Platform Summary
                    </h3>

                    <p>
                        Overview of Marketplace and Lost &amp; Found status
                    </p>

                </div>

            </div>


            <div class="admin-dashboard-charts">


                <!-- ==================================================
                     MARKETPLACE
                     ================================================== -->

                <div class="admin-dashboard-chart">

                    <h4>
                        Marketplace
                    </h4>


                    <div class="admin-dashboard-chart-container">

                        <canvas id="marketplaceChart"
                                data-approved="@Model.MarketplaceApproved"
                                data-pending="@Model.MarketplacePending"
                                data-rejected="@Model.MarketplaceRejected">
                        </canvas>

                    </div>


                    <!-- ==================================================
                         CUSTOM HORIZONTAL LEGEND
                         ================================================== -->

                    <div class="admin-dashboard-chart-legend">

                        <span class="approved">
                            <i></i>
                            Approved: @Model.MarketplaceApproved
                        </span>

                        <span class="pending">
                            <i></i>
                            Pending: @Model.MarketplacePending
                        </span>

                        <span class="rejected">
                            <i></i>
                            Rejected: @Model.MarketplaceRejected
                        </span>

                    </div>


                </div>


                <!-- ==================================================
                     LOST & FOUND
                     ================================================== -->

                <div class="admin-dashboard-chart">

                    <h4>
                        Lost &amp; Found
                    </h4>


                    <div class="admin-dashboard-chart-container">

                        <canvas id="lostFoundChart"
                                data-approved="@Model.LostFoundApproved"
                                data-pending="@Model.LostFoundPending"
                                data-rejected="@Model.LostFoundRejected">
                        </canvas>

                    </div>


                    <!-- ==================================================
                         CUSTOM HORIZONTAL LEGEND
                         ================================================== -->

                    <div class="admin-dashboard-chart-legend">

                        <span class="approved">
                            <i></i>
                            Approved: @Model.LostFoundApproved
                        </span>

                        <span class="pending">
                            <i></i>
                            Pending: @Model.LostFoundPending
                        </span>

                        <span class="rejected">
                            <i></i>
                            Rejected: @Model.LostFoundRejected
                        </span>

                    </div>


                </div>


            </div>

        </div>


        <!-- ======================================================
             APPROVAL QUEUE
             ====================================================== -->

        <div class="admin-dashboard-queue-card">

            <div class="admin-dashboard-card-header">

                <div>

                    <h3>
                        
                        Approval Queue
                    </h3>

                    <p>
                        Posts waiting for administrator approval
                    </p>

                </div>

            </div>


            <div class="admin-dashboard-queue">


                <!-- ==================================================
                     MARKETPLACE APPROVAL
                     ================================================== -->

                <div class="admin-dashboard-queue-item">

                    <div class="admin-dashboard-queue-top">

                        <div>

                            <h4>
                                Marketplace
                            </h4>

                            <p>
                                Listings waiting for administrator approval.
                            </p>

                        </div>

                        <span class="admin-dashboard-pending-count">
                            @Model.MarketplacePending
                        </span>

                    </div>


                    <a asp-controller="Listings"
                       asp-action="Index"
                       class="admin-dashboard-review-button">

                     

                        Review Listings

                    </a>

                </div>


                <!-- ==================================================
                     LOST & FOUND APPROVAL
                     ================================================== -->

                <div class="admin-dashboard-queue-item">

                    <div class="admin-dashboard-queue-top">

                        <div>

                            <h4>
                                Lost &amp; Found
                            </h4>

                            <p>
                                Reports waiting for administrator approval.
                            </p>

                        </div>

                        <span class="admin-dashboard-pending-count">
                            @Model.LostFoundPending
                        </span>

                    </div>


                    <a asp-controller="LostFounds"
                       asp-action="Index"
                       class="admin-dashboard-review-button">

                      

                        Review Reports

                    </a>

                </div>


            </div>

        </div>


    </div>


</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="~/js/admin-dashboard.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            if (typeof lucide !== "undefined") {
                lucide.createIcons();
            }

        });

    </script>

}