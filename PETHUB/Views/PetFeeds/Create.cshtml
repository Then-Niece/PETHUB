@model PETHUB.ViewModels.PetFeedViewModel

@{
    ViewData["Title"] = "Create PetFeed Post";
}

<div class="create-page">

    <div class="create-card">

        <!-- ==================================================
             HEADER
        ================================================== -->

        <div class="create-header">
            <h2>Create Pet Feed Post</h2>

            <p>
                Share an announcement or helpful pet tip with the community.
            </p>
        </div>


        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- ==================================================
                 FORM
            ================================================== -->

            <div class="create-form">

                <!-- LEFT SIDE -->

                <div class="create-fields">

                    <!-- Title -->

                    <div class="mb-3">

                        <label asp-for="Title"
                               class="form-label">
                            Title
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Enter post title" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Content -->

                    <div class="mb-3">

                        <label asp-for="Content"
                               class="form-label">
                            Content
                        </label>

                        <textarea asp-for="Content"
                                  rows="4"
                                  class="form-control"
                                  placeholder="Write something about your post..."></textarea>

                        <span asp-validation-for="Content"
                              class="text-danger">
                        </span>

                    </div>

            <!-- ==================================================
                 POST TYPE
            ================================================== -->

            <div class="mb-3">

                <label asp-for="Type"
                       class="form-label">
                    Post Type
                </label>


                <div class="pethub-select-wrapper">

                    <!-- Real select used for form submission -->
                    <select asp-for="Type"
                            id="petFeedTypeSelect"
                            class="pethub-select-native"
                            asp-items="Html.GetEnumSelectList<PETHUB.Models.PetFeedType>()">
                    </select>


                    <!-- Visible custom dropdown -->
                    <button type="button"
                            class="pethub-select-trigger"
                            data-select-target="petFeedTypeSelect">

                        <span class="pethub-select-text">
                            Select Post Type
                        </span>

                        <i data-lucide="chevron-down"></i>

                    </button>


                    <!-- Options are generated by custom-select.js -->
                    <div class="pethub-select-menu"
                         data-menu-for="petFeedTypeSelect">
                    </div>

                </div>


                <span asp-validation-for="Type"
                      class="text-danger">
                </span>

            </div>

                <!-- RIGHT SIDE - PHOTOS -->

                <div class="create-photos">

                    <h5>Photos</h5>

                    <div class="mb-3">

                        <input type="file"
                               id="imageInput"
                               name="Images"
                               multiple
                               class="form-control"
                               accept="image/*" />

                        <small class="text-muted">
                            You can upload multiple images.
                        </small>

                    </div>


                    <!-- IMAGE PREVIEW -->

                    <div id="imagePreviewContainer"
                         class="image-preview-grid">
                    </div>

                </div>

            </div>


            <!-- ==================================================
                 FORM ACTIONS
            ================================================== -->

            <hr class="my-4" />

            <div class="create-footer">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-success">
                    Create Post
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/imagePreviewHelper.js"></script>

    <script>
        setupImagePreview(
            "imageInput",
            "imagePreviewContainer"
        );
    </script>

}