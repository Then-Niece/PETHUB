@model PETHUB.ViewModels.PetFeedViewModel

@{
    ViewData["Title"] = "Create PetFeed Post";
}

<div class="create-page">

    <div class="create-card">

        <!-- ==================================================
             HEADER
        ================================================== -->

        <div class="create-header">

            <h2>Create Pet Feed Post</h2>

            <p>
                Share an announcement or helpful pet tip with the community.
            </p>

        </div>


        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data"
              id="petFeedCreateForm">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- ==================================================
                 FORM GRID
            ================================================== -->

            <div class="create-form">


                <!-- ==================================================
                     LEFT SIDE - POST INFORMATION
                ================================================== -->

                <div class="create-fields">


                    <!-- TITLE -->

                    <div class="create-field">

                        <label asp-for="Title"
                               class="form-label">
                            Title
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Enter post title" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CONTENT -->

                    <div class="create-field">

                        <label asp-for="Content"
                               class="form-label">
                            Content
                        </label>

                        <textarea asp-for="Content"
                                  rows="5"
                                  class="form-control create-content-input"
                                  placeholder="Write something about your post..."></textarea>

                        <span asp-validation-for="Content"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- POST TYPE -->

                    <div class="create-field">

                        <label asp-for="Type"
                               class="form-label">
                            Post Type
                        </label>


                        <div class="pethub-select-wrapper">

                            <!-- Real select used during submit -->

                            <select asp-for="Type"
                                    id="petFeedTypeSelect"
                                    class="pethub-select-native"
                                    asp-items="Html.GetEnumSelectList<PETHUB.Models.PetFeedType>()">
                            </select>


                            <!-- Visible custom select -->

                            <button type="button"
                                    class="pethub-select-trigger"
                                    data-select-target="petFeedTypeSelect">

                                <span class="pethub-select-text">
                                    Select Post Type
                                </span>

                                <i data-lucide="chevron-down"></i>

                            </button>


                            <div class="pethub-select-menu"
                                 data-menu-for="petFeedTypeSelect">
                            </div>

                        </div>


                        <span asp-validation-for="Type"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- ==================================================
                     RIGHT SIDE - PHOTOS
                ================================================== -->

                <div class="create-photos">

                    <div class="create-photos-header">

                        <div>

                            <h5>Photos</h5>

                            <p>
                                Add photos to your post.
                            </p>

                        </div>

                    </div>


                    <!-- HIDDEN REAL FILE INPUT -->

                    <input type="file"
                           id="imageInput"
                           name="Images"
                           multiple
                           hidden
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />


                    <!-- CUSTOM UPLOAD CONTROL -->

                    <div class="create-photo-upload-control">

                        <button type="button"
                                id="addPhotosButton"
                                class="create-photo-upload-button">

                            <i data-lucide="image-plus"></i>

                            <span>Add Photos</span>

                        </button>


                        <span id="photoUploadCount"
                              class="create-photo-upload-count">

                            0 / 5 photos

                        </span>

                    </div>


                    <!-- HELP TEXT -->

                    <p class="create-photo-upload-help">

                        Upload up to 5 photos.<br />
                        JPG, PNG or WEBP only.<br />
                        Maximum 5 MB each.

                    </p>


                    <!-- ERROR -->

                    <div id="imageUploadError"
                         class="create-photo-upload-error text-danger">
                    </div>


                    <!-- IMAGE PREVIEW -->

                    <div id="imagePreviewContainer"
                         class="image-preview-grid"
                         data-count="0">
                    </div>

                </div>

            </div>


            <!-- ==================================================
                 ACTIONS
            ================================================== -->

            <div class="create-footer">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>


                <button type="submit"
                        class="btn btn-success">

                    Create Post

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/imagePreviewHelper.js"
            asp-append-version="true">
    </script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                /* ==============================================
                   IMAGE PREVIEW / VALIDATION
                ============================================== */

                setupImagePreview(
                    "imageInput",
                    "imagePreviewContainer",
                    {
                        multiple: true,

                        maxFiles: 5,

                        maxFileSize:
                            5 * 1024 * 1024,

                        allowedTypes: [
                            "image/jpeg",
                            "image/png",
                            "image/webp"
                        ],

                        previewWidth: null,
                        previewHeight: null,

                        countId:
                            "photoUploadCount",

                        errorId:
                            "imageUploadError"
                    }
                );


                /* ==============================================
                   CUSTOM ADD PHOTOS BUTTON
                ============================================== */

                const imageInput =
                    document.getElementById(
                        "imageInput"
                    );

                const addPhotosButton =
                    document.getElementById(
                        "addPhotosButton"
                    );


                if (
                    imageInput &&
                    addPhotosButton
                ) {

                    addPhotosButton.addEventListener(
                        "click",
                        function () {

                            imageInput.click();

                        }
                    );

                }


                /* ==============================================
                   PREVENT ACCIDENTAL ENTER SUBMIT
                ============================================== */

                const form =
                    document.getElementById(
                        "petFeedCreateForm"
                    );


                if (form) {

                    form.addEventListener(
                        "keydown",
                        function (event) {

                            if (
                                event.key !== "Enter"
                            ) {
                                return;
                            }


                            if (
                                event.target.tagName ===
                                "TEXTAREA"
                            ) {
                                return;
                            }


                            if (
                                event.target.tagName ===
                                "BUTTON" ||
                                event.target.tagName ===
                                "SELECT"
                            ) {
                                return;
                            }


                            event.preventDefault();

                        }
                    );

                }


                /* Refresh Lucide icons */

                if (
                    typeof lucide !== "undefined"
                ) {

                    lucide.createIcons();

                }

            }
        );

    </script>
}