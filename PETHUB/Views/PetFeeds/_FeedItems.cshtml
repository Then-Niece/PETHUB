@using System.Linq
@using PETHUB.ViewModels
@model IEnumerable<PETHUB.ViewModels.PetFeedFeedViewModel>

    @if (User.IsInRole("Member"))
{
    <form class="feed-save-token-form"
          style="display:none;">

        @Html.AntiForgeryToken()

    </form>
}

@foreach (var post in Model)
{
    // ==========================================================
    // PET TIP
    // ==========================================================
    @if (post.ContentType == PetFeedContentType.PetFeed)
    {
        var hasImages = post.Images != null && post.Images.Any();

        <article class="feed-item @(post.IsHighlighted ? "highlight-post" : "") @(hasImages ? "" : "feed-item-no-image")"
                 id="post-@post.PetFeedId">

            <!-- ==================================================
                 POST HEADER
                 ================================================== -->

            <div class="feed-item-header">

                <div class="feed-item-author">

                    <img src="~/images/PETHUB-LOGO.png"
                         class="feed-item-author-image"
                         alt="PETHUB" />

                    <div class="feed-item-author-info">

                        <div class="feed-item-author-name-row">

                            <strong class="feed-item-author-name">
                                PETHUB
                            </strong>

                            <i data-lucide="badge-check"
                               class="feed-item-verified"
                               aria-label="Verified PETHUB account"></i>

                        </div>

                        <div class="feed-item-meta">

                            <span>
                                @post.DateCreated.ToString("MMM dd, yyyy")
                            </span>

                        </div>

                    </div>

                </div>

                <!-- Pet Tip badge -->
                <span class="feed-item-type-badge pet-tip-badge">
                    <i data-lucide="lightbulb"></i>
                    Pet Tip
                </span>

            </div>


            <!-- ==================================================
                 POST CONTENT
                 ================================================== -->

            <div class="feed-item-content @(hasImages ? "" : "feed-item-content-no-image")">

                <div class="feed-item-text">

                    <h3 class="feed-item-title">
                        @post.Title
                    </h3>

                    <div class="feed-item-description-wrapper">

                        <p class="feed-item-description">
                            @post.Content
                        </p>

                        <button type="button"
                                class="feed-item-see-more">
                            See more
                        </button>

                    </div>

                </div>


                <!-- ==================================================
                     PET TIP IMAGE / PHOTO CAROUSEL
                     ================================================== -->
                @if (hasImages)
                {
                    var images = post.Images!.ToList();
                    var photoCarouselId = $"petTipPhotos_{post.PetFeedId}";

                    @if (images.Count == 1)
                    {
                        <div class="feed-item-media">

                            <img src="@images[0].ImagePath"
                                 class="feed-item-main-image"
                                 alt="Pet Tip image" />

                        </div>
                    }
                    else
                    {
                        <div id="@photoCarouselId"
                             class="carousel slide feed-item-photo-carousel"
                             data-bs-ride="false">

                            <div class="carousel-inner">

                                @for (int imageIndex = 0;
                                      imageIndex < images.Count;
                                      imageIndex++)
                                {
                                    var image = images[imageIndex];

                                    <div class="carousel-item @(imageIndex == 0 ? "active" : "")">

                                        <div class="feed-item-media">

                                            <img src="@image.ImagePath"
                                                 class="feed-item-main-image"
                                                 alt="Pet Tip image" />

                                        </div>

                                    </div>
                                }

                            </div>

                            <button class="feed-item-photo-control feed-item-photo-prev"
                                    type="button"
                                    data-bs-target="#@photoCarouselId"
                                    data-bs-slide="prev"
                                    aria-label="Previous photo">

                                <span class="feed-item-photo-control-icon">
                                    <i data-lucide="chevron-left"></i>
                                </span>

                            </button>

                            <button class="feed-item-photo-control feed-item-photo-next"
                                    type="button"
                                    data-bs-target="#@photoCarouselId"
                                    data-bs-slide="next"
                                    aria-label="Next photo">

                                <span class="feed-item-photo-control-icon">
                                    <i data-lucide="chevron-right"></i>
                                </span>

                            </button>

                            <div class="feed-item-photo-counter">
                                <i data-lucide="images"></i>
                                <span>@images.Count</span>
                            </div>

                        </div>
                    }
                }

            </div>


            <!-- ==================================================
                 PET TIP ACTIVITY
                 ================================================== -->
            @if (User.IsInRole("Member"))
            {
                <div class="feed-item-footer">

                    <div class="feed-item-activity-left">
                        <form asp-action="@(post.IsPawed ? "Unpaw" : "Paw")"
                              method="post"
                              class="feed-item-action-form"
                              data-paw-form
                              data-is-pawed="@post.IsPawed.ToString().ToLower()"
                              data-paw-url="@Url.Action("Paw", "PetFeeds")"
                              data-unpaw-url="@Url.Action("Unpaw", "PetFeeds")">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@post.PetFeedId" />

                            <input type="hidden"
                                   name="feedSeed"
                                   value="@ViewData["FeedSeed"]" />

                            <button type="submit"
                                    class="feed-item-button feed-item-paw-button @(post.IsPawed ? "active" : "")"
                                    data-paw-button>

                                <i data-lucide="paw-print"></i>

                                <span data-paw-count-for="@post.PetFeedId"
                                      data-paw-count-value>
                                    @post.PawCount
                                </span>

                            </button>

                        </form>

                        <button type="button"
                                class="feed-item-button feed-item-comment-button"
                                data-comment-toggle="@post.PetFeedId"
                                aria-label="View comments">

                            <i data-lucide="message-circle"></i>

                            <span data-comment-count-for="@post.PetFeedId"
                                  data-comment-count-value>
                                @post.CommentCount
                            </span>
                        </button>

                    </div>


                    <button type="button"
                            class="feed-item-button feed-item-save-button @(post.IsSaved ? "saved" : "")"
                            data-save-type="petfeed"
                            data-save-id="@post.PetFeedId"
                            aria-label="@(post.IsSaved
                                ? "Remove from saved"
                                : "Save Pet Tip")">

                        <i data-lucide="heart"></i>

                    </button>
                </div>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <div class="feed-item-footer">

                    <div class="feed-item-activity-left">

                        <button type="button"
                                class="feed-item-button feed-item-paw-button"
                                data-bs-toggle="modal"
                                data-bs-target="#loginModal"
                                aria-label="Login to Paw">

                            <i data-lucide="paw-print"></i>

                            <span>@post.PawCount</span>

                        </button>

                        <button type="button"
                                class="feed-item-button feed-item-comment-button"
                                data-bs-toggle="modal"
                                data-bs-target="#loginModal"
                                aria-label="Login to comment">

                            <i data-lucide="message-circle"></i>

                            <span>@post.CommentCount</span>

                        </button>

                    </div>

                    <button type="button"
                            class="feed-item-button feed-item-save-button"
                            data-bs-toggle="modal"
                            data-bs-target="#loginModal"
                            aria-label="Login to save">

                        <i data-lucide="bookmark"></i>

                    </button>

                </div>
            }


            <!-- ==================================================
                 COMMENTS
                 Hidden until the comment icon is clicked.
                 ================================================== -->

            <div class="feed-item-comments"
                 data-comments-for="@post.PetFeedId"
                 hidden>

                <div class="feed-item-comments-header">

                    <h6 class="feed-item-section-title">
                        Comments
                    </h6>

                </div>

                @if (post.Comments != null && post.Comments.Any())
                {
                    <div class="feed-item-comments-list"
                         data-comments-list>

                        @foreach (var comment in post.Comments)
                        {
                            <div class="feed-item-comment"
                                 data-comment-id="@comment.CommentId">

                                <div class="feed-item-comment-header">

                                    <div class="feed-item-comment-author">

                                        <div class="feed-item-comment-avatar">

                                            @if (!string.IsNullOrEmpty(comment.Member?.ProfilePicturePath))
                                            {
                                                <img src="@comment.Member.ProfilePicturePath"
                                                     alt="Profile picture" />
                                            }
                                            else
                                            {
                                                @(comment.Member?.FirstName?.Substring(0, 1) ?? "?")
                                            }

                                        </div>

                                        <div class="feed-item-comment-author-info">

                                            <strong class="feed-item-comment-name">
                                                @comment.Member?.FirstName
                                                @comment.Member?.LastName
                                            </strong>

                                            <small class="feed-item-comment-date">
                                                @comment.DatePosted.ToString("MMM dd, yyyy")
                                            </small>

                                        </div>

                                    </div>

                                    @if (User.IsInRole("Admin") ||
                                         comment.MemberId ==
                                         User.FindFirst(
                                             System.Security.Claims.ClaimTypes.NameIdentifier
                                         )?.Value)
                                    {
                                        <form asp-action="DeleteComment"
                                              method="post"
                                              class="feed-item-delete-form"
                                              data-delete-comment-form>

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@comment.CommentId" />

                                            <input type="hidden"
                                                   name="feedSeed"
                                                   value="@ViewData["FeedSeed"]" />

                                            <button type="submit"
                                                    class="feed-item-button feed-item-delete-button"
                                                    aria-label="Delete comment">

                                                <i data-lucide="trash-2"></i>

                                            </button>

                                        </form>
                                    }

                                </div>

                                <p class="feed-item-comment-content">
                                    @comment.Content
                                </p>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <p class="feed-item-empty-comments"
                       data-empty-comments>
                        No comments yet. Be the first to comment!
                    </p>
                }


                <!-- ==================================================
                     ADD COMMENT
                     ================================================== -->
                @if (User.IsInRole("Member"))
                {
                    <form asp-action="AddComment"
                          method="post"
                          class="feed-item-comment-form"
                          data-add-comment-form>

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@post.PetFeedId" />

                        <input type="hidden"
                               name="feedSeed"
                               value="@ViewData["FeedSeed"]" />

                        <div class="feed-item-comment-input-wrapper">

                            <textarea name="content"
                                      class="feed-item-comment-input"
                                      rows="1"
                                      placeholder="Write a comment..."
                                      data-comment-input></textarea>

                        </div>

                        <button type="submit"
                                class="feed-item-button feed-item-comment-submit"
                                aria-label="Post comment">

                            <i data-lucide="send"></i>

                        </button>

                    </form>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <button type="button"
                            class="feed-item-button feed-item-login-comment"
                            data-bs-toggle="modal"
                            data-bs-target="#loginModal">

                        <i data-lucide="log-in"></i>

                        <span>
                            Login to comment
                        </span>

                    </button>
                }

            </div>

        </article>
    }


    // ==========================================================
    // MARKETPLACE
    // ==========================================================
    else if (post.ContentType == PetFeedContentType.Marketplace)
    {
        var hasImages = post.ImagePaths != null && post.ImagePaths.Any();

        <article class="feed-item @(hasImages ? "" : "feed-item-no-image")"
                 id="post-@post.ContentId">

            <!-- ==================================================
                 POST HEADER
                 ================================================== -->

            <div class="feed-item-header">

                <div class="feed-item-author">

                    @if (!string.IsNullOrEmpty(post.OwnerProfileImage))
                    {
                        <img src="@post.OwnerProfileImage"
                             class="feed-item-author-image"
                             alt="Post owner" />
                    }
                    else
                    {
                        <img src="~/images/default_profile.jpg"
                             class="feed-item-author-image"
                             alt="Post owner" />
                    }

                    <div class="feed-item-author-info">

                        <strong class="feed-item-author-name">
                            @(string.IsNullOrWhiteSpace(post.OwnerName)
                                ? "Unknown User"
                                : post.OwnerName)
                        </strong>

                        <div class="feed-item-meta">

                            <span>
                                @post.DateCreated.ToString("MMM dd, yyyy")
                            </span>

                            <span class="feed-item-meta-separator">
                                ·
                            </span>

                            @if (post.ListingType.HasValue)
                            {
                                <span>
                                    @post.ListingType
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <span class="feed-item-type-badge marketplace-badge">
                    <i data-lucide="shopping-bag"></i>
                    Marketplace
                </span>

            </div>


            <!-- ==================================================
                 POST CONTENT
                 ================================================== -->

            <div class="feed-item-content @(hasImages ? "" : "feed-item-content-no-image")">

                <div class="feed-item-text">

                    <h3 class="feed-item-title">
                        @post.Title
                    </h3>

                    <div class="feed-item-description-wrapper">

                        <p class="feed-item-description">
                            @post.Content
                        </p>

                        <button type="button"
                                class="feed-item-see-more">
                            See more
                        </button>

                    </div>

                </div>


                <!-- ==================================================
                     MARKETPLACE IMAGE / PHOTO CAROUSEL
                     ================================================== -->
                @if (hasImages)
                {
                    var images = post.ImagePaths!.ToList();
                    var photoCarouselId = $"marketplacePhotos_{post.ContentId}";

                    @if (images.Count == 1)
                    {
                        <div class="feed-item-media">

                            <img src="@images[0]"
                                 class="feed-item-main-image"
                                 alt="Marketplace listing image" />

                        </div>
                    }
                    else
                    {
                        <div id="@photoCarouselId"
                             class="carousel slide feed-item-photo-carousel"
                             data-bs-ride="false">

                            <div class="carousel-inner">

                                @for (int imageIndex = 0;
                                      imageIndex < images.Count;
                                      imageIndex++)
                                {
                                    var image = images[imageIndex];

                                    <div class="carousel-item @(imageIndex == 0 ? "active" : "")">

                                        <div class="feed-item-media">

                                            <img src="@image"
                                                 class="feed-item-main-image"
                                                 alt="Marketplace listing image" />

                                        </div>

                                    </div>
                                }

                            </div>

                            <button class="feed-item-photo-control feed-item-photo-prev"
                                    type="button"
                                    data-bs-target="#@photoCarouselId"
                                    data-bs-slide="prev"
                                    aria-label="Previous photo">

                                <span class="feed-item-photo-control-icon">
                                    <i data-lucide="chevron-left"></i>
                                </span>

                            </button>

                            <button class="feed-item-photo-control feed-item-photo-next"
                                    type="button"
                                    data-bs-target="#@photoCarouselId"
                                    data-bs-slide="next"
                                    aria-label="Next photo">

                                <span class="feed-item-photo-control-icon">
                                    <i data-lucide="chevron-right"></i>
                                </span>

                            </button>

                            <div class="feed-item-photo-counter">
                                <i data-lucide="images"></i>
                                <span>@images.Count</span>
                            </div>

                        </div>
                    }
                }

            </div>


            <!-- ==================================================
                 MARKETPLACE ACTIONS
                 ================================================== -->

            <div class="feed-item-actions">

                @if (User.IsInRole("Member"))
                {
                    <button type="button"
                            class="feed-item-button feed-item-save-button @(post.IsSaved ? "saved" : "")"
                            data-save-type="listing"
                            data-save-id="@post.ContentId"
                            aria-label="@(post.IsSaved
                                ? "Remove from saved"
                                : "Save marketplace listing")">

                        <i data-lucide="heart"></i>

                    </button>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <button type="button"
                            class="feed-item-button feed-item-save-button"
                            data-bs-toggle="modal"
                            data-bs-target="#loginModal"
                            aria-label="Login to save">

                        <i data-lucide="heart"></i>

                    </button>
                }


                @if (!string.IsNullOrWhiteSpace(post.DetailsUrl))
                {
                    <a href="@post.DetailsUrl"
                       class="feed-item-button feed-item-details-button">

                        <span>
                            View details
                        </span>

                        <i data-lucide="arrow-up-right"></i>

                    </a>
                }

            </div>

        </article>
    }


    // ==========================================================
    // LOST & FOUND
    // ==========================================================
    else if (post.ContentType == PetFeedContentType.LostFound)
    {
        var hasImages = post.ImagePaths != null && post.ImagePaths.Any();

        <article class="feed-item @(hasImages ? "" : "feed-item-no-image")"
                 id="post-@post.ContentId">

            <!-- ==================================================
                 POST HEADER
                 ================================================== -->

            <div class="feed-item-header">

                <div class="feed-item-author">

                    @if (!string.IsNullOrEmpty(post.OwnerProfileImage))
                    {
                        <img src="@post.OwnerProfileImage"
                             class="feed-item-author-image"
                             alt="Post owner" />
                    }
                    else
                    {
                        <img src="~/images/default_profile.jpg"
                             class="feed-item-author-image"
                             alt="Post owner" />
                    }

                    <div class="feed-item-author-info">

                        <strong class="feed-item-author-name">
                            @(string.IsNullOrWhiteSpace(post.OwnerName)
                                ? "Unknown User"
                                : post.OwnerName)
                        </strong>

                        <div class="feed-item-meta">

                            <span>
                                @post.DateCreated.ToString("MMM dd, yyyy")
                            </span>

                            <span class="feed-item-meta-separator">
                                ·
                            </span>

                            @if (post.LostFoundType.HasValue)
                            {
                                <span>
                                    @post.LostFoundType
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <span class="feed-item-type-badge lost-found-badge">
                    <i data-lucide="search"></i>
                    Lost &amp; Found
                </span>

            </div>


            <!-- ==================================================
                 POST CONTENT
                 ================================================== -->

            <div class="feed-item-content @(hasImages ? "" : "feed-item-content-no-image")">

                <div class="feed-item-text">

                    <h3 class="feed-item-title">
                        @post.Title
                    </h3>

                    <div class="feed-item-description-wrapper">

                        <p class="feed-item-description">
                            @post.Content
                        </p>

                        <button type="button"
                                class="feed-item-see-more">
                            See more
                        </button>

                    </div>

                </div>


                <!-- ==================================================
                     LOST & FOUND IMAGE / PHOTO CAROUSEL
                     ================================================== -->
                @if (hasImages)
                {
                    var images = post.ImagePaths!.ToList();
                    var photoCarouselId = $"lostFoundPhotos_{post.ContentId}";

                    @if (images.Count == 1)
                    {
                        <div class="feed-item-media">

                            <img src="@images[0]"
                                 class="feed-item-main-image"
                                 alt="Lost and Found image" />

                        </div>
                    }
                    else
                    {
                        <div id="@photoCarouselId"
                             class="carousel slide feed-item-photo-carousel"
                             data-bs-ride="false">

                            <div class="carousel-inner">

                                @for (int imageIndex = 0;
                                      imageIndex < images.Count;
                                      imageIndex++)
                                {
                                    var image = images[imageIndex];

                                    <div class="carousel-item @(imageIndex == 0 ? "active" : "")">

                                        <div class="feed-item-media">

                                            <img src="@image"
                                                 class="feed-item-main-image"
                                                 alt="Lost and Found image" />

                                        </div>

                                    </div>
                                }

                            </div>

                            <button class="feed-item-photo-control feed-item-photo-prev"
                                    type="button"
                                    data-bs-target="#@photoCarouselId"
                                    data-bs-slide="prev"
                                    aria-label="Previous photo">

                                <span class="feed-item-photo-control-icon">
                                    <i data-lucide="chevron-left"></i>
                                </span>

                            </button>

                            <button class="feed-item-photo-control feed-item-photo-next"
                                    type="button"
                                    data-bs-target="#@photoCarouselId"
                                    data-bs-slide="next"
                                    aria-label="Next photo">

                                <span class="feed-item-photo-control-icon">
                                    <i data-lucide="chevron-right"></i>
                                </span>

                            </button>

                            <div class="feed-item-photo-counter">
                                <i data-lucide="images"></i>
                                <span>@images.Count</span>
                            </div>

                        </div>
                    }
                }

            </div>


            <!-- ==================================================
                 LOST & FOUND ACTIONS
                 ================================================== -->

            <div class="feed-item-actions">

            @if (User.IsInRole("Member"))
            {
                <button type="button"
                        class="feed-item-button feed-item-save-button @(post.IsSaved ? "saved" : "")"
                        data-save-type="lostfound"
                        data-save-id="@post.ContentId"
                        aria-label="@(post.IsSaved
                            ? "Remove from saved"
                            : "Save Lost and Found report")">

                    <i data-lucide="heart"></i>

                </button>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <button type="button"
                        class="feed-item-button feed-item-save-button"
                        data-bs-toggle="modal"
                        data-bs-target="#loginModal"
                        aria-label="Login to save">

                    <i data-lucide="heart"></i>

                </button>
            }


                @if (!string.IsNullOrWhiteSpace(post.DetailsUrl))
                {
                    <a href="@post.DetailsUrl"
                       class="feed-item-button feed-item-details-button">

                        <span>
                            View details
                        </span>

                        <i data-lucide="arrow-up-right"></i>

                    </a>
                }

            </div>

        </article>
    }
}


<!-- ==============================================================
     PETFEED UI BEHAVIOR
     - Lucide icon initialization
     - See more / See less for all three feed types
     - Comment thread toggle for Pet Tips
     ============================================================== -->

<script>
    document.addEventListener("DOMContentLoaded", function () {

        /* ==========================================================
           LUCIDE
           ========================================================== */

        if (typeof lucide !== "undefined") {
            lucide.createIcons();
        }


        /* ==========================================================
           SEE MORE / SEE LESS
           Applies to Pet Tip, Marketplace, and Lost & Found.
           ========================================================== */

        document.querySelectorAll(".feed-item-description-wrapper")
            .forEach(function (wrapper) {

                const description =
                    wrapper.querySelector(".feed-item-description");

                const seeMore =
                    wrapper.querySelector(".feed-item-see-more");

                if (!description || !seeMore) {
                    return;
                }

                /* Show See More only when the description actually
                   exceeds the collapsed height. */

                if (description.scrollHeight >
                    description.clientHeight + 1) {

                    seeMore.classList.add("show");
                }


                seeMore.addEventListener("click", function () {

                    const isExpanded =
                        description.classList.contains("expanded");

                    if (isExpanded) {

                        description.classList.remove("expanded");

                        seeMore.textContent = "See more";

                    }
                    else {

                        description.classList.add("expanded");

                        seeMore.textContent = "See less";

                    }

                });

            });


        /* ==========================================================
           PET TIP COMMENT THREAD TOGGLE
           ========================================================== */

        document.querySelectorAll("[data-comment-toggle]")
            .forEach(function (button) {

                button.addEventListener("click", function () {

                    const postId =
                        button.getAttribute("data-comment-toggle");

                    const comments =
                        document.querySelector(
                            '[data-comments-for="' + postId + '"]'
                        );

                    if (!comments) {
                        return;
                    }

                    comments.hidden = !comments.hidden;

                });

            });


            /* ==========================================================
               SAVE / FAVORITE
               Handles:
               - PetFeed
               - Marketplace
               - Lost & Found
               ========================================================== */

            document.addEventListener(
                "click",
                async function (event) {

                    const button =
                        event.target.closest(
                            ".feed-item-save-button[data-save-type]"
                        );

                    if (!button) {
                        return;
                    }


                    event.preventDefault();
                    event.stopPropagation();


                    const saveType =
                        button.dataset.saveType;

                    const itemId =
                        button.dataset.saveId;


                    if (!saveType || !itemId) {
                        return;
                    }


                    let url = null;


                    if (saveType === "petfeed") {

                        url =
                            "/SavedItems/TogglePetFeed";

                    }
                    else if (saveType === "listing") {

                        url =
                            "/SavedItems/ToggleListing";

                    }
                    else if (saveType === "lostfound") {

                        url =
                            "/SavedItems/ToggleLostFound";

                    }


                    if (!url) {
                        return;
                    }


                    const token =
                        document.querySelector(
                            '.feed-save-token-form input[name="__RequestVerificationToken"]'
                        )?.value;


                    if (!token) {

                        console.error(
                            "Anti-forgery token was not found."
                        );

                        return;
                    }


                    button.disabled = true;


                    try {

                        const formData =
                            new FormData();

                        formData.append(
                            "id",
                            itemId
                        );

                        formData.append(
                            "__RequestVerificationToken",
                            token
                        );


                        const response =
                            await fetch(
                                url,
                                {
                                    method: "POST",
                                    body: formData
                                }
                            );


                        if (!response.ok) {

                            throw new Error(
                                "Save request failed."
                            );

                        }


                        const result =
                            await response.json();


                        button.classList.toggle(
                            "saved",
                            result.saved
                        );


                        if (result.saved) {

                            button.setAttribute(
                                "aria-label",
                                "Remove from saved"
                            );

                        }
                        else {

                            button.setAttribute(
                                "aria-label",
                                "Save item"
                            );

                        }


                        if (
                            typeof lucide !==
                            "undefined"
                        ) {

                            lucide.createIcons();

                        }

                    }
                    catch (error) {

                        console.error(
                            "Unable to save item:",
                            error
                        );

                    }
                    finally {

                        button.disabled = false;

                    }

                }
            );

    });
</script>
