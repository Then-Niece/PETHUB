@using System.Linq
@using PETHUB.ViewModels
@model IEnumerable<PETHUB.ViewModels.PetFeedFeedViewModel>

@foreach (var post in Model)
{
    // ==========================================================
    // PETFEED
    // ==========================================================
    // Regular PetFeed posts keep Paws and Comments for Members.
    @if (post.ContentType == PetFeedContentType.PetFeed)
    {
        // Determine whether this post contains at least one image.
        // This controls whether the card uses the image + text layout
        // or allows the text to use the full card width.
        var hasImages = post.Images != null && post.Images.Any();

        <article class="feed-card @(post.IsHighlighted ? "highlight-post" : "") @(hasImages ? "" : "feed-card-no-image")"
                 id="post-@post.PetFeedId">

            <!-- ==================================================
                 POST HEADER
                 ================================================== -->

            <div class="feed-card-header">

                <div class="feed-author">

                    <!--
                        PetFeed administrator posts use the PETHUB logo
                        as the visible author identity.
                    -->
                    <img src="~/images/PETHUB-LOGO.png"
                         class="feed-author-image"
                         alt="PETHUB" />

                    <div class="feed-author-info">

                        <strong class="feed-author-name">
                            PETHUB
                        </strong>

                        <small class="feed-post-date">
                            @post.DateCreated.ToString("MMM dd, yyyy")
                        </small>

                    </div>

                </div>

            </div>


            <!-- ==================================================
                 POST CONTENT
                 ================================================== -->

            <div class="feed-card-content @(hasImages ? "" : "feed-card-content-no-image")">

                @if (hasImages)
                {
                    <!--
                        The media section only exists when the post has
                        an image, preventing an empty image column.
                    -->
                    <div class="feed-media">

                        @{
                            // Convert the PetFeed image collection into a list.
                            // The list allows the view to check the number of
                            // images and safely access each image.
                            var images = post.Images!.ToList();
                        }

                        @if (images.Count == 1)
                        {
                            <!--
                                A single image is displayed as the main
                                feed image.
                            -->
                            <img src="@images[0].ImagePath"
                                 class="feed-main-image"
                                 alt="PetFeed image" />
                        }
                        else
                        {
                            <!--
                                Multiple images use the four-image preview.
                                Any images beyond four are represented by +N.
                            -->
                            <div class="feed-image-grid">

                                @foreach (var image in images.Take(4))
                                {
                                    <img src="@image.ImagePath"
                                         class="feed-grid-image"
                                         alt="PetFeed image" />
                                }

                                @if (images.Count > 4)
                                {
                                    <div class="feed-more-images">
                                        +@(images.Count - 4)
                                    </div>
                                }

                            </div>
                        }

                    </div>
                }


                <!-- ==================================================
                     TEXT CONTENT
                     ================================================== -->

                <div class="feed-text-content">

                    <!--
                        The CSS allows long titles to wrap instead of
                        overflowing or being cut off.
                    -->
                    <h3 class="feed-title">
                        @post.Title
                    </h3>

                    <p class="feed-description">
                        @post.Content
                    </p>

                </div>

            </div>


            <!-- ==================================================
                 PAW AREA
                 ================================================== -->
            @if (User.IsInRole("Member"))
            {
                <!--
                    Only Members receive the actual Paw controls.
                    This matches the Member-only Paw controller action.
                -->
                <div class="feed-engagement">

                    <div class="feed-paw-count"
                         data-paw-count-for="@post.PetFeedId">

                        <span class="feed-paw-icon">
                            🐾
                        </span>

                        <span data-paw-count-value>
                            @post.PawCount
                        </span>

                    </div>

                    <form asp-action="@(post.IsPawed ? "Unpaw" : "Paw")"
                          method="post"
                          class="feed-action-form"
                          data-paw-form
                          data-is-pawed="@post.IsPawed.ToString().ToLower()">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@post.PetFeedId" />

                        <!--
                            Preserving the current feedSeed keeps the feed's
                            random order stable if the AJAX request falls
                            back to a normal form submit (e.g. JavaScript
                            disabled or the fetch call fails).
                        -->
                        <input type="hidden"
                               name="feedSeed"
                               value="@ViewData["FeedSeed"]" />

                        <button type="submit"
                                class="feed-action-button"
                                data-paw-button>

                            @(post.IsPawed ? "Remove Paw" : "Paw")

                        </button>

                    </form>

                </div>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <!--
                    Only anonymous visitors receive the login prompt.
                    Authenticated Admins do not see this prompt.
                -->
                <div class="feed-engagement">

                    <div class="feed-paw-count">

                        <span class="feed-paw-icon">
                            🐾
                        </span>

                        <span>
                            @post.PawCount
                        </span>

                    </div>

                    <button type="button"
                            class="feed-action-button"
                            data-bs-toggle="modal"
                            data-bs-target="#loginModal">

                        Paw

                    </button>

                </div>
            }


            <!-- ==================================================
                 COMMENTS
                 ================================================== -->

            <div class="feed-comments-section"
                 data-comments-for="@post.PetFeedId">

                <h6 class="feed-section-title">
                    Comments
                </h6>

                @if (post.Comments != null && post.Comments.Any())
                {
                    <div class="feed-comments-list"
                         data-comments-list>

                        @foreach (var comment in post.Comments)
                        {
                            <div class="feed-comment"
                                 data-comment-id="@comment.CommentId">

                                <div class="feed-comment-header">

                                    <div class="feed-comment-author">

                                        <div class="feed-comment-avatar">

                                            @if (!string.IsNullOrEmpty(
                                                comment.Member?.ProfilePicturePath))
                                            {
                                                <!--
                                                    Display the member's profile
                                                    picture when available.
                                                -->
                                                <img src="@comment.Member.ProfilePicturePath"
                                                     alt="Profile picture" />
                                            }
                                            else
                                            {
                                                <!--
                                                    Fall back to the member's
                                                    first initial.
                                                -->
                                                @(comment.Member?.FirstName?.Substring(0, 1) ?? "?")
                                            }

                                        </div>

                                        <div>

                                            <strong>
                                                @comment.Member?.FirstName
                                                @comment.Member?.LastName
                                            </strong>

                                            <small>
                                                @comment.DatePosted.ToString("MMM dd, yyyy")
                                            </small>

                                        </div>

                                    </div>


                                    @if (User.IsInRole("Admin") ||
                                        comment.MemberId ==
                                        User.FindFirst(
                                            System.Security.Claims.ClaimTypes.NameIdentifier
                                        )?.Value)
                                    {
                                        <!--
                                            Admins can delete any comment.
                                            Members can delete their own comments.
                                        -->
                                        <form asp-action="DeleteComment"
                                              method="post"
                                              data-delete-comment-form>

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@comment.CommentId" />

                                            <input type="hidden"
                                                   name="feedSeed"
                                                   value="@ViewData["FeedSeed"]" />

                                            <button type="submit"
                                                    class="feed-delete-comment">

                                                Delete

                                            </button>

                                        </form>
                                    }

                                </div>

                                <p class="feed-comment-content">
                                    @comment.Content
                                </p>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <p class="feed-empty-comments"
                       data-empty-comments>
                        No comments yet. Be the first to comment!
                    </p>
                }


                <!-- ==================================================
                     ADD COMMENT
                     ================================================== -->
                @if (User.IsInRole("Member"))
                {
                    <!--
                        Only Members can add comments.
                    -->
                    <form asp-action="AddComment"
                          method="post"
                          class="feed-comment-form"
                          data-add-comment-form>

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@post.PetFeedId" />

                        <input type="hidden"
                               name="feedSeed"
                               value="@ViewData["FeedSeed"]" />

                        <textarea name="content"
                                  class="feed-comment-input"
                                  rows="2"
                                  placeholder="Write a comment..."
                                  data-comment-input></textarea>

                        <button type="submit"
                                class="feed-comment-submit">

                            Comment

                        </button>

                    </form>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <!--
                        Only anonymous visitors receive the login prompt.
                    -->
                    <button type="button"
                            class="feed-login-comment"
                            data-bs-toggle="modal"
                            data-bs-target="#loginModal">

                        Login to comment

                    </button>
                }

            </div>

        </article>
    }


    // ==========================================================
    // MARKETPLACE
    // ==========================================================
    else if (post.ContentType == PetFeedContentType.Marketplace)
    {
        // Check whether the Marketplace listing has images.
        // If not, the text section expands to use the full card width.
        var hasImages = post.ImagePaths != null && post.ImagePaths.Any();

        <article class="feed-card @(hasImages ? "" : "feed-card-no-image")"
                 id="post-@post.ContentId">

            <!-- POST HEADER -->

            <div class="feed-card-header">

                <div class="feed-author">

                    @if (!string.IsNullOrEmpty(post.OwnerProfileImage))
                    {
                        <!--
                            Display the Marketplace member's profile picture.
                        -->
                        <img src="@post.OwnerProfileImage"
                             class="feed-author-image"
                             alt="Post owner" />
                    }
                    else
                    {
                        <!--
                            Use the default profile picture when none exists.
                        -->
                        <img src="~/images/default_profile.jpg"
                             class="feed-author-image"
                             alt="Post owner" />
                    }

                    <div class="feed-author-info">

                        <strong class="feed-author-name">
                            @(string.IsNullOrWhiteSpace(post.OwnerName)
                                ? "Unknown User"
                                : post.OwnerName)
                        </strong>

                        <small class="feed-post-date">
                            @post.DateCreated.ToString("MMM dd, yyyy")
                        </small>

                    </div>

                </div>

            </div>


            <!-- MAIN CONTENT -->

            <div class="feed-card-content @(hasImages ? "" : "feed-card-content-no-image")">

                @if (hasImages)
                {
                    <!--
                        Only create the media section when images exist.
                    -->
                    <div class="feed-media">

                        @{
                            // Convert Marketplace image paths into a list.
                            // The list is used to determine whether to show
                            // one image or a multi-image preview.
                            var images = post.ImagePaths!.ToList();
                        }

                        @if (images.Count == 1)
                        {
                            <img src="@images[0]"
                                 class="feed-main-image"
                                 alt="Marketplace listing image" />
                        }
                        else
                        {
                            <div class="feed-image-grid">

                                @foreach (var image in images.Take(4))
                                {
                                    <img src="@image"
                                         class="feed-grid-image"
                                         alt="Marketplace listing image" />
                                }

                                @if (images.Count > 4)
                                {
                                    <div class="feed-more-images">
                                        +@(images.Count - 4)
                                    </div>
                                }

                            </div>
                        }

                    </div>
                }


                <!-- MARKETPLACE TEXT -->

                <div class="feed-text-content">

                    <span class="feed-type-badge marketplace-badge">
                        Marketplace
                    </span>

                    <h3 class="feed-title">
                        @post.Title
                    </h3>

                    <p class="feed-description">
                        @post.Content
                    </p>

                    @if (post.ListingType.HasValue)
                    {
                        <!--
                            Display the listing type when available.
                        -->
                        <p class="feed-meta-detail">

                            <strong>
                                Type:
                            </strong>

                            @post.ListingType

                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(post.DetailsUrl))
                    {
                        <!--
                            Use the existing Marketplace details URL.
                        -->
                        <a href="@post.DetailsUrl"
                           class="feed-details-button">

                            View details

                        </a>
                    }

                </div>

            </div>

        </article>
    }


    // ==========================================================
    // LOST & FOUND
    // ==========================================================
    else if (post.ContentType == PetFeedContentType.LostFound)
    {
        // Check whether the Lost & Found report has images.
        // If not, the text section expands to use the full card width.
        var hasImages = post.ImagePaths != null && post.ImagePaths.Any();

        <article class="feed-card @(hasImages ? "" : "feed-card-no-image")"
                 id="post-@post.ContentId">

            <!-- POST HEADER -->

            <div class="feed-card-header">

                <div class="feed-author">

                    @if (!string.IsNullOrEmpty(post.OwnerProfileImage))
                    {
                        <!--
                            Display the report owner's profile picture.
                        -->
                        <img src="@post.OwnerProfileImage"
                             class="feed-author-image"
                             alt="Post owner" />
                    }
                    else
                    {
                        <!--
                            Use the default profile picture when none exists.
                        -->
                        <img src="~/images/default_profile.jpg"
                             class="feed-author-image"
                             alt="Post owner" />
                    }

                    <div class="feed-author-info">

                        <strong class="feed-author-name">
                            @(string.IsNullOrWhiteSpace(post.OwnerName)
                                ? "Unknown User"
                                : post.OwnerName)
                        </strong>

                        <small class="feed-post-date">
                            @post.DateCreated.ToString("MMM dd, yyyy")
                        </small>

                    </div>

                </div>

            </div>


            <!-- MAIN CONTENT -->

            <div class="feed-card-content @(hasImages ? "" : "feed-card-content-no-image")">

                @if (hasImages)
                {
                    <!--
                        Only create the media section when images exist.
                    -->
                    <div class="feed-media">

                        @{
                            // Convert Lost & Found image paths into a list.
                            // The list is used to determine whether to show
                            // one image or a multi-image preview.
                            var images = post.ImagePaths!.ToList();
                        }

                        @if (images.Count == 1)
                        {
                            <img src="@images[0]"
                                 class="feed-main-image"
                                 alt="Lost and Found image" />
                        }
                        else
                        {
                            <div class="feed-image-grid">

                                @foreach (var image in images.Take(4))
                                {
                                    <img src="@image"
                                         class="feed-grid-image"
                                         alt="Lost and Found image" />
                                }

                                @if (images.Count > 4)
                                {
                                    <div class="feed-more-images">
                                        +@(images.Count - 4)
                                    </div>
                                }

                            </div>
                        }

                    </div>
                }


                <!-- LOST & FOUND TEXT -->

                <div class="feed-text-content">

                    <span class="feed-type-badge lost-found-badge">
                        Lost &amp; Found
                    </span>

                    <h3 class="feed-title">
                        @post.Title
                    </h3>

                    <p class="feed-description">
                        @post.Content
                    </p>

                    @if (post.LostFoundType.HasValue)
                    {
                        <!--
                            Display whether the report is Lost or Found.
                        -->
                        <p class="feed-meta-detail">

                            <strong>
                                Report:
                            </strong>

                            @post.LostFoundType

                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(post.DetailsUrl))
                    {
                        <!--
                            Use the existing Lost & Found details URL.
                        -->
                        <a href="@post.DetailsUrl"
                           class="feed-details-button">

                            View details

                        </a>
                    }

                </div>

            </div>

        </article>
    }
}