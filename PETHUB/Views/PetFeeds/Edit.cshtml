@model PETHUB.ViewModels.PetFeedViewModel

@{
    ViewData["Title"] = "Edit PetFeed Post";
}

<div class="petfeed-edit-page">

    <div class="petfeed-edit-card">

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data"
              id="petfeedEditForm">

            @Html.AntiForgeryToken()

            <!-- =====================================================
                 HEADER
            ====================================================== -->

            <div class="petfeed-edit-header">

                <h2>
                    Edit PetFeed Post
                </h2>

                <p class="text-muted">
                    Update your announcement or helpful pet tip.
                </p>

            </div>


            <!-- =====================================================
                 HIDDEN VALUES
            ====================================================== -->

            <input type="hidden"
                   asp-for="PetFeedId" />


            <!-- =====================================================
                 VALIDATION
            ====================================================== -->

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- =====================================================
                 MAIN FORM
            ====================================================== -->

            <div class="row g-4">

                <!-- =================================================
                     LEFT SIDE
                ================================================== -->

                <div class="col-lg-8">

                    <!-- =================================================
                         TITLE
                    ================================================== -->

                    <div class="mb-3">

                        <label asp-for="Title"
                               class="form-label">
                            Title
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Enter post title" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         CONTENT
                    ================================================== -->

                    <div class="mb-3">

                        <label asp-for="Content"
                               class="form-label">
                            Content
                        </label>

                        <textarea asp-for="Content"
                                  rows="6"
                                  class="form-control"
                                  placeholder="Write something about your post..."></textarea>

                        <span asp-validation-for="Content"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         POST TYPE
                    ================================================== -->

                    <div class="mb-3">

                        <label asp-for="Type"
                               class="form-label">
                            Post Type
                        </label>

                        <select asp-for="Type"
                                class="form-select"
                                asp-items="Html.GetEnumSelectList<PETHUB.Models.PetFeedType>()">
                        </select>

                        <span asp-validation-for="Type"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     RIGHT SIDE: PHOTOS
                ================================================== -->

                <div class="col-lg-4">

                    <div class="petfeed-edit-photo-card">

                        <h5>Photos</h5>


                        <!-- =================================================
                             CURRENT IMAGES
                        ================================================== -->
                        @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                        {
                            <div class="petfeed-edit-current-images">

                                @foreach (var img in Model.ExistingImages)
                                {
                                    <div class="petfeed-edit-image-item">

                                        <img src="@img.ImagePath"
                                             alt="PetFeed image"
                                             class="petfeed-edit-image" />

                                        <!--
                                            IMPORTANT:
                                            No nested form here.
                                            The button uses formaction to call
                                            RemoveImage while staying inside
                                            the main Edit form.
                                        -->

                                        <input type="hidden"
                                               name="id"
                                               value="@img.PetFeedImageId" />

                                        <button type="submit"
                                                formaction="@Url.Action("RemoveImage")"
                                                formmethod="post"
                                                class="petfeed-edit-remove-button">
                                            Remove
                                        </button>

                                    </div>
                                }

                            </div>
                        }


                        <!-- =================================================
                             ADD MORE IMAGES
                        ================================================== -->

                        <div class="petfeed-edit-upload">

                            <input asp-for="Images"
                                   type="file"
                                   id="imageInput"
                                   multiple
                                   accept="image/*"
                                   class="form-control" />

                            <p>
                                You can upload multiple images.
                            </p>

                        </div>


                        <!-- =================================================
                             NEW IMAGE PREVIEWS
                        ================================================== -->

                        <div id="imagePreviewContainer"
                             class="petfeed-edit-preview-grid">
                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 BOTTOM ACTIONS
            ====================================================== -->

            <hr class="my-4" />

            <div class="petfeed-edit-footer">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-success">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- IMAGE PREVIEW HELPER -->
    <script src="~/js/imagePreviewHelper.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

                    setupImagePreview(
                        "imageInput",
                        "imagePreviewContainer"
                    );

                });

    </script>

}
