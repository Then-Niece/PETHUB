@model PETHUB.ViewModels.PetFeedViewModel

@{
    ViewData["Title"] = "Edit PetFeed Post";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">

            <h1 class="text-center mb-4">Edit PetFeed Post</h1>

            <div class="row">

                <!-- LEFT SIDE: Current Images -->
                <div class="col-md-5">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Current Images</h5>
                        </div>

                        <div class="card-body">

                            @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                            {
                                <div class="row">

                                    @foreach (var img in Model.ExistingImages)
                                    {
                                        <div class="col-12 mb-3 text-center">

                                            <img src="@img.ImagePath"
                                                 class="img-fluid rounded shadow-sm"
                                                 style="height:150px;object-fit:cover;" />

                                            <form asp-action="RemoveImage" method="post" class="mt-2">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="id" value="@img.PetFeedImageId" />

                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    Remove
                                                </button>

                                            </form>

                                        </div>
                                    }

                                </div>
                            }
                            else
                            {
                                <p class="text-muted text-center">
                                    No images yet — upload one!
                                </p>
                            }

                        </div>
                    </div>
                </div>


                <!-- RIGHT SIDE: Edit Form -->
                <div class="col-md-7">

                    <div class="card shadow-sm">

                        <div class="card-body">

                            <form asp-action="Edit" method="post" enctype="multipart/form-data">

                                @Html.AntiForgeryToken()

                                <!-- Only keep ID -->
                                <input type="hidden" asp-for="PetFeedId" />


                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>


                                <!-- Title -->
                                <div class="form-group mb-3">

                                    <label asp-for="Title"></label>

                                    <input asp-for="Title" class="form-control" />

                                    <span asp-validation-for="Title" class="text-danger"></span>

                                </div>


                                <!-- Content -->
                                <div class="form-group mb-3">

                                    <label asp-for="Content"></label>

                                    <textarea asp-for="Content"
                                              class="form-control"
                                              rows="4"></textarea>

                                    <span asp-validation-for="Content" class="text-danger"></span>

                                </div>


                                <!-- Type -->
                                <div class="form-group mb-3">

                                    <label asp-for="Type"></label>

                                    <select asp-for="Type"
                                            class="form-select"
                                            asp-items="Html.GetEnumSelectList<PETHUB.Models.PetFeedType>()">
                                    </select>

                                    <span asp-validation-for="Type" class="text-danger"></span>

                                </div>


                                <!-- Add More Images -->
                                <div class="form-group mb-3">

                                    <label asp-for="Images">
                                        Add More Images
                                    </label>

                                    <input asp-for="Images"
                                           type="file"
                                           id="imageInput"
                                           multiple
                                           class="form-control" />

                                    <small class="form-text text-muted">
                                        You can select multiple files.
                                    </small>

                                </div>


                                <div id="imagePreviewContainer"
                                     class="d-flex flex-wrap gap-2 mt-3">
                                </div>


                                <!-- Submit -->
                                <div class="d-flex justify-content-between mt-4">

                                    <button type="submit" class="btn btn-primary">
                                        Save Changes
                                    </button>

                                    <a asp-action="Index" class="btn btn-secondary">
                                        Back to PetFeed
                                    </a>

                                </div>


                            </form>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <script src="~/js/imagePreviewHelper.js"></script>
        <script>
            setupImagePreview("imageInput", "imagePreviewContainer");
        </script>
    }
}
