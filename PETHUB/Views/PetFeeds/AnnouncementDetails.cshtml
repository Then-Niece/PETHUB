@using PETHUB.Models
@model PetFeed

@{
    // Store the related announcement images in a local collection.
    // The controller already loads all PetFeedImage records through
    // Include(p => p.Images), so the details page can display every image.
    var images = Model.Images?.ToList() ?? new List<PetFeedImage>();
}

<!-- =========================================================
     ANNOUNCEMENT DETAILS
     ========================================================= -->

<div class="container py-4">

    <!--
        Main announcement card.
        This page displays only public announcement information.
        Admin identity, Paws, and Comments are intentionally excluded.
    -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-body p-4 p-lg-5">

            <!-- =================================================
                 HEADER
                 ================================================= -->

            <div class="mb-4">

                <!--
                    Identifies the content as an official announcement.
                    No administrator identity is displayed.
                -->
                <span class="announcement-badge">
                    Announcement
                </span>

                <!--
                    Display the announcement title supplied by the
                    selected PetFeed record.
                -->
                <h1 class="fw-bold mt-3 mb-2">
                    @Model.Title
                </h1>

                <!--
                    Display the announcement creation date.
                    ToString formats the DateTime into a readable date.
                -->
                <p class="text-muted mb-0">
                    @Model.DateCreated.ToString("MMM dd, yyyy")
                </p>

            </div>


            <!-- =================================================
                 ANNOUNCEMENT CONTENT
                 ================================================= -->

            <div class="mb-4">

                <!--
                    The announcement content is rendered as text.
                    white-space: pre-line preserves intentional line breaks
                    entered by the administrator.
                -->
                <p class="announcement-details-content mb-0">
                    @Model.Content
                </p>

            </div>


            <!-- =================================================
                 ANNOUNCEMENT IMAGES
                 ================================================= -->
            @if (images.Any())
            {
                <!--
                    Display every image associated with this announcement.

                    Unlike the carousel preview, the details page intentionally
                    uses the complete image collection loaded by the controller.
                -->
                <div class="announcement-details-gallery">

                    @foreach (var image in images)
                    {
                        <!--
                            Each PetFeedImage contains the stored relative
                            ImagePath used by the application to display
                            the uploaded announcement image.
                        -->
                        <div class="announcement-details-image-wrapper">

                            <img src="@image.ImagePath"
                                 class="announcement-details-image"
                                 alt="Announcement image" />

                        </div>
                    }

                </div>
            }
            else
            {
                <!--
                    Display a simple message when the announcement has
                    no uploaded images.
                -->
                <div class="text-muted py-3">
                    No images available for this announcement.
                </div>
            }


            <!-- =================================================
                 BACK BUTTON
                 ================================================= -->

            <div class="mt-4">

                <!--
                    Return the user to the main PetFeed page.
                    This does not create a new details workflow.
                -->
                <a asp-controller="PetFeeds"
                   asp-action="Feed"
                   class="btn btn-outline-success">
                    Back to PetFeed
                </a>

            </div>

        </div>

    </div>

</div>