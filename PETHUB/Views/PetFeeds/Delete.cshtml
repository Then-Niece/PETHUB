@model PETHUB.Models.PetFeed

@{
    ViewData["Title"] = "Delete PetFeed Post";
}

<h1 class="mb-4">Delete PetFeed Post</h1>

<div class="alert alert-danger">
    <strong>Warning:</strong> Are you sure you want to delete this post? This action cannot be undone.
</div>

<div class="row justify-content-center">
    <!-- Left side: image -->
    <div class="col-md-6">
        @if (Model.Images != null && Model.Images.Any())
        {
            <img src="@Model.Images.First().ImagePath"
                 class="img-fluid rounded shadow-sm"
                 alt="PetFeed image"
                 style="height:400px;object-fit:cover;" />
        }
        else
        {
            <div class="bg-light text-center py-5 rounded shadow-sm">
                <p class="text-muted">No images uploaded for this post.</p>
            </div>
        }
    </div>

    <!-- Right side: info -->
    <div class="col-md-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h3 class="fw-bold">@Model.Title</h3>
                <p class="text-muted mb-1">Created on @Model.DateCreated.ToString("MMMM dd, yyyy")</p>
                <p class="mb-3">@Model.Content</p>
                <p><strong>Type:</strong> @Model.Type</p>
                <p><strong>Admin:</strong> @Model.Admin?.FirstName @Model.Admin?.LastName</p>
            </div>
            <div class="card-footer d-flex justify-content-center gap-3">
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PetFeedId" />
                    <button type="submit" class="btn btn-danger px-4">Yes, Delete</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
