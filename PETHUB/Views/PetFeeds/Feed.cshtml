@using System.Linq
@using PETHUB.ViewModels
@model IEnumerable<PETHUB.ViewModels.PetFeedFeedViewModel>

@{
    // Retrieve the active administrator announcements supplied by
    // PetFeedsController. If none exist, use an empty collection so
    // the partial can safely render nothing.
    var announcements =
        ViewData["Announcements"] as IEnumerable<PETHUB.Models.PetFeed>
        ?? Enumerable.Empty<PETHUB.Models.PetFeed>();
}

<!--
    Announcement carousel always appears before the normal combined feed.
    The partial renders nothing when there are no active announcements.
-->
@await Html.PartialAsync(
    "_Announcements",
    announcements
)

@* 
    The FeedSeed identifies the current randomized feed session.
    petfeed.js reads this value so every LoadMore request uses the same
    ordering generated by the controller.
*@
<div class="feed-container"
     data-feed-seed="@ViewData["FeedSeed"]">

    @await Html.PartialAsync("_FeedItems", Model)

</div>

<!-- ==============================================================
     LOGIN MODAL
     ============================================================== -->

<div class="modal fade"
     id="loginModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-body text-center p-5">

                <img src="~/images/PETHUB-LOGO.png"
                     asp-append-version="true"
                     style="width:80px;"
                     class="mb-4"
                     alt="PetHub Logo" />

                <div class="mb-3">

                    <i class="bi bi-heart-fill"
                       style="font-size:40px;color:#8ACE79;"></i>

                </div>

                <h3 class="fw-bold mb-3"
                    style="color:#2D3748;">

                    Login to Continue

                </h3>

                <p class="text-muted mb-4"
                   style="line-height:1.8;">

                    Sign in to react to posts, leave comments,
                    and participate in the PetHub community.

                </p>

                <div class="d-grid gap-3">

                    <a asp-controller="UserAccount"
                       asp-action="Login"
                       class="btn btn-lg text-white rounded-pill"
                       style="background:#8ACE79;">

                        Login

                    </a>

                    <button class="btn btn-light rounded-pill"
                            data-bs-dismiss="modal">

                        Maybe Later

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>