@using System.Linq
@using PETHUB.ViewModels
@model IEnumerable<PETHUB.ViewModels.PetFeedFeedViewModel>

@{
    // Retrieve the active administrator announcements supplied by
    // PetFeedsController. If none exist, use an empty collection so
    // the announcement partial can safely render nothing.
    var announcements =
        ViewData["Announcements"] as IEnumerable<PETHUB.Models.PetFeed>
        ?? Enumerable.Empty<PETHUB.Models.PetFeed>();
}

<!-- ==============================================================
     ANNOUNCEMENTS
     ============================================================== -->
<!--
    Render the announcement carousel before the normal combined feed.

    _Announcements.cshtml receives IEnumerable<PetFeed> because there
    can be multiple active announcements.
-->
@await Html.PartialAsync(
    "_Announcements",
    announcements
)


<!-- ==============================================================
     NORMAL PETFEED
     ============================================================== -->
@*
    FeedSeed identifies the current randomized feed session.

    petfeed.js reads this value when requesting additional posts so
    LoadMore requests continue using the same ordering generated by
    the controller.

    data-user-id identifies who this page was actually rendered for
    ("" for anonymous visitors). petfeed.js compares this against the
    identity stored alongside any cached feed state before restoring
    it, so a stale snapshot from a previous login (a different Member,
    or a Member who has since logged out) is never shown to the wrong
    person.
*@
<div class="feed-container"
     data-feed-seed="@ViewData["FeedSeed"]"
     data-user-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")">

    @await Html.PartialAsync("_FeedItems", Model)

</div>


<!-- ==============================================================
     LOGIN MODAL
     ============================================================== -->
@if (User.Identity?.IsAuthenticated != true)
{
    <!--
        The login modal is rendered ONLY for anonymous visitors.

        If the user is already authenticated, this entire modal is
        excluded from the generated HTML. Therefore authenticated
        users cannot accidentally receive the "Login to Continue"
        modal from a feed interaction.
    -->
    <div class="modal fade"
         id="loginModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow-lg rounded-4">

                <div class="modal-body text-center p-5">

                    <!--
                        PetHub logo displayed at the top of the login
                        prompt.
                    -->
                    <img src="~/images/PETHUB-LOGO.png"
                         asp-append-version="true"
                         style="width:80px;"
                         class="mb-4"
                         alt="PetHub Logo" />


                    <!--
                        Decorative heart icon used by the existing
                        login modal design.
                    -->
                    <div class="mb-3">

                        <i class="bi bi-heart-fill"
                           style="font-size:40px;color:#8ACE79;"></i>

                    </div>


                    <!-- Modal title -->
                    <h3 class="fw-bold mb-3"
                        style="color:#2D3748;">

                        Login to Continue

                    </h3>


                    <!-- Modal description -->
                    <p class="text-muted mb-4"
                       style="line-height:1.8;">

                        Sign in to react to posts, leave comments,
                        and participate in the PetHub community.

                    </p>


                    <!-- ==================================================
                         LOGIN ACTIONS
                         ================================================== -->

                    <div class="d-grid gap-3">

                        <!--
                            Navigate the anonymous visitor to the
                            existing UserAccount Login action.
                        -->
                        <a asp-controller="UserAccount"
                           asp-action="Login"
                           class="btn btn-lg text-white rounded-pill"
                           style="background:#8ACE79;">

                            Login

                        </a>


                        <!--
                            Close the Bootstrap modal without navigating.
                        -->
                        <button class="btn btn-light rounded-pill"
                                data-bs-dismiss="modal">

                            Maybe Later

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
}