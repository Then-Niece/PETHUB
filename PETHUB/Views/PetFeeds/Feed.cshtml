@using System.Linq
@using PETHUB.ViewModels
@model IEnumerable<PETHUB.ViewModels.PetFeedFeedViewModel>

@{
    var announcements =
        ViewData["Announcements"] as IEnumerable<PETHUB.Models.PetFeed>
        ?? Enumerable.Empty<PETHUB.Models.PetFeed>();
}

@await Html.PartialAsync(
    "_Announcements",
    announcements
)

<div class="feed-container"
     data-feed-seed="@ViewData["FeedSeed"]"
     data-user-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")">

    @await Html.PartialAsync("_FeedItems", Model)

</div>


@if (User.Identity?.IsAuthenticated != true)
{
    <div class="modal fade"
         id="loginModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow-lg rounded-4">

                <div class="modal-body text-center p-5">

                    <!-- PETHUB Logo -->
                    <img src="~/images/PETHUB-LOGO.png"
                         asp-append-version="true"
                         style="width:80px;"
                         class="mb-4"
                         alt="PetHub Logo" />


                    <!-- Icon -->
                    <div class="mb-3 login-modal-icon">
                        <i data-lucide="heart"></i>
                    </div>


                    <!-- Title -->
                    <h3 class="fw-bold mb-3 login-modal-title">
                        Login to Continue
                    </h3>


                    <!-- Description -->
                    <p class="text-muted mb-4 login-modal-description">
                        Sign in to react to posts, leave comments,
                        and participate in the PetHub community.
                    </p>


                    <!-- Actions -->
                    <div class="d-grid gap-3">

                        <a asp-controller="UserAccount"
                           asp-action="Login"
                           class="btn btn-lg text-white rounded-pill login-modal-button">
                            Login
                        </a>

                        <button type="button"
                                class="btn btn-light rounded-pill"
                                data-bs-dismiss="modal">
                            Maybe Later
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
}


<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (typeof lucide !== "undefined") {
            lucide.createIcons();
        }
    });
</script>