@using System.Linq
@using PETHUB.Models

@model IEnumerable<PETHUB.Models.PetFeed>

@{
    var items = Model?
        .Where(x => x != null)
        .ToList()
        ?? new List<PetFeed>();

    if (items.Count == 0)
    {
        return;
    }
}

<section class="feed-announcements">

    <!-- ==========================================================
         ANNOUNCEMENT CAROUSEL
         ========================================================== -->

    <div id="announcementCarousel"
         class="carousel slide announcement-carousel"
         data-bs-ride="false">

        <div class="carousel-inner">

            @for (int i = 0; i < items.Count; i++)
            {
                var item = items[i];

                var isActive = i == 0;

                var images = item.Images?
                    .ToList()
                    ?? new List<PetFeedImage>();

                var photoCarouselId = $"announcementPhotos_{item.PetFeedId}";

                <article class="carousel-item @(isActive ? "active" : "")">

                    <div class="announcement-card">

                        <!-- ==================================================
                             CARD HEADER
                             ================================================== -->

                        <div class="announcement-card-header">

                            <div class="announcement-author">

                                <img src="~/images/PETHUB-LOGO.png"
                                     class="announcement-author-image"
                                     alt="PETHUB" />

                                <div class="announcement-author-info">

                                    <div class="announcement-author-name-row">

                                        <strong class="announcement-author-name">
                                            PETHUB
                                        </strong>

                                        <i data-lucide="badge-check"
                                           class="announcement-verified"></i>

                                    </div>

                                    <div class="announcement-meta">

                                        <span>
                                            @item.DateCreated.ToString("MMM dd, yyyy")
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- Announcement Label -->

                            <div class="announcement-type">

                                <i data-lucide="megaphone"></i>

                                <span>
                                    Announcement
                                </span>

                            </div>

                        </div>


                        <!-- ==================================================
                             CARD CONTENT
                             ================================================== -->

                        <div class="announcement-card-content">

                            <h3 class="announcement-title">
                                @item.Title
                            </h3>


                            <div class="announcement-description-wrapper">

                                <p class="announcement-description">

                                    @item.Content

                                </p>

                                <button type="button"
                                        class="announcement-see-more">
                                    See more
                                </button>

                            </div>

                        </div>


                        <!-- ==================================================
                             ANNOUNCEMENT PHOTOS
                             ================================================== -->
                        @if (images.Any())
                        {
                            if (images.Count == 1)
                            {
                                <!-- Single Image -->

                                <div class="announcement-media">

                                    <img src="@images.First().ImagePath"
                                         class="announcement-image"
                                         alt="@item.Title" />

                                </div>
                            }
                            else
                            {
                                <!-- Photo Carousel -->

                                <div id="@photoCarouselId"
                                     class="carousel slide announcement-photo-carousel"
                                     data-bs-ride="false">

                                    <div class="carousel-inner">

                                        @for (int imageIndex = 0;
                                              imageIndex < images.Count;
                                              imageIndex++)
                                        {
                                            var image = images[imageIndex];

                                            <div class="carousel-item @(imageIndex == 0 ? "active" : "")">

                                                <div class="announcement-media">

                                                    <img src="@image.ImagePath"
                                                         class="announcement-image"
                                                         alt="@item.Title" />

                                                </div>

                                            </div>
                                        }

                                    </div>


                                    <!-- Photo Previous -->

                                    <button class="announcement-photo-control announcement-photo-prev"
                                            type="button"
                                            data-bs-target="#@photoCarouselId"
                                            data-bs-slide="prev">

                                        <span class="announcement-photo-control-icon"
                                              aria-hidden="true">

                                            <i data-lucide="chevron-left"></i>

                                        </span>

                                        <span class="visually-hidden">
                                            Previous photo
                                        </span>

                                    </button>


                                    <!-- Photo Next -->

                                    <button class="announcement-photo-control announcement-photo-next"
                                            type="button"
                                            data-bs-target="#@photoCarouselId"
                                            data-bs-slide="next">

                                        <span class="announcement-photo-control-icon"
                                              aria-hidden="true">

                                            <i data-lucide="chevron-right"></i>

                                        </span>

                                        <span class="visually-hidden">
                                            Next photo
                                        </span>

                                    </button>


                                    <!-- Photo Counter -->

                                    <div class="announcement-photo-counter">

                                        <i data-lucide="images"></i>

                                        <span>
                                            @images.Count
                                        </span>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="announcement-media announcement-no-image">

                                <div class="announcement-placeholder">

                                    <i data-lucide="image-off"></i>

                                    <span>
                                        No image available
                                    </span>

                                </div>

                            </div>
                        }




                    

                    </div>

                </article>
            }

        </div>


        <!-- ==========================================================
             ANNOUNCEMENT INDICATORS
             ========================================================== -->
        @if (items.Count > 1)
        {
            <div class="carousel-indicators announcement-indicators">

                @for (int i = 0; i < items.Count; i++)
                {
                    <button type="button"
                            data-bs-target="#announcementCarousel"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-current="@(i == 0 ? "true" : "false")"
                            aria-label="Go to announcement @(i + 1)">
                    </button>
                }

            </div>
        }


        <!-- ==========================================================
             ANNOUNCEMENT PREVIOUS / NEXT CONTROLS
             ========================================================== -->
        @if (items.Count > 1)
        {
            <button class="carousel-control-prev announcement-carousel-control announcement-carousel-prev"
                    type="button"
                    data-bs-target="#announcementCarousel"
                    data-bs-slide="prev">

                <span class="announcement-control-icon"
                      aria-hidden="true">

                    <i data-lucide="chevron-left"></i>

                </span>

                <span class="visually-hidden">
                    Previous
                </span>

            </button>


            <button class="carousel-control-next announcement-carousel-control announcement-carousel-next"
                    type="button"
                    data-bs-target="#announcementCarousel"
                    data-bs-slide="next">

                <span class="announcement-control-icon"
                      aria-hidden="true">

                    <i data-lucide="chevron-right"></i>

                </span>

                <span class="visually-hidden">
                    Next
                </span>

            </button>
        }

    </div>

</section>


<!-- ==============================================================
     SEE MORE + LUCIDE INITIALIZATION
     ============================================================== -->

<script>
    document.addEventListener("DOMContentLoaded", function () {

        /* ==========================================================
           LUCIDE
           ========================================================== */

        if (typeof lucide !== "undefined") {
            lucide.createIcons();
        }


        /* ==========================================================
           ANNOUNCEMENT SEE MORE
           ========================================================== */

        const descriptionWrappers =
            document.querySelectorAll(".announcement-description-wrapper");

        descriptionWrappers.forEach(function (wrapper) {

            const description =
                wrapper.querySelector(".announcement-description");

            const seeMore =
                wrapper.querySelector(".announcement-see-more");

            if (!description || !seeMore) {
                return;
            }


            /* Check whether the text is actually too long */

            if (description.scrollHeight > description.clientHeight + 1) {

                seeMore.classList.add("show");

            }


            seeMore.addEventListener("click", function () {

                const isExpanded =
                    description.classList.contains("expanded");

                if (isExpanded) {

                    description.classList.remove("expanded");

                    seeMore.textContent = "See more";

                }
                else {

                    description.classList.add("expanded");

                    seeMore.textContent = "See less";

                }

            });

        });

    });
</script>