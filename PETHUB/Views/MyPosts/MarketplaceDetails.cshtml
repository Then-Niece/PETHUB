@model PETHUB.Models.Listing

@{
    ViewData["Title"] = "Listing Details";

    // Used to determine whether the dropdown and needs a divider before Delete.
    bool hasOtherActions =
        Model.Status == ListApprovalStatus.Pending ||
        Model.Status == ListApprovalStatus.Rejected ||
        (
            Model.Status == ListApprovalStatus.Approved &&
            Model.ListStatus == ListingStatus.Pending
        );
}


<div class="marketplace-details-page">

    <!-- =====================================================
         MAIN DETAILS LAYOUT
    ====================================================== -->

    <div class="listing-details-layout">


        <!-- =================================================
             LEFT SIDE
             IMAGE GALLERY
        ================================================== -->

        <div class="listing-gallery">

            <div class="listing-main-image">

                @if (Model.Images != null && Model.Images.Any())
                {
                    <div id="listingCarousel"
                         class="carousel slide"
                         data-bs-ride="carousel">

                        <div class="carousel-inner">

                            @for (int i = 0; i < Model.Images.Count; i++)
                            {
                                var img = Model.Images.ElementAt(i);

                                <div class="carousel-item @(i == 0 ? "active" : "")">

                                    <img src="@img.ImagePath"
                                         alt="Listing Image" />

                                </div>
                            }

                        </div>


                        <!-- Previous -->

                        <button class="carousel-control-prev"
                                type="button"
                                data-bs-target="#listingCarousel"
                                data-bs-slide="prev">

                            <span class="carousel-control-prev-icon"></span>

                            <span class="visually-hidden">
                                Previous
                            </span>

                        </button>


                        <!-- Next -->

                        <button class="carousel-control-next"
                                type="button"
                                data-bs-target="#listingCarousel"
                                data-bs-slide="next">

                            <span class="carousel-control-next-icon"></span>

                            <span class="visually-hidden">
                                Next
                            </span>

                        </button>

                    </div>
                }
                else
                {
                    <div class="listing-no-image">

                        <span>
                            No images uploaded.
                        </span>

                    </div>
                }

            </div>

        </div>



        <!-- =================================================
             RIGHT SIDE
             OWNER / LISTING DETAILS
        ================================================== -->

        <div class="listing-info-panel">


            <!-- ======================================================
                 PROFILE
            ====================================================== -->

            <div class="listing-profile">

                <div class="listing-profile-main">

                    <div class="listing-profile-avatar">

                        <!-- Avatar -->
                        @if (!string.IsNullOrWhiteSpace(Model.Member?.ProfilePicturePath))
                        {
                            <img src="@Model.Member.ProfilePicturePath"
                                 class="rounded-circle border"
                                 style="width:44px;height:44px;object-fit:cover;" />
                        }
                        else
                        {
                            <img src="~/images/default_profile.jpg"
                                 class="rounded-circle border"
                                 style="width:44px;height:44px;object-fit:cover;" />
                        }


                    </div>

                    <!-- User Information -->

                    <div class="listing-profile-details">

                        <p class="listing-profile-name">

                            @Model.Member?.FirstName
                            @Model.Member?.LastName

                        </p>


                        <div class="listing-profile-meta">

                            <span>
                                @Model.DatePosted.ToString("MMMM dd, yyyy")
                            </span>

                            <span>·</span>

                            <span>

                                @(Model.Type == ListType.For_Adoption
                                    ? "For Adoption"
                                    : "For Sale")

                            </span>

                        </div>

                    </div>

                </div>



                <!-- ==================================================
                     THREE DOT MENU
                ================================================== -->

                <div class="listing-more-menu">


                    <!-- Three Dot Button -->

                    <button type="button"
                            class="listing-more-btn"
                            onclick="this.parentElement.classList.toggle('show')"
                            aria-label="More options">

                        <i data-lucide="more-horizontal"></i>

                    </button>



                    <!-- ==================================================
                         DROPDOWN
                    ================================================== -->

                    <div class="listing-more-dropdown">


                        <!-- ==================================================
                             EDIT
                        ================================================== -->
                        @if (Model.Status == ListApprovalStatus.Pending ||
                                                     Model.Status == ListApprovalStatus.Rejected)
                        {
                            <a asp-controller="Listings"
                               asp-action="Edit"
                               asp-route-id="@Model.ListingId">

                                <i data-lucide="pencil"></i>

                                <span>
                                    Edit
                                </span>

                            </a>
                        }



                        <!-- ==================================================
                             MARK AS SOLD
                        ================================================== -->
                        @if (Model.Status == ListApprovalStatus.Approved &&
                                                     Model.ListStatus == ListingStatus.Pending &&
                                                     Model.Type == ListType.For_Sale)
                        {
                            <form asp-action="MarkAsSold"
                                  asp-controller="MyPosts"
                                  asp-route-id="@Model.ListingId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit">

                                    <i data-lucide="circle-check"></i>

                                    <span>
                                        Mark as Sold
                                    </span>

                                </button>

                            </form>
                        }



                        <!-- ==================================================
                             MARK AS ADOPTED
                        ================================================== -->
                        @if (Model.Status == ListApprovalStatus.Approved &&
                                                     Model.ListStatus == ListingStatus.Pending &&
                                                     Model.Type == ListType.For_Adoption)
                        {
                            <form asp-action="MarkAsAdopted"
                                  asp-controller="MyPosts"
                                  asp-route-id="@Model.ListingId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit">

                                    <i data-lucide="heart-handshake"></i>

                                    <span>
                                        Mark as Adopted
                                    </span>

                                </button>

                            </form>
                        }



                        <!-- ==================================================
                             DIVIDER - ONLY SHOW IF THERE ARE OTHER ACTIONS
                        ================================================== -->
                        @if (hasOtherActions)
                        {
                            <div class="menu-divider"></div>
                        }



                        <!-- ==================================================
                             DELETE
                        ================================================== -->

                        <form asp-action="DeleteMarketplace"
                              asp-controller="MyPosts"
                              asp-route-id="@Model.ListingId"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="danger-action">

                                <i data-lucide="trash-2"></i>

                                <span>
                                    Delete
                                </span>

                            </button>

                        </form>


                    </div>

                </div>

            </div>



            <!-- ==================================================
                 PROFILE DIVIDER
            ================================================== -->

            <div class="listing-profile-divider"></div>



            <!-- =================================================
                 TITLE
            ================================================== -->
            <div class="listing-title-section">

                <h1>
                    @Model.Title
                </h1>

                @if (Model.Type == PETHUB.Models.ListType.For_Sale)
                {
                    <div class="listing-price">
                        ₱@Model.Price.ToString("N2")
                    </div>
                }

            </div>



            <!-- =================================================
                 ABOUT THIS PET
            ================================================== -->

            <section class="listing-info-section">

                <h3>
                    About This Pet
                </h3>


                <p class="listing-description">

                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description provided."
                        : Model.Description)

                </p>

            </section>



            <!-- =================================================
                 PET INFORMATION
            ================================================== -->

            <section class="listing-info-section">

                <h3>
                    Pet Information
                </h3>


                <div class="pet-information-list">


                    <!-- Pet Type -->

                    <div class="pet-information-item">

                        <span class="pet-information-label">

                            <i data-lucide="paw-print"></i>

                        </span>

                        <span class="pet-information-value">

                            @Model.PetType

                        </span>

                    </div>



                    <!-- Breed -->

                    <div class="pet-information-item">

                        <span class="pet-information-label">

                            <i data-lucide="tag"></i>

                        </span>

                        <span class="pet-information-value">

                            @(string.IsNullOrWhiteSpace(Model.Breed)
                                ? "Not specified"
                                : Model.Breed)

                        </span>

                    </div>



                    <!-- Sex -->

                    <div class="pet-information-item">

                        <span class="pet-information-label">

                            <i data-lucide="venus-and-mars"></i>

                        </span>

                        <span class="pet-information-value">

                            @Model.PetSex

                        </span>

                    </div>


                </div>

            </section>



            <!-- =================================================
                 LOCATION
            ================================================== -->

            <section class="listing-info-section">

                <h3>

                    <i data-lucide="map-pin"></i>

                    Where to Find

                </h3>


                <div class="listing-location-grid">


                    <!-- Street Address -->

                    <div class="listing-location-item">

                        <span class="listing-location-label">
                            Street Address
                        </span>

                        <span class="listing-location-value">

                            @(string.IsNullOrWhiteSpace(Model.StreetAddress)
                                ? "Not specified"
                                : Model.StreetAddress)

                        </span>

                    </div>



                    <!-- Barangay -->

                    <div class="listing-location-item">

                        <span class="listing-location-label">
                            Barangay
                        </span>

                        <span class="listing-location-value">

                            @(string.IsNullOrWhiteSpace(Model.Barangay)
                                ? "Not specified"
                                : Model.Barangay)

                        </span>

                    </div>



                    <!-- City -->

                    <div class="listing-location-item">

                        <span class="listing-location-label">
                            City
                        </span>

                        <span class="listing-location-value">

                            @(string.IsNullOrWhiteSpace(Model.City)
                                ? "Not specified"
                                : Model.City)

                        </span>

                    </div>



                    <!-- Province -->

                    <div class="listing-location-item">

                        <span class="listing-location-label">
                            Province
                        </span>

                        <span class="listing-location-value">

                            @(string.IsNullOrWhiteSpace(Model.Province)
                                ? "Not specified"
                                : Model.Province)

                        </span>

                    </div>


                </div>

            </section>



            <!-- =================================================
                 CONTACT NUMBER
            ================================================== -->

            <section class="listing-info-section listing-contact-section">

                <h3>

                    <i data-lucide="phone"></i>

                    Contact Number

                </h3>


                <p class="listing-contact-number">

                  

                    @(string.IsNullOrWhiteSpace(Model.Member?.ContactNumber)
                        ? "Not Available"
                        : Model.Member.ContactNumber)

                </p>

            </section>



            <!-- =================================================
                 LISTING STATUS
            ================================================== -->

            <section class="listing-info-section">

                <h3>

                    <i data-lucide="circle-check"></i>

                    Listing Status

                </h3>


                <div class="my-post-status">


                    @if (Model.Status == ListApprovalStatus.Pending)
                    {
                        <span class="my-post-status-badge pending">

                            Pending Approval

                        </span>
                    }
                    else if (Model.Status == ListApprovalStatus.Rejected)
                    {
                        <span class="my-post-status-badge rejected">

                            Rejected

                        </span>
                    }
                    else if (Model.Status == ListApprovalStatus.Approved)
                    {
                        @if (Model.ListStatus == ListingStatus.Sold)
                        {
                            <span class="my-post-status-badge completed">

                                Sold

                            </span>
                        }
                        else if (Model.ListStatus == ListingStatus.Adopted)
                        {
                            <span class="my-post-status-badge completed">

                                Adopted

                            </span>
                        }
                        else
                        {
                            <span class="my-post-status-badge approved">

                                Approved

                            </span>
                        }
                    }


                </div>

            </section>



            <!-- ======================================================
                 BACK TO MY POSTS

WIDE + CENTERED INSIDE RIGHT PANEL
            ====================================================== -->

            <div class="my-post-back-container">

                <a asp-action="Index"
                   asp-controller="MyPosts"
                   class="my-post-back-btn">

                    <i data-lucide="arrow-left"></i>

                    <span>
                        Back to My Posts
                    </span>

                </a>

            </div>


        </div>

    </div>

</div>



<!-- ==========================================================
     LUCIDE ICON INITIALIZATION
========================================================== -->

<script>

    document.addEventListener("DOMContentLoaded", function() {

        if (typeof lucide !== "undefined") {

            lucide.createIcons();

        }

    });

</script>



<!-- ==========================================================
     CLOSE DROPDOWN WHEN RIGHT PANEL IS SCROLLED
========================================================== -->

<script>

    document.addEventListener("DOMContentLoaded", function() {

        const detailsPanel =
            document.querySelector(".listing-info-panel");

        if (detailsPanel) {

            detailsPanel.addEventListener("scroll", function() {

                const menu =
                    document.querySelector(".listing-more-menu");

                if (menu) {

                    menu.classList.remove("show");

                }

            });

        }

    });

</script>



<!-- ==========================================================
     CLOSE DROPDOWN WHEN CLICKING OUTSIDE
========================================================== -->

<script>

    document.addEventListener("click", function(event) {

        const menu =
            document.querySelector(".listing-more-menu");

        if (!menu) {
            return;
        }


        if (!event.target.closest(".listing-more-menu")) {

            menu.classList.remove("show");

        }

    });

</script>