    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model PETHUB.Models.Listing

@{
    ViewData["Title"] = "Listing Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <!-- Left side: image gallery -->
        <div class="col-md-6">
            @if (Model.Images != null && Model.Images.Any())
            {
                <div id="listingCarousel" class="carousel slide shadow-sm" data-bs-ride="carousel">
                    <div class="carousel-inner rounded">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            var img = Model.Images.ElementAt(i);
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@img.ImagePath" class="d-block w-100" alt="Listing image" style="height:400px;object-fit:cover;">
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            }
            else
            {
                <div class="bg-light text-center py-5 rounded shadow-sm">
                    <p class="text-muted">No images uploaded for this listing.</p>
                </div>
            }
        </div>

        <!-- Right side: listing info -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <h2 class="fw-bold">
                        @Model.Title
                    </h2>

                    <p class="text-muted">
                        Posted on @Model.DatePosted.ToString("MMMM dd, yyyy")
                    </p>

                    <hr />

                    <h5>Description</h5>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "No description provided."
                            : Model.Description)
                    </p>

                    <hr />

                    <h5>Listing Information</h5>

                    <p>
                        <strong>Listing Type:</strong>
                        @(Model.Type == PETHUB.Models.ListType.For_Adoption
                            ? "For Adoption"
                            : "For Sale")
                    </p>

                    @if (Model.Type == ListType.For_Adoption)
                    {
                        <p>
                            <strong>Price:</strong>
                            <span class="text-success fw-bold">
                                Free for Adoption
                            </span>
                        </p>
                    }
                    else
                    {
                        <p>
                            <strong>Price:</strong>
                            ₱@Model.Price.ToString("N0")
                        </p>
                    }

                    <p>
                        <strong>Pet Type:</strong>
                        @Model.PetType
                    </p>

                    <p>
                        <strong>Breed:</strong>
                        @Model.Breed
                    </p>

                    <p>
                        <strong>Pet Sex:</strong>
                        @Model.PetSex
                    </p>

                    <hr />

                    <h5>Location</h5>

                    @if (!string.IsNullOrWhiteSpace(Model.StreetAddress))
                    {
                        <p>
                            <strong>Street Address:</strong><br />
                            @Model.StreetAddress
                        </p>
                    }

                    <p>
                        <strong>Barangay:</strong><br />
                        @Model.Barangay
                    </p>

                    <p>
                        <strong>City:</strong><br />
                        @Model.City
                    </p>

                    <p>
                        <strong>Province:</strong><br />
                        @Model.Province
                    </p>

                    <hr />
                </div>

                <div class="card-body">

                    <h5 class="fw-bold mb-3">
                        Member Information
                    </h5>

                    <p>
                        <strong>Posted by:</strong><br />
                        @Model.Member?.FirstName
                        @Model.Member?.LastName
                    </p>

                    <p>
                        <strong>Contact Number:</strong><br />
                        @(string.IsNullOrWhiteSpace(Model.Member?.ContactNumber)
                            ? "Not Available"
                            : Model.Member.ContactNumber)
                    </p>

                </div>
                <div class="card-footer d-flex justify-content-center gap-3">

                    @* 
                        Only show the Edit button if the listing
                        is still Pending only.

                        Approved listings are locked and can no
                        longer be modified by members.
                    *@

                    @if (Model.Status == ListApprovalStatus.Pending)                    {
                        <a asp-controller="Listings"
                           asp-action="Edit"
                           asp-route-id="@Model.ListingId"
                           class="btn btn-warning">
                            Edit
                        </a>
                    }

                    @* Approved listings can be marked as Sold or Adopted. *@
                    @if (Model.Status == ListApprovalStatus.Approved)
                    {
                        @if (Model.ListStatus == ListingStatus.Pending)
                        {
                            if (Model.Type == ListType.For_Sale)
                            {
                                <form asp-action="MarkAsSold"
                                      asp-controller="MyPosts"
                                      asp-route-id="@Model.ListingId"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-success">
                                        Mark as Sold
                                    </button>
                                </form>
                            }
                            else if (Model.Type == ListType.For_Adoption)
                            {
                                <form asp-action="MarkAsAdopted"
                                      asp-controller="MyPosts"
                                      asp-route-id="@Model.ListingId"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-success">
                                        Mark as Adopted
                                    </button>
                                </form>
                            }
                        }
                        else if (Model.ListStatus == ListingStatus.Sold)
                        {
                            <span class="badge bg-success align-self-center">
                                Sold
                            </span>
                        }
                        else if (Model.ListStatus == ListingStatus.Adopted)
                        {
                            <span class="badge bg-success align-self-center">
                                Adopted
                            </span>
                        }
                    }

                    @* Allow the owner to delete the listing regardless of approval status. *@
                    <form asp-action="DeleteMarketplace"
                          asp-controller="MyPosts"
                          asp-route-id="@Model.ListingId"
                          method="post">
                        
 
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-danger px-4">
                            Delete
                        </button>
                    </form>

                    @* Return to the owner's My Posts page. *@
                    <a asp-action="Index"
                       asp-controller="MyPosts"
                       class="btn btn-secondary px-4">
                        ← Back to My Posts
                    </a>

                </div>            
            </div>
        </div>
    </div>
</div>
