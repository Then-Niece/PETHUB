    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model PETHUB.Models.LostFound

@{
    ViewData["Title"] = "Lost & Found Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <!-- Left side: image gallery -->
        <div class="col-md-6">
            @if (Model.Images != null && Model.Images.Any())
            {
                <div id="lostFoundCarousel" class="carousel slide shadow-sm" data-bs-ride="carousel">
                    <div class="carousel-inner rounded">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            var img = Model.Images.ElementAt(i);
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@img.ImagePath" class="d-block w-100" alt="LostFound image" style="height:400px;object-fit:cover;">
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#lostFoundCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#lostFoundCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            }
            else
            {
                <div class="bg-light text-center py-5 rounded shadow-sm">
                    <p class="text-muted">No images uploaded for this report.</p>
                </div>
            }
        </div>

        <!-- Right side: report info -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h3 class="fw-bold">@Model.Title</h3>
                    <p class="text-muted mb-1">Reported on @Model.DateReported.ToString("MMMM dd, yyyy")</p>
                    <p class="mb-3">@Model.Description</p>
                    <p><strong>Type:</strong> @Model.Type</p>
                    <p><strong>Pet Type:</strong> @Model.PetType</p>
                    <p><strong>Breed:</strong> @(string.IsNullOrEmpty(Model.Breed) ? "Not specified" : Model.Breed)</p>
                    <p><strong>Sex:</strong> @(Model.Sex.HasValue ? Model.Sex.ToString() : "Not specified")</p>
                    @if (Model.Type == LostFoundType.Found)
                    {

                    }
                    else
                    {
                        <p>
                            <strong>Lost Date:</strong>
                            @(Model.LostDate.HasValue
                                ? Model.LostDate.Value.ToString("MMMM dd, yyyy")
                                : "Not specified")
                        </p>
                    }

                    <hr />

                    <h5>Location</h5>

                    @if (!string.IsNullOrWhiteSpace(Model.StreetAddress))
                    {
                        <p>
                            <strong>Street Address:</strong><br />
                            @Model.StreetAddress
                        </p>
                    }

                    <p>
                        <strong>Barangay:</strong><br />
                        @Model.Barangay
                    </p>

                    <p>
                        <strong>City:</strong><br />
                        @Model.City
                    </p>

                    <p>
                        <strong>Province:</strong><br />
                        @Model.Province
                    </p>

                    <hr />


                    <!-- I Added this conditional statement so that if the UserId is null then it means its a client report and it shows its details-->
                    <!-- But if its a registered member, it shows its firstname and last name -->
                    @if (Model.UserId == null)
                    {

                        <!-- Reporter Information -->
                        <h5>Reporter Information</h5>

                        <hr />

                        <p>
                            <strong>Name:</strong>
                            @Model.ClientName
                        </p>

                        <p>
                            <strong>Contact:</strong>
                            @Model.ClientContact
                        </p>
                    }
                    else
                    {

                        <!-- Reporter Information -->
                        <h5>Reporter Information (Member)</h5>
                        <hr/>
                        <p><strong>Posted by:</strong> @Model.User?.FirstName @Model.User?.LastName</p>
                        <p><strong>Contact Number:</strong> @Model.User?.ContactNumber</p>
                    }
                </div>
                <div class="card-footer d-flex justify-content-center gap-3">

                    @* Pending reports can still be edited. *@
                    @if (Model.Status == ApprovalStatus.Pending)
                    {
                        <a asp-controller="LostFounds"
                           asp-action="Edit"
                           asp-route-id="@Model.LostFoundId"
                           class="btn btn-warning px-4">
                            Edit
                        </a>
                    }

                    @* Approved reports that are still active can be resolved by the owner. *@
                    @if (Model.Status == ApprovalStatus.Approved &&
                         Model.RStatus == ReportStatus.Active)
                    {
                        <form asp-action="MarkReportResolved"
                              asp-controller="MyPosts"
                              asp-route-id="@Model.LostFoundId"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-success px-4">
                                @(Model.Type == LostFoundType.Lost
                                    ? "Mark as Found"
                                    : "Mark as Resolved")
                            </button>
                        </form>
                    }

                    @* Show a badge once the report has been resolved. *@
                    @if (Model.Status == ApprovalStatus.Approved &&
                         Model.RStatus == ReportStatus.Resolved)
                    {
                        <span class="btn btn-outline-success disabled px-4">
                            @(Model.Type == LostFoundType.Lost
                                ? "Found"
                                : "Resolved")
                        </span>
                    }

                    @* Members can always delete their own report.
                       The controller still validates ownership. *@
                    <form asp-action="DeleteLostFound"
                          asp-controller="MyPosts"
                          asp-route-id="@Model.LostFoundId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger px-4">
                            Delete
                        </button>
                    </form>

                    <a asp-controller="MyPosts"
                       asp-action="Index"
                       class="btn btn-secondary px-4">
                        ← Back to My Posts
                    </a>

                </div>            
        </div>
        </div>
    </div>
</div>
