@model PETHUB.ViewModels.MyPostsViewModel

@{
    ViewData["Title"] = "My Posts";

    // =========================================================
    // MY POSTS FILTERS
    // =========================================================

    var myPostsFilters = PETHUB.Helpers.FilterBarHelper.Create(
        PETHUB.Helpers.FilterBarHelper.Status(Model.StatusFilter),
        PETHUB.Helpers.FilterBarHelper.PostType(Model.TypeFilter)
    );
}


<div class="my-posts-page">


    <!-- ==========================================================
         PROFILE SUMMARY
    ========================================================== -->

    <partial name="_ProfileSummaryCard"
             model="Model.Profile" />


    <!-- ==========================================================
         MY POSTS HEADER
    ========================================================== -->

    <div class="my-posts-heading">

        <div>

            <h2>
                My Posts
            </h2>

            <p>
                Manage your listings and reports
            </p>

        </div>

    </div>


    <!-- ==========================================================
         FILTERS + TOTAL POST COUNT
    ========================================================== -->

    <div class="my-posts-toolbar">

        <div class="my-posts-filters">

            @foreach (var filter in myPostsFilters.Filters)
            {
                var selectedValue = filter.SelectedValue ?? filter.DefaultValue;

                <div class="my-post-filter"
                     data-filter-dropdown>

                    <span class="my-post-filter-label">
                        @filter.Label
                    </span>

                    <button type="button"
                            class="my-post-filter-button"
                            data-dropdown-button
                            aria-expanded="false">

                        <span>
                            @(filter.Options.FirstOrDefault(x => x.Value == selectedValue)?.Label
                                ?? filter.Options.FirstOrDefault()?.Label)
                        </span>

                        <i data-lucide="chevron-down"></i>

                    </button>

                    <div class="my-post-filter-menu"
                         data-dropdown-menu>

                        @foreach (var option in filter.Options)
                        {
                            var query = Context.Request.Query
                                .ToDictionary(
                                    item => item.Key,
                                    item => item.Value.ToString()
                                );

                            if (string.IsNullOrEmpty(option.Value))
                            {
                                query.Remove(filter.ParameterName);
                            }
                            else
                            {
                                query[filter.ParameterName] = option.Value;
                            }

                            var queryString = string.Join(
                                "&",
                                query.Select(
                                    item => $"{item.Key}={Uri.EscapeDataString(item.Value)}"
                                )
                            );

                            var baseUrl = Context.Request.Path.ToString();

                            var optionUrl = string.IsNullOrEmpty(queryString)
                                ? baseUrl
                                : $"{baseUrl}?{queryString}";

                            var isSelected = option.Value == selectedValue;

                            <a href="@optionUrl"
                               class="my-post-filter-option @(isSelected ? "selected" : "")">

                                @option.Label

                            </a>
                        }

                    </div>

                </div>
            }

        </div>

        <span class="my-posts-count">

            @Model.TotalItems
            @(Model.TotalItems == 1 ? "post" : "posts")

        </span>

    </div>


    <!-- ==========================================================
         MY POSTS RESULTS
    ========================================================== -->

    <div class="my-posts-results">

        @foreach (var post in Model.Posts)
        {

            <!-- ==================================================
                 MARKETPLACE POST
            ================================================== -->
            @if (post.Listing != null)
            {
                <div class="my-post-card">


                    <!-- ==================================================
                         LISTING IMAGE
                    ================================================== -->

                    <a asp-controller="MyPosts"
                       asp-action="MarketplaceDetails"
                       asp-route-id="@post.Listing.ListingId"
                       class="my-post-card-image-link">

                        @if (post.Listing.Images != null &&
                             post.Listing.Images.Any())
                        {
                            <img src="@Url.Content(post.Listing.Images.First().ImagePath)"
                                 class="my-post-card-image"
                                 alt="Listing Image" />
                        }
                        else
                        {
                            <img src="@Url.Content("~/images/no-image.png")"
                                 class="my-post-card-image"
                                 alt="No Image" />
                        }

                    </a>


                    <!-- ==================================================
                         LISTING INFORMATION
                    ================================================== -->

                    <a asp-controller="MyPosts"
                       asp-action="MarketplaceDetails"
                       asp-route-id="@post.Listing.ListingId"
                       class="my-post-card-content">

                        <h3>
                            @post.Listing.Title
                        </h3>

                        <p class="my-post-card-type">
                            Marketplace · @post.Listing.Type
                        </p>

                        <p class="my-post-card-date">
                            Created @post.Listing.DatePosted.ToString("MMM dd, yyyy")
                        </p>

                    </a>


                    <!-- ==================================================
                         RIGHT SIDE ACTIONS
                    ================================================== -->

                    <div class="my-post-card-actions">


                        <!-- ==================================================
                             THREE-DOT MENU
                        ================================================== -->

                        <div class="dropdown">

                            <button class="my-post-more-button"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    aria-label="Post options">

                                <i data-lucide="ellipsis"></i>

                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>

                                    <a asp-controller="MyPosts"
                                       asp-action="MarketplaceDetails"
                                       asp-route-id="@post.Listing.ListingId"
                                       class="dropdown-item">

                                        View Details

                                    </a>

                                </li>

                            </ul>

                        </div>


                        <!-- ==================================================
                             APPROVAL STATUS
                        ================================================== -->
                        @if (post.Listing.Status == ListApprovalStatus.Pending)
                        {
                            <span class="my-post-status my-post-status-pending">
                                Pending
                            </span>
                        }
                        else if (post.Listing.Status == ListApprovalStatus.Approved)
                        {
                            <span class="my-post-status my-post-status-approved">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="my-post-status my-post-status-rejected">
                                Rejected
                            </span>
                        }

                    </div>

                </div>
            }
            else if (post.Report != null)
            {
                <div class="my-post-card">


                    <!-- ==================================================
                         REPORT IMAGE
                    ================================================== -->

                    <a asp-controller="MyPosts"
                       asp-action="LostFoundDetails"
                       asp-route-id="@post.Report.LostFoundId"
                       class="my-post-card-image-link">

                        @if (post.Report.Images != null &&
                             post.Report.Images.Any())
                        {
                            <img src="@Url.Content(post.Report.Images.First().ImagePath)"
                                 class="my-post-card-image"
                                 alt="Report Image" />
                        }
                        else
                        {
                            <img src="@Url.Content("~/images/no-image.png")"
                                 class="my-post-card-image"
                                 alt="No Image" />
                        }

                    </a>


                    <!-- ==================================================
                         REPORT INFORMATION
                    ================================================== -->

                    <a asp-controller="MyPosts"
                       asp-action="LostFoundDetails"
                       asp-route-id="@post.Report.LostFoundId"
                       class="my-post-card-content">

                        <h3>
                            @post.Report.Title
                        </h3>

                        <p class="my-post-card-type">
                            Lost &amp; Found · @post.Report.Type
                        </p>

                        <p class="my-post-card-date">
                            Created @post.Report.DateReported.ToString("MMM dd, yyyy")
                        </p>

                    </a>


                    <!-- ==================================================
                         RIGHT SIDE ACTIONS
                    ================================================== -->

                    <div class="my-post-card-actions">


                        <!-- ==================================================
                             THREE-DOT MENU
                        ================================================== -->

                        <div class="dropdown">

                            <button class="my-post-more-button"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    aria-label="Post options">

                                <i data-lucide="ellipsis"></i>

                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>

                                    <a asp-controller="MyPosts"
                                       asp-action="LostFoundDetails"
                                       asp-route-id="@post.Report.LostFoundId"
                                       class="dropdown-item">

                                        View Details

                                    </a>

                                </li>

                            </ul>

                        </div>


                        <!-- ==================================================
                             APPROVAL STATUS
                        ================================================== -->
                        @if (post.Report.Status == ApprovalStatus.Pending)
                        {
                            <span class="my-post-status my-post-status-pending">
                                Pending
                            </span>
                        }
                        else if (post.Report.Status == ApprovalStatus.Approved)
                        {
                            <span class="my-post-status my-post-status-approved">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="my-post-status my-post-status-rejected">
                                Rejected
                            </span>
                        }

                    </div>

                </div>
            }

        }

    </div>

    <partial name="_Pagination" model="Model" />

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            if (typeof lucide !== "undefined") {
                lucide.createIcons();
            }

        });

    </script>

}