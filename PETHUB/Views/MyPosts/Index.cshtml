@model PETHUB.ViewModels.MyPostsViewModel

@{
    ViewData["Title"] = "My Posts";
}

@* Header and Edit Profile Button*@
<div class="d-flex justify-content-between align-items-center mb-4">


</div>

    @* Profile Summary Card is displayed here *@

    <a asp-controller="MyProfile"
       asp-action="View"
       class="text-decoration-none text-reset d-block">
        <partial name="_ProfileSummaryCard" model="Model.Profile" />
    </a>

    <h2 class="mb-4 mt-4">
        My Posts
    </h2>


    @foreach (var post in Model.Posts)
    {
        @* ===========================
           MARKETPLACE POSTS
           =========================== *@
        @if (post.Listing != null)
        {
            <div class="card shadow-sm">

                <!-- Card Body -->
                <div class="card-body d-flex justify-content-between align-items-center">

                    <!-- LEFT SIDE -->
                    <a asp-controller="MyPosts"
                       asp-action="MarketplaceDetails"
                       asp-route-id="@post.Listing.ListingId"
                       class="d-flex align-items-center flex-grow-1 text-decoration-none text-dark">

                        <!-- Listing Thumbnail -->
                        <div class="me-4">

                            @if (post.Listing.Images != null && post.Listing.Images.Any())
                            {
                                <img src="@Url.Content(post.Listing.Images.First().ImagePath)"
                                     class="img-fluid rounded"
                                     alt="Listing Image"
                                     style="width:140px;height:140px;object-fit:cover;" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/images/no-image.png")"
                                     class="img-fluid rounded"
                                     alt="No Image"
                                     style="width:140px;height:140px;object-fit:cover;" />
                            }

                        </div>

                        <!-- Listing Information -->
                        <div>

                            <h4 class="fw-bold">
                                @post.Listing.Title
                            </h4>

                            <p class="mb-1">
                                <strong>Created:</strong>
                                @post.Listing.DatePosted.ToString("MMM dd, yyyy")
                            </p>

                            <p class="mb-1">
                                <strong>Listing Type:</strong>
                                @post.Listing.Type
                            </p>

                        </div>

                    </a>

                    <!-- RIGHT SIDE -->
                    <div class="d-flex flex-wrap gap-2 justify-content-end ms-4">


                    </div>
                    
                </div>

                <!-- Footer -->
                <div class="card-footer d-flex justify-content-end align-items-center">

                    <div>

                        <strong>Approval:</strong>

                        @if (post.Listing.Status == ListApprovalStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">
                                Pending Approval
                            </span>
                        }
                        else if (post.Listing.Status == ListApprovalStatus.Approved)
                        {
                            <span class="badge bg-success">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Rejected
                            </span>
                        }

                    </div>


                </div>

            </div>
        }

        @* ===========================
           LOST & FOUND POSTS
           =========================== *@
        else if (post.Report != null)
        {
            <div class="card shadow-sm">

                <!-- Card Body -->
                <div class="card-body d-flex justify-content-between align-items-center">

                    <!-- LEFT SIDE -->
                    <a asp-controller="MyPosts"
                       asp-action="LostFoundDetails"
                       asp-route-id="@post.Report.LostFoundId"
                       class="d-flex align-items-center flex-grow-1 text-decoration-none text-dark">

                        <!-- Report Thumbnail -->
                        <div class="me-4">

                            @if (post.Report.Images != null && post.Report.Images.Any())
                            {
                                <img src="@Url.Content(post.Report.Images.First().ImagePath)"
                                     class="img-fluid rounded"
                                     alt="Report Image"
                                     style="width:140px;height:140px;object-fit:cover;" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/images/no-image.png")"
                                     class="img-fluid rounded"
                                     alt="No Image"
                                     style="width:140px;height:140px;object-fit:cover;" />
                            }

                        </div>

                        <!-- Report Information -->
                        <div>

                            <h4 class="fw-bold">
                                @post.Report.Title
                            </h4>

                            <p class="mb-1">
                                <strong>Created:</strong>
                                @post.Report.DateReported.ToString("MMM dd, yyyy")
                            </p>

                            <p class="mb-1">
                                <strong>Report Type:</strong>
                                @post.Report.Type
                            </p>

                        </div>

                    </a>

                    <!-- RIGHT SIDE -->
                    <div class="d-flex flex-wrap gap-2 justify-content-end ms-4">


                    </div>

                </div>

                <!-- Footer -->
                <div class="card-footer d-flex justify-content-end align-items-end">

                    <div>

                        <strong>Approval:</strong>

                        @if (post.Report.Status == ApprovalStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">
                                Pending Approval
                            </span>
                        }
                        else if (post.Report.Status == ApprovalStatus.Approved)
                        {
                            <span class="badge bg-success">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Rejected
                            </span>
                        }

                    </div>

                </div>

            </div>
        }
    }

</div>

