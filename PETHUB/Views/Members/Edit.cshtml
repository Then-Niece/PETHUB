@model PETHUB.ViewModels.EditMemberViewModel

@{
    ViewData["Title"] = "Edit Member";

    ViewData["Province"] = Model.Province;
    ViewData["City"] = Model.City;
    ViewData["Barangay"] = Model.Barangay;
    ViewData["StreetAddress"] = Model.StreetAddress;
}

<div class="container-fluid py-4">

    <div class="crud-page edit-member-page">

        <div class="crud-card">

            <div class="crud-header">

                <h2>Edit Member</h2>

                <p>
                    Update the member information below.
                </p>

            </div>


            <form asp-action="Edit"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>


                <div class="crud-content">

                    <!-- =================================================
                         LEFT SIDE
                    ================================================== -->

                    <div class="form-grid">


                        <!-- Username -->
                        <div class="form-group">

                            <label asp-for="UserName">
                                Username
                            </label>

                            <input asp-for="UserName"
                                   class="form-control custom-input" />

                            <span asp-validation-for="UserName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Email -->
                        <div class="form-group">

                            <label asp-for="Email">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control custom-input readonly-input"
                                   readonly />

                            <small class="edit-member-help">
                                Verified email cannot be changed.
                            </small>

                        </div>


                        <!-- First Name -->
                        <div class="form-group">

                            <label asp-for="FirstName">
                                First Name
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control custom-input" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Middle Name -->
                        <div class="form-group">

                            <label asp-for="MiddleName">
                                Middle Name
                            </label>

                            <input asp-for="MiddleName"
                                   class="form-control custom-input"
                                   placeholder="Optional" />

                            <span asp-validation-for="MiddleName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Last Name -->
                        <div class="form-group">

                            <label asp-for="LastName">
                                Last Name
                            </label>

                            <input asp-for="LastName"
                                   class="form-control custom-input" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Contact Number -->
                        <div class="form-group">

                            <label asp-for="ContactNumber">
                                Contact Number
                            </label>

                            <input asp-for="ContactNumber"
                                   class="form-control custom-input"
                                   maxlength="11"
                                   inputmode="numeric"
                                   autocomplete="tel"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '')" />

                            <span asp-validation-for="ContactNumber"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Gender -->
                        <div class="form-group full-width">

                            <label>
                                Gender
                            </label>

                            <div class="gender-group">

                                <div class="form-check">

                                    <input asp-for="Gender"
                                           class="form-check-input"
                                           type="radio"
                                           value="Male"
                                           id="male" />

                                    <label class="form-check-label"
                                           for="male">
                                        Male
                                    </label>

                                </div>


                                <div class="form-check">

                                    <input asp-for="Gender"
                                           class="form-check-input"
                                           type="radio"
                                           value="Female"
                                           id="female" />

                                    <label class="form-check-label"
                                           for="female">
                                        Female
                                    </label>

                                </div>

                            </div>

                            <span asp-validation-for="Gender"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             BIRTHDATE
                        ================================================== -->

                        <div class="form-group full-width edit-member-birthdate">

                            <partial name="Components/_DateFields"
                                     model='new PETHUB.ViewModels.DateFieldsViewModel
                                     {
                                         FieldName = "Birthdate",
                                         Label = "Birthdate",
                                         Value = Model.Birthdate,
                                         AllowFuture = false,
                                         MinimumAge = 18
                                     }' />

<span asp-validation-for="Birthdate"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             ADDRESS
                        ================================================== -->

                        <div class="edit-member-address full-width">

                            <div class="edit-member-section-title">
                                Address
                            </div>

                            <partial name="Components/_AddressFields" />

                        </div>

                    </div>


                    <!-- =================================================
                         RIGHT SIDE - VALID ID
                    ================================================== -->

                    <div class="upload-panel">

                        <h5>
                            Valid ID
                        </h5>

                        <p class="upload-text">
                            Existing uploaded Valid ID.
                        </p>


                        <div class="upload-preview">

                            @if (!string.IsNullOrWhiteSpace(Model.IdPhotoPath))
                            {
                                <img src="@Url.Content(Model.IdPhotoPath)"
                                     class="edit-member-id-image"
                                     alt="Member Valid ID" />
                            }
                            else
                            {
                                <div class="upload-placeholder">

                                    <i class="bi bi-card-image"></i>

                                    <p>
                                        No Valid ID Preview
                                    </p>

                                </div>
                            }

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     FOOTER
                ================================================== -->

                <div class="crud-footer">

                    <a asp-action="Index"
                       class="btn-cancel">

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn-primary-action">

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/address-helper.js"
            asp-append-version="true">
    </script>
}