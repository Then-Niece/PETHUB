@model PETHUB.Models.ApplicationUser

@{
    ViewData["Title"] = "Edit Member";
    ViewData["Province"] = Model.Province;
    ViewData["City"] = Model.City;
    ViewData["Barangay"] = Model.Barangay;
    ViewData["StreetAddress"] = Model.StreetAddress;
}

<div class="container-fluid py-4">

    <div class="crud-page">

        <div class="crud-card">

            <div class="crud-header">

                <h2>Edit Member</h2>

                <p>
                    Update the member information below.
                </p>

            </div>

            <form asp-action="Edit">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>

                <div class="crud-content">

                  

                    <div class="form-grid">

                        <!-- Username -->
                        <div class="form-group">

                            <label asp-for="UserName">
                                Username
                            </label>

                            <input asp-for="UserName"
                                   class="form-control custom-input" />

                            <span asp-validation-for="UserName"
                                  class="text-danger"></span>

                        </div>

                        <!-- Email -->
                        <div class="form-group">

                            <label asp-for="Email">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control custom-input" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>

                        </div>

                        <!-- First Name -->
                        <div class="form-group">

                            <label asp-for="FirstName">
                                First Name
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control custom-input" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger"></span>

                        </div>

                        <!-- Last Name -->
                        <div class="form-group">

                            <label asp-for="LastName">
                                Last Name
                            </label>

                            <input asp-for="LastName"
                                   class="form-control custom-input" />

                            <span asp-validation-for="LastName"
                                  class="text-danger"></span>

                        </div>

                        <!-- Contact -->
                        <div class="form-group">

                            <label asp-for="ContactNumber">
                                Contact Number
                            </label>

                            <input asp-for="ContactNumber"
                                   class="form-control custom-input" />

                            <span asp-validation-for="ContactNumber"
                                  class="text-danger"></span>

                        </div>

                        <!-- Gender -->
                        <div class="form-group">

                            <label>
                                Gender
                            </label>

                            <div class="gender-group">

                                <div class="form-check">

                                    <input asp-for="Gender"
                                           class="form-check-input"
                                           type="radio"
                                           value="Male"
                                           id="male" />

                                    <label class="form-check-label"
                                           for="male">

                                        Male

                                    </label>

                                </div>

                                <div class="form-check">

                                    <input asp-for="Gender"
                                           class="form-check-input"
                                           type="radio"
                                           value="Female"
                                           id="female" />

                                    <label class="form-check-label"
                                           for="female">

                                        Female

                                    </label>

                                </div>

                            </div>

                            <span asp-validation-for="Gender"
                                  class="text-danger"></span>

                        </div>

                        <!-- Birthdate -->
                        <div class="form-group">

                            <label asp-for="Birthdate">
                                Birth Date
                            </label>

                            <input asp-for="Birthdate"
                                   type="date"
                                   class="form-control custom-input" />

                            <span asp-validation-for="Birthdate"
                                  class="text-danger"></span>

                        </div>

                        <!-- Status -->
                        <div class="form-group">

                            <label asp-for="Status">
                                Status
                            </label>

                            <select asp-for="Status"
                                    asp-items="Html.GetEnumSelectList<UserStatus>()"
                                    class="form-select custom-input">
                            </select>

                            <span asp-validation-for="Status"
                                  class="text-danger"></span>

                        </div>

                        <!-- Address -->
                        <partial name="Components/_AddressFields" />
                    </div>

                   

                    <div class="upload-panel">

                        <h5>
                            Valid ID
                        </h5>

                        <p class="upload-text">

                            Existing uploaded Valid ID.

                        </p>

                        <div class="upload-preview">

                          

                            <div class="upload-placeholder">

                                <i class="bi bi-card-image"></i>

                                <p>

                                    No Valid ID Preview

                                </p>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="crud-footer">

                    <a asp-action="Index"
                       class="btn-cancel">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn-primary-action">

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/address-helper.js" asp-append-version="true"></script>
}