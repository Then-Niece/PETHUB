@model PETHUB.ViewModels.PaginationViewModel<PETHUB.Models.ApplicationUser>
@{
    ViewData["Title"] = "Members";
}

<div class="container-fluid px-2 py-4">

    <div class="admin-header">

        <div>
            <h2 class="admin-title">Members</h2>
            <p class="admin-subtitle">
                Manage registered community members.
            </p>
        </div>

        <a asp-action="Create" class="admin-add-btn">
            + New Member
        </a>

    </div>

    <div class="admin-card">

        <div class="admin-card-header">

            <div class="search-box">
                <i data-lucide="search" class="search-icon"></i>

                <input class="admin-search"
                       placeholder="Search members..." />
            </div>

            <span class="member-count">
                @Model.TotalItems
                @(Model.TotalItems == 1 ? "Member" : "Members")
            </span>

        </div>

        

            <table class="admin-table">

                <thead>

                    <tr>

                        <th>Username</th>

                        <th>Full Name</th>

                        <th>Email</th>

                        <th class="text-center">Contact</th>

                        <th class="text-center">Gender</th>

                        <th class="text-center">Role</th>

                        <th class="text-center">Status</th>

                        <th class="text-center" >
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                @foreach (var item in Model.Items)
                    {
                        <tr>

                            <td>@item.UserName</td>

                            <td class="full-name-col">
                                @item.FirstName @item.LastName
                            </td>

                            <td class="email-col">
                                @item.Email
                            </td>

                            <td>
                                @item.ContactNumber
                            </td>

                            <td class="text-center">
                                <span class="gender-pill @(item.Gender == "Male" ? "male" : "female")">
                                    @item.Gender
                                </span>
                            </td>

                            <td class="text-center">
                                <span class="role-pill">
                                    @ViewBag.MemberRoles[item.Id]
                                </span>
                            </td>

                            <td class="text-center">

                                @if (item.Status == UserStatus.Active)
                                {
                                    <span class="status-pill active">
                                        Active
                                    </span>
                                }
                                else if (item.Status == UserStatus.Inactive)
                                {
                                    <span class="status-pill inactive">
                                        Inactive
                                    </span>
                                }
                                else
                                {
                                    <span class="status-pill pending">
                                        Pending
                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <div class="action-dropdown">

                                    <button type="button" class="action-menu-btn">

                                        <i data-lucide="ellipsis-vertical"></i>

                                    </button>

                                    <div class="action-menu">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id">
                                            View
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id">
                                            Edit
                                        </a>

                                        <div class="menu-divider"></div>


                                        @if (item.Status == UserStatus.Active)
                                        {
                                            <form asp-action="Deactivate"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="action-menu-form">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="deactivate-item">

                                                    Deactivate

                                                </button>

                                            </form>
                                        }
                                        else if (item.Status == UserStatus.Inactive)
                                        {
                                            <form asp-action="Reactivate"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="action-menu-form">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="reactivate-item">

                                                    Reactivate

                                                </button>

                                            </form>
                                        }

                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            

      

    </div>

    <partial name="_Pagination" model="Model" />



</div>