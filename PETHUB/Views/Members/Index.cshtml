@model PETHUB.ViewModels.PaginationViewModel<PETHUB.Models.ApplicationUser>

@{
    ViewData["Title"] = "Members";
}

<div class="container-fluid px-2 py-4">

    <div class="members-page">

        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <div class="admin-header">

            <div class="admin-header-text">

                <h2 class="admin-title">
                    Members
                </h2>

                <p class="admin-subtitle">
                    Manage registered community members.
                </p>

            </div>


            <a asp-action="Create"
               class="admin-add-btn">

                <i data-lucide="user-plus"></i>

                New Member

            </a>

        </div>


        <!-- =====================================================
             MEMBER CARD
        ====================================================== -->

        <div class="admin-card members-card">


            <!-- =================================================
                 TOOLBAR
            ================================================== -->

            <div class="admin-card-header members-toolbar">

                <form asp-action="Index"
                      method="get"
                      class="search-box"
                      id="memberSearchForm">

                    <i data-lucide="search"
                       class="search-icon">
                    </i>

                    <input class="admin-search"
                           type="text"
                           name="search"
                           id="memberSearchInput"
                           value="@ViewBag.Search"
                           placeholder="Search members..."
                           autocomplete="off" />

                </form>


                <span class="member-count"
                      id="memberCount">

                    @Model.TotalItems
                    @(Model.TotalItems == 1 ? "Member" : "Members")

                </span>

            </div>


            <!-- =================================================
                 TABLE
            ================================================== -->

            <div class="members-table-wrap">

                <table class="admin-table members-table">

                    <thead>

                        <tr>

                            <th>
                                Username
                            </th>

                            <th>
                                Full Name
                            </th>

                            <th>
                                Email
                            </th>

                            <th class="text-center">
                                Contact
                            </th>

                            <th class="text-center">
                                Gender
                            </th>

                            <th class="text-center">
                                Role
                            </th>

                            <th class="text-center">
                                Status
                            </th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody id="membersTableBody">

                        <partial name="_MemberRows"
                                 model="Model.Items" />

                    </tbody>

                </table>

            </div>

        </div>


        <!-- =====================================================
             PAGINATION
        ====================================================== -->

        <div class="members-pagination">

            <partial name="_Pagination"
                     model="Model" />

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const searchInput =
                    document.getElementById(
                        "memberSearchInput"
                    );

                const tableBody =
                    document.getElementById(
                        "membersTableBody"
                    );

                const memberCount =
                    document.getElementById(
                        "memberCount"
                    );


                if (
                    !searchInput ||
                    !tableBody
                ) {
                    return;
                }


                let searchTimer;


                searchInput.addEventListener(
                    "input",
                    function () {

                        clearTimeout(
                            searchTimer
                        );


                        const searchValue =
                            this.value.trim();


                        searchTimer =
                            setTimeout(
                                async function () {

                                    try {

                                        const response =
                                            await fetch(
                                                `/Members/Search?search=${encodeURIComponent(searchValue)}`
                                            );


                                        if (!response.ok) {
                                            return;
                                        }


                                        const html =
                                            await response.text();


                                        tableBody.innerHTML =
                                            html;


                                        // Re-render icons in AJAX rows.
                                        if (window.lucide) {
                                            lucide.createIcons();
                                        }


                                        // Update result count.
                                        const rowCount =
                                            tableBody.querySelectorAll(
                                                "tr"
                                            ).length;


                                        if (memberCount) {

                                            memberCount.textContent =
                                                `${rowCount} ${rowCount === 1
                                                    ? "Member"
                                                    : "Members"}`;

                                        }

                                    }
                                    catch (error) {

                                        console.error(
                                            "Member search failed:",
                                            error
                                        );

                                    }

                                },
                                300
                            );

                    }
                );

            }
        );

    </script>
}