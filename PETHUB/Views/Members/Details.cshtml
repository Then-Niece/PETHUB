@model PETHUB.Models.ApplicationUser

@{
    ViewData["Title"] = "View Member";
}

<div class="container-fluid py-4">

    <div class="crud-page member-details-page">

        <div class="crud-card">

            <!-- HEADER -->
            <div class="crud-header">

                <h2>View Member</h2>

                <p>
                    Review the member's account and personal information.
                </p>

            </div>


            <!-- CONTENT -->
            <div class="member-view-content">

                <!-- LEFT SIDE -->
                <div class="member-view-main">


                    <!-- ACCOUNT -->
                    <section class="member-view-section">

                        <div class="member-view-section-header">

                            <h5>Account Information</h5>

                        </div>

                        <div class="member-view-grid">

                            <div class="member-view-item">
                                <span class="member-view-label">Username</span>
                                <strong class="member-view-value">
                                    @Model.UserName
                                </strong>
                            </div>


                            <div class="member-view-item">
                                <span class="member-view-label">Email</span>
                                <strong class="member-view-value">
                                    @Model.Email
                                </strong>
                            </div>


                            <div class="member-view-item">
                                <span class="member-view-label">Status</span>

                                <strong class="member-view-value">
                                    @Model.Status
                                </strong>
                            </div>


                            <div class="member-view-item">
                                <span class="member-view-label">Role</span>

                                <strong class="member-view-value">
                                    @ViewBag.MemberRoles[Model.Id]
                                </strong>
                            </div>

                        </div>

                    </section>


                    <!-- PERSONAL -->
                    <section class="member-view-section">

                        <div class="member-view-section-header">

                            <h5>Personal Information</h5>

                        </div>

                        <div class="member-view-grid">

                            <div class="member-view-item">
                                <span class="member-view-label">First Name</span>

                                <strong class="member-view-value">
                                    @Model.FirstName
                                </strong>
                            </div>


                            <div class="member-view-item">
                                <span class="member-view-label">Middle Name</span>

                                <strong class="member-view-value">
                                    @(string.IsNullOrWhiteSpace(Model.MiddleName)
                                        ? "Not specified"
                                        : Model.MiddleName)
                                </strong>
                            </div>


                            <div class="member-view-item">
                                <span class="member-view-label">Last Name</span>

                                <strong class="member-view-value">
                                    @Model.LastName
                                </strong>
                            </div>


                            <div class="member-view-item">
                                <span class="member-view-label">Contact Number</span>

                                <strong class="member-view-value">
                                    @Model.ContactNumber
                                </strong>
                            </div>


                            <div class="member-view-item">
                                <span class="member-view-label">Gender</span>

                                <strong class="member-view-value">
                                    @(string.IsNullOrWhiteSpace(Model.Gender)
                                        ? "Not specified"
                                        : Model.Gender)
                                </strong>
                            </div>


                            <div class="member-view-item">
                                <span class="member-view-label">Birthdate</span>

                                <strong class="member-view-value">
                                    @(Model.Birthdate?.ToString("MMMM dd, yyyy")
                                        ?? "Not specified")
                                </strong>
                            </div>

                        </div>

                    </section>


                    <!-- ADDRESS -->
                    <section class="member-view-section">

                        <div class="member-view-section-header">

                            <h5>Address</h5>

                        </div>

                        <div class="member-view-grid">

                            <div class="member-view-item">
                                <span class="member-view-label">Province</span>

                                <strong class="member-view-value">
                                    @Model.Province
                                </strong>
                            </div>


                            <div class="member-view-item">
                                <span class="member-view-label">City</span>

                                <strong class="member-view-value">
                                    @Model.City
                                </strong>
                            </div>


                            <div class="member-view-item">
                                <span class="member-view-label">Barangay</span>

                                <strong class="member-view-value">
                                    @Model.Barangay
                                </strong>
                            </div>


                            <div class="member-view-item">
                                <span class="member-view-label">Street Address</span>

                                <strong class="member-view-value">
                                    @(string.IsNullOrWhiteSpace(Model.StreetAddress)
                                        ? "Not specified"
                                        : Model.StreetAddress)
                                </strong>
                            </div>

                        </div>

                    </section>

                </div>


                <!-- RIGHT SIDE -->
                <aside class="member-id-panel">

                    <div class="member-id-header">

                        <h5>Valid ID</h5>

                        <p>
                            Uploaded identification document.
                        </p>

                    </div>


                    <div class="member-id-preview">

                        @if (!string.IsNullOrWhiteSpace(Model.IdPhotoPath))
                        {
                            <img src="@Url.Content(Model.IdPhotoPath)"
                                 alt="Member Valid ID" />
                        }
                        else
                        {
                            <div class="member-id-empty">

                                <i data-lucide="image"></i>

                                <span>
                                    No Valid ID Preview
                                </span>

                            </div>
                        }

                    </div>

                </aside>

            </div>


            <!-- FOOTER -->
            <div class="crud-footer">

                <a asp-action="Index"
                   class="btn-cancel">

                    Back to Members

                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn-primary-action">

                    Edit Member

                </a>

            </div>

        </div>

    </div>

</div>