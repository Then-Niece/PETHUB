@model PETHUB.Models.ApplicationUser

@{
    ViewData["Title"] = "View Member";
}

<div class="container-fluid py-4">

    <div class="crud-page">

        <div class="crud-card">

            <div class="crud-header">

                <h2>View Member</h2>

                <p>
                    View the member information below.
                </p>

            </div>

            <div class="crud-content">

                <!-- ==========================
                     LEFT SIDE
                =========================== -->

                <div class="form-grid">

                    <!-- Username -->
                    <div class="form-group">

                        <label>Username</label>

                        <input class="form-control custom-input readonly-input"
                               value="@Model.UserName"
                               readonly />

                    </div>

                    <!-- Email -->
                    <div class="form-group">

                        <label>Email</label>

                        <input class="form-control custom-input readonly-input"
                               value="@Model.Email"
                               readonly />

                    </div>

                    <!-- First Name -->
                    <div class="form-group">

                        <label>First Name</label>

                        <input class="form-control custom-input readonly-input"
                               value="@Model.FirstName"
                               readonly />

                    </div>

                    <!-- Last Name -->
                    <div class="form-group">

                        <label>Last Name</label>

                        <input class="form-control custom-input readonly-input"
                               value="@Model.LastName"
                               readonly />

                    </div>

                    <!-- Contact -->
                    <div class="form-group">

                        <label>Contact Number</label>

                        <input class="form-control custom-input readonly-input"
                               value="@Model.ContactNumber"
                               readonly />

                    </div>

                    <!-- Gender -->
                    <div class="form-group">

                        <label>Gender</label>

                        <input class="form-control custom-input readonly-input"
                               value="@Model.Gender"
                               readonly />

                    </div>

                    <!-- Birthdate -->
                    <div class="form-group">

                        <label>Birthdate</label>

                        <input class="form-control custom-input readonly-input"
                               value="@Model.Birthdate?.ToString("MMM dd, yyyy")"
                               readonly />

                    </div>

                    <!-- Status -->
                    <div class="form-group">

                        <label>Status</label>

                        <input class="form-control custom-input readonly-input"
                               value="@(Model.Status == UserStatus.Active ? "Active" : "Inactive")"
                               readonly />

                    </div>

                    <!-- Role -->
                    <div class="form-group">

                        <label>Role</label>

                        <input class="form-control custom-input readonly-input"
                               value="@ViewBag.MemberRoles[Model.Id]"
                               readonly />

                    </div>

                    <!-- Address -->
                    <div class="form-group full-width">

                        <label>Address</label>

                        <input class="form-control custom-input readonly-input"
                               value="@Model.Address"
                               readonly />

                    </div>

                </div>

                <!-- ==========================
                     RIGHT SIDE
                =========================== -->

                <div class="upload-panel">

                    <h5>Valid ID</h5>

                    <p class="upload-text">
                        Existing uploaded Valid ID.
                    </p>

                    <div class="upload-preview">

                        <!--
                            TODO:
                            Replace this placeholder with the
                            actual Valid ID image once the backend
                            property is available.
                        -->

                        <div class="upload-placeholder">

                            <i class="bi bi-card-image"></i>

                            <p>No Valid ID Preview</p>

                        </div>

                    </div>

                </div>

            </div>

            <div class="crud-footer">

                <a asp-action="Index"
                   class="btn-cancel">

                    Back to Members

                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn-primary-action">

                    Edit Member

                </a>

            </div>

        </div>

    </div>

</div>