@model PETHUB.ViewModels.MemberViewModel

@{
    ViewData["Title"] = "Create Member";
}

<div class="container-fluid py-4">

    <div class="crud-page">

        <div class="crud-card">

            <div class="crud-header">

                <h2>Create Member</h2>

                <p>
                    Register a new member by completing the information below.
                </p>

            </div>

            <form asp-action="Create" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>

                <div class="crud-content">

                    <!-- ==========================
                         LEFT SIDE
                    =========================== -->

                    <div class="member-form">

                        <div class="form-grid">

                            <!-- Username -->
                            <div class="form-group">

                                <label asp-for="UserName">
                                    Username
                                </label>

                                <input asp-for="UserName"
                                       class="form-control custom-input" />

                                <span asp-validation-for="UserName"
                                      class="text-danger"></span>

                            </div>

                            <!-- Email -->
                            <div class="form-group">

                                <label asp-for="Email">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       class="form-control custom-input" />

                                <span asp-validation-for="Email"
                                      class="text-danger"></span>

                            </div>

                            <!-- First Name -->
                            <div class="form-group">

                                <label asp-for="FirstName">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control custom-input" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>

                            </div>

                            <!-- Last Name -->
                            <div class="form-group">

                                <label asp-for="LastName">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control custom-input" />

                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>

                            </div>

                            <!-- Contact -->
                            <div class="form-group">

                                <label asp-for="ContactNumber">
                                    Contact Number
                                </label>

                                <input asp-for="ContactNumber"
                                       class="form-control custom-input" />

                                <span asp-validation-for="ContactNumber"
                                      class="text-danger"></span>

                            </div>

                            <!-- Gender -->
                            <div class="form-group">

                                <label>
                                    Gender
                                </label>

                                <div class="gender-group">

                                    <div class="form-check">

                                        <input asp-for="Gender"
                                               type="radio"
                                               value="Male"
                                               id="male"
                                               class="form-check-input" />

                                        <label for="male"
                                               class="form-check-label">

                                            Male

                                        </label>

                                    </div>

                                    <div class="form-check">

                                        <input asp-for="Gender"
                                               type="radio"
                                               value="Female"
                                               id="female"
                                               class="form-check-input" />

                                        <label for="female"
                                               class="form-check-label">

                                            Female

                                        </label>

                                    </div>

                                </div>

                                <span asp-validation-for="Gender"
                                      class="text-danger"></span>

                            </div>

                            <!-- Birthdate -->
                            <div class="form-group">

                                <label asp-for="Birthdate">
                                    Birth Date
                                </label>

                                <input asp-for="Birthdate"
                                       type="date"
                                       class="form-control custom-input" />

                                <span asp-validation-for="Birthdate"
                                      class="text-danger"></span>

                            </div>

                            <!-- Status -->
                            <div class="form-group">

                                <label>
                                    Status
                                </label>

                                <input asp-for="Status"
                                       readonly
                                       value="Active"
                                       class="form-control custom-input readonly-input" />

                            </div>

                            <!-- Password -->
                            <div class="form-group full-width">

                                <label asp-for="Password">
                                    Password
                                </label>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control custom-input" />

                                <span asp-validation-for="Password"
                                      class="text-danger"></span>

                            </div>

                            <!-- Address -->
                            <div class="form-group full-width">

                                <label asp-for="Address">
                                    Address
                                </label>

                                <input asp-for="Address"
                                       class="form-control custom-input" />

                                <span asp-validation-for="Address"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                    <!-- ==========================
                         RIGHT SIDE
                    =========================== -->

                    <div class="upload-panel">

                        <h5>
                            Valid ID
                        </h5>

                        <p class="upload-text">

                            Upload a clear image of the member's valid ID.

                        </p>

                        <div class="upload-preview">

                            <img id="idPhotoPreview"
                                 src="#"
                                 alt="Preview" />

                            <div class="upload-placeholder">

                                <i class="bi bi-card-image"></i>

                                <p>

                                    Image Preview

                                </p>

                            </div>

                        </div>

                        <label asp-for="IdPhoto"
                               class="upload-label">

                            Valid ID
                            <small>(Optional)</small>

                        </label>

                        <input asp-for="IdPhoto"
                               type="file"
                               class="form-control custom-input"
                               id="IdPhotoInput" />

                        <span asp-validation-for="IdPhoto"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="crud-footer">

                    <a asp-action="Index"
                       class="btn-cancel">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn-primary-action">

                        Create Member

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $("#IdPhotoInput").on("change", function() {

            var file = this.files[0];

            if (file) {

                var validTypes = ["image/jpeg", "image/png", "image/jpg"];

                if ($.inArray(file.type, validTypes) < 0) {

                    alert("Only JPG and PNG files are allowed.");

                    $(this).val("");

                    return;
                }

                if (file.size > 2 * 1024 * 1024) {

                    alert("File size must be less than 2MB.");

                    $(this).val("");

                    return;
                }

                var reader = new FileReader();

                reader.onload = function(e) {

                    $("#idPhotoPreview")
                        .attr("src", e.target.result)
                        .show();

                };

                reader.readAsDataURL(file);
            }

        });

    </script>

}