@model PETHUB.ViewModels.MemberViewModel

@{
    ViewData["Title"] = "Create Member";

    ViewData["Province"] = "";
    ViewData["City"] = "";
    ViewData["Barangay"] = "";
    ViewData["StreetAddress"] = "";
}

<div class="container-fluid py-4">

    <div class="crud-page create-member-page">

        <div class="crud-card">

            <!-- =====================================================
                 HEADER
            ====================================================== -->

            <div class="crud-header">

                <h2>Create Member</h2>

                <p>
                    Register a new member by completing the information below.
                </p>

            </div>


            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>


                <div class="crud-content">

                    <!-- =================================================
                         LEFT SIDE
                    ================================================== -->

                    <div class="member-form">

                        <div class="form-grid">


                            <!-- Username -->
                            <div class="form-group">

                                <label asp-for="UserName">
                                    Username
                                </label>

                                <input asp-for="UserName"
                                       class="form-control custom-input" />

                                <span asp-validation-for="UserName"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Email -->
                            <div class="form-group">

                                <label asp-for="Email">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       class="form-control custom-input" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- First Name -->
                            <div class="form-group">

                                <label asp-for="FirstName">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control custom-input" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Middle Name -->
                            <div class="form-group">

                                <label asp-for="MiddleName">
                                    Middle Name
                                </label>

                                <input asp-for="MiddleName"
                                       class="form-control custom-input"
                                       placeholder="Optional" />

                                <span asp-validation-for="MiddleName"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Last Name -->
                            <div class="form-group">

                                <label asp-for="LastName">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control custom-input" />

                                <span asp-validation-for="LastName"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Contact Number -->
                            <div class="form-group">

                                <label asp-for="ContactNumber">
                                    Contact Number
                                </label>

                                <input asp-for="ContactNumber"
                                       class="form-control custom-input"
                                       maxlength="11"
                                       inputmode="numeric"
                                       autocomplete="tel"
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '')" />

                                <span asp-validation-for="ContactNumber"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Gender -->
                            <div class="form-group full-width">

                                <label>
                                    Gender
                                </label>

                                <div class="gender-group">

                                    <div class="form-check">

                                        <input asp-for="Gender"
                                               type="radio"
                                               value="Male"
                                               id="male"
                                               class="form-check-input" />

                                        <label for="male"
                                               class="form-check-label">
                                            Male
                                        </label>

                                    </div>


                                    <div class="form-check">

                                        <input asp-for="Gender"
                                               type="radio"
                                               value="Female"
                                               id="female"
                                               class="form-check-input" />

                                        <label for="female"
                                               class="form-check-label">
                                            Female
                                        </label>

                                    </div>

                                </div>

                                <span asp-validation-for="Gender"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- =================================================
                                 BIRTHDATE
                            ================================================== -->

                            <div class="form-group full-width">

                                <partial name="Components/_DateFields"
                                         model='new PETHUB.ViewModels.DateFieldsViewModel
                                         {
                                             FieldName = "Birthdate",
                                             Label = "Birthdate",
                                             Value = Model?.Birthdate,
                                             AllowFuture = false,
                                             MinimumAge = 18
                                         }' />

                                <span asp-validation-for="Birthdate"
                                      class="text-danger">
                                </span>

                            </div>

                            <!-- Password -->
                            <div class="form-group full-width">

                                <label asp-for="Password">
                                    Password
                                </label>

                                <div class="member-password-field">

                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control custom-input member-password-input"
                                           id="memberPassword"
                                           autocomplete="new-password" />

                                    <button type="button"
                                            class="password-toggle member-password-toggle"
                                            data-password-target="memberPassword"
                                            aria-label="Show password">

                                        <i data-lucide="eye"></i>

                                    </button>

                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- =================================================
                                 ADDRESS
                            ================================================== -->

                            <div class="create-member-address full-width">

                                <div class="create-member-section-title">
                                    Address
                                </div>

                                <partial name="Components/_AddressFields" />

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         RIGHT SIDE - VALID ID
                    ================================================== -->

                    <div class="upload-panel create-member-id-panel">

                        <h5>
                            Valid ID
                        </h5>

                        <p class="upload-text">
                            Upload a clear image of the member's valid ID.
                        </p>


                        <div class="create-member-id-preview">

                            <div id="idPhotoPreview">
                            </div>

                            <div id="idPhotoPlaceholder"
                                 class="create-member-id-placeholder">

                                <i data-lucide="image"></i>

                                <span>
                                    Image Preview
                                </span>

                            </div>

                        </div>


                        <label class="upload-label">
                            Valid ID
                            <small>(Optional)</small>
                        </label>


                        <div class="create-member-file-field">

                            <input asp-for="IdPhoto"
                                   type="file"
                                   id="IdPhotoInput"
                                   class="create-member-file-input"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                            <label for="IdPhotoInput"
                                   class="create-member-file-button">

                                <i data-lucide="image-plus"></i>

                                Choose File

                            </label>

                            <span id="memberFileName"
                                  class="create-member-file-name">

                                No file chosen

                            </span>

                        </div>


                        <span asp-validation-for="IdPhoto"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- =====================================================
                     FOOTER
                ====================================================== -->

                <div class="crud-footer">

                    <a asp-action="Index"
                       class="btn-cancel">
                        Cancel
                    </a>


                    <button type="submit"
                            class="btn-primary-action">
                        Create Member
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/imagePreviewHelper.js"
            asp-append-version="true">
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // =====================================================
            // VALID ID PREVIEW
            // =====================================================

            setupImagePreview(
                "IdPhotoInput",
                "idPhotoPreview",
                {
                    multiple: false,
                    placeholderId: "idPhotoPlaceholder",
                    previewWidth: null,
                    previewHeight: null
                }
            );


            // =====================================================
            // FILE NAME
            // =====================================================

            const fileInput =
                document.getElementById("IdPhotoInput");

            const fileName =
                document.getElementById("memberFileName");


            if (fileInput && fileName) {

                fileInput.addEventListener(
                    "change",
                    function () {

                        fileName.textContent =
                            this.files &&
                            this.files.length > 0

                                ? this.files[0].name

                                : "No file chosen";

                    }
                );

            }

        });
    </script>

    <script src="~/js/address-helper.js"
            asp-append-version="true">
    </script>
}