@model PETHUB.ViewModels.MemberViewModel

@{
    ViewData["Title"] = "Create Member";
}

<div class="container-fluid py-4">

    <div class="crud-page">

        <div class="crud-card">

            <div class="crud-header">

                <h2>Create Member</h2>

                <p>
                    Register a new member by completing the information below.
                </p>

            </div>

            <form asp-action="Create" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>

                <div class="crud-content">

                    <!-- ==========================
                         LEFT SIDE
                    =========================== -->

                    <div class="member-form">

                        <div class="form-grid">

                            <!-- Username -->
                            <div class="form-group">

                                <label asp-for="UserName">
                                    Username
                                </label>

                                <input asp-for="UserName"
                                       class="form-control custom-input" />

                                <span asp-validation-for="UserName"
                                      class="text-danger"></span>

                            </div>

                            <!-- Email -->
                            <div class="form-group">

                                <label asp-for="Email">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       class="form-control custom-input" />

                                <span asp-validation-for="Email"
                                      class="text-danger"></span>

                            </div>

                            <!-- First Name -->
                            <div class="form-group">

                                <label asp-for="FirstName">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control custom-input" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>

                            </div>

                            <!-- Last Name -->
                            <div class="form-group">

                                <label asp-for="LastName">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control custom-input" />

                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>

                            </div>

                            <!-- Contact -->
                            <div class="form-group">

                                <label asp-for="ContactNumber">
                                    Contact Number
                                </label>

                                <input asp-for="ContactNumber"
                                       class="form-control custom-input" />

                                <span asp-validation-for="ContactNumber"
                                      class="text-danger"></span>

                            </div>

                            <!-- Gender -->
                            <div class="form-group">

                                <label>
                                    Gender
                                </label>

                                <div class="gender-group">

                                    <div class="form-check">

                                        <input asp-for="Gender"
                                               type="radio"
                                               value="Male"
                                               id="male"
                                               class="form-check-input" />

                                        <label for="male"
                                               class="form-check-label">

                                            Male

                                        </label>

                                    </div>

                                    <div class="form-check">

                                        <input asp-for="Gender"
                                               type="radio"
                                               value="Female"
                                               id="female"
                                               class="form-check-input" />

                                        <label for="female"
                                               class="form-check-label">

                                            Female

                                        </label>

                                    </div>

                                </div>

                                <span asp-validation-for="Gender"
                                      class="text-danger"></span>

                            </div>

                            <!-- Birthdate -->
                            <div class="form-group">

                                <label asp-for="Birthdate">
                                    Birth Date
                                </label>

                                <input asp-for="Birthdate"
                                       type="date"
                                       class="form-control custom-input" />

                                <span asp-validation-for="Birthdate"
                                      class="text-danger"></span>

                            </div>

                            <!-- Status -->
                            <div class="form-group">

                                <label>
                                    Status
                                </label>

                                <input asp-for="Status"
                                       readonly
                                       value="Active"
                                       class="form-control custom-input readonly-input" />

                            </div>

                            <!-- Password -->
                            <div class="form-group full-width">

                                <label asp-for="Password" class="form-label"></label>
                                <div class="input-group">

                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control custom-input" 
                                           id="memberPassword"/>

                                    <button type="button"
                                            class="password-toggle"
                                            data-password-target="memberPassword"
                                            aria-label="Show password">

                                            <i data-lucide="eye"></i>

                                    </button>

                                </div>
                                <span asp-validation-for="Password" class="text-danger"></span>

                            </div>

                            <!-- Address -->
                            <partial name="Components/_AddressFields" />

                        </div>

                    </div>

                    <!-- ==========================
                         RIGHT SIDE
                    =========================== -->

                    <div class="upload-panel">

                        <h5>
                            Valid ID
                        </h5>

                        <p class="upload-text">

                            Upload a clear image of the member's valid ID.

                        </p>

                        <div class="upload-preview">

                            <div id="idPhotoPreview"
                                 class="d-flex flex-wrap gap-2">
                            </div>

                            <div id="idPhotoPlaceholder" class="upload-placeholder">
                                <i class="bi bi-card-image"></i>

                                <p>
                                    Image Preview
                                </p>
                            </div>

                        </div>
                        <label asp-for="IdPhoto"
                               class="upload-label">

                            Valid ID
                            <small>(Optional)</small>

                        </label>

                        <input asp-for="IdPhoto"
                               type="file"
                               class="form-control custom-input"
                               id="IdPhotoInput" />

                        <span asp-validation-for="IdPhoto"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="crud-footer">

                    <a asp-action="Index"
                       class="btn-cancel">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn-primary-action">

                        Create Member

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/imagePreviewHelper.js"></script>

    <script>

        setupImagePreview("IdPhotoInput", "idPhotoPreview", {
        multiple: false,
        placeholderId: "idPhotoPlaceholder"
        });

    </script>
    <script src="~/js/address-helper.js"></script>
}