@model PETHUB.Models.LostFound

@{
    ViewData["Title"] = "Create Lost & Found Report";

    bool showReportForm = !ViewData.ModelState.IsValid;
}


<!-- =========================================================
     FORM 1 - CHOOSE REPORT TYPE
========================================================== -->

<div id="reportTypeSelection"
     class="container py-5"
     style="@(showReportForm ? "display:none;" : "")">

    <div class="lostfound-form-card">

        <div class="text-center mb-5">

            <h2>
                Create Lost & Found Report
            </h2>

            <p class="text-muted">
                Choose the type of report you want to create.
            </p>

        </div>


        <div class="row justify-content-center">

            <!-- =================================================
                 LOST PET
            ================================================== -->

            <div class="col-md-5 mb-3">

                <div class="listing-type-card"
                     onclick="showLostForm()">

                    <i data-lucide="search"></i>

                    <h5 class="mt-3">
                        Lost Pet
                    </h5>

                    <small>
                        Report a pet that has gone missing.
                    </small>

                </div>

            </div>


            <!-- =================================================
                 FOUND PET
            ================================================== -->

            <div class="col-md-5 mb-3">

                <div class="listing-type-card"
                     onclick="showFoundForm()">

                    <i data-lucide="heart-handshake"></i>

                    <h5 class="mt-3">
                        Found Pet
                    </h5>

                    <small>
                        Report a pet you have found.
                    </small>

                </div>

            </div>

        </div>

    </div>

</div>



<!-- =========================================================
     FORM 2 - ACTUAL REPORT FORM
========================================================== -->

<div id="reportForm"
     class="container py-5"
     style="@(showReportForm ? "" : "display:none;")">

    <div class="lostfound-form-card">


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="mb-4">

            <h2 id="reportFormTitle">
                Create Lost & Found Report
            </h2>

            <p id="reportFormSubtitle"
               class="text-muted mb-0">

                Provide the details of the lost or found pet.

            </p>

        </div>



        <!-- =====================================================
             ACTUAL FORM
        ====================================================== -->

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- =================================================
                 HIDDEN REPORT TYPE

                 Lost = 0
                 Found = 1
            ================================================== -->

            <input asp-for="Type"
                   type="hidden"
                   id="typeSelect" />


            <div class="row">


                <!-- =================================================
                     LEFT SIDE
                ================================================== -->

                <div class="col-lg-8">


                    <!-- =============================================
                         TITLE
                    ============================================== -->

                    <div class="mb-3">

                        <label asp-for="Title"
                               class="form-label">
                            Title
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Enter report title" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- =============================================
                         DESCRIPTION
                    ============================================== -->

                    <div class="mb-4">

                        <label asp-for="Description"
                               class="form-label">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describe the pet and provide any important details..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- =============================================
                         LOST DATE
                    ============================================== -->

                    <div class="mb-4"
                         id="lostDateGroup"
                         style="display:none;">

                        <label asp-for="LostDate"
                               class="form-label">
                            Lost Date
                        </label>

                        <input asp-for="LostDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="LostDate"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- =============================================
                         PET TYPE
                    ============================================== -->

                    <div class="mb-4">

                        <label class="form-label">
                            Pet Type
                        </label>


                        <div class="lostfound-radio-group">

                            @foreach (
                                PETHUB.Models.PetType petType
                                in Enum.GetValues(
                                    typeof(PETHUB.Models.PetType)
                                )
                            )
                            {
                                <label class="lostfound-radio-option">

                                    <input type="radio"
                                           asp-for="PetType"
                                           value="@petType" />

                                    <span class="lostfound-radio-circle"></span>

                                    <span class="lostfound-radio-label">
                                        @petType
                                    </span>

                                </label>
                            }

                        </div>


                        <span asp-validation-for="PetType"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- =============================================
                         PET SEX
                    ============================================== -->

                    <div class="mb-4">

                        <label class="form-label">
                            Pet Sex
                        </label>


                        <div class="lostfound-radio-group">

                            @foreach (
                                PETHUB.Models.PetSex petSex
                                in Enum.GetValues(
                                    typeof(PETHUB.Models.PetSex)
                                )
                            )
                            {
                                <label class="lostfound-radio-option">

                                    <input type="radio"
                                           asp-for="Sex"
                                           value="@petSex" />

                                    <span class="lostfound-radio-circle"></span>

                                    <span class="lostfound-radio-label">
                                        @petSex
                                    </span>

                                </label>
                            }

                        </div>


                        <span asp-validation-for="Sex"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- =============================================
                         BREED
                    ============================================== -->

                    <div class="mb-4">

                        <label asp-for="Breed"
                               class="form-label">
                            Breed
                        </label>

                        <input asp-for="Breed"
                               class="form-control"
                               placeholder="Enter breed" />

                        <span asp-validation-for="Breed"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- =============================================
                         LOCATION
                    ============================================== -->

                    <div class="mb-4">


                        <partial name="Components/_AddressFields" />

                    </div>



                    <!-- =============================================
                         GUEST / CLIENT INFORMATION
                    ============================================== -->

                                        @if (User.Identity.IsAuthenticated)
                                        {
                                            <!-- Hide client fields for members -->
                                        }
                                        else
                                        {
                                            <div class="client-information-box">

                                                <h5 class="client-info-title">
                                                    Contact Information
                                                </h5>

                                                <p class="client-info-subtitle">
                                                    Please provide your contact information for this report.
                                                </p>


                                                <!-- CLIENT NAME -->

                                                <div class="mb-3">

                                                    <label asp-for="ClientName"
                                                           class="form-label">
                                                        Client Name
                                                    </label>

                                                    <input asp-for="ClientName"
                                                           class="form-control"
                                                           placeholder="Enter client name" />

                                                    <span asp-validation-for="ClientName"
                                                          class="text-danger">
                                                    </span>

                                                </div>


                                                <!-- CLIENT CONTACT -->

                                                <div class="mb-3">

                                                    <label asp-for="ClientContact"
                                                           class="form-label">
                                                        Client Contact
                                                    </label>

                                                    <input asp-for="ClientContact"
                                                           class="form-control"
                                                           placeholder="Enter client contact number" />

                                                    <span asp-validation-for="ClientContact"
                                                          class="text-danger">
                                                    </span>

                                                </div>


                                                <!-- GOVERNMENT ID -->

                                                <div class="mb-0">

                                                    <label class="form-label">
                                                        Upload a Valid Government ID
                                                    </label>

                                                    <input type="file"
                                                           name="ClientIdImage"
                                                           id="ClientIdImage"
                                                           class="form-control"
                                                           accept=".jpg,.jpeg,.png" />

                                                    <div id="idPhotoPreview"
                                                         class="d-flex flex-wrap gap-2 mt-2">
                                                    </div>

                                                </div>

                                            </div>
                                        }

                </div>



                <!-- =================================================
                     RIGHT SIDE - PHOTOS
                ================================================== -->

                <div class="col-lg-4">

                    <div class="photo-upload-card">

                        <h5>
                            Photos
                        </h5>


                        <div class="mb-3">

                            <label class="form-label">
                                Upload Images
                            </label>

                            <input type="file"
                                   id="imageInput"
                                   name="Images"
                                   multiple
                                   class="form-control"
                                   accept="image/*" />

                            <small class="text-muted">
                                You can upload multiple images.
                            </small>

                        </div>


                        <!-- IMAGE PREVIEW -->

                        <div id="imagePreviewContainer"
                             class="image-preview-grid">
                        </div>

                    </div>

                </div>

            </div>



            <!-- =====================================================
                 ACTIONS
            ====================================================== -->

            <hr />


            <div class="d-flex justify-content-end gap-2">

                <!-- Cancel returns to Form 1 -->

                <button type="button"
                        class="btn btn-outline-secondary"
                        onclick="cancelReport()">

                    Cancel

                </button>


                <button type="submit"
                        class="btn btn-success">

                    Submit Report

                </button>

            </div>

        </form>

    </div>

</div>



<!-- =========================================================
     REPORT TYPE JAVASCRIPT
========================================================== -->

<script>

    /*
     * Lost = 0
     * Found = 1
     */


    // =========================================================
    // LOST
    // =========================================================

    function showLostForm() {

        const selection =
            document.getElementById("reportTypeSelection");

        const form =
            document.getElementById("reportForm");

        const typeSelect =
            document.getElementById("typeSelect");

        const title =
            document.getElementById("reportFormTitle");

        const subtitle =
            document.getElementById("reportFormSubtitle");


        // Set Lost

        typeSelect.value = "0";


        // Change heading

        title.textContent =
            "Create Lost Report";


        // Change subtitle

        subtitle.textContent =
            "Report a lost pet and help reunite them with their owner.";


        // Switch to Form 2

        selection.style.display = "none";

        form.style.display = "block";


        // Show Lost Date

        toggleLostDate();


        // Reload Lucide icons

        if (typeof lucide !== "undefined") {

            lucide.createIcons();

        }

    }



    // =========================================================
    // FOUND
    // =========================================================

    function showFoundForm() {

        const selection =
            document.getElementById("reportTypeSelection");

        const form =
            document.getElementById("reportForm");

        const typeSelect =
            document.getElementById("typeSelect");

        const title =
            document.getElementById("reportFormTitle");

        const subtitle =
            document.getElementById("reportFormSubtitle");


        // Set Found

        typeSelect.value = "1";


        // Change heading

        title.textContent =
            "Create Found Report";


        // Change subtitle

        subtitle.textContent =
            "Report a found pet and help reunite them with their owner.";


        // Switch to Form 2

        selection.style.display = "none";

        form.style.display = "block";


        // Hide Lost Date

        toggleLostDate();


        // Reload Lucide icons

        if (typeof lucide !== "undefined") {

            lucide.createIcons();

        }

    }



    // =========================================================
    // CANCEL
    // Return to FORM 1
    // =========================================================

    function cancelReport() {

        const selection =
            document.getElementById("reportTypeSelection");

        const form =
            document.getElementById("reportForm");


        // Hide Form 2

        form.style.display = "none";


        // Show Form 1

        selection.style.display = "block";

    }



    // =========================================================
    // LOST DATE
    // =========================================================

    function toggleLostDate() {

        const typeSelect =
            document.getElementById("typeSelect");

        const lostDateGroup =
            document.getElementById("lostDateGroup");


        if (!typeSelect || !lostDateGroup) {

            return;

        }


        /*
         * Lost = 0
         * Found = 1
         */

        lostDateGroup.style.display =
            typeSelect.value === "0"
                ? "block"
                : "none";

    }



    // =========================================================
    // RESTORE FORM AFTER VALIDATION ERROR
    // =========================================================

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const typeSelect =
                document.getElementById("typeSelect");

            const title =
                document.getElementById("reportFormTitle");

            const subtitle =
                document.getElementById("reportFormSubtitle");


            if (!typeSelect) {

                return;

            }


            // Lost

            if (typeSelect.value === "0") {

                if (title) {

                    title.textContent =
                        "Create Lost Report";

                }

                if (subtitle) {

                    subtitle.textContent =
                        "Report a lost pet and help reunite them with their owner.";

                }

            }


            // Found

            else if (typeSelect.value === "1") {

                if (title) {

                    title.textContent =
                        "Create Found Report";

                }

                if (subtitle) {

                    subtitle.textContent =
                        "Report a found pet and help reunite them with their owner.";

                }

            }


            toggleLostDate();

        }
    );

</script>



@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }


    <!-- =========================================================
         IMAGE PREVIEW HELPER
    ========================================================== -->

    <script src="~/js/imagePreviewHelper.js"></script>


    <script>

        setupImagePreview(
            "imageInput",
            "imagePreviewContainer"
        );

    </script>


    <!-- =========================================================
         CLIENT ID PREVIEW
    ========================================================== -->

    <script>

        setupImagePreview(
            "ClientIdImage",
            "idPhotoPreview",
            {
                multiple: false
            }
        );

    </script>


    <!-- =========================================================
         ADDRESS HELPER
    ========================================================== -->

    <script src="~/js/address-helper.js"
            asp-append-version="true"></script>

}