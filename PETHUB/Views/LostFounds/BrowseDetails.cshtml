@model PETHUB.Models.LostFound

@{
    ViewData["Title"] = "Lost & Found Details";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/lostfound-details.css"
          asp-append-version="true" />
}

<div class="marketplace-details-page lostfound-marketplace-details">

    <div class="mb-3">
        <a asp-action="Browse"
           class="text-decoration-none">
            ← Back to Reports
        </a>
    </div>

    <div class="listing-details-layout">

        <!-- IMAGE GALLERY -->
        <div class="listing-gallery">

            @if (Model.Images != null && Model.Images.Any())
            {
                <div id="lostFoundCarousel"
                     class="carousel slide listing-main-image"
                     data-bs-ride="carousel">

                    <div class="carousel-inner">

                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            var img = Model.Images.ElementAt(i);

                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@img.ImagePath"
                                     class="d-block w-100"
                                     alt="Lost & Found Image @(i + 1)" />
                            </div>
                        }

                    </div>

                    <button class="carousel-control-prev"
                            type="button"
                            data-bs-target="#lostFoundCarousel"
                            data-bs-slide="prev">

                        <span class="carousel-control-prev-icon"></span>
                        <span class="visually-hidden">Previous</span>

                    </button>

                    <button class="carousel-control-next"
                            type="button"
                            data-bs-target="#lostFoundCarousel"
                            data-bs-slide="next">

                        <span class="carousel-control-next-icon"></span>
                        <span class="visually-hidden">Next</span>

                    </button>

                </div>

                <div class="listing-thumbnail-grid">

                    @for (int i = 0; i < Model.Images.Count; i++)
                    {
                        var img = Model.Images.ElementAt(i);

                        <button type="button"
                                class="listing-thumbnail lostfound-thumbnail @(i == 0 ? "active" : "")"
                                data-bs-target="#lostFoundCarousel"
                                data-bs-slide-to="@i"
                                aria-label="View image @(i + 1)">

                            <img src="@img.ImagePath"
                                 alt="Lost & Found Image @(i + 1)" />

                        </button>
                    }

                </div>
            }
            else
            {
                <div class="listing-no-image">
                    <span>No images uploaded for this report.</span>
                </div>
            }

        </div>


        <!-- INFORMATION -->
        <div class="listing-info-panel">

            <!-- PROFILE -->
            <div class="listing-profile">

                <div class="listing-profile-main">

                    <div class="listing-profile-avatar">

                        @if (Model.UserId == null)
                        {
                            <img src="~/images/default_profile.jpg"
                                 class="rounded-circle border"
                                 style="width:44px;height:44px;object-fit:cover;"
                                 alt="Client profile" />
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.User?.ProfilePicturePath))
                        {
                            <img src="@Model.User.ProfilePicturePath"
                                 class="rounded-circle border"
                                 style="width:44px;height:44px;object-fit:cover;"
                                 alt="Member profile" />
                        }
                        else
                        {
                            <img src="~/images/default_profile.jpg"
                                 class="rounded-circle border"
                                 style="width:44px;height:44px;object-fit:cover;"
                                 alt="Member profile" />
                        }

                    </div>

                    <div class="listing-profile-details">

                        <div class="listing-profile-name">
                            @if (Model.UserId == null)
                            {
                                @Model.ClientName
                            }
                            else
                            {
                                @($"{Model.User?.FirstName} {Model.User?.LastName}")
                            }
                        </div>

                        <div class="listing-profile-meta">

                            <span>
                                @Model.DateReported.ToString("MMMM dd, yyyy")
                            </span>

                            <span>·</span>

                            @if (Model.Type == LostFoundType.Found)
                            {
                                <span class="listing-type-pill lostfound-type-pill-found">
                                    Found Pet
                                </span>
                            }
                            else
                            {
                                <span class="listing-type-pill lostfound-type-pill-lost">
                                    Lost Pet
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- THREE DOT MENU -->
                <div class="listing-more-menu">

                    <button type="button"
                            class="listing-more-btn"
                            aria-label="More options"
                            onclick="this.parentElement.classList.toggle('show')">

                        <i data-lucide="more-horizontal"></i>

                    </button>

                    <div class="listing-more-dropdown">

                        <button type="button"
                                id="copyLostFoundLink">

                            <i data-lucide="link"></i>

                            <span id="copyLostFoundLinkText">
                                Copy Link
                            </span>

                        </button>

                        <div class="menu-divider"></div>

                                <!-- =================================================
                                     DIVIDER
                                ================================================= -->

                                <div class="lostfound-menu-divider"></div>


 <!-- =================================================
     REPORT LISTING
================================================= -->
@if (User.IsInRole("Member") &&
     Model.UserId != User.FindFirst(
         System.Security.Claims.ClaimTypes.NameIdentifier
     )?.Value)
{
    @if (string.IsNullOrEmpty(Model.UserId))
    {
        <!-- =================================================
             GUEST-OWNED POST
             Guest-created Lost & Found posts cannot be reported.
        ================================================== -->
        <button type="button"
                class="danger-action"
                onclick="alert('This post cannot be reported because it was posted by an unregistered user.');">

            <i data-lucide="flag"></i>

            <span>
                Report
            </span>

        </button>
    }
    else
    {
        <!-- =================================================
             REGISTERED-MEMBER POST
             Normal reporting workflow.
        ================================================== -->
        <button type="button"
                class="danger-action"
                data-bs-toggle="modal"
                data-bs-target="#reportModal"
                data-report-type="LostFound"
                data-report-id="@Model.LostFoundId"
                data-report-title="@Model.Title">

            <i data-lucide="flag"></i>

            <span>
                Report
            </span>

        </button>
    }
}

                    </div>

                </div>

            </div>


            <div class="listing-profile-divider"></div>


            <!-- TITLE -->
            <div class="listing-title-section">
                <h1>@Model.Title</h1>
            </div>


            <!-- ABOUT -->
            <section class="listing-info-section">

                <h3>About This Report</h3>

                <p class="listing-description">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description provided."
                        : Model.Description)
                </p>

            </section>


            <!-- PET INFORMATION -->
            <section class="listing-info-section">

                <h3>Pet Information</h3>

                <div class="listing-details-table">

                    <div class="listing-details-row">
                        <div class="listing-details-label">
                            <span>Pet Type</span>
                        </div>

                        <div class="listing-details-value">
                            @Model.PetType
                        </div>
                    </div>


                    <div class="listing-details-row">
                        <div class="listing-details-label">
                            <span>Breed</span>
                        </div>

                        <div class="listing-details-value">
                            @(string.IsNullOrWhiteSpace(Model.Breed)
                                ? "Not specified"
                                : Model.Breed)
                        </div>
                    </div>


                    <div class="listing-details-row">
                        <div class="listing-details-label">
                            <span>Sex</span>
                        </div>

                        <div class="listing-details-value">
                            @(Model.Sex.HasValue
                                ? Model.Sex.ToString()
                                : "Not specified")
                        </div>
                    </div>


                    @if (Model.Type != LostFoundType.Found)
                    {
                        <div class="listing-details-row">
                            <div class="listing-details-label">
                                <span>Lost Date</span>
                            </div>

                            <div class="listing-details-value">
                                @(Model.LostDate.HasValue
                                    ? Model.LostDate.Value.ToString("MMMM dd, yyyy")
                                    : "Not specified")
                            </div>
                        </div>
                    }

                </div>

            </section>


            <!-- LOCATION -->
            <section class="listing-info-section">

                <h3>
                    <i data-lucide="map-pin"></i>
                    Where To Find
                </h3>

                <div class="listing-details-table">

                    <div class="listing-details-row">
                        <div class="listing-details-label">
                            <span>Street Address</span>
                        </div>

                        <div class="listing-details-value">
                            @(string.IsNullOrWhiteSpace(Model.StreetAddress)
                                ? "Not specified"
                                : Model.StreetAddress)
                        </div>
                    </div>


                    <div class="listing-details-row">
                        <div class="listing-details-label">
                            <span>Barangay</span>
                        </div>

                        <div class="listing-details-value">
                            @(string.IsNullOrWhiteSpace(Model.Barangay)
                                ? "Not specified"
                                : Model.Barangay)
                        </div>
                    </div>


                    <div class="listing-details-row">
                        <div class="listing-details-label">
                            <span>City</span>
                        </div>

                        <div class="listing-details-value">
                            @(string.IsNullOrWhiteSpace(Model.City)
                                ? "Not specified"
                                : Model.City)
                        </div>
                    </div>


                    <div class="listing-details-row">
                        <div class="listing-details-label">
                            <span>Province</span>
                        </div>

                        <div class="listing-details-value">
                            @(string.IsNullOrWhiteSpace(Model.Province)
                                ? "Not specified"
                                : Model.Province)
                        </div>
                    </div>

                </div>

            </section>


            <!-- ACTIONS -->
            <div class="listing-actions">

                @if (User.Identity?.IsAuthenticated == true &&
                     User.IsInRole("Member") &&
                     !string.IsNullOrEmpty(Model.UserId) &&
                     Model.UserId != User.FindFirst(
                         System.Security.Claims.ClaimTypes.NameIdentifier
                     )?.Value)
                {
                    <form asp-controller="Messages"
                          asp-action="StartLostFoundConversation"
                          method="post"
                          class="listing-message-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="lostFoundId"
                               value="@Model.LostFoundId" />

                        <button type="submit"
                                class="btn listing-message-btn">

                            <i data-lucide="message-circle"></i>
                            <span>Message Me</span>

                        </button>

                    </form>
                }


                @if (User.IsInRole("Member"))
                {
                    <form class="lostfound-save-token-form"
                          style="display:none;">
                        @Html.AntiForgeryToken()
                    </form>

                    <button type="button"
                            class="btn listing-favorite-btn lostfound-favorite-button @(ViewBag.IsSaved == true ? "saved" : "")"
                            data-save-id="@Model.LostFoundId"
                            aria-label="@(ViewBag.IsSaved == true
                                ? "Remove from saved"
                                : "Add to favorites")">

                        <i data-lucide="heart"></i>

                    </button>
                }

            </div>

        </div>

    </div>

</div>


@section Scripts {

<script>
    document.addEventListener("DOMContentLoaded", function () {

        if (typeof lucide !== "undefined") {
            lucide.createIcons();
        }


        // =========================================================
        // MORE MENU
        // =========================================================

        const moreMenu =
            document.querySelector(".listing-more-menu");

        document.addEventListener("click", function (event) {

            if (!moreMenu) {
                return;
            }

            if (!event.target.closest(".listing-more-menu")) {
                moreMenu.classList.remove("show");
            }

        });


        // =========================================================
        // COPY LINK
        // =========================================================

        const copyLinkButton =
            document.getElementById("copyLostFoundLink");

        const copyLinkText =
            document.getElementById("copyLostFoundLinkText");

        if (copyLinkButton) {

            copyLinkButton.addEventListener("click", async function () {

                try {

                    await navigator.clipboard.writeText(
                        window.location.href
                    );

                    if (copyLinkText) {

                        copyLinkText.textContent =
                            "Link Copied!";

                        setTimeout(function () {

                            copyLinkText.textContent =
                                "Copy Link";

                        }, 1800);
                    }


                }
                catch (error) {

                    console.error(
                        "Unable to copy Lost & Found link:",
                        error
                    );

                }

            });

        }


        // =========================================================
        // FAVORITE
        // =========================================================

        const favoriteButton =
            document.querySelector(
                ".lostfound-favorite-button"
            );

        if (favoriteButton) {

            favoriteButton.addEventListener("click", async function () {

                if (favoriteButton.disabled) {
                    return;
                }

                const token =
                    document.querySelector(
                        '.lostfound-save-token-form input[name="__RequestVerificationToken"]'
                    )?.value;

                if (!token) {
                    console.error("Anti-forgery token not found.");
                    return;
                }

                const formData = new FormData();

                formData.append(
                    "id",
                    favoriteButton.dataset.saveId
                );

                formData.append(
                    "__RequestVerificationToken",
                    token
                );

                favoriteButton.disabled = true;

                try {

                    const response =
                        await fetch(
                            "/SavedItems/ToggleLostFound",
                            {
                                method: "POST",
                                body: formData
                            }
                        );

                    if (!response.ok) {
                        throw new Error(
                            "Unable to update favorite."
                        );
                    }

                    const result =
                        await response.json();

                    favoriteButton.classList.toggle(
                        "saved",
                        result.saved
                    );

                    favoriteButton.setAttribute(
                        "aria-label",
                        result.saved
                            ? "Remove from saved"
                            : "Add to favorites"
                    );

                }
                catch (error) {

                    console.error(
                        "Favorite error:",
                        error
                    );

                }
                finally {
                    favoriteButton.disabled = false;
                }

            });

        }


        // =========================================================
        // THUMBNAIL SYNC
        // =========================================================

        const carousel =
            document.getElementById("lostFoundCarousel");

        const thumbnails =
            document.querySelectorAll(
                ".lostfound-thumbnail"
            );

        if (carousel && thumbnails.length > 0) {

            carousel.addEventListener(
                "slid.bs.carousel",
                function (event) {

                    thumbnails.forEach(function (thumbnail) {
                        thumbnail.classList.remove("active");
                    });

                    const activeThumbnail =
                        thumbnails[event.to];

                    if (activeThumbnail) {
                        activeThumbnail.classList.add("active");
                    }

                }
            );

        }

    });
</script>

}
