@model PETHUB.Models.LostFound

@{
    ViewData["Title"] = "Lost & Found Details";
}

<div class="lostfound-details-page">

    <div class="container-fluid lostfound-details-container">

        <!-- =====================================================
             BACK TO REPORTS
        ===================================================== -->

        <div class="lostfound-back-top">

            <a asp-action="Browse"
               class="lostfound-back-button">

                <i data-lucide="arrow-left"></i>

                <span>Back to Reports</span>

            </a>

        </div>


        <div class="row lostfound-details-row">


            <!-- =====================================================
                 LEFT SIDE - IMAGE GALLERY
            ===================================================== -->

            <div class="col-lg-6 lostfound-left-column">

                @if (Model.Images != null && Model.Images.Any())
                {
                    <!-- =================================================
                         MAIN IMAGE CAROUSEL
                    ================================================= -->

                    <div id="lostFoundCarousel"
                         class="carousel slide lostfound-carousel"
                         data-bs-ride="false">

                        <div class="carousel-inner lostfound-carousel-inner">

                            @for (int i = 0; i < Model.Images.Count; i++)
                            {
                                var img = Model.Images.ElementAt(i);

                                <div class="carousel-item @(i == 0 ? "active" : "")">

                                    <img src="@img.ImagePath"
                                         class="d-block w-100 lostfound-main-image"
                                         alt="Lost & Found image @(i + 1)" />

                                </div>
                            }

                        </div>


                        <!-- =================================================
                             PREVIOUS ARROW
                        ================================================= -->

                        <button class="carousel-control-prev lostfound-carousel-button"
                                type="button"
                                data-bs-target="#lostFoundCarousel"
                                data-bs-slide="prev">

                            <i data-lucide="chevron-left"
                               class="lostfound-carousel-arrow"></i>

                            <span class="visually-hidden">
                                Previous
                            </span>

                        </button>


                        <!-- =================================================
                             NEXT ARROW
                        ================================================= -->

                        <button class="carousel-control-next lostfound-carousel-button"
                                type="button"
                                data-bs-target="#lostFoundCarousel"
                                data-bs-slide="next">

                            <i data-lucide="chevron-right"
                               class="lostfound-carousel-arrow"></i>

                            <span class="visually-hidden">
                                Next
                            </span>

                        </button>

                    </div>


                    <!-- =================================================
                         THUMBNAILS
                    ================================================= -->

                    <div class="lostfound-thumbnail-container">

                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            var img = Model.Images.ElementAt(i);

                            <button type="button"
                                    class="lostfound-thumbnail @(i == 0 ? "active" : "")"
                                    data-bs-target="#lostFoundCarousel"
                                    data-bs-slide-to="@i"
                                    aria-label="View image @(i + 1)">

                                <img src="@img.ImagePath"
                                     alt="Thumbnail @(i + 1)" />

                            </button>
                        }

                    </div>
                }
                else
                {
                    <!-- =================================================
                         NO IMAGE
                    ================================================= -->

                    <div class="lostfound-no-image">

                        <p class="text-muted mb-0">
                            No images uploaded for this report.
                        </p>

                    </div>
                }

            </div>



            <!-- =====================================================
                 RIGHT SIDE - DETAILS
            ===================================================== -->

            <div class="col-lg-6 lostfound-right-column">

                <div class="lostfound-details-scroll">


                    <!-- =================================================
                         REPORTER / DATE / LOST OR FOUND / THREE DOTS
                    ================================================= -->

                    <div class="lostfound-profile-section">


                        <!-- =================================================
                             PROFILE IMAGE
                        ================================================= -->

                        <div class="lostfound-profile-avatar">

                            @if (Model.UserId == null)
                            {
                                <img src="~/images/default_profile.jpg"
                                     alt="Client profile" />
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(Model.User?.ProfilePicturePath))
                                {
                                    <img src="@Model.User.ProfilePicturePath"
                                         alt="Member profile" />
                                }
                                else
                                {
                                    <img src="~/images/default_profile.jpg"
                                         alt="Member profile" />
                                }
                            }

                        </div>


                        <!-- =================================================
                             PROFILE DETAILS
                        ================================================= -->

                        <div class="lostfound-profile-details">

                            <!-- NAME -->
                            @if (Model.UserId == null)
                            {
                                <div class="lostfound-profile-name">
                                    @Model.ClientName
                                </div>
                            }
                            else
                            {
                                <div class="lostfound-profile-name">
                                    @Model.User?.FirstName @Model.User?.LastName
                                </div>
                            }


                            <!-- DATE + REPORT TYPE -->

                            <div class="lostfound-profile-meta">

                                <span class="lostfound-profile-date">
                                    @Model.DateReported.ToString("MMMM dd, yyyy")
                                </span>

                                <span class="lostfound-meta-dot">
                                    ·
                                </span>


                                @if (Model.Type == LostFoundType.Found)
                                {
                                    <span class="lostfound-type-badge found">
                                        Found Pet
                                    </span>
                                }
                                else
                                {
                                    <span class="lostfound-type-badge lost">
                                        Lost Pet
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- =================================================
                             THREE DOT MENU
                        ================================================= -->

                        <div class="lostfound-post-menu">

                            <!-- THREE DOT BUTTON -->

                            <button type="button"
                                    class="lostfound-post-menu-button"
                                    aria-label="More options"
                                    onclick="this.parentElement.classList.toggle('show')">

                                <i data-lucide="more-horizontal"></i>

                            </button>


                            <!-- =================================================
                                 DROPDOWN MENU
                            ================================================= -->

                            <div class="lostfound-post-dropdown">


                                <!-- =================================================
                                     COPY LINK
                                ================================================= -->

                                <button type="button"
                                        id="copyLostFoundLink">

                                    <i data-lucide="link"></i>

                                    <span id="copyLostFoundLinkText">
                                        Copy Link
                                    </span>

                                </button>


                                <!-- =================================================
                                     DIVIDER
                                ================================================= -->

                                <div class="lostfound-menu-divider"></div>


 <!-- =================================================
     REPORT LISTING
================================================= -->
@if (User.IsInRole("Member") &&
     Model.UserId != User.FindFirst(
         System.Security.Claims.ClaimTypes.NameIdentifier
     )?.Value)
{
    @if (string.IsNullOrEmpty(Model.UserId))
    {
        <!-- =================================================
             GUEST-OWNED POST
             Guest-created Lost & Found posts cannot be reported.
        ================================================== -->
        <button type="button"
                class="danger-action"
                onclick="alert('This post cannot be reported because it was posted by an unregistered user.');">

            <i data-lucide="flag"></i>

            <span>
                Report
            </span>

        </button>
    }
    else
    {
        <!-- =================================================
             REGISTERED-MEMBER POST
             Normal reporting workflow.
        ================================================== -->
        <button type="button"
                class="danger-action"
                data-bs-toggle="modal"
                data-bs-target="#reportModal"
                data-report-type="LostFound"
                data-report-id="@Model.LostFoundId"
                data-report-title="@Model.Title">

            <i data-lucide="flag"></i>

            <span>
                Report
            </span>

        </button>
    }
}

                            </div>

                        </div>

                    </div>



                    <!-- =================================================
                         DIVIDER
                    ================================================= -->

                    <div class="lostfound-divider"></div>



                    <!-- =================================================
                         TITLE
                    ================================================= -->

                    <h1 class="lostfound-title">
                        @Model.Title
                    </h1>



                    <!-- =================================================
                         ABOUT THIS REPORT
                    ================================================= -->

                    <div class="lostfound-about-section">

                        <div class="lostfound-about-content">

                            <h5 class="lost-found-section-title">
                                About This Report
                            </h5>


                            <div class="lostfound-description-wrapper">

                                <p class="lostfound-description">

                                    @(string.IsNullOrWhiteSpace(Model.Description)
                                        ? "No description provided."
                                        : Model.Description)

                                </p>

                            </div>

                        </div>

                    </div>



                    <!-- =================================================
                         PET INFORMATION
                    ================================================= -->

                    <div class="lostfound-information-section">

                        <h5 class="lost-found-section-title">
                            Pet Information
                        </h5>


                        <div class="lostfound-information-box">


                            <!-- PET TYPE -->

                            <div class="lostfound-information-row">

                                <span class="lostfound-information-label">
                                    Pet Type
                                </span>

                                <span class="lostfound-information-value">
                                    @Model.PetType
                                </span>

                            </div>


                            <!-- PET SEX -->

                            <div class="lostfound-information-row">

                                <span class="lostfound-information-label">
                                    Pet Sex
                                </span>

                                <span class="lostfound-information-value">

                                    @(Model.Sex.HasValue
                                        ? Model.Sex.ToString()
                                        : "Not specified")

                                </span>

                            </div>


                            <!-- BREED -->

                            <div class="lostfound-information-row">

                                <span class="lostfound-information-label">
                                    Breed
                                </span>

                                <span class="lostfound-information-value">

                                    @(string.IsNullOrEmpty(Model.Breed)
                                        ? "Not specified"
                                        : Model.Breed)

                                </span>

                            </div>


                            <!-- LOST DATE -->
                            @if (Model.Type == LostFoundType.Found)
                            {

                            }
                            else
                            {
                                <div class="lostfound-information-row">

                                    <span class="lostfound-information-label">
                                        Lost Date
                                    </span>

                                    <span class="lostfound-information-value">

                                        @(Model.LostDate.HasValue
                                            ? Model.LostDate.Value.ToString("MMMM dd, yyyy")
                                            : "Not specified")

                                    </span>

                                </div>
                            }

                        </div>

                    </div>



                    <!-- =================================================
                         WHERE TO FIND
                    ================================================= -->

                    <div class="lostfound-information-section">

                        <h5 class="lost-found-section-title">

                            <i data-lucide="map-pin"></i>

                            <span>
                                Where to Find
                            </span>

                        </h5>


                        <div class="lostfound-information-box">


                            <!-- STREET ADDRESS -->
                            @if (!string.IsNullOrWhiteSpace(Model.StreetAddress))
                            {
                                <div class="lostfound-information-row">

                                    <span class="lostfound-information-label">
                                        Street Address
                                    </span>

                                    <span class="lostfound-information-value">
                                        @Model.StreetAddress
                                    </span>

                                </div>
                            }


                            <!-- BARANGAY -->

                            <div class="lostfound-information-row">

                                <span class="lostfound-information-label">
                                    Barangay
                                </span>

                                <span class="lostfound-information-value">
                                    @Model.Barangay
                                </span>

                            </div>


                            <!-- CITY -->

                            <div class="lostfound-information-row">

                                <span class="lostfound-information-label">
                                    City
                                </span>

                                <span class="lostfound-information-value">
                                    @Model.City
                                </span>

                            </div>


                            <!-- PROVINCE -->

                            <div class="lostfound-information-row">

                                <span class="lostfound-information-label">
                                    Province
                                </span>

                                <span class="lostfound-information-value">
                                    @Model.Province
                                </span>

                            </div>

                        </div>

                    </div>



                    <!-- =================================================
                         MESSAGE REPORTER
                    ================================================= -->
                    @if (User.Identity?.IsAuthenticated == true &&
                                             User.IsInRole("Member") &&
                                             !string.IsNullOrEmpty(Model.UserId) &&
                                             Model.UserId != User.FindFirst(
                                                 System.Security.Claims.ClaimTypes.NameIdentifier
                                             )?.Value)
                    {
                        <div class="lostfound-message-section">

                            <form asp-controller="Messages"
                                  asp-action="StartLostFoundConversation"
                                  method="post"
                                  class="lostfound-message-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="lostFoundId"
                                       value="@Model.LostFoundId" />

                                <button type="submit"
                                        class="lostfound-message-button">

                                    <i data-lucide="message-circle"></i>

                                    <span>
                                        Message Me
                                    </span>

                                </button>

                            </form>

                        </div>
                    }


                </div>

            </div>

        </div>

    </div>

</div>



<!-- =========================================================
     LUCIDE + MENU + CAROUSEL THUMBNAIL SYNC
========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {


        /* ==================================================
           LUCIDE ICONS
        ================================================== */

        if (typeof lucide !== "undefined") {

            lucide.createIcons();

        }


        /* ==================================================
           THREE DOT MENU
        ================================================== */

        const moreMenu =
            document.querySelector(".lostfound-post-menu");


        const copyLinkButton =
            document.getElementById("copyLostFoundLink");


        const copyLinkText =
            document.getElementById("copyLostFoundLinkText");


        /* ==================================================
           CLOSE MENU WHEN CLICKING OUTSIDE
        ================================================== */

        document.addEventListener("click", function (event) {

            if (!moreMenu) {
                return;
            }


            if (!event.target.closest(".lostfound-post-menu")) {

                moreMenu.classList.remove("show");

            }

        });


        /* ==================================================
           COPY LOST & FOUND LINK
        ================================================== */

        if (copyLinkButton) {

            copyLinkButton.addEventListener(
                "click",
                async function () {

                    try {

                        await navigator.clipboard.writeText(
                            window.location.href
                        );


                        if (copyLinkText) {

                            copyLinkText.textContent =
                                "Link Copied!";


                            setTimeout(function () {

                                copyLinkText.textContent =
                                    "Copy Link";

                            }, 1800);

                        }


                        if (moreMenu) {

                            moreMenu.classList.remove("show");

                        }

                    }
                    catch (error) {

                        console.error(
                            "Unable to copy Lost & Found link:",
                            error
                        );

                    }

                }
            );

        }



        /* ==================================================
           THUMBNAIL SYNC WITH CAROUSEL
        ================================================== */

        const carousel =
            document.getElementById("lostFoundCarousel");


        const thumbnails =
            document.querySelectorAll(
                ".lostfound-thumbnail"
            );


        if (carousel && thumbnails.length > 0) {

            carousel.addEventListener(
                "slid.bs.carousel",
                function (event) {


                    thumbnails.forEach(function (thumbnail) {

                        thumbnail.classList.remove("active");

                    });


                    const activeThumbnail =
                        thumbnails[event.to];


                    if (activeThumbnail) {

                        activeThumbnail.classList.add("active");

                    }

                }
            );

        }

    });

</script>
