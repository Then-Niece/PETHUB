@model PETHUB.ViewModels.PaginationViewModel<PETHUB.Models.LostFound>
@using PETHUB.Helpers

@{
    ViewData["Title"] = "Lost & Found Reports";

    // Create the existing Lost & Found approval filters.
    var lostFoundApprovalFilters = PETHUB.Helpers.FilterBarHelper.Create(
        PETHUB.Helpers.FilterBarHelper.Status(
            Context.Request.Query["status"].ToString()
        ),
        PETHUB.Helpers.FilterBarHelper.LostFoundType(
            Context.Request.Query["lostFoundType"].ToString()
        ),
        PETHUB.Helpers.FilterBarHelper.PetType(
            Context.Request.Query["petType"].ToString()
        )
    );
}


<div class="admin-lost-found-page">


    <!-- ==========================================================
         PAGE HEADER
    ========================================================== -->

    <div class="admin-lost-found-header">

        <div class="admin-lost-found-header-text">

            <h1>
                Lost &amp; Found Approval
            </h1>

            <p>
                Review and manage lost and found reports
            </p>

        </div>

    </div>


    <!-- ==========================================================
         FILTERS + TOTAL COUNT
    ========================================================== -->

    <div class="admin-lost-found-filter-card">

        <div class="admin-lost-found-filters">

            @foreach (var filter in lostFoundApprovalFilters.Filters)
            {
                var selectedValue = filter.SelectedValue ?? filter.DefaultValue;

                <div class="admin-lost-found-filter"
                     data-filter-dropdown>

                    <span class="admin-lost-found-filter-label">
                        @filter.Label
                    </span>


                    <!-- FILTER BUTTON -->

                    <button type="button"
                            class="admin-lost-found-filter-button"
                            data-dropdown-button
                            aria-expanded="false">

                        <span>
                            @(filter.Options.FirstOrDefault(x => x.Value == selectedValue)?.Label
                                ?? filter.Options.FirstOrDefault()?.Label)
                        </span>

                        <i data-lucide="chevron-down"></i>

                    </button>


                    <!-- FILTER MENU -->

                    <div class="admin-lost-found-filter-menu"
                         data-dropdown-menu>

                        @foreach (var option in filter.Options)
                        {
                            var query = Context.Request.Query
                                .ToDictionary(
                                    item => item.Key,
                                    item => item.Value.ToString()
                                );

                            if (string.IsNullOrEmpty(option.Value))
                            {
                                query.Remove(filter.ParameterName);
                            }
                            else
                            {
                                query[filter.ParameterName] = option.Value;
                            }

                            var queryString = string.Join(
                                "&",
                                query.Select(
                                    item => $"{item.Key}={Uri.EscapeDataString(item.Value)}"
                                )
                            );

                            var baseUrl = Context.Request.Path.ToString();

                            var optionUrl = string.IsNullOrEmpty(queryString)
                                ? baseUrl
                                : $"{baseUrl}?{queryString}";

                            var isSelected = option.Value == selectedValue;

                            <a href="@optionUrl"
                               class="admin-lost-found-filter-option @(isSelected ? "selected" : "")">

                                @option.Label

                            </a>
                        }

                    </div>

                </div>
            }

        </div>


        <!-- TOTAL COUNT -->

        <span class="admin-lost-found-total">

            @Model.TotalItems
            @(Model.TotalItems == 1 ? "post" : "posts")

        </span>

    </div>


    <!-- ==========================================================
         LOST & FOUND RESULTS
    ========================================================== -->

    <div class="admin-lost-found-posts">

        @foreach (var item in Model.Items)
        {

            <!-- ==================================================
                 CLICKABLE LOST & FOUND CARD
            ================================================== -->

            <a asp-action="Details"
               asp-route-id="@item.LostFoundId"
               class="admin-lost-found-card">


                <!-- ==================================================
                     REPORT IMAGE
                ================================================== -->

                <div class="admin-lost-found-image-container">

                    @if (item.Images != null &&
                         item.Images.Any())
                    {
                        <img src="@Url.Content(item.Images.First().ImagePath)"
                             class="admin-lost-found-image"
                             alt="Pet image" />
                    }
                    else
                    {
                        <img src="@Url.Content("~/images/no-image.png")"
                             class="admin-lost-found-image"
                             alt="No image" />
                    }

                </div>


                <!-- ==================================================
                     REPORT INFORMATION
                ================================================== -->

                <div class="admin-lost-found-content">

                    <h3 class="admin-lost-found-title">
                        @item.Title
                    </h3>


                    <p class="admin-lost-found-date">

                        Created @item.DateReported.ToString("MMM dd, yyyy")

                    </p>


                    <p class="admin-lost-found-location">

                        @(string.IsNullOrEmpty(item.City)
                            ? "No location"
                            : item.City + ", " + item.Province)

                    </p>

                </div>


                <!-- ==================================================
                     APPROVAL STATUS
                ================================================== -->

                <div class="admin-lost-found-actions">

                    @if (item.Status == ApprovalStatus.Pending)
                    {
                        <span class="admin-lost-found-status admin-lost-found-status-pending">

                            Pending

                        </span>
                    }
                    else if (item.Status == ApprovalStatus.Approved)
                    {
                        <span class="admin-lost-found-status admin-lost-found-status-approved">

                            Approved

                        </span>
                    }
                    else
                    {
                        <span class="admin-lost-found-status admin-lost-found-status-rejected">

                            Rejected

                        </span>
                    }

                </div>


            </a>

        }

    </div>


    <partial name="_Pagination" model="Model" />

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            if (typeof lucide !== "undefined") {
                lucide.createIcons();
            }

        });

    </script>

}