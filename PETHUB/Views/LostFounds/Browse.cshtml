@model IEnumerable<PETHUB.Models.LostFound>

@{
    ViewData["Title"] = "Lost & Found Reports";
}


<h1 style="text-align: center;">Lost & Found </h1>

<!-- Add Report Button -->
<!-- Ony the member and client can add lost and found reports -->
@if (User.IsInRole("Member"))
{
    <a asp-controller="LostFounds"
       asp-action="Create"
       class="btn  btn-lg rounded-pill" style="background-color:#8ACE79; color:white;">
        Add Report
    </a>
}
else if (User.IsInRole("Admin"))
{
    //Admin Cannot add a Marketplace Listing
}
else
{
    <button type="button"
            class="btn btn-lg rounded-pill"
            style="color:white; background-color:#8ACE79;"
            data-bs-toggle="modal"
            data-bs-target="#guestActionModal">
        Add Report
    </button>
}

<div class="row mt-4">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <a asp-action="BrowseDetails" asp-route-id="@item.LostFoundId">
                <div class="card h-100 shadow-sm">

                    @if (item.Images != null && item.Images.Any())
                    {
                        <img src="@Url.Content(item.Images.First().ImagePath)"
                             class="card-img-top"
                             alt="LostFound image"
                             style="height:200px;object-fit:cover;">
                    }
                    else
                    {
                        <img src="@Url.Content("~/images/no-image.png")"
                             class="card-img-top"
                             alt="No image"
                             style="height:200px;object-fit:cover;">
                    }

                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>

                        <p class="card-text text-muted">
                            @item.Description
                        </p>

                        <p>
                            <strong>Type:</strong> @item.Type
                        </p>

                        <p>
                            <small>
                                Reported @item.DateReported.ToString("MMM dd, yyyy")
                            </small>
                        </p>

                        <p>
                            <small class="text-muted">
                                Location:
                                @(string.IsNullOrEmpty(item.Location)
                                    ? "Not specified"
                                    : item.Location)
                            </small>
                        </p>

                    </div>

                </div>
            </a>
        </div>
    }
</div>

<!-- Guest Modal -->
<div class="modal fade"
     id="guestActionModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-body text-center p-5">

                <img src="~/images/PETHUB-LOGO.png"
                     asp-append-version="true"
                     style="width:80px;"
                     class="mb-4"
                     alt="PetHub Logo" />

                <span class="badge rounded-pill px-3 py-2 mb-3"
                      style="background:#EAF8E6;color:#4F8D42;">

                    MEMBERS ONLY

                </span>

                <h3 class="fw-bold mb-3"
                    style="color:#2D3748;">

                    Join the PetHub Community

                </h3>

                <p class="text-muted mb-4"
                   style="line-height:1.8;">

                    Creating listings and submitting reports are exclusive
                    to registered members. Create a free account or sign in
                    to continue.

                </p>

                <div class="d-grid gap-3">

                    <a asp-controller="UserAccount"
                       asp-action="Register"
                       class="btn btn-lg text-white rounded-pill"
                       style="background:#8ACE79;">

                        Become a Member

                    </a>

                    <a asp-controller="LostFounds"
                       asp-action="Create"
                       class="btn btn-light rounded-pill">

                        Continue as Guest

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>