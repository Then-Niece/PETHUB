@model PETHUB.ViewModels.PaginationViewModel<PETHUB.Models.LostFound>

@{
    ViewData["Title"] = "Lost & Found Reports";

    // =========================================================
    // LOST & FOUND FILTERS
    // =========================================================

    var lostFoundFilters = PETHUB.Helpers.FilterBarHelper.Create(
        PETHUB.Helpers.FilterBarHelper.LostFoundType(
            Context.Request.Query["lostFoundType"].ToString()
        ),
        PETHUB.Helpers.FilterBarHelper.PetType(
            Context.Request.Query["petType"].ToString()
        )
    );


    // =========================================================
    // LOST & FOUND REPORT COUNT
    // =========================================================

    var reportCount = Model.TotalItems;

    var selectedPetType =
        Context.Request.Query["petType"].ToString();


    // =========================================================
    // COUNT LABEL
    // =========================================================

    var countLabel = "Reports";

    if (!string.IsNullOrEmpty(selectedPetType))
    {
        if (selectedPetType.Equals(
                "dog",
                StringComparison.OrdinalIgnoreCase) ||
            selectedPetType.Equals(
                "dogs",
                StringComparison.OrdinalIgnoreCase))
        {
            countLabel = "Dogs";
        }
        else if (selectedPetType.Equals(
                     "cat",
                     StringComparison.OrdinalIgnoreCase) ||
                 selectedPetType.Equals(
                     "cats",
                     StringComparison.OrdinalIgnoreCase))
        {
            countLabel = "Cats";
        }
        else
        {
            countLabel = selectedPetType;
        }
    }
}



<!-- =========================================================
     LOST & FOUND HERO
========================================================== -->

<section class="lost-found-hero"
         style="background-image: url('@Url.Content("~/images/banner_hero.jpg")');">

    <div class="lost-found-hero-overlay"></div>

    <div class="lost-found-hero-content">

        <h1 class="lost-found-hero-title">
            Help Bring Pets Home
        </h1>

        <p class="lost-found-hero-description">
            Help reunite lost pets with their families
            and give found pets a chance to return home.
        </p>

    </div>

</section>



<!-- =========================================================
     LOST & FOUND FILTER
========================================================== -->

<div class="lost-found-filter-container">

    <div class="lost-found-filter-bar">


        <!-- =====================================================
             FILTER LABEL
        ====================================================== -->

        <div class="lost-found-filter-label">

            <i data-lucide="sliders-horizontal"></i>

            <span>
                Filters
            </span>

        </div>



        <!-- =====================================================
             FILTER CONTROLS
        ====================================================== -->

        <div class="lost-found-filter-controls">

            @foreach (var filter in lostFoundFilters.Filters)
            {
                var selectedValue =
                    filter.SelectedValue ?? filter.DefaultValue;


                var filterIcon =
                    filter.ParameterName == "lostFoundType"
                        ? "search"
                        : "paw-print";


                // =================================================
                // BUILD OPTION URLS
                // =================================================

                var filterOptions = new List<dynamic>();

                foreach (var option in filter.Options)
                {
                    var query = Context.Request.Query
                        .ToDictionary(
                            item => item.Key,
                            item => item.Value.ToString()
                        );


                    if (string.IsNullOrEmpty(option.Value))
                    {
                        query.Remove(filter.ParameterName);
                    }
                    else
                    {
                        query[filter.ParameterName] = option.Value;
                    }


                    var queryString = string.Join(
                        "&",
                        query.Select(
                            item =>
                                $"{item.Key}={Uri.EscapeDataString(item.Value)}"
                        )
                    );


                    var baseUrl =
                        Context.Request.Path.ToString();


                    var optionUrl =
                        string.IsNullOrEmpty(queryString)
                            ? baseUrl
                            : $"{baseUrl}?{queryString}";


                    var isSelected =
                        option.Value == selectedValue;


                    filterOptions.Add(new
                    {
                        Label = option.Label,
                        Value = option.Value,
                        Url = optionUrl,
                        IsSelected = isSelected
                    });
                }



                // =================================================
                // CURRENT DISPLAY LABEL
                // =================================================

                var selectedOption =
                    filterOptions.FirstOrDefault(
                        x => x.IsSelected
                    );


                var displayLabel =
                    selectedOption?.Label;


                if (string.IsNullOrEmpty(selectedValue))
                {
                    displayLabel =
                        filter.ParameterName == "lostFoundType"
                            ? "All Reports"
                            : "All Pets";
                }


                if (string.IsNullOrEmpty(displayLabel))
                {
                    displayLabel =
                        filter.ParameterName == "lostFoundType"
                            ? "All Reports"
                            : "All Pets";
                }



                <!-- =================================================
                     DROPDOWN
                ================================================== -->

                <div class="lost-found-filter-item lost-found-dropdown"
                     data-filter-dropdown>


                    <!-- DROPDOWN BUTTON -->

                    <button type="button"
                            class="lost-found-dropdown-button"
                            data-dropdown-button
                            aria-haspopup="true"
                            aria-expanded="false">

                        <span class="lost-found-dropdown-button-content">

                            <i data-lucide="@filterIcon"
                               class="lost-found-filter-select-icon"></i>

                            <span class="lost-found-dropdown-current">
                                @displayLabel
                            </span>

                        </span>

                        <i data-lucide="chevron-down"
                           class="lost-found-dropdown-chevron"></i>

                    </button>



                    <!-- =================================================
                         DROPDOWN MENU
                    ================================================== -->

                    <div class="lost-found-dropdown-menu"
                         data-dropdown-menu
                         role="menu">

                        @foreach (var option in filterOptions)
                        {
                            <a href="@option.Url"
                               class="lost-found-dropdown-item @(option.IsSelected ? "active" : "")"
                               role="menuitem">

                                <span class="lost-found-dropdown-item-content">

                                    <span>

                                        @if (filter.ParameterName == "lostFoundType" &&
                                             string.IsNullOrEmpty(option.Value))
                                        {
                                            @:All Reports
                                        }
                                        else if (filter.ParameterName == "petType" &&
                                                 string.IsNullOrEmpty(option.Value))
                                        {
                                            @:All Pets
                                        }
                                        else
                                        {
                                            @option.Label
                                        }

                                    </span>

                                </span>

                            </a>
                        }

                    </div>

                </div>
            }

        </div>



        <!-- =====================================================
             REPORT COUNT
        ====================================================== -->

        <div class="lost-found-filter-count">

            <strong>
                @reportCount
            </strong>

            <span>
                @countLabel
            </span>

        </div>

    </div>

</div>



