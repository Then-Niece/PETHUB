<!-- =========================================================
     GUEST MODAL

KEPT AS YOUR ORIGINAL.
========================================================== -->

<div class="modal fade"
     id="guestActionModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-body text-center p-5">

                <img src="~/images/PETHUB-LOGO.png"
                     asp-append-version="true"
                     style="width:80px;"
                     class="mb-4"
                     alt="PetHub Logo" />

                <span class="badge rounded-pill px-3 py-2 mb-3"
                      style="background:#EAF8E6;color:#4F8D42;">

                    MEMBERS ONLY

                </span>

                <h3 class="fw-bold mb-3"
                    style="color:#2D3748;">

                    Join the PetHub Community

                </h3>

                <p class="text-muted mb-4"
                   style="line-height:1.8;">

                    Creating listings and submitting reports are exclusive
                    to registered members. Create a free account or sign in
                    to continue.

                </p>

                <div class="d-grid gap-3">

                    <a asp-controller="UserAccount"
                       asp-action="Register"
                       class="btn btn-lg text-white rounded-pill"
                       style="background:#8ACE79;">

                        Become a Member

                    </a>

                    <a asp-controller="LostFounds"
                       asp-action="Create"
                       class="btn btn-light rounded-pill">

                        Continue as Guest

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>



@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /*
             * Lucide icon initialization.
             *
             * The reusable dropdown JavaScript continues
             * to handle the filter dropdown behavior.
             */

            if (typeof lucide !== "undefined") {

                lucide.createIcons();

            }

        });

    </script>

}