@model IEnumerable<PETHUB.Models.LostFound>

@{
    ViewData["Title"] = "Lost & Found Reports";
    // Create a filter bar containing the Lost/Found report-type filter.
    // Request.Query preserves the currently selected value after reload.
    var lostFoundFilters = PETHUB.Helpers.FilterBarHelper.Create(
        PETHUB.Helpers.FilterBarHelper.LostFoundType(
            Context.Request.Query["lostFoundType"].ToString()
        ),
        PETHUB.Helpers.FilterBarHelper.PetType(
               Context.Request.Query["petType"].ToString()
           )
        );
}

@* Render the reusable Lost/Found filter. *@
<partial name="Components/_FilterBar"
         model="lostFoundFilters" />

<!-- Add Report Button -->
<!-- Only the member and client can add lost and found reports -->
@if (User.IsInRole("Member"))
{
    <a asp-controller="LostFounds"
       asp-action="Create"
       class="btn  btn-lg rounded-pill" style="background-color:#8ACE79; color:white;">
        Add Report
    </a>
}
else if (User.IsInRole("Admin"))
{
    //Admin Cannot add a Marketplace Listing
}
else
{
    <button type="button"
            class="btn btn-lg rounded-pill"
            style="color:white; background-color:#8ACE79;"
            data-bs-toggle="modal"
            data-bs-target="#guestActionModal">
        Add Report
    </button>
}


<div class="row mt-4">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">

            <!-- The card contains both the navigation link and the Report button.
                 Keeping the button outside the link prevents the two interactive
                 elements from interfering with each other. -->
            <div class="card h-100 shadow-sm position-relative">

                <!-- Makes the normal card area navigate to BrowseDetails.
                     Bootstrap's stretched-link allows the card to behave like
                     a clickable card while keeping the Report button independent. -->
                <a asp-action="BrowseDetails"
                   asp-route-id="@item.LostFoundId"
                   class="stretched-link text-decoration-none text-dark">

                    @if (item.Images != null && item.Images.Any())
                    {
                        <img src="@Url.Content(item.Images.First().ImagePath)"
                             class="card-img-top"
                             alt="LostFound image"
                             style="height:200px;object-fit:cover;">
                    }
                    else
                    {
                        <img src="@Url.Content("~/images/no-image.png")"
                             class="card-img-top"
                             alt="No image"
                             style="height:200px;object-fit:cover;">
                    }

                    <div class="card-body">

                        <h5 class="card-title">
                            @item.Title
                        </h5>

                        <p class="card-text text-muted">
                            @item.Description
                        </p>

                        <p>
                            <strong>Type:</strong> @item.Type
                        </p>

                        <p>
                            <small>
                                Reported @item.DateReported.ToString("MMM dd, yyyy")
                            </small>
                        </p>

                        <p>
                            <small class="text-muted">
                                Location:
                                @(string.IsNullOrEmpty(item.City)
                                    ? "Not specified"
                                    : item.City + ", " + item.Province)
                            </small>
                        </p>

                    </div>

                </a>

                @if (User.IsInRole("Member") &&
                     !string.IsNullOrEmpty(item.UserId) &&
                     item.UserId != User.FindFirst(
                         System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                {
                    <!-- Only registered-member Lost & Found posts can be reported.
                         The owner cannot report their own post, and posts created
                         by unregistered clients have no UserId. -->
                    <button type="button"
                            class="btn btn-sm btn-light shadow-sm report-card-button position-absolute top-0 end-0 m-2"
                            style="z-index:2;"
                            data-bs-toggle="modal"
                            data-bs-target="#reportModal"
                            data-report-type="LostFound"
                            data-report-id="@item.LostFoundId"
                            data-report-title="@item.Title"
                            aria-label="Report @item.Title">

                        <i data-lucide="flag"></i>

                    </button>
                }

            </div>

        </div>
    }
</div>

<!-- Guest Modal -->
<div class="modal fade"
     id="guestActionModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-body text-center p-5">

                <img src="~/images/PETHUB-LOGO.png"
                     asp-append-version="true"
                     style="width:80px;"
                     class="mb-4"
                     alt="PetHub Logo" />

                <span class="badge rounded-pill px-3 py-2 mb-3"
                      style="background:#EAF8E6;color:#4F8D42;">

                    MEMBERS ONLY

                </span>

                <h3 class="fw-bold mb-3"
                    style="color:#2D3748;">

                    Join the PetHub Community

                </h3>

                <p class="text-muted mb-4"
                   style="line-height:1.8;">

                    Creating listings and submitting reports are exclusive
                    to registered members. Create a free account or sign in
                    to continue.

                </p>

                <div class="d-grid gap-3">

                    <a asp-controller="UserAccount"
                       asp-action="Register"
                       class="btn btn-lg text-white rounded-pill"
                       style="background:#8ACE79;">

                        Become a Member

                    </a>

                    <a asp-controller="LostFounds"
                       asp-action="Create"
                       class="btn btn-light rounded-pill">

                        Continue as Guest

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>