@model IEnumerable<PETHUB.Models.LostFound>

@{
    ViewData["Title"] = "Lost & Found Reports";
}

<h1 style="text-align: center;">Lost & Found </h1>

<!-- Add Report Button -->
<!-- Ony the member and client can add lost and found reports -->
@if (User.IsInRole("Member"))
{
    <a asp-controller="LostFounds"
       asp-action="Create"
       class="btn  btn-lg rounded-pill" style="background-color:#8ACE79; color:white;">
        Add Report
    </a>
}
else if (User.IsInRole("Admin"))
{
    //Admin Cannot add a Marketplace Listing
}
else
{
    <button type="button"
            class="btn btn-lg rounded-pill"
            style="color:white; background-color:#8ACE79;"
            data-bs-toggle="modal"
            data-bs-target="#reportModal">
        Add Report
    </button>
}

<div class="row mt-4">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <a asp-action="BrowseDetails" asp-route-id="@item.LostFoundId">
                <div class="card h-100 shadow-sm">

                    @if (item.Images != null && item.Images.Any())
                    {
                        <img src="@Url.Content(item.Images.First().ImagePath)"
                             class="card-img-top"
                             alt="LostFound image"
                             style="height:200px;object-fit:cover;">
                    }
                    else
                    {
                        <img src="@Url.Content("~/images/no-image.png")"
                             class="card-img-top"
                             alt="No image"
                             style="height:200px;object-fit:cover;">
                    }

                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>

                        <p class="card-text text-muted">
                            @item.Description
                        </p>

                        <p>
                            <strong>Type:</strong> @item.Type
                        </p>

                        <p>
                            <small>
                                Reported @item.DateReported.ToString("MMM dd, yyyy")
                            </small>
                        </p>

                        <p>
                            <small class="text-muted">
                                Location:
                                @(string.IsNullOrEmpty(item.Location)
                                    ? "Not specified"
                                    : item.Location)
                            </small>
                        </p>

                    </div>

                </div>
            </a>
        </div>
    }
</div>

<!-- Guest Modal -->
<div class="modal fade"
     id="reportModal"
     tabindex="-1"
     aria-labelledby="reportModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content text-center p-4">

            <h4 class="mb-4">
                You need to be a member to access all reporting features.
            </h4>

            <div class="d-grid gap-3">

                <!-- Continue as Guest -->
                <a asp-controller="LostFounds"
                   asp-action="Create"
                   class="btn btn-lg btn-outline-primary">
                    Continue as Guest
                </a>

                <!-- Become Member -->
                <a asp-controller="UserAccount"
                   asp-action="Register"
                   class="btn btn-lg btn-success">
                    Become a Member
                </a>

            </div>

        </div>

    </div>

</div>