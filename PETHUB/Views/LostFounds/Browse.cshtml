<!-- =========================================================
     LOST & FOUND CARDS

========================================================== -->

<div class="row mt-4 lost-found-card-grid">

    @foreach (var item in Model.Items)
    {
        var isLost = item.Type.ToString().Equals(
            "Lost",
            StringComparison.OrdinalIgnoreCase
        );

        var location =
            string.IsNullOrEmpty(item.City)
                ? "Not specified"
                : item.City + ", " + item.Province;


        <div class="col-md-3 mb-4">


            <!-- =================================================
                 LOST & FOUND CARD
            ================================================== -->

            <div class="lost-found-card h-100 position-relative @(isLost ? "lost-card" : "found-card")">


                <!-- =================================================
                     EXISTING DETAILS LINK
                ================================================== -->

                <a asp-action="BrowseDetails"
                   asp-route-id="@item.LostFoundId"
                   class="lost-found-card-link">


                    <article class="lost-found-card-inner">


                        <!-- =================================================
                             STATUS RAIL
                        ================================================== -->

                        <span class="lost-found-status-rail"></span>



                        <!-- =================================================
                             IMAGE
                        ================================================== -->

                        <div class="lost-found-card-image-wrapper">

                            @if (item.Images != null && item.Images.Any())
                            {
                                <img src="@Url.Content(item.Images.First().ImagePath)"
                                     class="lost-found-card-image"
                                     alt="@item.Title" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/images/no-image.png")"
                                     class="lost-found-card-image"
                                     alt="No image" />
                            }


                            <!-- Image gradient -->

                            <div class="lost-found-card-image-gradient"></div>



                            <!-- =================================================
                                 LOST / FOUND BADGE
                            ================================================== -->
                            @if (isLost)
                            {
                                <span class="lost-found-type-badge lost-found-type-badge-lost">

                                    <i data-lucide="search"></i>

                                    LOST

                                </span>
                            }
                            else
                            {
                                <span class="lost-found-type-badge lost-found-type-badge-found">

                                    <i data-lucide="heart-handshake"></i>

                                    FOUND

                                </span>
                            }



                            <!-- =================================================
                                 PET TYPE BADGE
                            ================================================== -->

                            <span class="lost-found-pet-badge">

                                <i data-lucide="paw-print"></i>

                                @item.PetType

                            </span>

                        </div>



                        <!-- =================================================
                             CARD BODY
                        ================================================== -->

                        <div class="lost-found-card-body">


                            <!-- =================================================
                                 TITLE
                            ================================================== -->

                            <h3 class="lost-found-card-title">

                                @item.Title

                            </h3>



                            <!-- =================================================
                                 LOCATION
                            ================================================== -->

                            <div class="lost-found-card-location-row">

                                <i data-lucide="map-pin"></i>

                                <span>

                                    <span class="lost-found-location-label">

                                        @(isLost
                                            ? "Last seen: "
                                            : "Found in ")

                                    </span>

                                    <span class="lost-found-location-value">

                                        @location

                                    </span>

                                </span>

                            </div>



                            <!-- =================================================
                                 DESCRIPTION
                            ================================================== -->

                            <p class="lost-found-card-description">

                                @item.Description

                            </p>



                            <!-- =================================================
                                 FOOTER

                            ================================================== -->

                            <div class="lost-found-card-footer">

                                <span class="lost-found-card-date">

                                    <i data-lucide="clock"></i>

                                    @item.DateReported.ToString("MMM dd, yyyy")

                                </span>

                            </div>

                        </div>

                    </article>

                </a>



                <!-- =================================================
                     REPORT BUTTON

COMMENTED OUT.

ORIGINAL PROGRAMMER LOGIC PRESERVED.
                ================================================== -->
                @*
                @if (User.IsInRole("Member") &&
                     !string.IsNullOrEmpty(item.UserId) &&
                     item.UserId != User.FindFirst(
                         System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                {
                    <!-- Only registered-member Lost & Found posts
                         can be reported.

                         The owner cannot report their own post,
                         and posts created by unregistered clients
                         have no UserId. -->

                    <button type="button"
                            class="btn btn-sm btn-light shadow-sm report-card-button position-absolute top-0 end-0 m-2"
                            style="z-index:2;"
                            data-bs-toggle="modal"
                            data-bs-target="#reportModal"
                            data-report-type="LostFound"
                            data-report-id="@item.LostFoundId"
                            data-report-title="@item.Title"
                            aria-label="Report @item.Title">

                        <i data-lucide="flag"></i>

                    </button>
                }
                *@

            </div>

        </div>
    }

</div>

