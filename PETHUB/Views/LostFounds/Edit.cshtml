@model PETHUB.Models.LostFound

@{
    ViewData["Title"] = "Edit Report";

    ViewData["Province"] = Model.Province;
    ViewData["City"] = Model.City;
    ViewData["Barangay"] = Model.Barangay;
    ViewData["StreetAddress"] = Model.StreetAddress;
}


<div class="edit-listing-page">


    <!-- =====================================================
         MAIN EDIT FORM
    ====================================================== -->

    <div class="listing-form-card">

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data"
              id="editLostFoundForm">

            @Html.AntiForgeryToken()


            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="mb-4">

                <h2>
                    Edit Report
                </h2>

                <p class="text-muted">
                    Update the information below to keep your report
                    accurate and up to date.
                </p>

            </div>


            <!-- =================================================
                 HIDDEN VALUES
            ================================================== -->

            <input type="hidden"
                   asp-for="LostFoundId" />

            <input type="hidden"
                   asp-for="Status" />

            <input type="hidden"
                   asp-for="RStatus" />

            <input type="hidden"
                   asp-for="UserId" />

            <input type="hidden"
                   asp-for="DateReported" />



            <!-- =================================================
                 VALIDATION
            ================================================== -->

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>



            <div class="row g-4">


                <!-- =================================================
                     LEFT SIDE
                ================================================== -->

                <div class="col-lg-8">


                    <!-- =================================================
                         REPORT TYPE
                    ================================================== -->

                    <div class="mb-4">

                        <h5 class="mb-1">
                            Report Type
                        </h5>

                        <p class="text-muted mb-3">
                            This report is currently marked as:
                        </p>


                        <div class="row g-3">


                            <!-- =========================================
                                 LOST
                            ========================================== -->

                            <div class="col-md-6">

                                <div class="listing-type-card
                                     @(Model.Type == LostFoundType.Lost ? "active" : "")">

                                    <div class="listing-type-icon">

                                        <i data-lucide="search"></i>

                                    </div>

                                    <div>

                                        <h5>
                                            Lost
                                        </h5>

                                        <small>
                                            Help find this missing pet
                                        </small>

                                    </div>

                                </div>

                            </div>



                            <!-- =========================================
                                 FOUND
                            ========================================== -->

                            <div class="col-md-6">

                                <div class="listing-type-card
                                     @(Model.Type == LostFoundType.Found ? "active" : "")">

                                    <div class="listing-type-icon">

                                        <i data-lucide="heart-handshake"></i>

                                    </div>

                                    <div>

                                        <h5>
                                            Found
                                        </h5>

                                        <small>
                                            Help reunite this pet
                                        </small>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <input type="hidden"
                               asp-for="Type"
                               id="typeSelect" />

                        <span asp-validation-for="Type"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- =================================================
                         TITLE
                    ================================================== -->

                    <div class="mb-3">

                        <label asp-for="Title"
                               class="form-label">

                            Title

                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Enter report title" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- =================================================
                         DESCRIPTION
                    ================================================== -->

                    <div class="mb-3">

                        <label asp-for="Description"
                               class="form-label">

                            Description

                        </label>

                        <textarea asp-for="Description"
                                  rows="3"
                                  class="form-control"
                                  placeholder="Describe the pet and the circumstances..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- =================================================
                         PET TYPE
                    ================================================== -->

                    <div class="mb-3">

                        <label class="form-label">
                            Pet Type
                        </label>


                        <div>


                            <!-- DOG -->

                            <div class="form-check form-check-inline">

                                <input asp-for="PetType"
                                       class="form-check-input"
                                       type="radio"
                                       value="Dog"
                                       id="editDog" />

                                <label class="form-check-label"
                                       for="editDog">

                                    Dog

                                </label>

                            </div>


                            <!-- CAT -->

                            <div class="form-check form-check-inline">

                                <input asp-for="PetType"
                                       class="form-check-input"
                                       type="radio"
                                       value="Cat"
                                       id="editCat" />

                                <label class="form-check-label"
                                       for="editCat">

                                    Cat

                                </label>

                            </div>

                        </div>


                        <span asp-validation-for="PetType"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- =================================================
                         PET SEX
                    ================================================== -->

                    <div class="mb-3">

                        <label class="form-label">
                            Pet Sex
                        </label>


                        <div>


                            <!-- MALE -->

                            <div class="form-check form-check-inline">

                                <input asp-for="Sex"
                                       class="form-check-input"
                                       type="radio"
                                       value="Male"
                                       id="editMale" />

                                <label class="form-check-label"
                                       for="editMale">

                                    Male

                                </label>

                            </div>


                            <!-- FEMALE -->

                            <div class="form-check form-check-inline">

                                <input asp-for="Sex"
                                       class="form-check-input"
                                       type="radio"
                                       value="Female"
                                       id="editFemale" />

                                <label class="form-check-label"
                                       for="editFemale">

                                    Female

                                </label>

                            </div>


                            <!-- UNKNOWN -->

                            <div class="form-check form-check-inline">

                                <input asp-for="Sex"
                                       class="form-check-input"
                                       type="radio"
                                       value="Unknown"
                                       id="editUnknown" />

                                <label class="form-check-label"
                                       for="editUnknown">

                                    Unknown

                                </label>

                            </div>

                        </div>


                        <span asp-validation-for="Sex"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- =================================================
                         BREED
                    ================================================== -->

                    <div class="mb-3">

                        <label asp-for="Breed"
                               class="form-label">

                            Breed

                        </label>

                        <input asp-for="Breed"
                               class="form-control"
                               placeholder="Breed" />

                        <span asp-validation-for="Breed"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- =================================================
                         LOST DATE
                    ================================================== -->

                    <div class="mb-3">

                        <label asp-for="LostDate"
                               class="form-label">

                            Lost Date

                        </label>

                        <input asp-for="LostDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="LostDate"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- =================================================
                         LOCATION
                    ================================================== -->

                    <div class="mb-3">

                        <h5>
                            Location
                        </h5>

                        <p class="text-muted">
                            Where can interested people find this pet?
                        </p>

                    </div>


                    <partial name="Components/_AddressFields" />

                </div>



                <!-- =================================================
                     RIGHT SIDE
                     PHOTOS
                ================================================== -->

                <div class="col-lg-4">

                    <div class="photo-upload-card">

                        <h5 class="mb-3">
                            Photos
                        </h5>


                        <!-- =========================================
                             FILE INPUT
                        ========================================== -->

                        <div class="mb-3">

                            <input type="file"
                                   id="imageInput"
                                   name="Images"
                                   multiple
                                   accept="image/*"
                                   class="form-control" />

                            <p class="text-muted">
                                You can upload multiple images.
                            </p>

                        </div>



                        <!-- =========================================
                             PHOTO GRID
                        ========================================== -->

                        <div class="image-preview-grid">


                            <!-- =====================================
                                 EXISTING DATABASE PHOTOS
                            ====================================== -->

                            @if (Model.Images != null && Model.Images.Any())
                            {
                                @foreach (var img in Model.Images)
                                {
                                    <div class="edit-photo-item existing-photo">

                                        <img src="@img.ImagePath"
                                             alt="Lost & Found image"
                                             class="edit-photo-image" />


                                        <button type="button"
                                                class="edit-photo-remove"
                                                aria-label="Remove image"
                                                data-image-id="@img.LostFoundImageId">

                                            <i data-lucide="x"></i>

                                        </button>

                                    </div>
                                }
                            }



                            <!-- =====================================
                                 NEW PHOTO PREVIEWS
                            ====================================== -->

                            <div id="imagePreviewContainer"
                                 style="display: contents;">
                            </div>

                        </div>

                    </div>

                </div>

            </div>


                                <!-- =================================================
                         BOTTOM ACTIONS
                    ================================================== -->

                    <div class="lostfound-edit-actions">

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Index"
                               class="lostfound-cancel-btn">
                                Cancel
                            </a>
                        }
                        else
                        {
                            <a asp-controller="MyPosts"
                               asp-action="LostFoundDetails"
                               asp-route-id="@Model.LostFoundId"
                               class="lostfound-cancel-btn">
                                Cancel
                            </a>
                        }

                        <button type="submit"
                                class="lostfound-save-btn">
                            Update Report
                        </button>

                    </div>

    

        </form>

    </div>

</div>



@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <!-- =========================================================
         IMAGE PREVIEW HELPER
    ========================================================== -->

    <script src="~/js/imagePreviewHelper.js"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {


            // =========================================================
            // IMAGE PREVIEW
            // =========================================================

            setupImagePreview(
                "imageInput",
                "imagePreviewContainer"
            );



            // =========================================================
            // PHOTO ELEMENTS
            // =========================================================

            const imageInput =
                document.getElementById("imageInput");

            const photoGrid =
                document.querySelector(".image-preview-grid");

            const previewContainer =
                document.getElementById(
                    "imagePreviewContainer"
                );



            // =========================================================
            // UPDATE PHOTO DISPLAY
            // =========================================================

            function updatePhotoDisplay() {

                if (
                    !imageInput ||
                    !photoGrid ||
                    !previewContainer
                ) {
                    return;
                }


                // Count existing photos that are not marked for deletion.

                const existingPhotos =
                    Array.from(
                        photoGrid.querySelectorAll(
                            ".existing-photo:not(.marked-for-removal)"
                        )
                    );


                // Get new photo previews created by the helper.

                const newPhotos =
                    Array.from(
                        previewContainer.children
                    ).filter(function (element) {

                        return !element.classList.contains(
                            "more-images"
                        );

                    });


                // Count actual photos.

                const existingCount =
                    existingPhotos.length;

                const newCount =
                    imageInput.files.length;


                // Existing + new = total photos.

                const totalPhotos =
                    existingCount + newCount;


                // Maximum visible photos.

                const maxVisible = 4;



                // =====================================================
                // EXISTING PHOTOS
                // =====================================================

                existingPhotos.forEach(
                    function (photo, index) {

                        if (index < maxVisible) {

                            photo.style.display = "";

                        }
                        else {

                            photo.style.display = "none";

                        }

                    }
                );



                // =====================================================
                // NEW PHOTO PREVIEWS
                // =====================================================

                // Existing photos use the first slots.

                const availableSlots =
                    Math.max(
                        0,
                        maxVisible -
                        Math.min(
                            existingCount,
                            maxVisible
                        )
                    );


                newPhotos.forEach(
                    function (photo, index) {

                        if (index < availableSlots) {

                            photo.style.display = "";

                        }
                        else {

                            photo.style.display = "none";

                        }

                    }
                );



                // =====================================================
                // MORE PHOTOS
                // =====================================================

                // Remove old +more.

                const oldMore =
                    previewContainer.querySelector(
                        ".more-images"
                    );


                if (oldMore) {
                    oldMore.remove();
                }


                // Calculate hidden photos.

                const moreCount =
                    Math.max(
                        0,
                        totalPhotos - maxVisible
                    );


                if (moreCount > 0) {

                    const more =
                        document.createElement("div");

                    more.classList.add(
                        "more-images"
                    );

                    more.textContent =
                        `+${moreCount} more photos`;

                    previewContainer.appendChild(
                        more
                    );

                }

            }



            // =========================================================
            // NEW PHOTO SELECTION
            // =========================================================

            if (imageInput) {

                imageInput.addEventListener(
                    "change",
                    function () {

                        setTimeout(
                            updatePhotoDisplay,
                            300
                        );

                    }
                );

            }



            // =========================================================
            // EXISTING PHOTO REMOVE
            // =========================================================

            const existingRemoveButtons =
                document.querySelectorAll(
                    ".existing-photo .edit-photo-remove"
                );


            existingRemoveButtons.forEach(
                function (button) {

                    button.addEventListener(
                        "click",
                        function (event) {

                            event.preventDefault();
                            event.stopPropagation();


                            const photo =
                                button.closest(
                                    ".existing-photo"
                                );


                            if (!photo) {
                                return;
                            }


                            // Get database image ID.

                            const imageId =
                                button.dataset.imageId;


                            if (!imageId) {
                                return;
                            }


                            // Prevent duplicate removal.

                            if (
                                photo.classList.contains(
                                    "marked-for-removal"
                                )
                            ) {
                                return;
                            }


                            // Find main Edit form.

                            const editForm =
                                document.getElementById(
                                    "editLostFoundForm"
                                );


                            if (editForm) {

                                // Send deleted image ID
                                // to the Edit POST.

                                const hiddenInput =
                                    document.createElement(
                                        "input"
                                    );

                                hiddenInput.type =
                                    "hidden";

                                hiddenInput.name =
                                    "DeletedImageIds";

                                hiddenInput.value =
                                    imageId;


                                editForm.appendChild(
                                    hiddenInput
                                );

                            }


                            // Hide photo.

                            photo.style.display =
                                "none";


                            // Remember deletion.

                            photo.classList.add(
                                "marked-for-removal"
                            );


                            // Recalculate photos.

                            updatePhotoDisplay();

                        }
                    );

                }
            );



            // =========================================================
            // INITIAL PHOTO DISPLAY
            // =========================================================

            updatePhotoDisplay();



            // =========================================================
            // PREVENT ENTER FROM SUBMITTING FORM
            // =========================================================

            const editForm =
                document.getElementById(
                    "editLostFoundForm"
                );


            if (editForm) {

                editForm.addEventListener(
                    "keydown",
                    function (event) {

                        // Allow Enter inside textarea.

                        if (
                            event.target.tagName ===
                            "TEXTAREA"
                        ) {
                            return;
                        }


                        // Prevent Enter from submitting.

                        if (
                            event.key === "Enter"
                        ) {

                            event.preventDefault();

                        }

                    }
                );

            }



            // =========================================================
            // LUCIDE ICONS
            // =========================================================

            if (
                typeof lucide !== "undefined"
            ) {

                lucide.createIcons();

            }

        });

    </script>


    <!-- =========================================================
         ADDRESS HELPER
    ========================================================== -->

    <script src="~/js/address-helper.js"
            asp-append-version="true"></script>
}