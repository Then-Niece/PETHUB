@{
    ViewData["Title"] = "Password Reset Successful";
    ViewData["HideSidebar"] = true;
    ViewData["HideNavbar"] = true;
}

<link rel="stylesheet"
      href="~/css/reset-password-confirmation.css"
      asp-append-version="true" />


<div class="reset-confirmation-page">

    <div class="reset-confirmation-card">

        <!-- SUCCESS ICON -->

        <div class="reset-confirmation-icon">
            <i data-lucide="circle-check-big"></i>
        </div>


        <!-- TEXT -->

        <h1>Password reset successful</h1>

        <p class="reset-confirmation-message">
            Your PetHub password has been successfully updated.
        </p>

        <p class="reset-confirmation-secondary">
            You can now sign in to your account using your new password.
            We've also sent a security notification to your email.
        </p>


        <!-- LOGIN -->

        <a asp-controller="UserAccount"
           asp-action="Login"
           class="reset-confirmation-btn">

            Continue to login

        </a>


        <!-- HOME -->

        <a asp-controller="Home"
           asp-action="Index"
           class="reset-confirmation-home">

            <i data-lucide="arrow-left"></i>

            Back to home

        </a>

    </div>

</div>