@model PETHUB.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    ViewData["HideSidebar"] = true;
    ViewData["HideNavbar"] = true;
}

<link rel="stylesheet"
      href="~/css/forgot-password.css"
      asp-append-version="true" />


<div class="forgot-page">

    <div class="forgot-card">

        <div class="forgot-header">

            <img src="~/images/PETHUB-LOGO.png"
                 alt="PetHub Logo"
                 class="forgot-logo" />

            <h1>Forgot your password?</h1>

            <p>
                Enter the email address connected to your PetHub account
                and we'll send you a password reset link.
            </p>

        </div>


        <form asp-action="ForgotPassword"
              method="post"
              class="forgot-form">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="text-danger forgot-validation-summary">
            </div>


            <div class="floating-field">

                <input asp-for="Email"
                       class="floating-input"
                       placeholder=" "
                       autocomplete="email" />

                <label asp-for="Email"
                       class="floating-label">
                    Email Address
                </label>

                <span asp-validation-for="Email"
                      class="text-danger field-error">
                </span>

            </div>


            <button type="submit"
                    class="forgot-submit-btn">

                Send reset link

            </button>


            <a asp-controller="UserAccount"
               asp-action="Login"
               class="back-login-link">

                <i data-lucide="arrow-left"></i>

                Back to login

            </a>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}