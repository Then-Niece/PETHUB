@{
    ViewData["Title"] = "Reset Link Expired";
    ViewData["HideSidebar"] = true;
}

<div class="container d-flex justify-content-center align-items-center"
     style="min-height: 70vh;">

    <div class="text-center" style="max-width: 500px;">

        <div style="
            width:80px;
            height:80px;
            margin:0 auto 25px;
            border-radius:50%;
            background:#FFF4E5;
            display:flex;
            align-items:center;
            justify-content:center;
            font-size:36px;">
            
            <a data-lucide="clock"></a>
        </div>

        <h2 class="mb-3">
            Reset Link Expired
        </h2>

        <p class="text-muted mb-4">
            Your password reset link has expired.
            For your security, password reset links are only valid
            for 10 minutes.
        </p>

        <p class="text-muted mb-4">
            Please request a new password reset link to continue.
        </p>

        <a asp-controller="UserAccount"
           asp-action="ForgotPassword"
           class="btn btn-success px-4">
            Request New Reset Link
        </a>

        <div class="mt-3">
            <a asp-controller="UserAccount"
               asp-action="Login"
               class="text-muted">
                Back to Login
            </a>
        </div>

    </div>

</div>