@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Reset Link Expired";
    ViewData["HideSidebar"] = true;
    ViewData["HideNavbar"] = true;
}

<link rel="stylesheet"
      href="~/css/reset-link-expired.css"
      asp-append-version="true" />


<div class="expired-page">

    <div class="expired-card">

        <div class="expired-icon">
            <i data-lucide="clock-3"></i>
        </div>

        <h1>Reset link expired</h1>

        <p class="expired-message">
            Your password reset link has expired.
            For your security, reset links are only valid for 10 minutes.
        </p>

        <p class="expired-secondary">
            Request a new password reset link to continue.
        </p>


        <a asp-controller="UserAccount"
           asp-action="ForgotPassword"
           class="expired-primary-btn">

            Request new reset link

        </a>


        <a asp-controller="UserAccount"
           asp-action="Login"
           class="expired-back-link">

            <i data-lucide="arrow-left"></i>

            Back to login

        </a>

    </div>

</div>