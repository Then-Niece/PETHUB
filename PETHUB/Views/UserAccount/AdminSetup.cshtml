@model PETHUB.ViewModels.AdminViewModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Administrator Account Setup";
    ViewData["HideNavbar"] = true;
    ViewData["HideSidebar"] = true;
}

<link rel="stylesheet"
      href="~/css/admin-setup.css"
      asp-append-version="true" />

<div class="admin-setup-page">

    <div class="admin-setup-card">

        <div class="admin-setup-header">

            <div class="admin-setup-brand">
                <div class="admin-setup-logo">
                    <i data-lucide="shield-check"></i>
                </div>

                <div>
                    <h1>Complete administrator account</h1>

                    <p>
                        You've been invited to become a PETHUB administrator.
                        Complete the details below to finish setting up your account.
                    </p>
                </div>
            </div>

        </div>

        <form asp-action="AdminSetup"
              asp-controller="UserAccount"
              method="post"
              class="admin-setup-form">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="userId"
                   value="@ViewBag.UserId" />

            <input type="hidden"
                   name="token"
                   value="@ViewBag.Token" />

            <div asp-validation-summary="ModelOnly"
                 class="admin-setup-summary">
            </div>

            <div class="admin-setup-grid">

                <!-- EMAIL -->
                <div class="admin-setup-field full">

                    <label asp-for="Email">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           class="admin-setup-input readonly"
                           readonly />

                    <span asp-validation-for="Email"
                          class="admin-setup-error">
                    </span>

                </div>


                <!-- FIRST NAME -->
                <div class="admin-setup-field">

                    <label asp-for="FirstName">
                        First Name
                    </label>

                    <input asp-for="FirstName"
                           class="admin-setup-input"
                           placeholder="Enter your first name" />

                    <span asp-validation-for="FirstName"
                          class="admin-setup-error">
                    </span>

                </div>

                <!-- MIDDLE NAME -->
                <div class="admin-setup-field">

                    <label asp-for="MiddleName">
                        Middle Name
                    </label>

                    <input asp-for="MiddleName"
                           class="admin-setup-input"
                           placeholder="Enter your middle name" />

                    <span asp-validation-for="MiddleName"
                          class="admin-setup-error">
                    </span>

                </div>

                <!-- LAST NAME -->
                <div class="admin-setup-field">

                    <label asp-for="LastName">
                        Last Name
                    </label>

                    <input asp-for="LastName"
                           class="admin-setup-input"
                           placeholder="Enter your last name" />

                    <span asp-validation-for="LastName"
                          class="admin-setup-error">
                    </span>

                </div>


                <!-- USERNAME -->
                <div class="admin-setup-field">

                    <label asp-for="UserName">
                        Username
                    </label>

                    <input asp-for="UserName"
                           class="admin-setup-input"
                           placeholder="Choose a username" />

                    <span asp-validation-for="UserName"
                          class="admin-setup-error">
                    </span>

                </div>


                <!-- CONTACT NUMBER -->
                <div class="admin-setup-field full">

                    <label asp-for="ContactNumber">
                        Contact Number
                    </label>

                    <input asp-for="ContactNumber"
                           class="admin-setup-input"
                           placeholder="11-digit contact number"
                           maxlength="11"
                           inputmode="numeric"
                           autocomplete="tel"
                           oninput="this.value = this.value.replace(/[^0-9]/g, '')" />

                    <span asp-validation-for="ContactNumber"
                          class="admin-setup-error">
                    </span>

                </div>


                <!-- PASSWORD -->
                <div class="admin-setup-field full">

                    <label asp-for="Password">
                        Password
                    </label>

                    <div class="admin-password-wrapper">

                        <input asp-for="Password"
                               type="password"
                               class="admin-setup-input password-input"
                               id="adminPassword"
                               placeholder="Create your password"
                               autocomplete="new-password" />

                        <button class="password-toggle admin-password-toggle"
                                type="button"
                                data-password-target="adminPassword"
                                aria-label="Show password">

                            <i data-lucide="eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="admin-setup-error">
                    </span>

                </div>

                <div class="admin-setup-field full">

                    <label asp-for="ConfirmPassword">
                        Confirm Password
                    </label>

                    <div class="admin-password-wrapper">

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="admin-setup-input password-input"
                               id="adminConfirmPassword"
                               placeholder="Re-enter your password"
                               autocomplete="new-password" />

                        <button class="password-toggle admin-password-toggle"
                                type="button"
                                data-password-target="adminConfirmPassword"
                                aria-label="Show password">

                            <i data-lucide="eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="admin-setup-error">
                    </span>

                </div>


            </div>

            <div class="admin-setup-footer">

                <button type="submit"
                        class="admin-setup-submit">

                    Complete Account Setup

                </button>

                <p class="admin-setup-note">
                    This invitation is intended only for the invited administrator.
                </p>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}