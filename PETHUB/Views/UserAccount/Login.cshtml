@model PETHUB.ViewModels.LoginViewModel

<div class="container-fluid"
     style="
    min-height:calc(100vh - 57px);
    background-image:url('/images/bg.png');
    background-size:cover;
    background-position:center;
    background-repeat:no-repeat;">

    <div class="row justify-content-center align-items-center py-5"
         style="min-height:calc(100vh - 57px);">

        <div class="col-xl-5 col-lg-6 col-md-8 col-sm-10">

            <div class="rounded-5 bg-white p-5 shadow">

                <!-- Heading -->
                <h1 class="fw-bold mb-2 text-center" style="font-size:2.8rem; color:#2D3748;">
                    Welcome to PetHub
                    
                </h1>

                <p class="text-muted mb-5 text-center">
                    A community dedicated to pet well-being.
                </p>

                <form asp-action="Login" method="post">

                   

                    <!-- Username / Email -->
                    <div class="mb-4">

                        <label asp-for="UserNameOrEmail"
                               class="form-label fw-semibold">
                            Email or Username
                        </label>

                        <div class="input-group">

                            <span class="input-group-text rounded-start-pill border-end-0 bg-white">
                                <i data-lucide="user" style="width:20px;height:20px;"></i>
                            </span>

                      

                            <input asp-for="UserNameOrEmail"
                                   id="emailInput"
                                   class="form-control rounded-end-pill border-start-0"
                                   placeholder="Enter your username or email" />

                        </div>

                       

                    </div>

                    <!-- Password -->
                    <div class="mb-4">

                        <label asp-for="Password"
                               class="form-label fw-semibold">
                            Password
                        </label>

                        <div class="input-group">

                            <span class="input-group-text rounded-start-pill border-end-0 bg-white">
                                <i data-lucide="lock" style="width:20px;height:20px;"></i>
                            </span>

                            <input asp-for="Password"
                                   id="passwordInput"
                                   type="password"
                                   class="form-control rounded-end-pill border-start-0"
                                   placeholder="Enter your password" />

                        </div>

                       

                    </div>

                    <!-- Remember Me -->
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div class="form-check">

                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label">
                            </label>

                        </div>

                        <a href="#"
                           class="text-decoration-none fw-semibold"
                           style="color:#E76E51;">
                            Forgot Password?
                        </a>

                    </div>

                    <!-- Login Button -->
                    <button type="submit"
                            class="btn login-btn rounded-pill fw-bold w-100 py-3">
                        Sign in
                    </button>

                </form>

                <!-- Divider -->
                <div class="d-flex align-items-center my-4">

                    <hr class="flex-grow-1">

                    <span class="text-muted small mx-3">
                        OR CONTINUE WITH
                    </span>

                    <hr class="flex-grow-1">

                </div>

                <!-- Social Buttons (UI only) -->
                <div class="row g-2">

                    <div class="col-6">
                        <button type="button"
                                class="btn btn-outline-secondary rounded-pill w-100">
                            Google
                        </button>
                    </div>

                    <div class="col-6">
                        <button type="button"
                                class="btn btn-outline-secondary rounded-pill w-100">
                            Facebook
                        </button>
                    </div>

                </div>

                <!-- Register -->
                <p class="text-muted mt-4 mb-0 text-center">

                    Don't have an account?

                    <a asp-controller="UserAccount"
                       asp-action="Register"
                       class="fw-bold text-decoration-none"
                       style="color:#E76E51;">
                        Sign up
                    </a>

                </p>

            </div>

        </div>

    </div>

</div>