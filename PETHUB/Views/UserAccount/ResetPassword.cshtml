@model PETHUB.ViewModels.ResetPasswordViewModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Reset Password";
    ViewData["HideSidebar"] = true;
    ViewData["HideNavbar"] = true;
}

<link rel="stylesheet"
      href="~/css/reset-password.css"
      asp-append-version="true" />


<div class="reset-page">

    <div class="reset-card">

        <div class="reset-header">

            <div class="reset-icon">
                <i data-lucide="key-round"></i>
            </div>

            <h1>Reset your password</h1>

            <p>
                Create a new password for your PetHub account.
            </p>

        </div>


        <form asp-action="ResetPassword"
              method="post"
              class="reset-form">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Token" />


            <div asp-validation-summary="ModelOnly"
                 class="reset-validation-summary">
            </div>


            <!-- EMAIL -->

            <div class="floating-field">

                <input asp-for="Email"
                       class="floating-input"
                       placeholder=" "
                       autocomplete="email"
                       readonly />

                <label asp-for="Email"
                       class="floating-label">
                    Email Address
                </label>

                <span asp-validation-for="Email"
                      class="field-error">
                </span>

            </div>


            <!-- PASSWORD -->

            <div class="floating-field password-field">

                <input asp-for="Password"
                       type="password"
                       class="floating-input"
                       id="resetPassword"
                       placeholder=" "
                       autocomplete="new-password" />

                <label asp-for="Password"
                       class="floating-label">
                    New Password
                </label>

                <button type="button"
                        class="password-toggle"
                        data-password-target="resetPassword"
                        aria-label="Show password">

                    <i data-lucide="eye"></i>

                </button>

                <span asp-validation-for="Password"
                      class="field-error">
                </span>

            </div>


            <!-- CONFIRM PASSWORD -->

            <div class="floating-field password-field">

                <input asp-for="ConfirmPassword"
                       type="password"
                       class="floating-input"
                       id="confirmResetPassword"
                       placeholder=" "
                       autocomplete="new-password" />

                <label asp-for="ConfirmPassword"
                       class="floating-label">
                    Confirm Password
                </label>

                <button type="button"
                        class="password-toggle"
                        data-password-target="confirmResetPassword"
                        aria-label="Show password">

                    <i data-lucide="eye"></i>

                </button>

                <span asp-validation-for="ConfirmPassword"
                      class="field-error">
                </span>

            </div>


            <button type="submit"
                    class="reset-submit-btn">

                Reset password

            </button>


            <a asp-controller="UserAccount"
               asp-action="Login"
               class="back-login-link">

                <i data-lucide="arrow-left"></i>

                Back to login

            </a>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}