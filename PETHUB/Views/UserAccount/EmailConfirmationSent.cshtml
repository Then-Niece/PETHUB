@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Check Your Email";
    ViewData["HideSidebar"] = true;
    ViewData["HideNavbar"] = true;
}

<link rel="stylesheet"
      href="~/css/email-confirmation.css"
      asp-append-version="true" />


<div class="email-confirmation-page">

    <div class="email-confirmation-card">

        <div class="email-confirmation-icon">
            <i data-lucide="mail-check"></i>
        </div>


        <h1>Check your email</h1>


        <p class="email-confirmation-message">
            Your PetHub account has been created successfully.
        </p>


        <p class="email-confirmation-secondary">
            We've sent a verification link to your email address.
            Please verify your account within
            <strong>24 hours</strong>.
        </p>


        <div class="email-confirmation-note">

            <i data-lucide="info"></i>

            <span>
                Didn't receive the email?
                Check your spam or junk folder.
            </span>

        </div>


        <a asp-controller="UserAccount"
           asp-action="Login"
           class="email-confirmation-btn">

            Go to login

        </a>


        <a asp-controller="Home"
           asp-action="Index"
           class="email-confirmation-home">

            <i data-lucide="arrow-left"></i>

            Back to home

        </a>

    </div>

</div>