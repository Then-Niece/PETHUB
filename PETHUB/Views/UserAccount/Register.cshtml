@model PETHUB.ViewModels.RegisterViewModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Register";
    ViewData["HideSidebar"] = true;

    ViewData["Province"] ??= Model?.Province ?? "";
    ViewData["City"] ??= Model?.City ?? "";
    ViewData["Barangay"] ??= Model?.Barangay ?? "";
    ViewData["StreetAddress"] ??= Model?.StreetAddress ?? "";
}


<link rel="stylesheet"
      href="~/css/register.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/terms-modal.css"
      asp-append-version="true" />


<style>

    /* =========================================================
           REQUIRED FIELD MARK
        ========================================================== */

    .required-mark {
        color: #dc3545;
        margin-left: 2px;
        font-weight: 700;
    }


    /* Birthdate comes from a reusable partial,
           so add the required mark only on Register. */

    .register-birthdate-required .form-label::after {
        content: " *";
        color: #dc3545;
        font-weight: 700;
    }


    /* Address fields are also from a reusable partial.
           Only show the required marks while inside Register. */

    .register-address label[for="Province"]::after,
    .register-address label[for="City"]::after,
    .register-address label[for="Barangay"]::after {
        content: " *";
        color: #dc3545;
        font-weight: 700;
    }


    .register-required-note {
        margin: 0 0 1.25rem;
        font-size: 0.82rem;
        color: #6b7280;
    }

</style>


<div class="register-page">

    <div class="register-wrapper">


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="register-header">

            <img src="~/images/PETHUB-LOGO.png"
                 alt="PetHub Logo"
                 class="register-logo" />

            <div>

                <h1>
                    Create your PetHub account
                </h1>

                <p>
                    Join the community and help pets find loving homes,
                    reconnect with their families, and meet responsible owners.
                </p>

            </div>

        </div>



        <!-- =====================================================
             FORM CARD
        ====================================================== -->

        <div class="register-card">

            <form asp-action="Register"
                  method="post"
                  enctype="multipart/form-data"
                  class="register-form"
                  id="registerForm">

                @Html.AntiForgeryToken()

                <!-- VALIDATION SUMMARY -->

                <div asp-validation-summary="ModelOnly"
                     class="register-validation-summary text-danger">
                </div>



                <!-- =================================================
                     PERSONAL INFORMATION
                ================================================== -->

                <section class="register-section">

                    <div class="register-section-heading">

                        <div class="register-section-icon">

                            <i data-lucide="user-round"></i>

                        </div>

                        <div>

                            <h2>
                                Personal information
                            </h2>

                            <p>
                                Tell us a little about yourself.
                            </p>

                        </div>

                    </div>



                    <div class="register-grid">


                        <!-- FIRST NAME -->

                        <div class="floating-field">

                            <input asp-for="FirstName"
                                   class="floating-input"
                                   placeholder=" "
                                   autocomplete="given-name" />

                            <label asp-for="FirstName"
                                   class="floating-label">

                                First Name
                                <span class="required-mark">*</span>

                            </label>

                            <span asp-validation-for="FirstName"
                                  class="field-error">
                            </span>

                        </div>



                        <!-- MIDDLE NAME -->

                        <div class="floating-field">

                            <input asp-for="MiddleName"
                                   class="floating-input"
                                   placeholder=" "
                                   autocomplete="additional-name" />

                            <label asp-for="MiddleName"
                                   class="floating-label">

                                Middle Name

                            </label>

                            <span asp-validation-for="MiddleName"
                                  class="field-error">
                            </span>

                        </div>



                        <!-- LAST NAME -->

                        <div class="floating-field">

                            <input asp-for="LastName"
                                   class="floating-input"
                                   placeholder=" "
                                   autocomplete="family-name" />

                            <label asp-for="LastName"
                                   class="floating-label">

                                Last Name
                                <span class="required-mark">*</span>

                            </label>

                            <span asp-validation-for="LastName"
                                  class="field-error">
                            </span>

                        </div>



                        <!-- EMAIL -->

                        <div class="floating-field">

                            <input asp-for="Email"
                                   class="floating-input"
                                   placeholder=" "
                                   autocomplete="email" />

                            <label asp-for="Email"
                                   class="floating-label">

                                Email Address
                                <span class="required-mark">*</span>

                            </label>

                            <span asp-validation-for="Email"
                                  class="field-error">
                            </span>

                        </div>



                        <!-- CONTACT NUMBER -->

                        <div class="floating-field register-contact-field">

                            <input asp-for="ContactNumber"
                                   class="floating-input"
                                   placeholder=" "
                                   autocomplete="tel"
                                   inputmode="numeric"
                                   maxlength="11"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '')" />

                            <label asp-for="ContactNumber"
                                   class="floating-label">

                                Contact Number
                                <span class="required-mark">*</span>

                            </label>

                            <span asp-validation-for="ContactNumber"
                                  class="field-error">
                            </span>

                        </div>



                        <!-- BIRTHDATE -->

                        <div class="register-field register-birthdate-required">

                            <partial name="Components/_DateFields"
                                     model='new PETHUB.ViewModels.DateFieldsViewModel
                                     {
                                         FieldName = "Birthdate",
                                         Label = "Birthdate",
                                         Value = Model?.Birthdate,
                                         AllowFuture = false,
                                         MinimumAge = 18
                                     }' />

<span asp-validation-for="Birthdate"
                                  class="field-error">
                            </span>

                        </div>



                        <!-- GENDER -->

                        <div class="register-field
                            register-full-width
                            register-gender-field">

                            <label class="register-field-label">

                                Gender
                                <span class="required-mark">*</span>

                            </label>


                            <div class="gender-options">


                                <label class="gender-option">

                                    <input asp-for="Gender"
                                           type="radio"
                                           value="Male" />

                                    <span>

                                        <i data-lucide="user"></i>

                                        Male

                                    </span>

                                </label>


                                <label class="gender-option">

                                    <input asp-for="Gender"
                                           type="radio"
                                           value="Female" />

                                    <span>

                                        <i data-lucide="user"></i>

                                        Female

                                    </span>

                                </label>


                            </div>


                            <span asp-validation-for="Gender"
                                  class="field-error">
                            </span>

                        </div>


                    </div>

                </section>



                <!-- =================================================
                     ADDRESS
                ================================================== -->

                <section class="register-section">

                    <div class="register-section-heading">

                        <div class="register-section-icon">

                            <i data-lucide="map-pin"></i>

                        </div>

                        <div>

                            <h2>
                                Address
                            </h2>

                            <p>
                                Provide your current location information.
                            </p>

                        </div>

                    </div>


                    <div class="register-address">

                        <partial name="Components/_AddressFields" />

                    </div>

                </section>



                <!-- =================================================
                     ACCOUNT INFORMATION
                ================================================== -->

                <section class="register-section">

                    <div class="register-section-heading">

                        <div class="register-section-icon">

                            <i data-lucide="shield-check"></i>

                        </div>

                        <div>

                            <h2>
                                Account information
                            </h2>

                            <p>
                                Choose your username and secure your account.
                            </p>

                        </div>

                    </div>



                    <div class="register-grid">


                        <!-- USERNAME -->

                        <div class="floating-field register-full-width">

                            <input asp-for="UserName"
                                   class="floating-input"
                                   placeholder=" "
                                   autocomplete="username" />

                            <label asp-for="UserName"
                                   class="floating-label">

                                Username
                                <span class="required-mark">*</span>

                            </label>

                            <span asp-validation-for="UserName"
                                  class="field-error">
                            </span>

                        </div>



                        <!-- PASSWORD -->

                        <div class="floating-field password-field">

                            <input asp-for="Password"
                                   type="password"
                                   class="floating-input"
                                   id="registerPassword"
                                   placeholder=" "
                                   autocomplete="new-password" />

                            <label asp-for="Password"
                                   class="floating-label">

                                Password
                                <span class="required-mark">*</span>

                            </label>


                            <button type="button"
                                    class="register-password-toggle password-toggle"
                                    data-password-target="registerPassword"
                                    aria-label="Show password">

                                <i data-lucide="eye"></i>

                            </button>


                            <span asp-validation-for="Password"
                                  class="field-error">
                            </span>

                        </div>



                        <!-- CONFIRM PASSWORD -->

                        <div class="floating-field password-field">

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="floating-input"
                                   id="confirmPassword"
                                   placeholder=" "
                                   autocomplete="new-password" />

                            <label asp-for="ConfirmPassword"
                                   class="floating-label">

                                Confirm Password
                                <span class="required-mark">*</span>

                            </label>


                            <button type="button"
                                    class="register-password-toggle password-toggle"
                                    data-password-target="confirmPassword"
                                    aria-label="Show password">

                                <i data-lucide="eye"></i>

                            </button>


                            <span asp-validation-for="ConfirmPassword"
                                  class="field-error">
                            </span>

                        </div>



                        <!-- =================================================
                             PASSWORD REQUIREMENTS
                        ================================================== -->

                        <div class="password-requirements register-full-width">

                            <div class="password-requirements-header">

                                <div class="password-requirements-icon">

                                    <i data-lucide="shield-check"></i>

                                </div>


                                <div>

                                    <strong>
                                        Password requirements
                                    </strong>

                                    <span>
                                        Use a secure password with all
                                        of the following:
                                    </span>

                                </div>

                            </div>



                            <div class="password-requirements-grid">


                                <div class="password-rule">

                                    <i data-lucide="check-circle-2"></i>

                                    <span>
                                        8+ characters
                                    </span>

                                </div>


                                <div class="password-rule">

                                    <i data-lucide="check-circle-2"></i>

                                    <span>
                                        Uppercase letter
                                    </span>

                                </div>


                                <div class="password-rule">

                                    <i data-lucide="check-circle-2"></i>

                                    <span>
                                        Lowercase letter
                                    </span>

                                </div>


                                <div class="password-rule">

                                    <i data-lucide="check-circle-2"></i>

                                    <span>
                                        Number
                                    </span>

                                </div>


                                <div class="password-rule">

                                    <i data-lucide="check-circle-2"></i>

                                    <span>
                                        Special character
                                    </span>

                                </div>


                            </div>

                        </div>


                    </div>

                </section>



                <!-- =================================================
                     ID VERIFICATION
                ================================================== -->

                <section class="register-section">

                    <div class="register-section-heading">

                        <div class="register-section-icon">

                            <i data-lucide="badge-check"></i>

                        </div>

                        <div>

                            <h2>
                                Identity verification
                            </h2>

                            <p>
                                Upload a valid ID photo to help us maintain
                                a safer PetHub community.
                            </p>

                        </div>

                    </div>



                    <div class="id-upload-field">


                        <label asp-for="IdPhoto"
                               class="register-field-label">

                            ID Photo
                            <span class="required-mark">*</span>

                        </label>



                        <label for="IdPhotoInput"
                               class="id-upload-box">


                            <div class="id-upload-icon">

                                <i data-lucide="upload-cloud"></i>

                            </div>


                            <div class="id-upload-text">

                                <strong>
                                    Choose an ID photo
                                </strong>

                                <span>
                                    Click here to select an image
                                </span>

                            </div>


                        </label>



                        <input asp-for="IdPhoto"
                               type="file"
                               id="IdPhotoInput"
                               class="id-file-input"
                               accept="image/*" />


                        <span asp-validation-for="IdPhoto"
                              class="field-error">
                        </span>



                        <div id="idPhotoPreview"
                             class="id-photo-preview">
                        </div>


                    </div>

                </section>



                <!-- =================================================
                     TERMS AND CONDITIONS
                ================================================== -->

                <div class="register-terms">

                    <input asp-for="AcceptTerms"
                           id="AcceptTerms"
                           class="form-check-input" />


                    <label asp-for="AcceptTerms">

                        I have read, understood, and agree to the

                        <a href="#"
                           data-bs-toggle="modal"
                           data-bs-target="#termsModal">

                            PetHub Terms and Conditions

                        </a>

                        <span class="required-mark">*</span>

                    </label>

                </div>


                <span asp-validation-for="AcceptTerms"
                      class="field-error terms-error">
                </span>



                <!-- =================================================
                     ACTIONS
                ================================================== -->

                <div class="register-actions">


                    <button type="submit"
                            class="register-submit-btn">

                        Create account

                    </button>



                    <div class="register-login-link">

                        <span>
                            Already have an account?
                        </span>

                        <a asp-controller="UserAccount"
                           asp-action="Login">

                            Log in

                        </a>

                    </div>



                    <a asp-controller="Home"
                       asp-action="Index"
                       class="register-back-home">

                        <i data-lucide="arrow-left"></i>

                        Back to Home

                    </a>


                </div>


            </form>

        </div>

    </div>

</div>



<partial name="_TermsAndConditionsModal" />



@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

    <script>
        $(function () {

            const form = $("#registerForm");
            const terms = $("#AcceptTerms");
            const termsError =
                $('[data-valmsg-for="AcceptTerms"]');


            form.on("submit", function (event) {

                if (!terms.is(":checked")) {

                    event.preventDefault();

                    termsError
                        .removeClass("field-validation-valid")
                        .addClass("field-validation-error")
                        .text("You must accept the Terms and Conditions.");


                    document
                        .querySelector(".register-terms")
                        .scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });

                    return false;
                }


                termsError
                    .removeClass("field-validation-error")
                    .addClass("field-validation-valid")
                    .text("");

            });


            terms.on("change", function () {

                if (this.checked) {

                    termsError
                        .removeClass("field-validation-error")
                        .addClass("field-validation-valid")
                        .text("");
                }

            });

        });
    </script>


    <!-- =====================================================
         SCROLL TO FIRST INVALID FIELD
    ====================================================== -->

    <script>

        $(function () {

            const form = $("#registerForm");


            form.on(
                "invalid-form.validate",
                function () {

                    const firstError =
                        document.querySelector(
                            "#registerForm .input-validation-error"
                        );


                    if (!firstError)
                        return;


                    firstError.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });


                    setTimeout(
                        function () {

                            firstError.focus({
                                preventScroll: true
                            });

                        },
                        300
                    );

                }
            );

        });

    </script>



    <!-- =====================================================
         IMAGE PREVIEW
    ====================================================== -->

    <script src="~/js/imagePreviewHelper.js"
            asp-append-version="true">
    </script>


    <script>

        setupImagePreview(
            "IdPhotoInput",
            "idPhotoPreview",
            {
                multiple: false,
                previewWidth: 240,
                previewHeight: 150
            }
        );

    </script>



    <!-- =====================================================
         ADDRESS
    ====================================================== -->

    <script src="~/js/address-helper.js"
            asp-append-version="true">
    </script>

}