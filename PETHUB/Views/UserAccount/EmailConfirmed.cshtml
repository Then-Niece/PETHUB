@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Email Confirmed";
    ViewData["HideSidebar"] = true;
    ViewData["HideNavbar"] = true;
}

<link rel="stylesheet"
      href="~/css/email-confirmation.css"
      asp-append-version="true" />


<div class="email-confirmation-page">

    <div class="email-confirmation-card">

        <div class="email-confirmation-icon success">
            <i data-lucide="badge-check"></i>
        </div>


        <h1>Email verified successfully</h1>


        <p class="email-confirmation-message">
            Your PetHub email address has been successfully verified.
        </p>


        <p class="email-confirmation-secondary">
            Your account is now ready. You can sign in and start using PetHub.
        </p>


        <a asp-controller="UserAccount"
           asp-action="Login"
           class="email-confirmation-btn">

            Continue to login

        </a>


        <a asp-controller="Home"
           asp-action="Index"
           class="email-confirmation-home">

            <i data-lucide="arrow-left"></i>

            Back to home

        </a>

    </div>

</div>