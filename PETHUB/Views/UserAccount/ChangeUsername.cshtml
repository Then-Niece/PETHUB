@model PETHUB.ViewModels.ChangeUsernameViewModel

@{
    ViewData["Title"] = "Change Username";
}

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

<form asp-controller="UserAccount" asp-action="ChangeUsername" method="post">
    <div class="form-group">
        <label asp-for="NewUsername"></label>
        <input asp-for="NewUsername" class="form-control" />
        <span asp-validation-for="NewUsername" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Change Username</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}