@{
    ViewData["Title"] = "Email Submitted";
    ViewData["HideSidebar"] = true;
    ViewData["HideNavbar"] = true;
}

<link rel="stylesheet"
      href="~/css/forgot-password.css"
      asp-append-version="true" />


<div class="forgot-page">

    <div class="forgot-card">

        <div class="forgot-header">

            <div class="auth-confirmation-icon">
                <i data-lucide="mail-check"></i>
            </div>

            <h1>
                Check your inbox
            </h1>

            <p>
                If an account exists for the email address you entered,
                we've sent a password reset link.
            </p>

            <p class="confirmation-secondary-text">
                Please check your inbox and spam folder.
            </p>

        </div>


        <a asp-controller="UserAccount"
           asp-action="Login"
           class="forgot-submit-btn confirmation-button">

            Back to login

        </a>

    </div>

</div>