@{
    ViewData["Title"] = "Email Submitted";
}

<div class="container text-center mt-5">

   <img src="~/images/email_sent.png"
     class="mb-4"
     style="width:90px;"
     alt="Email Sent" />

    <h2 class="fw-bold">Check Your Inbox</h2>

    <p class="text-muted m-3"
       style="line-height:1.8;">
        If an account exists for the email address you entered,
        we've sent a password <br />reset link.
        Please check your inbox and spam folder.
    </p>


    <a asp-action="Login"
       class="btn fw-semibold rounded-pill px-4 mt-1 text-white"
       style="background:#8ACE79;border:none;">
        Back to Login
    </a>
    
</div>
