@{
    ViewData["Title"] = "Verification Link Expired";
    ViewData["HideSidebar"] = true;
    ViewData["HideNavbar"] = true;
}

<link rel="stylesheet"
      href="~/css/email-confirmation.css"
      asp-append-version="true" />


<div class="email-confirmation-page">

    <div class="email-confirmation-card">

        <div class="email-confirmation-icon warning">
            <i data-lucide="clock-alert"></i>
        </div>


        <h1>Verification link expired</h1>


        <p class="email-confirmation-message">
            Your email verification link is invalid or has expired.
        </p>


        <p class="email-confirmation-secondary">
            Request a new verification email to continue setting up your PetHub account.
        </p>


        <a asp-controller="UserAccount"
           asp-action="ResendEmailConfirmation"
           class="email-confirmation-btn">

            Send new verification link

        </a>


        <a asp-controller="UserAccount"
           asp-action="Login"
           class="email-confirmation-home">

            <i data-lucide="arrow-left"></i>

            Back to login

        </a>

    </div>

</div>