@model PETHUB.ViewModels.AppealViewModel

@{
    ViewData["Title"] = "Appeal Removed Post";
}

<div class="appeal-page">

    <div class="appeal-card">

        <!-- ==========================================================
             PAGE HEADER
        ========================================================== -->

        <div class="appeal-header">

            <div class="appeal-header-icon">
                <i data-lucide="scale"></i>
            </div>

            <div class="appeal-header-content">

                <h1>
                    Appeal Removed Post
                </h1>

                <p>
                    Request a review of your removed post.
                </p>

            </div>

        </div>


        <!-- ==========================================================
             DIVIDER
        ========================================================== -->

        <div class="appeal-divider"></div>


        <!-- ==========================================================
             APPEALED POST
        ========================================================== -->

        <div class="appeal-post-section">

            <p class="appeal-post-label">
                You are submitting an appeal for
            </p>


            <div class="appeal-post-card">

                <div class="appeal-post-content">

                    <h2>
                        @Model.PostTitle
                    </h2>

                    <div class="appeal-post-meta">

                        <span class="appeal-post-type">

                            <i data-lucide="search"></i>

                            @(Model.PostType == "lostfound"
                                ? "LOST & FOUND"
                                : "MARKETPLACE")

                        </span>

                        <span class="appeal-post-separator">
                            •
                        </span>

                        <span>
                            Removed Post
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ==========================================================
             APPEAL FORM
        ========================================================== -->

        <form asp-controller="Appeals"
              asp-action="Create"
              method="post"
              class="appeal-form">

            <!-- Hidden values identify the existing removed post.
                 The controller validates these values again against
                 the authenticated Member before creating the Appeal. -->

            <input type="hidden"
                   asp-for="PostType" />

            <input type="hidden"
                   asp-for="PostId" />


            <!-- ======================================================
                 APPEAL MESSAGE
            ====================================================== -->

            <div class="appeal-message-section">

                <label asp-for="AppealMessage"
                       class="appeal-message-label">

                    Why should this post be restored?

                </label>


                <textarea asp-for="AppealMessage"
                          class="appeal-message-input"
                          rows="7"
                          placeholder="Explain why you believe the removal was incorrect..."></textarea>


                <span asp-validation-for="AppealMessage"
                      class="appeal-validation">
                </span>


                <p class="appeal-message-help">
                    Be clear and provide any information that may help the
                    moderation team reconsider the removal.
                </p>

            </div>


            <!-- ======================================================
                 ACTION BUTTONS
            ====================================================== -->

            <div class="appeal-actions">

                <!-- Returns without creating an appeal. -->

                <a asp-controller="RemovedPosts"
                   asp-action="Details"
                   asp-route-type="@Model.PostType"
                   asp-route-id="@Model.PostId"
                   class="appeal-cancel-btn">

                    Cancel

                </a>


                <!-- Submits the Member's appeal message. -->

                <button type="submit"
                        class="appeal-submit-btn">

                    Submit Appeal

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            if (typeof lucide !== "undefined") {
                lucide.createIcons();
            }

        });

    </script>

}