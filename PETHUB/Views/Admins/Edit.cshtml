@model PETHUB.ViewModels.EditAdminViewModel

@{
    ViewData["Title"] = "Edit Admin";
}

<div class="container-fluid py-4">

    <div class="admin-crud-page">

        <div class="crud-card">

            <div class="crud-header">
                <h2>Edit Administrator</h2>
                <p>Update administrator account information.</p>
            </div>

            <form asp-action="Edit">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger px-4 pt-3"></div>

                <div class="crud-content-single">

                    <div class="form-grid">

                        <div class="form-group">
                            <label asp-for="FirstName"></label>
                            <input asp-for="FirstName" class="form-control custom-input" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="LastName"></label>
                            <input asp-for="LastName" class="form-control custom-input" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="UserName"></label>
                            <input asp-for="UserName" class="form-control custom-input" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <<div class="form-group">
                            <label asp-for="Email"></label>
                            <input asp-for="Email"
                                   class="form-control custom-input readonly-input"
                                   readonly />
                        </div>

                        <div class="form-group">
                            <label asp-for="ContactNumber"></label>
                            <input asp-for="ContactNumber" class="form-control custom-input" />
                            <span asp-validation-for="ContactNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Status"></label>
                            <input value="@Model.Status"
                                   class="form-control custom-input readonly-input"
                                   readonly />
                        </div>

                    </div>

                </div>

                <div class="crud-footer">

                    <a asp-action="Index" class="btn-cancel">
                        Cancel
                    </a>

                    <button type="submit" class="btn-primary-action">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}