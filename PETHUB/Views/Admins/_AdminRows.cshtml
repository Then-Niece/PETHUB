@model IEnumerable<PETHUB.Models.ApplicationUser>

@foreach (var item in Model)
{
    <tr>

        <td>@item.UserName</td>

        <td class="full-name-col">
            @item.FirstName @item.LastName
        </td>

        <td class="email-col">
            @item.Email
        </td>

        <td>
            @item.ContactNumber
        </td>

        <td>
            <span class="admin-role-pill">
                @ViewBag.UserRoles[item.Id]
            </span>
        </td>

        <td>

            @if (item.Status == UserStatus.Active)
            {
                <span class="status-pill active">
                    Active
                </span>
            }
            else if (item.Status == UserStatus.Inactive)
            {
                <span class="status-pill inactive">
                    Inactive
                </span>
            }
            else
            {
                <span class="status-pill pending">
                    Pending
                </span>
            }

        </td>

        <td>

            <div class="action-dropdown">

                <button type="button"
                        class="action-menu-btn">
                    <i data-lucide="more-vertical"></i>
                </button>

                <div class="action-menu">

                    <a asp-action="Details"
                       asp-route-id="@item.Id">
                        View
                    </a>

                    <div class="menu-divider"></div>

                    @if (item.Status == UserStatus.Active)
                    {
                        <form asp-action="Deactivate"
                              asp-route-id="@item.Id"
                              method="post"
                              class="action-menu-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="dropdown-item deactivate-item">
                                Deactivate
                            </button>

                        </form>
                    }
                    else if (item.Status == UserStatus.Inactive)
                    {
                        <form asp-action="Reactivate"
                              asp-route-id="@item.Id"
                              method="post"
                              class="action-menu-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="dropdown-item reactivate-item">
                                Reactivate
                            </button>

                        </form>
                    }

                </div>

            </div>

        </td>

    </tr>
}