@model PETHUB.Models.ApplicationUser

@{
    ViewData["Title"] = "Admin Details";
}

<div class="container-fluid py-4">

    <div class="admin-crud-page">

        <div class="crud-card">

            <div class="crud-header">
                <h2>Administrator Details</h2>
                <p>View administrator account information.</p>
            </div>

            <div class="crud-content-single">

                <div class="form-grid">

                    <div class="form-group">
                        <label>User Name</label>
                        <input class="form-control custom-input readonly-input"
                               value="@Model.UserName"
                               readonly />
                    </div>

                    <div class="form-group">
                        <label>First Name</label>
                        <input class="form-control custom-input readonly-input"
                               value="@Model.FirstName"
                               readonly />
                    </div>

                    <div class="form-group">
                        <label>Last Name</label>
                        <input class="form-control custom-input readonly-input"
                               value="@Model.LastName"
                               readonly />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input class="form-control custom-input readonly-input"
                               value="@Model.Email"
                               readonly />
                    </div>

                    <div class="form-group">
                        <label>Contact Number</label>
                        <input class="form-control custom-input readonly-input"
                               value="@Model.ContactNumber"
                               readonly />
                    </div>

                    <div class="form-group">
                        <label>Role</label>
                        <input class="form-control custom-input readonly-input"
                               value="@ViewBag.UserRoles[Model.Id]"
                               readonly />
                    </div>

                    <div class="form-group">
                        <label>Status</label>
                        <input class="form-control custom-input readonly-input"
                               value="@Model.Status"
                               readonly />
                    </div>

                </div>

            </div>

            <div class="crud-footer">

                <a asp-action="Index" class="btn-cancel">
                    Back to List
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn-primary-action">
                    Edit Administrator
                </a>

            </div>

        </div>

    </div>

</div>