@model PETHUB.ViewModels.AdminInvitationViewModel

@{
    ViewData["Title"] = "Create Admin";
}

<div class="container-fluid py-4">

    <div class="admin-crud-page">

        <div class="crud-card">

            <div class="crud-header">
                <h2>Invite Administrator</h2>
                <p>Enter the email address of the person you want to invite as an administrator.</p>
            </div>

            <form asp-action="Create" method="post">

                <div class="crud-content-single">

                    <div class="form-group">

                        <label asp-for="Email">
                            Email Address
                        </label>

                        <input asp-for="Email"
                               class="form-control custom-input"
                               type="email"
                               placeholder="Enter administrator's email address" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>

                    </div>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger px-4 pt-3"></div>

                </div>

                <div class="crud-footer">

                    <a asp-action="Index"
                       class="btn-cancel">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn-primary-action">
                        Send Invitation
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
