@model PETHUB.ViewModels.AdminViewModel

@{
    ViewData["Title"] = "Create Admin";
}

<div class="container-fluid py-4">

    <div class="admin-crud-page">

        <div class="crud-card">

            <div class="crud-header">
                <h2>Create Administrator</h2>
                <p>Add a new administrator account.</p>
            </div>

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger px-4 pt-3"></div>

                <div class="crud-content-single">

                    <div class="form-grid">

                        <div class="form-group">
                            <label asp-for="FirstName">First Name</label>
                            <input asp-for="FirstName" class="form-control custom-input" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="LastName">Last Name</label>
                            <input asp-for="LastName" class="form-control custom-input" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="UserName">Username</label>
                            <input asp-for="UserName" class="form-control custom-input" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Email"></label>
                            <input asp-for="Email" class="form-control custom-input" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ContactNumber"></label>
                            <input asp-for="ContactNumber" class="form-control custom-input" />
                            <span asp-validation-for="ContactNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Status"></label>
                            <input asp-for="Status"
                                   class="form-control custom-input readonly-input"
                                   value="Active"
                                   readonly />
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Password"
                                       type="password"
                                       class="form-control" 
                                       id="adminPassword"/>

                                <button class="password-toggle"
                                        type="button"
                                        data-password-target="adminPassword"
                                        aria-label="Show password">

                                        <i data-lucide="eye"></i>

                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                    </div>

                </div>

                <div class="crud-footer">

                    <a asp-action="Index" class="btn-cancel">
                        Cancel
                    </a>

                    <button type="submit" class="btn-primary-action">
                        Create Administrator
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}