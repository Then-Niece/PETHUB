@model PETHUB.Models.ApplicationUser

@{
    ViewData["Title"] = "Delete Admin";
}

<div class="container-fluid py-4">

    <div class="crud-page">

        <div class="crud-card delete-card">

            <div class="crud-header">

                <h2>Delete Administrator</h2>

                <p>
                    Permanently remove the selected administrator from the system.
                </p>

            </div>

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div class="delete-content">

                    <div class="delete-info">

                        <div class="info-row">

                            <span class="info-label">
                                Username
                            </span>

                            <span>
                                @Model.UserName
                            </span>

                        </div>

                        <div class="info-row">

                            <span class="info-label">
                                Full Name
                            </span>

                            <span>
                                @Model.FirstName @Model.LastName
                            </span>

                        </div>

                        <div class="info-row">

                            <span class="info-label">
                                Email
                            </span>

                            <span>
                                @Model.Email
                            </span>

                        </div>

                        <div class="info-row">

                            <span class="info-label">
                                Status
                            </span>

                            <span>
                                @Model.Status
                            </span>

                        </div>

                    </div>

                    <div class="delete-warning">

                        <i data-lucide="triangle-alert"></i>

                        <span>
                            This action is permanent and cannot be undone.
                        </span>

                    </div>

                </div>

                <div class="crud-footer">

                    <a asp-action="Index"
                       class="btn-cancel">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn-delete-action">
                        Delete Administrator
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
