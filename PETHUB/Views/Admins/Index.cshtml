@model PETHUB.ViewModels.PaginationViewModel<PETHUB.Models.ApplicationUser>
@{
    ViewData["Title"] = "Admins";
}

<div class="container-fluid px-2 py-4">

    <div class="admin-header">

        <div>

            <h2 class="admin-title">
                Admins
            </h2>

            <p class="admin-subtitle">
                Manage system administrators.
            </p>

        </div>

        <a asp-action="Create" class="admin-add-btn">
            + New Admin
        </a>

    </div>

    <div class="admin-card">

        <div class="admin-toolbar">

            <div class="search-box">

                <i data-lucide="search" class="search-icon"></i>

                <input class="admin-search"
                       type="text"
                       placeholder="Search admins..." />

            </div>

            <div class="member-count">

                @Model.TotalItems Admin@(Model.TotalItems == 1 ? "" : "s")

            </div>

        </div>

        <table class="admin-table">

            <thead>

                <tr>

                    <th>Username</th>

                    <th>Full Name</th>

                    <th>Email</th>

                    <th>Contact</th>

                    <th>Role</th>

                    <th>Status</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.Items)
                {

                    <tr>

                        <td>@item.UserName</td>

                        <td class="full-name-col">
                            @item.FirstName @item.LastName
                        </td>

                        <td class="email-col">
                            @item.Email
                        </td>

                        <td>
                            @item.ContactNumber
                        </td>

                        <td>

                            <span class="admin-role-pill">

                                @ViewBag.UserRoles[item.Id]

                            </span>

                        </td>

                        <td>

                            @if (item.Status == UserStatus.Active)
                            {
                                <span class="status-pill active">Active</span>
                            }
                            else if (item.Status == UserStatus.Inactive)
                            {
                                <span class="status-pill inactive">Inactive</span>
                            }
                            else
                            {
                                <span class="status-pill pending">Pending</span>
                            }

                        </td>

                        <td>

                            <div class="action-dropdown">

                                <button class="action-menu-btn">
                                    <i data-lucide="more-vertical"></i>
                                </button>

                                <div class="action-menu">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id">
                                        Edit
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id">
                                        View
                                    </a>

                                    <div class="menu-divider"></div>

                                    @if (item.Status == UserStatus.Active)
                                    {
                                        <form asp-action="Deactivate"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item deactivate-item">
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                    else if (item.Status == UserStatus.Inactive)
                                    {
                                        <form asp-action="Reactivate"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item reactivate-item">
                                                Reactivate
                                            </button>
                                        </form>
                                    }

                                </div>

                            </div>

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    </div>

    <partial name="_Pagination" model="Model" />

 

</div>

