@model IEnumerable<PETHUB.Models.ApplicationUser>

@{
    ViewData["Title"] = "Admins";
}

<div class="container-fluid px-2 py-4">

    <div class="admin-header">

        <div>

            <h2 class="admin-title">
                Admins
            </h2>

            <p class="admin-subtitle">
                Manage system administrators.
            </p>

        </div>

        <a asp-action="Create" class="admin-add-btn">
            + New Admin
        </a>

    </div>

    <div class="admin-card">

        <div class="admin-toolbar">

            <div class="search-box">

                <i data-lucide="search" class="search-icon"></i>

                <input class="admin-search"
                       type="text"
                       placeholder="Search admins..." />

            </div>

            <div class="member-count">

                @Model.Count() Admin@(Model.Count() == 1 ? "" : "s")

            </div>

        </div>

        <table class="admin-table">

            <thead>

                <tr>

                    <th>Username</th>

                    <th>Full Name</th>

                    <th>Email</th>

                    <th>Contact Number</th>

                    <th>Role</th>

                    <th>Status</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {

                    <tr>

                        <td>@item.UserName</td>

                        <td class="full-name-col">
                            @item.FirstName @item.LastName
                        </td>

                        <td class="email-col">
                            @item.Email
                        </td>

                        <td>
                            @item.ContactNumber
                        </td>

                        <td>

                            <span class="admin-role-pill">

                                @ViewBag.UserRoles[item.Id]

                            </span>

                        </td>

                        <td>

                            @if (item.Status == UserStatus.Active)
                            {
                                <span class="status-pill active">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="status-pill inactive">
                                    Inactive
                                </span>
                            }

                        </td>

                        <td>

                            <div class="action-dropdown">

                                <button class="action-menu-btn">
                                    <i data-lucide="more-vertical"></i>
                                </button>

                                <div class="action-menu">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id">
                                        Edit
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id">
                                        View
                                    </a>

                                    <div class="menu-divider"></div>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="delete-item">
                                        Delete
                                    </a>

                                </div>

                            </div>

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    </div>

    <div class="admin-pagination">

        <div class="pagination-info">

            Showing 1–10 of @Model.Count() admin@(Model.Count() == 1 ? "" : "s")

        </div>

        <div class="pagination-links">

            <a href="#" class="page-btn disabled">

                &lt;

            </a>

            <a href="#" class="page-btn active">

                1

            </a>

            <a href="#" class="page-btn disabled">

                &gt;

            </a>

        </div>

    </div>

</div>

