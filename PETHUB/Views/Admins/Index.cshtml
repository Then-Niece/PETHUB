@model PETHUB.ViewModels.PaginationViewModel<PETHUB.Models.ApplicationUser>
@{
    ViewData["Title"] = "Admins";
}

<div class="container-fluid px-2 py-4">

    <div class="admin-header">

        <div>

            <h2 class="admin-title">
                Admins
            </h2>

            <p class="admin-subtitle">
                Manage system administrators.
            </p>

        </div>

        <a asp-action="Create" class="admin-add-btn">
            + New Admin
        </a>

    </div>

    <div class="admin-card">

        <div class="admin-toolbar">

           <form asp-action="Index"
                  method="get"
                  class="search-box"
                  id="adminSearchForm">

                <i data-lucide="search"
                   class="search-icon"></i>

                <input class="admin-search"
                       type="text"
                       name="search"
                       id="adminSearchInput"
                       value="@ViewBag.Search"
                       placeholder="Search admins..."
                       autocomplete="off" />

            </form>

            <div class="member-count"
                 id="adminCount">

                @Model.TotalItems Admin@(Model.TotalItems == 1 ? "" : "s")

            </div>

        </div>

        <table class="admin-table">

            <thead>

                <tr>

                    <th>Username</th>

                    <th>Full Name</th>

                    <th>Email</th>

                    <th>Contact</th>

                    <th>Role</th>

                    <th>Status</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody id="adminsTableBody">

                <partial name="_AdminRows" model="Model.Items" />

            </tbody>

        </table>

    </div>

    <partial name="_Pagination" model="Model" />

 

</div>



@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("adminSearchInput");

            const tableBody =
                document.getElementById("adminsTableBody");

            const adminCount =
                document.getElementById("adminCount");

            if (!searchInput || !tableBody) {
                return;
            }

            let searchTimer;


            searchInput.addEventListener("input", function () {

                clearTimeout(searchTimer);

                const searchValue = this.value.trim();

                searchTimer = setTimeout(async function () {

                    try {

                        const response = await fetch(
                            `/Admins/Search?search=${encodeURIComponent(searchValue)}`
                        );

                        if (!response.ok) {
                            return;
                        }

                        const html = await response.text();

                        tableBody.innerHTML = html;


                        // Re-render Lucide icons inside the newly loaded rows.
                        if (window.lucide) {
                            lucide.createIcons();
                        }


                        // Update the administrator count.
                        const rowCount =
                            tableBody.querySelectorAll("tr").length;

                        if (adminCount) {

                            adminCount.textContent =
                                `${rowCount} ${rowCount === 1 ? "Admin" : "Admins"}`;

                        }

                    }
                    catch (error) {

                        console.error(
                            "Admin search failed:",
                            error
                        );

                    }

                }, 300);

            });

        });
    </script>
}

