@model PETHUB.ViewModels.AdminMyPostsViewModel

@{
    ViewData["Title"] = "My Posts";
}


<div class="admin-my-posts-page">


    @* =========================================================
       PROFILE SUMMARY CARD
       ========================================================= *@

    <partial name="_AdminProfileSummaryCard"
             model="Model.Profile" />



    @* =========================================================
       PAGE HEADER
       ========================================================= *@

    <div class="admin-my-posts-header">

        <div class="admin-my-posts-header-text">

            <h1>
                My Posts
            </h1>

            <p>
                Manage the PetFeed posts you have created
            </p>

        </div>

    </div>



    @* =========================================================
       FILTER AREA
       Reserved for programmer implementation.
       Do not add filter logic here yet.
       ========================================================= *@

    <div class="admin-my-posts-filter-card">

        <div class="admin-my-posts-filter-placeholder">

            @* Filters will be implemented here later. *@

        </div>

        <span class="admin-my-posts-total">

            @Model.Posts.Count()
            @(Model.Posts.Count() == 1 ? "post" : "posts")

        </span>

    </div>



    @* =========================================================
       POSTS
       ========================================================= *@

    @if (!Model.Posts.Any())
    {
        <div class="admin-my-posts-empty">

            <h3>
                No PetFeed Posts Found
            </h3>

            <p>
                You haven't created any PetFeed posts yet.
            </p>

        </div>
    }
    else
    {
        <div class="admin-my-posts-list">


            @foreach (var post in Model.Posts)
            {

                <a asp-action="Details"
                   asp-route-id="@post.PetFeedId"
                   class="admin-my-posts-card">


                    @* =================================================
                       IMAGE
                       ================================================= *@

                    <div class="admin-my-posts-image-container">

                        @if (post.Images != null && post.Images.Any())
                        {
                            <img src="@Url.Content(post.Images.First().ImagePath)"
                                 alt="PetFeed image"
                                 class="admin-my-posts-image" />
                        }
                        else
                        {
                            <img src="@Url.Content("~/images/no-image.png")"
                                 alt="No image"
                                 class="admin-my-posts-image" />
                        }

                    </div>



                    @* =================================================
                       POST INFORMATION
                       ================================================= *@

                    <div class="admin-my-posts-content">

                        <h3 class="admin-my-posts-title">

                            @post.Title

                        </h3>


                        <p class="admin-my-posts-date">

                            Created @post.DateCreated.ToString("MMM dd, yyyy")

                        </p>


                        @* =================================================
                           ENGAGEMENT
                           ================================================= *@

                        <div class="admin-my-posts-engagement">

                            <span>

                                <i data-lucide="paw-print"></i>

                                @post.Paws.Count()

                            </span>


                            <span>

                                <i data-lucide="message-circle"></i>

                                @post.Comments.Count()

                            </span>

                        </div>


                    </div>



                    @* =================================================
                       RIGHT SIDE
                       ================================================= *@

                    <div class="admin-my-posts-actions">


                        @* =================================================
                           PETFEED TYPE
                           Uses existing Admin PetFeed pill styles.
                           ================================================= *@

                        @if (post.Type == PETHUB.Models.PetFeedType.Announcement)
                        {
                            <span class="admin-my-posts-type-status admin-my-posts-type-announcement">
                                Announcement
                            </span>
                        }
                        else if (post.Type == PETHUB.Models.PetFeedType.PetTip)
                        {
                            <span class="admin-my-posts-type-status admin-my-posts-type-tip">
                                Pet Tip
                            </span>
                        }

                    </div>


                </a>

            }


        </div>
    }

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            if (typeof lucide !== "undefined") {

                lucide.createIcons();

            }

        });

    </script>

}