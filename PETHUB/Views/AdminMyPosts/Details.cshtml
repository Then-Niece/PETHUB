@model PETHUB.Models.PetFeed

@{
    ViewData["Title"] = "Post Details";
}

<h2>Post Details</h2>

<!-- Displays the complete information of the selected PetFeed post. -->
<div class="card shadow-sm">

    <div class="card-body">

        <h3>@Model.Title</h3>

        <p class="text-muted">
            @Model.Type
        </p>

        <p>
            @Model.Content
        </p>

        <hr />

        <p>
            <strong>Date Posted:</strong>
            @Model.DateCreated.ToString("MMMM dd, yyyy")
        </p>

        <p>
            <strong>Paws:</strong>
            @Model.Paws.Count()
        </p>

        <p>
            <strong>Comments:</strong>
            @Model.Comments.Count()
        </p>

    </div>

</div>

@if (Model.Images != null && Model.Images.Any())
{
    <div class="row mt-4">

        @foreach (var image in Model.Images)
        {
            <div class="col-md-4 mb-3">

                <!-- Displays every uploaded image attached to this PetFeed post. -->
                <img src="@image.ImagePath"
                     class="img-fluid rounded border" />

            </div>
        }

    </div>
}

<div class="mt-4">

<!-- Redirects to the existing PetFeeds Edit page.
        The PetFeedsController performs another ownership check
        before allowing any modifications. -->
    <a asp-controller="PetFeeds"
        asp-action="Edit"
        asp-route-id="@Model.PetFeedId"
        class="btn btn-success">

        Edit

    </a>

<!-- Deletes the selected PetFeed and returns to My Posts.
     Ownership is verified again inside the controller. -->
    <form asp-action="Delete"
        method="post"
        class="d-inline">

    @Html.AntiForgeryToken()

    <input type="hidden"
            name="id"
            value="@Model.PetFeedId" />

    <button type="submit"
            class="btn btn-danger"
            onclick="return confirm('Are you sure you want to delete this post?');">

        Delete

    </button>

</form>
    <a asp-action="Index"
       class="btn btn-secondary">

        Back

    </a>

</div>