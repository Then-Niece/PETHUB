@model PETHUB.ViewModels.AdminEditProfileViewModel

@{
    ViewData["Title"] = "View My Profile";
}


<div class="container-fluid py-4 admin-profile-page-container">

    @* =========================================================
       MAIN ADMIN PROFILE LAYOUT
       ========================================================= *@

    <div class="admin-profile-layout">


        @* =====================================================
           LEFT COLUMN
           ===================================================== *@

        <div class="admin-profile-left-column">


            @* =================================================
               ADMIN PROFILE CARD
               ================================================= *@

            <div class="admin-profile-card">

                @* Cover *@

                <div class="admin-profile-cover">
                </div>


                @* Profile Picture *@

                <div class="admin-profile-picture-wrapper">

                    @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                    {
                        <img id="adminProfilePicturePreview"
                             src="@Model.ProfilePicturePath"
                             class="admin-profile-picture"
                             alt="Profile Picture" />
                    }
                    else
                    {
                        <img id="adminProfilePicturePreview"
                             src="~/images/default_profile.jpg"
                             class="admin-profile-picture"
                             alt="Default Profile Picture" />
                    }

                </div>


                @* Administrator Information *@

                <div class="admin-profile-info">

                    <h3 class="admin-profile-name">

                        @Model.FirstName

                        @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                        {
                            <span>
                                @Model.MiddleName
                            </span>
                        }

                        @Model.LastName

                    </h3>


                    <div class="admin-profile-role">
                        Administrator
                    </div>


                    <p class="admin-profile-joined">

                        Joined
                        @Model.CreatedAt.ToString("MMMM dd, yyyy")

                    </p>


                    @* Edit Profile *@

                    <a asp-action="Edit"
                       class="admin-profile-edit-button">

                        Edit Profile

                    </a>

                </div>

            </div>


            @* =================================================
               ADMIN ACTIVITY CARD
               ================================================= *@

            <div class="admin-profile-activity-card">

                <div class="admin-profile-section-header">

                    <h4>
                        Activity
                    </h4>

                    <p>
                        Overview of your activity.
                    </p>

                </div>


                @* PetFeed Posts *@

                <div class="admin-profile-activity-item">

                    <div class="admin-profile-activity-content">

                        <strong>
                            @Model.PetFeedPostsCount
                        </strong>

                        <span>
                            PetFeed Posts
                        </span>

                    </div>

                </div>


                @* Announcements *@

                <div class="admin-profile-activity-item">

                    <div class="admin-profile-activity-content">

                        <strong>
                            @Model.AnnouncementsCount
                        </strong>

                        <span>
                            Announcements
                        </span>

                    </div>

                </div>


                @* Pet Tips *@

                <div class="admin-profile-activity-item">

                    <div class="admin-profile-activity-content">

                        <strong>
                            @Model.PetTipsCount
                        </strong>

                        <span>
                            Pet Tips
                        </span>

                    </div>

                </div>

            </div>

        </div>


        @* =====================================================
           RIGHT COLUMN
           ===================================================== *@

        <div class="admin-profile-right-column">


            @* =================================================
               ABOUT ME
               ================================================= *@

            @if (!string.IsNullOrWhiteSpace(Model.Bio))
            {
                <div class="admin-profile-information-card">

                    <div class="admin-profile-section-header">

                        <h3>
                            About Me
                        </h3>

                        <p>
                            A little about yourself.
                        </p>

                    </div>


                    <h6 class="admin-profile-subsection-title">
                        Biography
                    </h6>


                    <div class="admin-profile-information-item">

                        <span class="admin-profile-information-value">
                            @Model.Bio
                        </span>

                    </div>

                </div>
            }


            @* =================================================
               PERSONAL INFORMATION
               ================================================= *@

            <div class="admin-profile-information-card">

                <div class="admin-profile-section-header">

                    <h3>
                        Personal Information
                    </h3>

                    <p>
                        Your profile details.
                    </p>

                </div>


                @* NAME *@

                <h6 class="admin-profile-subsection-title">
                    Name
                </h6>


                <div class="admin-profile-information-grid">


                    @* First Name *@

                    <div class="admin-profile-information-item">

                        <span class="admin-profile-information-label">
                            First Name
                        </span>

                        <span class="admin-profile-information-value">
                            @Model.FirstName
                        </span>

                    </div>


                    @* Middle Name *@

                    <div class="admin-profile-information-item">

                        <span class="admin-profile-information-label">
                            Middle Name
                        </span>

                        <span class="admin-profile-information-value">

                            @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                            {
                                @Model.MiddleName
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not specified
                                </span>
                            }

                        </span>

                    </div>


                    @* Last Name *@

                    <div class="admin-profile-information-item">

                        <span class="admin-profile-information-label">
                            Last Name
                        </span>

                        <span class="admin-profile-information-value">
                            @Model.LastName
                        </span>

                    </div>

                </div>


                @* CONTACT DETAILS *@

                <h6 class="admin-profile-subsection-title">
                    Contact Details
                </h6>


                <div class="admin-profile-information-grid">


                    @* Email *@

                    <div class="admin-profile-information-item">

                        <span class="admin-profile-information-label">
                            Email Address
                        </span>

                        <span class="admin-profile-information-value">
                            @Model.Email
                        </span>

                    </div>


                    @* Contact Number *@

                    <div class="admin-profile-information-item">

                        <span class="admin-profile-information-label">
                            Contact Number
                        </span>

                        <span class="admin-profile-information-value">

                            @if (!string.IsNullOrWhiteSpace(Model.ContactNumber))
                            {
                                @Model.ContactNumber
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not specified
                                </span>
                            }

                        </span>

                    </div>

                </div>

            </div>


            @* =================================================
               ACCOUNT INFORMATION
               ================================================= *@

            <div class="admin-profile-information-card">

                <div class="admin-profile-section-header">

                    <h3>
                        Account Information
                    </h3>

                    <p>
                        Administrator account information and status.
                    </p>

                </div>


                @* ACCOUNT *@

                <h6 class="admin-profile-subsection-title">
                    Account
                </h6>


                <div class="admin-profile-information-grid">


                    @* Email Address *@

                    <div class="admin-profile-information-item">

                        <span class="admin-profile-information-label">
                            Email Address
                        </span>

                        <span class="admin-profile-information-value">
                            @Model.Email
                        </span>

                    </div>


                    @* Administrator Since *@

                    <div class="admin-profile-information-item">

                        <span class="admin-profile-information-label">
                            Administrator Since
                        </span>

                        <span class="admin-profile-information-value">
                            @Model.CreatedAt.ToString("MMMM dd, yyyy")
                        </span>

                    </div>

                </div>


                @* ACCOUNT STATUS *@

                <h6 class="admin-profile-subsection-title">
                    Account Status
                </h6>


                <div class="admin-profile-information-grid">

                    <div class="admin-profile-information-item">

                        <span class="admin-profile-information-label">
                            Status
                        </span>

                        <span class="admin-profile-information-value">
                            @Model.Status
                        </span>

                    </div>

                </div>

            </div>


            @* =================================================
               ACTIONS
               ================================================= *@

            <div class="admin-profile-information-card">

                <div class="admin-profile-section-header">

                    <h3>
                        Actions
                    </h3>

                    <p>
                        Manage your administrator profile.
                    </p>

                </div>


                <div class="admin-profile-actions">

                    <a asp-controller="AdminMyPosts"
                       asp-action="Index"
                       class="admin-profile-secondary-button">

                        Back

                    </a>


                    <a asp-action="Edit"
                       class="admin-profile-edit-button">

                        Edit Profile

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>