@model PETHUB.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Edit My Profile";
    ViewData["Province"] = Model.Province;
    ViewData["City"] = Model.City;
    ViewData["Barangay"] = Model.Barangay;
    ViewData["StreetAddress"] = Model.StreetAddress;
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <!-- ========================================================= -->
            <!-- PAGE HEADER                                                -->
            <!-- ========================================================= -->
            @if (TempData["SuccessMessage"] != null) @* Shows Success Message After Saving Changes *@
            {
                <div class="alert alert-success alert-dismissible fade show">

                    @TempData["SuccessMessage"] @* Call from TempData in MyProfileController *@

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h2 class="mb-1">Edit My Profile</h2>

                    <p class="text-muted mb-0">
                        Manage your personal information and account details.
                    </p>

                </div>

            </div>

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()
                @* Summarize overall error on validation fields *@
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>
                <!-- ========================================================= -->
                <!-- PROFILE CARD                                               -->
                <!-- ========================================================= -->

                <div class="card shadow-sm mb-4 mt-4">

                    <div class="card-body text-center">

                        <!-- Profile Picture -->
                        @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                        {
                            <img id="profilePicturePreview"
                                 src="@Model.ProfilePicturePath"
                                 class="rounded-circle border mb-3"
                                 width="180"
                                 height="180"
                                 style="object-fit:cover;" />
                        }
                        else
                        {
                            <img id="profilePicturePreview"
                                 src="~/images/default-profile.png"
                                 class="rounded-circle border mb-3"
                                 width="180"
                                 height="180"
                                 style="object-fit:cover;" />
                        }
                        <!-- Name -->

                        <h3 class="mb-1">

                            @Model.FirstName

                            @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                            {
                                @Model.MiddleName
                            }   

                            @Model.LastName

                        </h3>

                        <!-- User Type -->

                        <p class="text-muted mb-2">

                            Administrator

                        </p>

                        <!-- Joined Date -->

                        <p class="text-secondary">

                            <strong>Joined:</strong>

                            @Model.CreatedAt.ToString("MMMM dd, yyyy")

                        </p>

                        <!-- Change Profile Picture -->
                        <!-- Hidden file input used for selecting a new profile picture -->
                        <input asp-for="ProfilePictureFile"
                               type="file"
                               id="profilePictureInput"
                               accept=".jpg,.jpeg,.png,.webp"
                               class="d-none" />

                        <!-- Opens the hidden file picker -->
                        <button type="button"
                                id="changeProfilePictureBtn"
                                class="btn btn-outline-success mb-4">

                            Change Profile Picture

                        </button>

                        <span asp-validation-for="ProfilePictureFile"
                              class="text-danger d-block mt-2">
                        </span>
                        <hr />

                        <div class="border-top mt-4 pt-4">

                            <!-- ========================================================= -->
                            <!-- ADMIN ACTIVITY SUMMARY                                    -->
                            <!-- ========================================================= -->

                            <div class="row g-0 text-center">

                                <div class="col">

                                    <small class="text-muted d-block">
                                        PetFeed Posts
                                    </small>

                                    <h3 class="fw-bold mt-2 mb-0">
                                        @Model.PetFeedPostsCount
                                    </h3>

                                </div>

                                <div class="col border-start">

                                    <small class="text-muted d-block">
                                        Announcements
                                    </small>

                                    <h3 class="fw-bold mt-2 mb-0">
                                        @Model.AnnouncementsCount
                                    </h3>

                                </div>

                                <div class="col border-start">

                                    <small class="text-muted d-block">
                                        Pet Tips
                                    </small>

                                    <h3 class="fw-bold mt-2 mb-0">
                                        @Model.PetTipsCount
                                    </h3>

                                </div>

                            </div>

                            @* ========================================================= *@
                            @* ABOUT ME                                                  *@
                            @* ========================================================= *@

                            <div class="card shadow-sm mb-4 mt-4">

                                <div class="card-body text-start">

                                    <h4 class="mb-1">
                                        About Me
                                    </h4>

                                    <p class="text-muted mb-4">
                                        Share a short introduction about yourself with other administrators.
                                    </p>

                                    <h6 class="fw-bold text-success border-bottom pb-2 mb-4">
                                        Biography
                                    </h6>

                                    <textarea asp-for="Bio"
                                              rows="5"
                                              class="form-control"
                                              placeholder="Tell other administrators a little about yourself...">
                                    </textarea>
                                    <span asp-validation-for="Bio" class="text-danger"></span>
                                </div>

                            </div>

                            @* ========================================================= *@
                            @* PERSONAL INFORMATION                                      *@
                            @* ========================================================= *@

                            <div class="card shadow-sm mb-4 mt-4">

                                <div class="card-body">

                                    <h4 class="mb-1 text-start">
                                        Personal Information
                                    </h4>

                                    <p class="text-muted mb-4 text-start">
                                        Update your personal details below.
                                    </p>

                                    @* ------------------------------------------------- *@
                                    @* NAME                                              *@
                                    @* ------------------------------------------------- *@

                                    <h6 class="fw-bold text-success border-bottom pb-2 mb-4 text-start">
                                        Name
                                    </h6>

                                    <div class="row align-items-center mb-3">

                                        <div class="col-md-4">
                                            <label asp-for="FirstName" class="fw-semibold"></label>
                                        </div>

                                        <div class="col-md-8">
                                            <input asp-for="FirstName" class="form-control" />
                                            <span asp-validation-for="FirstName" class="text-danger"></span>
                                        </div>

                                    </div>

                                    <div class="row align-items-center mb-3">

                                        <div class="col-md-4">
                                            <label asp-for="MiddleName" class="fw-semibold"></label>
                                        </div>

                                        <div class="col-md-8">
                                            <input asp-for="MiddleName" class="form-control" />
                                            <span asp-validation-for="MiddleName" class="text-danger"></span>
                                        </div>

                                    </div>

                                    <div class="row align-items-center">

                                        <div class="col-md-4">
                                            <label asp-for="LastName" class="fw-semibold"></label>
                                        </div>

                                        <div class="col-md-8">
                                            <input asp-for="LastName" class="form-control" />
                                            <span asp-validation-for="LastName" class="text-danger"></span>
                                        </div>

                                    </div>

                                    @* ------------------------------------------------- *@
                                    @* CONTACT DETAILS                                   *@
                                    @* ------------------------------------------------- *@

                                    <h6 class="fw-bold text-success border-bottom pb-2 mt-5 mb-4 text-start">
                                        Contact Details
                                    </h6>

                                    <div class="row align-items-center mb-3">

                                        <div class="col-md-4">

                                            <label class="fw-semibold">
                                                Email Address
                                            </label>

                                        </div>

                                        <div class="col-md-8">

                                            <input asp-for="Email"
                                                   class="form-control"
                                                   readonly />

                                        </div>

                                    </div>

                                    <div class="row align-items-center">

                                        <div class="col-md-4">

                                            <label asp-for="ContactNumber"
                                                   class="fw-semibold">
                                            </label>

                                        </div>

                                        <div class="col-md-8">

                                            <input asp-for="ContactNumber"
                                                   class="form-control" />
                                            <span asp-validation-for="ContactNumber" class="text-danger"></span>

                                        </div>

                                    </div>

                                    @* ------------------------------------------------- *@
                                    @* PERSONAL DETAILS                                  *@
                                    @* ------------------------------------------------- *@

                                    <h6 class="fw-bold text-success border-bottom pb-2 mt-5 mb-4 text-start">
                                        Personal Details
                                    </h6>

                                    <div class="row align-items-center mb-3">

                                        <div class="col-md-4">

                                            <label asp-for="Gender"
                                                   class="fw-semibold">
                                            </label>

                                        </div>

                                        <div class="col-md-8">

                                            <select asp-for="Gender"
                                                    class="form-select">

                                                <option value="">
                                                    Select Gender
                                                </option>

                                                <option>Male</option>

                                                <option>Female</option>

                                            </select>
                                            <span asp-validation-for="Gender" class="text-danger"></span>
                                        </div>

                                    </div>

                                    <div class="row align-items-center">

                                        <div class="col-md-4">

                                            <label asp-for="Birthdate"
                                                   class="fw-semibold">
                                            </label>

                                        </div>

                                        <div class="col-md-8">

                                            <input asp-for="Birthdate"
                                                   type="date"
                                                   class="form-control" />
                                            <span asp-validation-for="Birthdate" class="text-danger"></span>
                                        </div>

                                    </div>
                                </div>

                            </div>
                            @* ========================================================= *@
                            @* ADDRESS                                                   *@
                            @* ========================================================= *@

                            <div class="card shadow-sm mb-4 mt-4">

                                <div class="card-body text-start">

                                    <h4 class="mb-1">
                                        Address
                                    </h4>

                                    <p class="text-muted mb-4">
                                        Update your residential address below.
                                    </p>

                                    @* ------------------------------------------------- *@
                                    @* LOCATION                                          *@
                                    @* ------------------------------------------------- *@

                                    <h6 class="fw-bold text-success border-bottom pb-2 mb-4">
                                        Location
                                    </h6>

                                    <partial name="Components/_EditProfileAddressFields" 
                                             model="Model"/>
                                </div>
                            </div>

                            @* ========================================================= *@
                            @* ACCOUNT INFORMATION                                       *@
                            @* ========================================================= *@

                            <div class="card shadow-sm mb-4">

                                <div class="card-body text-start">

                                    <h4 class="mb-1">
                                        Account Information
                                    </h4>

                                    <p class="text-muted mb-4">
                                        View your account information and administrator details.
                                    </p>

                                    @* ------------------------------------------------- *@
                                    @* ACCOUNT                                           *@
                                    @* ------------------------------------------------- *@

                                    <h6 class="fw-bold text-success border-bottom pb-2 mb-4">
                                        Account
                                    </h6>

                                    <div class="row align-items-center mb-3">

                                        <div class="col-md-4">
                                            <label class="fw-semibold">
                                                Email Address
                                            </label>
                                        </div>

                                        <div class="col-md-8">
                                            <input asp-for="Email"
                                                   class="form-control"
                                                   readonly />
                                        </div>

                                    </div>

                                    <div class="row align-items-center">

                                        <div class="col-md-4">
                                            <label class="fw-semibold">
                                                Administrator Since
                                            </label>
                                        </div>

                                        <div class="col-md-8">
                                            <input class="form-control"
                                                   value="@Model.CreatedAt.ToString("MMMM dd, yyyy")"
                                                   readonly />
                                        </div>

                                    </div>

                                    @* ------------------------------------------------- *@
                                    @* ACCOUNT STATUS                                    *@
                                    @* ------------------------------------------------- *@

                                    <h6 class="fw-bold text-success border-bottom pb-2 mt-5 mb-4">
                                        Account Status
                                    </h6>

                                    <div class="row align-items-center mb-3">

                                        <div class="col-md-4">
                                            <label class="fw-semibold">
                                                Status
                                            </label>
                                        </div>

                                        <div class="col-md-8">
                                            <input asp-for="Status"
                                                   class="form-control"
                                                   readonly />
                                        </div>

                                    </div>

                                    <div class="row align-items-center">

                                        <div class="col-md-4">
                                            <label class="fw-semibold">
                                                Accepted Terms
                                            </label>
                                        </div>

                                        <div class="col-md-8">

                                            <input class="form-control"
                                                   value="@(Model.AcceptedTermsDate?.ToString("MMMM dd, yyyy") ?? "Not Accepted Terms and Agreement")"
                                                   readonly />

                                        </div>

                                    </div>

                                </div>
                            </div>
                            @* ========================================================= *@
                            @* ACTIONS                                                   *@
                            @* ========================================================= *@

                            <div class="card shadow-sm mb-4">

                                <div class="card-body">

                                    <h4 class="mb-1 text-start">
                                        Actions
                                    </h4>

                                    <p class="text-muted mb-4 text-start">
                                        Review your changes before saving.
                                    </p>

                                    <div class="d-flex justify-content-end gap-2">

                                        <a asp-action="View"
                                           class="btn btn-outline-secondary">

                                            Back

                                        </a>

                                        <a asp-action="Edit"
                                           class="btn btn-outline-secondary">

                                            Cancel

                                        </a>

                                        <button type="submit"
                                                class="btn btn-success">

                                            Save Changes

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>

    @section Scripts
    {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
        <script src="~/js/address-helper.js" asp-append-version="true"></script>

        <script>

            // Wait until the page has fully loaded.
            document.addEventListener("DOMContentLoaded", function () {

            // Get the hidden file input.
            const fileInput = document.getElementById("profilePictureInput");

            // Get the visible button.
            const button = document.getElementById("changeProfilePictureBtn");

            // Clicking the button opens the hidden file selector.
            button.addEventListener("click", function () {

            fileInput.click();

            });

            });

        </script>

        <script>

            // ============================================================
            // Profile Picture Live Preview
            // ============================================================

            document.addEventListener("DOMContentLoaded", function () {

            const profilePictureInput = document.getElementById("profilePictureInput");
            const profilePicturePreview = document.getElementById("profilePicturePreview");

            // Exit safely if the controls are missing.
            if (!profilePictureInput || !profilePicturePreview)
            return;

            profilePictureInput.addEventListener("change", function () {

            if (this.files && this.files[0]) {

            const reader = new FileReader();

            reader.onload = function (e) {

            profilePicturePreview.src = e.target.result;

            };

            reader.readAsDataURL(this.files[0]);

            }

            });

            });

        </script>

    }