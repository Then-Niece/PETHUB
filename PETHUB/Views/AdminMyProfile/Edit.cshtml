@model PETHUB.ViewModels.AdminEditProfileViewModel

@{
    ViewData["Title"] = "Edit My Profile";
}


<div class="admin-edit-profile-page">

    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()


        <div class="admin-edit-profile-layout">

            <!-- ========================================================= -->
            <!-- LEFT COLUMN                                                -->
            <!-- ========================================================= -->

            <div class="admin-edit-profile-left-column">

                <!-- ===================================================== -->
                <!-- PROFILE CARD                                          -->
                <!-- ===================================================== -->

                <div class="admin-edit-profile-card">

                    <div class="admin-edit-profile-cover">
                    </div>


                    <div class="admin-edit-profile-picture-wrapper">

                        @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                        {
                            <img id="profilePicturePreview"
                                 src="@Model.ProfilePicturePath"
                                 class="admin-edit-profile-picture"
                                 alt="Profile Picture" />
                        }
                        else
                        {
                            <img id="profilePicturePreview"
                                 src="~/images/default_profile.jpg"
                                 class="admin-edit-profile-picture"
                                 alt="Default Profile Picture" />
                        }

                    </div>


                    <div class="admin-edit-profile-info">

                        <h3 class="admin-edit-profile-name">

                            @Model.FirstName

                            @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                            {
                                <span>
                                    @Model.MiddleName
                                </span>
                            }

                            @Model.LastName

                        </h3>


                        <div class="admin-edit-profile-role">
                            Administrator
                        </div>


                        <p class="admin-edit-profile-joined">

                            Joined
                            @Model.CreatedAt.ToString("MMMM dd, yyyy")

                        </p>


                        <!-- ================================================= -->
                        <!-- PROFILE PICTURE INPUT                              -->
                        <!-- ================================================= -->

                        <input asp-for="ProfilePictureFile"
                               type="file"
                               id="profilePictureInput"
                               accept=".jpg,.jpeg,.png,.webp"
                               class="d-none" />


                        <input asp-for="RemoveProfilePicture"
                               type="hidden"
                               id="RemoveProfilePicture" />


                        <!-- ================================================= -->
                        <!-- PROFILE PHOTO MODAL BUTTON                         -->
                        <!-- ================================================= -->

                        <button type="button"
                                id="openProfilePhotoModalBtn"
                                class="admin-edit-profile-photo-button">

                            Change Profile Photo

                        </button>


                        <!-- ================================================= -->
                        <!-- HELPER BUTTONS                                     -->
                        <!-- Kept hidden because profilePictureHelper.js        -->
                        <!-- continues to use these existing controls.          -->
                        <!-- ================================================= -->

                        <button type="button"
                                id="changeProfilePictureBtn"
                                class="d-none">

                            Change Profile Picture

                        </button>


                        <button type="button"
                                id="removeProfilePictureBtn"
                                class="d-none">

                            Remove Photo

                        </button>


                        <span asp-validation-for="ProfilePictureFile"
                              class="text-danger d-block mt-2">
                        </span>

                    </div>

                </div>


                <!-- ===================================================== -->
                <!-- ACTIVITY                                               -->
                <!-- ===================================================== -->

                <div class="admin-edit-profile-activity-card">

                    <div class="admin-edit-profile-section-header">

                        <h4>
                            Activity
                        </h4>

                        <p>
                            Your PetFeed activity.
                        </p>

                    </div>


                    <div class="admin-edit-profile-activity-list">

                        <div class="admin-edit-profile-activity-item">

                            <div class="admin-edit-profile-activity-content">

                                <strong>
                                    @Model.PetFeedPostsCount
                                </strong>

                                <span>
                                    PetFeed Posts
                                </span>

                            </div>

                        </div>


                        <div class="admin-edit-profile-activity-item">

                            <div class="admin-edit-profile-activity-content">

                                <strong>
                                    @Model.AnnouncementsCount
                                </strong>

                                <span>
                                    Announcements
                                </span>

                            </div>

                        </div>


                        <div class="admin-edit-profile-activity-item">

                            <div class="admin-edit-profile-activity-content">

                                <strong>
                                    @Model.PetTipsCount
                                </strong>

                                <span>
                                    Pet Tips
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ========================================================= -->
            <!-- RIGHT COLUMN                                               -->
            <!-- ========================================================= -->

            <div class="admin-edit-profile-right-column">

                <!-- Display model-level validation errors. -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- ===================================================== -->
                <!-- ABOUT ME                                               -->
                <!-- ===================================================== -->
                <!--
                    Preserved from the other branch so the Administrator's
                    biography remains editable in the redesigned page.
                -->

                <div class="admin-edit-profile-information-card">

                    <div class="admin-edit-profile-section-header">

                        <h3>
                            About Me
                        </h3>

                        <p>
                            Share a short introduction about yourself with other administrators.
                        </p>

                    </div>


                    <h6 class="admin-edit-profile-subsection-title">
                        Biography
                    </h6>


                    <div class="admin-edit-profile-information-item">

                        <textarea asp-for="Bio"
                                  rows="5"
                                  class="form-control"
                                  placeholder="Tell other administrators a little about yourself...">
                        </textarea>

                        <span asp-validation-for="Bio"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- ===================================================== -->
                <!-- PERSONAL INFORMATION                                   -->
                <!-- ===================================================== -->

                <div class="admin-edit-profile-information-card">

                    <div class="admin-edit-profile-section-header">

                        <h3>
                            Personal Information
                        </h3>

                        <p>
                            Update your personal details below.
                        </p>

                    </div>


                    <!-- ------------------------------------------------- -->
                    <!-- NAME                                               -->
                    <!-- ------------------------------------------------- -->

                    <h6 class="admin-edit-profile-subsection-title">
                        Name
                    </h6>


                    <div class="admin-edit-profile-information-grid">

                        <div class="admin-edit-profile-information-item">

                            <label asp-for="FirstName"
                                   class="admin-edit-profile-information-label">
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="admin-edit-profile-information-item">

                            <label asp-for="MiddleName"
                                   class="admin-edit-profile-information-label">
                            </label>

                            <input asp-for="MiddleName"
                                   class="form-control" />

                            <span asp-validation-for="MiddleName"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="admin-edit-profile-information-item">

                            <label asp-for="LastName"
                                   class="admin-edit-profile-information-label">
                            </label>

                            <input asp-for="LastName"
                                   class="form-control" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- ------------------------------------------------- -->
                    <!-- CONTACT DETAILS                                    -->
                    <!-- ------------------------------------------------- -->

                    <h6 class="admin-edit-profile-subsection-title">
                        Contact Details
                    </h6>


                    <div class="admin-edit-profile-information-grid">

                        <div class="admin-edit-profile-information-item">

                            <label class="admin-edit-profile-information-label">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   readonly />

                        </div>


                        <div class="admin-edit-profile-information-item">

                            <label asp-for="ContactNumber"
                                   class="admin-edit-profile-information-label">
                            </label>

                            <input asp-for="ContactNumber"
                                   class="form-control" />

                            <span asp-validation-for="ContactNumber"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- ===================================================== -->
                <!-- ACCOUNT INFORMATION                                    -->
                <!-- ===================================================== -->

                <div class="admin-edit-profile-information-card">

                    <div class="admin-edit-profile-section-header">

                        <h3>
                            Account Information
                        </h3>

                        <p>
                            View your account information and administrator details.
                        </p>

                    </div>


                    <!-- ------------------------------------------------- -->
                    <!-- ACCOUNT                                            -->
                    <!-- ------------------------------------------------- -->

                    <h6 class="admin-edit-profile-subsection-title">
                        Account
                    </h6>


                    <div class="admin-edit-profile-information-grid">

                        <div class="admin-edit-profile-information-item">

                            <label class="admin-edit-profile-information-label">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   readonly />

                        </div>


                        <div class="admin-edit-profile-information-item">

                            <label class="admin-edit-profile-information-label">
                                Administrator Since
                            </label>

                            <input class="form-control"
                                   value="@Model.CreatedAt.ToString("MMMM dd, yyyy")"
                                   readonly />

                        </div>

                    </div>


                    <!-- ------------------------------------------------- -->
                    <!-- ACCOUNT STATUS                                     -->
                    <!-- ------------------------------------------------- -->

                    <h6 class="admin-edit-profile-subsection-title">
                        Account Status
                    </h6>


                    <div class="admin-edit-profile-information-grid">

                        <div class="admin-edit-profile-information-item">

                            <label class="admin-edit-profile-information-label">
                                Status
                            </label>

                            <input asp-for="Status"
                                   class="form-control"
                                   readonly />

                        </div>

                    </div>

                </div>


                <!-- ===================================================== -->
                <!-- ACTIONS                                                -->
                <!-- ===================================================== -->

                <div class="admin-edit-profile-actions-card">

                    <div class="admin-edit-profile-actions">

                        <!--
                            Return to the Administrator's profile without
                            submitting any changes.
                        -->
                        <a asp-action="View"
                           class="admin-edit-profile-cancel-button">

                            Cancel

                        </a>


                        <button type="submit"
                                class="admin-edit-profile-save-button">

                            Save Changes

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </form>


    @* =============================================================
       PROFILE PHOTO MODAL

       The redesigned page uses a modal while still reusing the
       existing profilePictureHelper.js functionality underneath.
       ============================================================= *@

    <div id="profilePhotoModal"
         class="admin-edit-profile-photo-modal"
         aria-hidden="true">

        <div class="admin-edit-profile-photo-modal-backdrop"
             id="profilePhotoModalBackdrop">
        </div>


        <div class="admin-edit-profile-photo-modal-content"
             role="dialog"
             aria-modal="true"
             aria-labelledby="profilePhotoModalTitle">


            <div class="admin-edit-profile-photo-modal-header">

                <h4 id="profilePhotoModalTitle">
                    Change Profile Photo
                </h4>

            </div>


            <div class="admin-edit-profile-photo-modal-body">

                <button type="button"
                        id="modalUploadProfilePhotoBtn"
                        class="admin-edit-profile-photo-modal-button">

                    Upload Photo

                </button>


                <button type="button"
                        id="modalRemoveProfilePhotoBtn"
                        class="admin-edit-profile-photo-modal-button admin-edit-profile-photo-remove-button">

                    Remove Current Photo

                </button>


                <button type="button"
                        id="closeProfilePhotoModalBtn"
                        class="admin-edit-profile-photo-modal-button admin-edit-profile-photo-cancel-button">

                    Cancel

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script src="~/js/profilePictureHelper.js"></script>


    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // =========================================================
            // PROFILE PHOTO MODAL
            // =========================================================

            const modal =
                document.getElementById("profilePhotoModal");

            const openModalButton =
                document.getElementById("openProfilePhotoModalBtn");

            const closeModalButton =
                document.getElementById("closeProfilePhotoModalBtn");

            const backdrop =
                document.getElementById("profilePhotoModalBackdrop");

            const existingChangeButton =
                document.getElementById("changeProfilePictureBtn");

            const existingRemoveButton =
                document.getElementById("removeProfilePictureBtn");

            const modalUploadButton =
                document.getElementById("modalUploadProfilePhotoBtn");

            const modalRemoveButton =
                document.getElementById("modalRemoveProfilePhotoBtn");


            function openProfilePhotoModal() {

                if (!modal) {
                    return;
                }

                modal.classList.add("show");

                modal.setAttribute(
                    "aria-hidden",
                    "false"
                );
            }


            function closeProfilePhotoModal() {

                if (!modal) {
                    return;
                }

                modal.classList.remove("show");

                modal.setAttribute(
                    "aria-hidden",
                    "true"
                );
            }


            if (openModalButton) {

                openModalButton.addEventListener(
                    "click",
                    function () {

                        openProfilePhotoModal();

                    }
                );
            }


            if (closeModalButton) {

                closeModalButton.addEventListener(
                    "click",
                    function () {

                        closeProfilePhotoModal();

                    }
                );
            }


            if (backdrop) {

                backdrop.addEventListener(
                    "click",
                    function () {

                        closeProfilePhotoModal();

                    }
                );
            }


            // =========================================================
            // UPLOAD PHOTO
            // =========================================================

            if (modalUploadButton &&
                existingChangeButton) {

                modalUploadButton.addEventListener(
                    "click",
                    function () {

                        existingChangeButton.click();

                        closeProfilePhotoModal();

                    }
                );
            }


            // =========================================================
            // REMOVE PHOTO
            // =========================================================

            if (modalRemoveButton &&
                existingRemoveButton) {

                modalRemoveButton.addEventListener(
                    "click",
                    function () {

                        existingRemoveButton.click();

                        closeProfilePhotoModal();

                    }
                );
            }


            // =========================================================
            // ESCAPE KEY CLOSES MODAL
            // =========================================================

            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Escape" &&
                        modal &&
                        modal.classList.contains("show")
                    ) {

                        closeProfilePhotoModal();
                    }

                }
            );


            // =========================================================
            // EXISTING PROFILE PICTURE HELPER
            // =========================================================

            setupProfilePicture();

        });
    </script>
}