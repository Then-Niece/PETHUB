@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
    var action = ViewContext.RouteData.Values["Action"]?.ToString();

    bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    bool isAdmin = User.IsInRole("Admin");
    bool isMember = User.IsInRole("Member");

    // Shared Pages (Member & Admin)
    bool isFeed = controller == "PetFeeds" && action == "Feed";
    bool isMarketplace = controller == "Listings" && action == "Marketplace";
    bool isLostFound = controller == "LostFounds" && action == "Browse";

    // Member Pages
    bool isMyPosts = controller == "MyPosts";

    // Admin Pages
    bool isMembers = controller == "Members";
    bool isAdmins = controller == "Admins";
    bool isMarketplaceApproval = controller == "MarketplaceApprovals";
    bool isLostFoundApproval = controller == "LostFoundApprovals";
}

<header>

    @* Guest Navbar *@
    @if (!isAuthenticated)
    {
        <nav class="navbar navbar-expand-lg bg-white shadow-sm navbar-custom">

            <div class="container-fluid px-4">

                <!-- Logo -->
                <a class="navbar-brand fw-bold fs-3 d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="PublicLandingPage"
                   style="color:#2D3748;">

                    <img src="/images/PETHUB-LOGO.png"
                         alt="PetHub Logo"
                         class="navbar-logo me-2" />

                    PetHub

                </a>

               
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#guestNavbar">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse justify-content-end"
                     id="guestNavbar">

                    <ul class="navbar-nav align-items-center gap-lg-3">

                        <li class="nav-item">
                            <a class="nav-link fw-semibold"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-semibold"
                               asp-controller="Listings"
                               asp-action="Marketplace">
                                Marketplace
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-semibold"
                               asp-controller="LostFounds"
                               asp-action="Browse">
                                Lost &amp; Found
                            </a>
                        </li>

                        <li class="nav-item mx-2">
                            <a class="nav-link fw-semibold" asp-controller="PetFeeds" asp-action="Feed">
                                PetFeed
                            </a>
                        </li>
                            
                        <li class="nav-item ms-lg-2">
                            <a asp-controller="UserAccount"
                               asp-action="Login"
                               class="btn rounded-pill px-4 fw-semibold text-white"
                               style="background:#8ACE79; border:none;">

                                Login

                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>
    }

    @* Member/Admin Navbar *@
    else
    {
        <nav class="navbar navbar-expand-lg bg-white shadow-sm navbar-custom">

            <div class="container-fluid px-4">

                <!-- Left Side -->
                <div class="d-flex align-items-center">

                    <button id="sidebarToggle"
                            class="btn border-0 me-3"
                            type="button">

                        <i data-lucide="menu"></i>

                    </button>

                    <a class="navbar-brand fw-bold fs-3 d-flex align-items-center mb-0"
                       asp-controller="Home"
                       asp-action="PublicLandingPage"
                       style="color:#2D3748;">

                        <img src="/images/PETHUB-LOGO.png"
                             class="navbar-logo me-2"
                             alt="PetHub Logo" />

                        PetHub

                    </a>

                </div>

                <!-- Center -->
                <div class="flex-grow-1 d-flex justify-content-center">

                    @* PetFeed *@
                    @if (isFeed)
                    {
                        <div class="navbar-search">
                            <div class="input-group">

                                <span class="input-group-text">
                                    <i data-lucide="search"></i>
                                </span>

                                <input class="form-control"
                                       type="text"
                                       placeholder="Search PetHub..." />

                            </div>
                        </div>
                    }

                    @*Marketplace *@
                    else if (isMarketplace)
                    {
                        <div class="d-flex align-items-center gap-2">

            

                            <h5 class="mb-0 fw-semibold">
                                Pet Marketplace
                            </h5>

                        </div>
                    }

                    @*Lost & Found *@
                    else if (isLostFound)
                    {
                        <div class="d-flex align-items-center gap-2">


                            <h5 class="mb-0 fw-semibold">
                                Lost &amp; Found
                            </h5>

                        </div>
                    }

                    @* My Post *@
                    else if (isMyPosts)
                    {
                        <div class="d-flex align-items-center gap-2">

                            

                        </div>
                    }

                    @* Members *@
                    else if (isMembers)
                    {
                        <div class="d-flex align-items-center gap-2">

                            <i data-lucide="users"></i>

                            <h5 class="mb-0 fw-semibold">
                                Members
                            </h5>

                        </div>
                    }

                    @*  Admin *@
                    else if (isAdmins)
                    {
                        <div class="d-flex align-items-center gap-2">

                            <i data-lucide="shield"></i>

                            <h5 class="mb-0 fw-semibold">
                                Administrators
                            </h5>

                        </div>
                    }

                    @* Marketplace Approval*@
                    else if (isMarketplaceApproval)
                    {
                        <div class="d-flex align-items-center gap-2">

                            <i data-lucide="badge-check"></i>

                            <h5 class="mb-0 fw-semibold">
                                Marketplace Approval
                            </h5>

                        </div>
                    }

                    @* Lost & Found Approval *@
                    else if (isLostFoundApproval)
                    {
                        <div class="d-flex align-items-center gap-2">

                            <i data-lucide="flag"></i>

                            <h5 class="mb-0 fw-semibold">
                                Lost &amp; Found Approval
                            </h5>

                        </div>
                    }

                </div>

                <!-- Right Side -->
                <div class="navbar-actions">

                    <button class="navbar-icon-btn ">
                        <i data-lucide="message-circle"></i>
                    </button>

                    <button class="navbar-icon-btn ">
                        <i data-lucide="bell"></i>
                    </button>

                    <!-- Profile -->
                    <div class="dropdown">

                        <button class="profile-button"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <div class="profile-avatar">

@*                                 <img src="@Model.ProfilePicturePath"
 *@                                     
                                <img src="~/uploads/clientids/"
                                     alt="Profile" />

                            </div>

                            <i data-lucide="chevron-down"
                               class="profile-chevron"></i>

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown p-2">

                            <li class="px-3 py-2">

                                <div class="d-flex align-items-center gap-3">

                                    <div class="profile-avatar profile-avatar-large">

                                        <img src="~/images/default_profile.jpg"
                                             alt="Profile" />

                                    </div>

                                    <div>

                                        <div class="fw-bold">

                                            @User.Identity!.Name

                                        </div>

                                        <small class="text-muted">

                                            @(isAdmin ? "Administrator" : "Member")

                                        </small>

                                    </div>

                                </div>

                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>
                                @if(User.IsInRole("Admin"))
                                {
                                    <a class="dropdown-item py-2"
                                       asp-controller="PetFeeds"
                                       asp-action="Index">

                                        <i data-lucide="user"
                                           class="me-2"></i>

                                        Dashboard
                                    </a>

                                }
                                else if (User.IsInRole("Member"))
                                {
                                     <a class="dropdown-item py-2"
                                       asp-controller="MyPosts"
                                        asp-action="Index">

                                        <i data-lucide="user"
                                           class="me-2"></i>

                                        My Profile
                                    </a>
                                }

                            </li>

                            <li>

                                <a class="dropdown-item py-2"
                                   href="#">

                                    <i data-lucide="settings"
                                       class="me-2"></i>

                                    Settings

                                </a>

                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>

                                <form asp-controller="UserAccount"
                                      asp-action="Logout"
                                      method="post">

                                    <button type="submit"
                                            class="dropdown-item py-2">

                                        <i data-lucide="log-out"
                                           class="me-2"></i>

                                        Logout

                                    </button>

                                </form>

                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </nav>
    }

</header>