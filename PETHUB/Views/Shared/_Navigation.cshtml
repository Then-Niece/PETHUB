@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

<header>

        <div class="container-fluid">

            <!-- NEW NAV -->
            <nav class="navbar navbar-expand-lg sticky-top bg-white py-3 shadow-sm">
                <div class="container">

                    <!-- Logo -->
                    <a class="navbar-brand fw-bold fs-3 d-flex align-items-center"
                       asp-controller="Home"
                       asp-action="PublicLandingPage"
                       style="color:#2D3748;">

                        <span class="me-2" style="color:#8ACE79;">logo</span>
                        PetHub
                    </a>

                    <!-- Mobile Button -->
                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbar">

                        <span class="navbar-toggler-icon"></span>

                    </button>

                    <div class="navbar-collapse justify-content-end collapse"
                         id="navbar">


                        <!-- Buttons -->
                        <div class="d-flex gap-3">

                        <!-- Navigation -->
                        <ul class="navbar-nav">

                             @* ==========================================================
                                                     CLIENT ONLY
                               ========================================================== *@

                            @if (!User.Identity!.IsAuthenticated)
                            {
                                <li class="nav-item mx-2">
                                    <a class="nav-link fw-semibold" asp-controller="Home"
                                       asp-action="Index">
                                        Home
                                    </a>
                                </li>

                                <li class="nav-item mx-2">
                                    <a class="nav-link fw-semibold" asp-controller="LostFounds"
                                       asp-action="Browse">
                                        Lost & Found
                                    </a>
                                </li>

                                <li class="nav-item mx-2">
                                    <a class="nav-link fw-semibold" asp-controller="Listings"
                                       asp-action="Marketplace">
                                        Marketplace
                                    </a>
                                </li>

                                <li class="nav-item mx-2">
                                    <a class="nav-link fw-semibold" asp-controller="LostFounds"
                                       asp-action="Browse">
                                        About
                                    </a>
                                </li>
                            }
                        </ul>

                        <ul class="navbar-nav d-flex gap-3">

                            @if (!User.Identity!.IsAuthenticated)
                            {
                                <a asp-controller="UserAccount"
                                   asp-action="Login"
                                   class="btn rounded-pill fw-semibold px-4 text-white"
                                   style="
                                    background:#8ACE79;
                                    border:none;
                                    transition:.3s;"
                                   onmouseover="this.style.background='#6FBF5E'"
                                   onmouseout="this.style.background='#8ACE79'">
                                    Login
                                </a>
                            }
                            else
                            {
                                <li class="nav-item">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="nav-link text-muted">
                                            Hello, Admin @User.Identity.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="nav-link text-muted">
                                            Hello, @User.Identity.Name
                                        </span>
                                    }

                                </li>

                                <li class="nav-item">
                                    <form asp-controller="UserAccount"
                                            asp-action="Logout"
                                            method="post"
                                            class="d-inline">

                                        <button type="submit"
                                                class="nav-link btn btn-link">
                                            Logout
                                        </button>

                                    </form>
                                </li>
                            }

                            </ul>
                        </ul>
                    </div>

                </div>

            </nav>
        </div>
</header>