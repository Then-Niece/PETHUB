<!-- =========================================================
     SHARED SYSTEM MODAL
========================================================= -->

<div class="modal fade"
     id="systemModal"
     tabindex="-1"
     aria-labelledby="systemModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content system-modal">

            <div class="modal-body">

                <div id="systemModalIcon"
                     class="system-modal-icon error">

                    <i data-lucide="triangle-alert"></i>

                </div>


                <h3 id="systemModalTitle"
                    class="system-modal-title">

                    Something went wrong

                </h3>


                <div id="systemModalMessage"
                     class="system-modal-message">

                    Please try again.

                </div>


                <div class="system-modal-actions">

                    <button type="button"
                            id="systemModalPrimaryButton"
                            class="system-modal-button primary"
                            data-bs-dismiss="modal">

                        Okay

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>