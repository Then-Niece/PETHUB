@{
}

<div class="my-posts-profile-card">

    <!-- ==========================================================
         PROFILE INFORMATION
    ========================================================== -->

    <div class="my-posts-profile-info">

        <!-- Profile Picture -->
        @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
        {
            <img id="profilePicturePreview"
                 src="@Model.ProfilePicturePath"
                 class="my-posts-profile-picture"
                 alt="Profile Picture" />
        }
        else
        {
            <img id="profilePicturePreview"
                 src="~/images/default_profile.jpg"
                 class="my-posts-profile-picture"
                 alt="Default Profile Picture" />
        }


        <!-- Name + Membership -->

        <div class="my-posts-profile-details">

            <h3>

                @Model.FirstName

                @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                {
                    @Model.MiddleName
                }

                @Model.LastName

            </h3>

            <p>
                Member since @Model.CreatedAt.ToString("MMM dd, yyyy")
            </p>

        </div>


        <!-- Horizontal Three-Dot Menu -->

        <div class="dropdown my-posts-profile-dropdown">

            <button class="my-posts-profile-menu"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Profile options">

                <i data-lucide="ellipsis"></i>

            </button>

            <ul class="dropdown-menu dropdown-menu-end">

                <li>
                    <a asp-controller="MyProfile"
                       asp-action="View"
                       class="dropdown-item">
                        Personal Details
                    </a>
                </li>

                <li>
                    <a href="#"
                       class="dropdown-item">
                        Archive
                    </a>
                </li>

                <li>
                    <a href="#"
                       class="dropdown-item">
                        Settings
                    </a>
                </li>

            </ul>

        </div>

    </div>


    <!-- ==========================================================
         ACTIVITY SUMMARY
    ========================================================== -->

    <div class="my-posts-activity-summary">

        <div class="my-posts-stat">

            <strong>
                @Model.MarketplaceListingsCount
            </strong>

            <span>
                Marketplace Listings
            </span>

        </div>

        <div class="my-posts-stat">

            <strong>
                @Model.LostFoundReportsCount
            </strong>

            <span>
                Lost &amp; Found Reports
            </span>

        </div>

        <div class="my-posts-stat">

            <strong>
                @Model.PetsSoldCount
            </strong>

            <span>
                Sold
            </span>

        </div>

        <div class="my-posts-stat">

            <strong>
                @Model.PetsAdoptedCount
            </strong>

            <span>
                Adopted
            </span>

        </div>

        <div class="my-posts-stat">

            <strong>
                @Model.ResolvedReportsCount
            </strong>

            <span>
                Resolved Reports
            </span>

        </div>

    </div>

</div>