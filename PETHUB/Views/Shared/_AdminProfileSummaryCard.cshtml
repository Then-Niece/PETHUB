@*
    Admin Profile Summary Card
*@

<div class="admin-profile-card">

    <!-- =========================================================
         PROFILE INFORMATION
    ========================================================== -->

    <div class="admin-profile-info">

        <!-- Profile Picture -->
        @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
        {
            <img id="profilePicturePreview"
                 src="@Model.ProfilePicturePath"
                 class="admin-profile-picture"
                 alt="Profile Picture" />
        }
        else
        {
            <img id="profilePicturePreview"
                 src="~/images/default_profile.jpg"
                 class="admin-profile-picture"
                 alt="Default Profile Picture" />
        }

        <!-- Name + Administrator Since -->
        <div class="admin-profile-details">

            <h3>
                @Model.FirstName

                @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                {
                    @Model.MiddleName
                }

                @Model.LastName
            </h3>

            <p>
                Administrator since @Model.CreatedAt.ToString("MMM dd, yyyy")
            </p>

        </div>

        <!-- Three-Dot Menu -->
        <div class="dropdown admin-profile-dropdown">

            <button class="admin-profile-menu"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Profile options">

                <i data-lucide="ellipsis"></i>

            </button>

            <ul class="dropdown-menu dropdown-menu-end">

                <li>
                    <a asp-controller="AdminMyProfile"
                       asp-action="View"
                       class="dropdown-item">
                        Personal Details
                    </a>
                </li>

                <li>
                    <a href="#"
                       class="dropdown-item">
                        Archive
                    </a>
                </li>

                <li>
                    <a href="#"
                       class="dropdown-item">
                        Settings
                    </a>
                </li>

            </ul>

        </div>

    </div>


    <!-- =========================================================
         ADMIN ACTIVITY SUMMARY
    ========================================================== -->

    <div class="admin-profile-stats">

        <div class="admin-profile-stat">

            <strong>
                @Model.PetFeedPostsCount
            </strong>

            <span>
                PetFeed Posts
            </span>

        </div>


        <div class="admin-profile-stat">

            <strong>
                @Model.AnnouncementsCount
            </strong>

            <span>
                Announcements
            </span>

        </div>


        <div class="admin-profile-stat">

            <strong>
                @Model.PetTipsCount
            </strong>

            <span>
                Pet Tips
            </span>

        </div>

    </div>

</div>