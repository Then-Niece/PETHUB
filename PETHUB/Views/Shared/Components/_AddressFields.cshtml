@*
    Reusable address fields component.

    Address logic:
        address-helper.js

    Dropdown appearance:
        custom-select.js
        custom-select.css
*@


<div class="row g-3">


    <!-- =====================================================
         PROVINCE
    ====================================================== -->

    <div class="col-md-6">

        <label for="Province"
               class="form-label">

            Province

        </label>


        <div class="pethub-select-wrapper">


            <!-- REAL SELECT -->

            <select id="Province"
                    name="Province"
                    class="pethub-select-native"
                    data-selected="@ViewData["Province"]">

                <option value="">
                    Select Province
                </option>

            </select>


            <!-- CUSTOM VISUAL SELECT -->

            <button type="button"
                    class="pethub-select-trigger placeholder"
                    data-select-target="Province">

                <span class="pethub-select-text">
                    Select Province
                </span>

                <i data-lucide="chevron-down"></i>

            </button>


            <!-- CUSTOM OPTIONS -->

            <div class="pethub-select-menu"
                 data-menu-for="Province">
            </div>


        </div>

    </div>



    <!-- =====================================================
         CITY
    ====================================================== -->

    <div class="col-md-6">

        <label for="City"
               class="form-label">

            City

        </label>


        <div class="pethub-select-wrapper">


            <select id="City"
                    name="City"
                    class="pethub-select-native"
                    data-selected="@ViewData["City"]"
                    disabled>

                <option value="">
                    Select City
                </option>

            </select>


            <button type="button"
                    class="pethub-select-trigger placeholder disabled"
                    data-select-target="City"
                    disabled>

                <span class="pethub-select-text">
                    Select City
                </span>

                <i data-lucide="chevron-down"></i>

            </button>


            <div class="pethub-select-menu"
                 data-menu-for="City">
            </div>


        </div>

    </div>



    <!-- =====================================================
         BARANGAY
    ====================================================== -->

    <div class="col-md-6">

        <label for="Barangay"
               class="form-label">

            Barangay

        </label>


        <div class="pethub-select-wrapper">


            <select id="Barangay"
                    name="Barangay"
                    class="pethub-select-native"
                    data-selected="@ViewData["Barangay"]"
                    disabled>

                <option value="">
                    Select Barangay
                </option>

            </select>


            <button type="button"
                    class="pethub-select-trigger placeholder disabled"
                    data-select-target="Barangay"
                    disabled>

                <span class="pethub-select-text">
                    Select Barangay
                </span>

                <i data-lucide="chevron-down"></i>

            </button>


            <div class="pethub-select-menu"
                 data-menu-for="Barangay">
            </div>


        </div>

    </div>



    <!-- =====================================================
         STREET ADDRESS
    ====================================================== -->

    <div class="col-md-6">

        <label for="StreetAddress"
               class="form-label">

            Street Address

        </label>


        <input type="text"
               id="StreetAddress"
               name="StreetAddress"
               class="form-control pethub-address-input"
               value="@ViewData["StreetAddress"]"
               placeholder="Enter street address" />
    </div>


</div>