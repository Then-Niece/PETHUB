@model PETHUB.ViewModels.EditProfileViewModel

@*
    Reusable Edit Profile Address Fields

    Uses:
        address-helper.js
        custom-select.js
        custom-select.css

    Keeps ASP.NET MVC validation/model binding
    through asp-for on the real select/input fields.
*@


<div class="row g-3">


    <!-- =====================================================
         PROVINCE
    ====================================================== -->

    <div class="col-md-6">

        <label asp-for="Province"
               class="form-label">
        </label>


        <div class="pethub-select-wrapper">


            <!-- REAL SELECT -->

            <select asp-for="Province"
                    id="Province"
                    class="pethub-select-native"
                    data-selected="@Model.Province">

                <option value="">
                    Select Province
                </option>

            </select>


            <!-- CUSTOM VISUAL SELECT -->

            <button type="button"
                    class="pethub-select-trigger placeholder"
                    data-select-target="Province">

                <span class="pethub-select-text">
                    Select Province
                </span>

                <i data-lucide="chevron-down"></i>

            </button>


            <!-- CUSTOM OPTIONS -->

            <div class="pethub-select-menu"
                 data-menu-for="Province">
            </div>


        </div>


        <span asp-validation-for="Province"
              class="text-danger">
        </span>

    </div>



    <!-- =====================================================
         CITY
    ====================================================== -->

    <div class="col-md-6">

        <label asp-for="City"
               class="form-label">
        </label>


        <div class="pethub-select-wrapper">


            <!-- REAL SELECT -->

            <select asp-for="City"
                    id="City"
                    class="pethub-select-native"
                    data-selected="@Model.City"
                    disabled>

                <option value="">
                    Select City
                </option>

            </select>


            <!-- CUSTOM VISUAL SELECT -->

            <button type="button"
                    class="pethub-select-trigger placeholder disabled"
                    data-select-target="City"
                    disabled>

                <span class="pethub-select-text">
                    Select City
                </span>

                <i data-lucide="chevron-down"></i>

            </button>


            <!-- CUSTOM OPTIONS -->

            <div class="pethub-select-menu"
                 data-menu-for="City">
            </div>


        </div>


        <span asp-validation-for="City"
              class="text-danger">
        </span>

    </div>



    <!-- =====================================================
         BARANGAY
    ====================================================== -->

    <div class="col-md-6">

        <label asp-for="Barangay"
               class="form-label">
        </label>


        <div class="pethub-select-wrapper">


            <!-- REAL SELECT -->

            <select asp-for="Barangay"
                    id="Barangay"
                    class="pethub-select-native"
                    data-selected="@Model.Barangay"
                    disabled>

                <option value="">
                    Select Barangay
                </option>

            </select>


            <!-- CUSTOM VISUAL SELECT -->

            <button type="button"
                    class="pethub-select-trigger placeholder disabled"
                    data-select-target="Barangay"
                    disabled>

                <span class="pethub-select-text">
                    Select Barangay
                </span>

                <i data-lucide="chevron-down"></i>

            </button>


            <!-- CUSTOM OPTIONS -->

            <div class="pethub-select-menu"
                 data-menu-for="Barangay">
            </div>


        </div>


        <span asp-validation-for="Barangay"
              class="text-danger">
        </span>

    </div>



    <!-- =====================================================
         STREET ADDRESS
    ====================================================== -->

    <div class="col-md-6">

        <label asp-for="StreetAddress"
               class="form-label">
        </label>


        <input asp-for="StreetAddress"
               id="StreetAddress"
               class="form-control pethub-address-input"
               placeholder="Enter street address" />


        <span asp-validation-for="StreetAddress"
              class="text-danger">
        </span>

    </div>


</div>