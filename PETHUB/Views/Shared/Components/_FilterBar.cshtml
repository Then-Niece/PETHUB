@model PETHUB.ViewModels.FilterBarViewModel

<div class="d-flex gap-3 mt-4 mb-4 align-items-end">

    @foreach (var filter in Model.Filters)
    {
        // Use the current selected value when available.
        // Otherwise, use the default configured by the helper.
        var selectedValue = filter.SelectedValue ?? filter.DefaultValue;

        <div style="width: 200px;">

            @* Display the label belonging to this individual filter. *@
            <label class="form-label">
                @filter.Label
            </label>

            <select class="form-select"
                    onchange="window.location.href = this.value;">

                @foreach (var option in filter.Options)
                {
                    // Copy the existing query parameters so changing this
                    // filter does not reset another active filter.
                    var query = Context.Request.Query
                        .ToDictionary(
                            item => item.Key,
                            item => item.Value.ToString()
                        );

                    // Replace only the current filter's query parameter.
                    if (string.IsNullOrEmpty(option.Value))
                    {
                        query.Remove(filter.ParameterName);
                    }
                    else
                    {
                        query[filter.ParameterName] = option.Value;
                    }

                    // Build the query string for the selected option.
                    var queryString = string.Join(
                        "&",
                        query.Select(
                            item => $"{item.Key}={Uri.EscapeDataString(item.Value)}"
                        )
                    );

                    // Get the current page URL.
                    var baseUrl = Context.Request.Path.ToString();

                    // Add the query string only when one exists.
                    var optionUrl = string.IsNullOrEmpty(queryString)
                        ? baseUrl
                        : $"{baseUrl}?{queryString}";

                    // Keep the current option selected after the page reloads.
                    var isSelected = option.Value == selectedValue;

                    <option value="@optionUrl"
                            selected="@isSelected">
                        @option.Label
                    </option>
                }

            </select>

        </div>
    }

</div>