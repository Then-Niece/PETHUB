<nav class="sidebar-nav">

    <!-- ==========================================
     ADMIN / MEMBER VIEW TOGGLE

     This switch will allow an Admin to change
     the sidebar between:

     - Admin View
     - Member View
     
     ========================================== -->

    <div class="sidebar-view-toggle">

        <div class="sidebar-view-toggle-content">

            <div class="sidebar-view-toggle-label">

                <i data-lucide="eye"></i>

                <span class="sidebar-text">
                    Member View
                </span>

            </div>

            <div class="form-check form-switch m-0">

                <input class="form-check-input"
                       type="checkbox"
                       id="memberViewToggle"
                       role="switch"
                       aria-label="Toggle Member View">

            </div>

        </div>

    </div>

    <hr class="sidebar-divider" />

    <div id="memberNavigation">

        <!-- Explore -->
        <div class="sidebar-section">

            <h6 class="sidebar-section-title">
                Explore
            </h6>


            <!-- Home -->
            <a asp-controller="PetFeeds"
               asp-action="Feed"
               class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "PetFeeds" &&
                                                                      ViewContext.RouteData.Values["Action"]?.ToString() == "Feed" ? "active" : "")">

                <i data-lucide="house"></i>

                <span class="sidebar-text">
                    Home
                </span>

            </a>

            <!-- Marketplace -->
            <a asp-controller="Listings"
               asp-action="Marketplace"
               class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Listings" &&
                                                                      ViewContext.RouteData.Values["Action"]?.ToString() == "Marketplace" ? "active" : "")">

                <i data-lucide="shopping-bag"></i>

                <span class="sidebar-text">
                    Marketplace
                </span>

            </a>


            <!-- Lost & Found -->
            <a asp-controller="LostFounds"
               asp-action="Browse"
               class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "LostFounds" &&
                                                                      ViewContext.RouteData.Values["Action"]?.ToString() == "Browse" ? "active" : "")">

                <i data-lucide="search"></i>

                <span class="sidebar-text">
                    Lost &amp; Found
                </span>

            </a>

        </div>
    </div>


    <!-- ==========================================
         ADMIN NAVIGATION

         These links are specific to the Admin.

         Later, the View toggle will hide/show this
         entire section.
         ========================================== -->

    <div id="adminNavigation">

        <!-- Administration -->
        <div class="sidebar-section">

            <h6 class="sidebar-section-title">
                Administration
            </h6>


            <!-- Dashboard -->
            <a asp-controller="AdminDashboard"
               asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminDashboard" &&
                                                                          ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">

                <i data-lucide="layout-dashboard"></i>

                <span class="sidebar-text">
                    Dashboard
                </span>

            </a>

            <!-- Pet Feed -->
            <a asp-controller="PetFeeds"
               asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "PetFeed" &&
                                                                          ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">

                <i data-lucide="paw-print"></i>

                <span class="sidebar-text">
                    Pet Feed
                </span>

            </a>


        </div>


        <hr class="sidebar-divider" />


        <!-- User Management -->
        <div class="sidebar-section">

            <h6 class="sidebar-section-title">
                User Management
            </h6>


            <!-- Members -->
            <a asp-controller="Members"
               asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Members" ? "active" : "")">

                <i data-lucide="users"></i>

                <span class="sidebar-text">
                    Members
                </span>

            </a>


            <!-- Admins -->
            <a asp-controller="Admins"
               asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admins" ? "active" : "")">

                <i data-lucide="user-cog"></i>

                <span class="sidebar-text">
                    Admins
                </span>

            </a>

        </div>


        <hr class="sidebar-divider" />


        <!-- Content Moderation -->
        <div class="sidebar-section">

            <h6 class="sidebar-section-title">
                Content Moderation
            </h6>


            <!-- Marketplace Approval -->
            <a asp-controller="Listings"
               asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Listings" &&
                                                                       ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">

                <i data-lucide="badge-check"></i>

                <span class="sidebar-text">
                    Marketplace Approval
                </span>

            </a>


            <!-- Lost & Found Approval -->
            <a asp-controller="LostFounds"
               asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "LostFounds" &&
                                                                       ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">

                <i data-lucide="shield-check"></i>

                <span class="sidebar-text">
                    Lost &amp; Found Approval
                </span>

            </a>

        </div>

    </div>

</nav>