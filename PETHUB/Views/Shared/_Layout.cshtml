<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PETHUB</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PETHUB.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">PETHUB</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Members" asp-action="Index">Members</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Users" asp-action="Index">Users</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Listings" asp-action="Index">Marketplace User</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Marketplace" asp-action="Index">Marketplace Client</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="LostFounds" asp-action="Index">Lost & Found User</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="LostFoundClient" asp-action="Index">Lost & Found Client</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <form asp-controller="UserAccount" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="UserAccount" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="UserAccount" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
<div class="d-flex">

    <!-- Sidebar -->
    @* <nav class="sidebar bg-dark">
        <ul class="nav flex-column"> *@

            @* Future Dashboard redirect *@
@*             <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="DashboardController" asp-action="Dashboard">
                    Dashboard
                </a>
            </li>
 *@ 
            @* Lost and Found redirect *@
          @*  <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="LostFounds" asp-action="Index">
                    Lost & Found
                </a>
            </li> *@

            @* Marketplace redirect *@
           @*  <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Listings" asp-action="Index">
                    Marketplace
                </a>
            </li> *@

            @* Add User redirect *@
           @*  <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Users" asp-action="Create">
                    Add User
                </a>
            </li> *@

            @* Add Member redirect *@
           @*  <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Members" asp-action="Create">
                    Add Member
                </a>
            </li>

        </ul>
    </nav> *@

    <!-- Main content -->
    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
</div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - PETHUB - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
