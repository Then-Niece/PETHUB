@using Microsoft.AspNetCore.Identity
@using PETHUB.Models

@inject UserManager<ApplicationUser> UserManager

@{
    ApplicationUser? currentThemeUser = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        currentThemeUser =
            await UserManager.GetUserAsync(User);
    }

    var useDarkMode =
        currentThemeUser?.ThemePreference == "Dark";
}
<!DOCTYPE html>
<html lang="en" class="@(useDarkMode ? "dark-mode" : "")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PETHUB</title>
    <link rel="icon" type="image/png" href="~/images/PETHUB-LOGO.png" />

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-member-crud.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/messages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-report.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Marketplace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Lost&Found.css" asp-append-version="true" />

    <!-- Date fields styles for everypage that needs date to use -->
    <link rel="stylesheet"
          href="~/css/date-fields.css"
          asp-append-version="true" />

    <!-- PetFeed styles from both branches -->
    <link rel="stylesheet" href="~/css/petfeed-cards.css" asp-append-version="true" />

    <!-- Profile / Logs / Gallery styles preserved from the other branch -->
    <link rel="stylesheet" href="~/css/MemberProfile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Logs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/image-gallery.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/image-preview.css" asp-append-version="true" />

    <!-- New shared UI styles -->
    <link rel="stylesheet" href="~/css/custom-select.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/system-modal.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/PETHUB.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/price.css" asp-append-version="true" />

    <!-- Saved Items styles -->
    <link rel="stylesheet" href="~/css/saved-items.css" asp-append-version="true" />

    <!-- MUST BE LAST  para ma work and dark mode-->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)


    <!-- ==========================================
         PETHUB SIDEBAR - RESTORE STATE

         Runs before the page is displayed so the
         sidebar does not animate on page navigation.
         ========================================== -->
    <script>
        (function () {

            const storageKey = "pethubSidebarCollapsed";
            const savedState = localStorage.getItem(storageKey);

            // Tell CSS that we are restoring the sidebar.
            document.documentElement.classList.add("sidebar-loading");

            // If the user previously collapsed the sidebar,
            // tell CSS to start it at the collapsed width.
            if (savedState === "true") {

                document.documentElement.classList.add(
                    "sidebar-collapsed"
                );
            }

        })();
    </script>
</head>

<body>

    <!-- =========================================================
         PAGE LOADER
         ========================================================= -->
    <div id="pageLoader" class="page-loader hidden">
        <div class="page-loader-content">

            <img src="~/images/cat-loading.gif"
                 alt="Loading..."
                 class="page-loader-cat" />

            <p>Loading...</p>

        </div>
    </div>

    @* =========================================================
       NAVIGATION
       =========================================================
       HideNavbar support is preserved from the newer branch.
       ========================================================= *@

    @if (!(ViewData["HideNavbar"] as bool? ?? false))
    {
        @await Component.InvokeAsync("Navigation")
    }


    <div class="app @(ViewData["HideNavbar"] as bool? == true ? "app-no-navbar" : "")">

        @* =====================================================
           SIDEBAR
           ===================================================== *@

        @if (User.Identity?.IsAuthenticated == true &&
             !(ViewData["HideSidebar"] as bool? ?? false))
        {
            <div id="sidebar-wrapper">

                <aside id="sidebar">

                    @if (User.IsInRole("Admin"))
                    {
                        <partial name="_AdminSidebar" />
                    }
                    else if (User.IsInRole("Member"))
                    {
                        <partial name="_MemberSidebar" />
                    }

                </aside>

            </div>

            <div id="sidebarOverlay"
                 class="sidebar-overlay">
            </div>
        }


        @* =====================================================
           MAIN PAGE CONTENT
           ===================================================== *@

        <main id="mainContent">
            @RenderBody()
        </main>

    </div>


    <!-- =========================================================
         SHARED REPORT MODAL

         Used by Marketplace and Lost & Found pages.
         ========================================================= -->

    <partial name="_ReportModal" />


    <!-- =========================================================
         SHARED SYSTEM MODAL

         Used by TempData feedback and other reusable system
         notifications.
         ========================================================= -->

    <partial name="_SystemModal" />


    <!-- =========================================================
         CORE SCRIPTS
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    
    <!-- Shared report modal -->
    <script src="~/js/report-modal.js" asp-append-version="true"></script>


    <!-- Lucide icons -->
    <script src="https://unpkg.com/lucide@latest"></script>


    <!-- =========================================================
         SHARED UI SCRIPTS
         ========================================================= -->

    <script src="~/js/custom-select.js" asp-append-version="true"></script>

    <script src="~/js/system-modal.js" asp-append-version="true"></script>


    <!-- =========================================================
         EXISTING APPLICATION SCRIPTS
         ========================================================= -->

    <script src="~/js/Price.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    <script src="~/js/user-crud.js"></script>
    <script src="~/js/imagePreviewHelper.js" asp-append-version="true"></script>
    <!-- Preserved from the other branch -->
    <script src="~/js/imageGallery.js" asp-append-version="true"></script>
    <!-- For changing theme feature js -->
    @if (User.Identity?.IsAuthenticated == true)
{
    <!-- Dark mode is available only to logged-in users -->
    <script src="~/js/theme.js" asp-append-version="true"></script>
}


    <!-- =========================================================
         SIGNALR / GLOBAL MESSAGING
         ========================================================= -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script src="~/js/global-messaging.js" asp-append-version="true"></script>

    <!-- Date fields -->
    <script src="~/js/date-fields.js"
        asp-append-version="true"></script>


    <!-- =========================================================
         PETFEED
         ========================================================= -->

    <script src="~/js/petfeed.js" asp-append-version="true"></script>

    @* =========================================================
       TEMPDATA -> SYSTEM MODAL

       Reads SuccessMessage, ErrorMessage, WarningMessage and
       InfoMessage after the system-modal JavaScript is loaded.
       ========================================================= *@

    @await Html.PartialAsync("_TempDataSystemModal")


    @* Page-specific scripts *@

    @await RenderSectionAsync(
        "Scripts",
        required: false)



        <script>
    document.addEventListener("DOMContentLoaded", function () {

        const loader = document.getElementById("pageLoader");

        if (!loader) {
            return;
        }


        // =========================================================
        // SHOW LOADER
        // =========================================================

        function showLoader() {
            loader.classList.remove("hidden");
        }


        // =========================================================
        // HIDE LOADER
        // =========================================================

        function hideLoader() {
            loader.classList.add("hidden");
        }


        // Make sure the loader is hidden when the page is ready.
        hideLoader();


        // =========================================================
        // LINKS
        // =========================================================

        document.addEventListener("click", function (event) {

            const link = event.target.closest("a");

            if (!link) {
                return;
            }

            const href = link.getAttribute("href");


            // Ignore links that don't cause normal page navigation.
            if (
                !href ||
                href.startsWith("#") ||
                href.startsWith("javascript:") ||
                href.startsWith("mailto:") ||
                href.startsWith("tel:") ||
                link.target === "_blank" ||
                link.hasAttribute("download")
            ) {
                return;
            }


            // Don't show loader when staying on exactly the same URL.
            if (link.href === window.location.href) {
                return;
            }


            showLoader();

        });


        // =========================================================
        // FORM SUBMISSION
        // =========================================================

       document.addEventListener("submit", function (event) {

            const form = event.target;


            // Forms below use AJAX/fetch and do not navigate.
            // Therefore the page loader must not appear.
            if (
                form.id === "messageSendForm" ||
                form.hasAttribute("data-paw-form") ||
                form.hasAttribute("data-add-comment-form") ||
                form.hasAttribute("data-delete-comment-form")
            ) {
                return;
            }


            showLoader();
        });


        // =========================================================
        // BROWSER BACK / FORWARD
        // =========================================================

        window.addEventListener("pageshow", function () {
            hideLoader();
        });

    });
</script>

<div id="profileDropdownOverlay" class="profile-dropdown-overlay"></div>
</body>

</html>