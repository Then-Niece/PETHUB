<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PETHUB</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/messages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Marketplace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Lost&Found.css" asp-append-version="true" />

    <!-- PetFeed styles from both branches -->
    <link rel="stylesheet" href="~/css/PetFeed.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/petfeed-cards.css" asp-append-version="true" />

    <!-- Profile / Logs / Gallery styles preserved from the other branch -->
    <link rel="stylesheet" href="~/css/MemberProfile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Logs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/image-gallery.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/image-preview.css" asp-append-version="true" />

    <!-- New shared UI styles -->
    <link rel="stylesheet" href="~/css/custom-select.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/system-modal.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/PETHUB.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/price.css" asp-append-version="true" />


    <!-- ==========================================
         PETHUB SIDEBAR - RESTORE STATE

         Runs before the page is displayed so the
         sidebar does not animate on page navigation.
         ========================================== -->
    <script>
        (function () {

            const storageKey = "pethubSidebarCollapsed";
            const savedState = localStorage.getItem(storageKey);

            // Tell CSS that we are restoring the sidebar.
            document.documentElement.classList.add("sidebar-loading");

            // If the user previously collapsed the sidebar,
            // tell CSS to start it at the collapsed width.
            if (savedState === "true") {

                document.documentElement.classList.add(
                    "sidebar-collapsed"
                );
            }

        })();
    </script>
</head>

<body>

    @* =========================================================
       NAVIGATION
       =========================================================
       HideNavbar support is preserved from the newer branch.
       ========================================================= *@

    @if (!(ViewData["HideNavbar"] as bool? ?? false))
    {
        @await Component.InvokeAsync("Navigation")
    }


    <div class="app @(ViewData["HideNavbar"] as bool? == true ? "app-no-navbar" : "")">

        @* =====================================================
           SIDEBAR
           ===================================================== *@

        @if (!(ViewData["HideSidebar"] as bool? ?? false)
            && User.Identity?.IsAuthenticated == true)
        {
            <div id="sidebar-wrapper">

                <aside id="sidebar">

                    @if (User.IsInRole("Admin"))
                    {
                        <partial name="_AdminSidebar" />
                    }
                    else if (User.IsInRole("Member"))
                    {
                        <partial name="_MemberSidebar" />
                    }

                </aside>

            </div>


            <div id="sidebarOverlay"
                 class="sidebar-overlay">
            </div>
        }


        @* =====================================================
           MAIN PAGE CONTENT
           ===================================================== *@

        <main id="mainContent">
            @RenderBody()
        </main>

    </div>


    <!-- =========================================================
         SHARED REPORT MODAL

         Used by Marketplace and Lost & Found pages.
         ========================================================= -->

    <partial name="_ReportModal" />


    <!-- =========================================================
         SHARED SYSTEM MODAL

         Used by TempData feedback and other reusable system
         notifications.
         ========================================================= -->

    <partial name="_SystemModal" />


    <!-- =========================================================
         CORE SCRIPTS
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- Shared report modal -->
    <script src="~/js/report-modal.js" asp-append-version="true"></script>


    <!-- Lucide icons -->
    <script src="https://unpkg.com/lucide@latest"></script>


    <!-- =========================================================
         SHARED UI SCRIPTS
         ========================================================= -->

    <script src="~/js/custom-select.js" asp-append-version="true"></script>

    <script src="~/js/system-modal.js" asp-append-version="true"></script>


    <!-- =========================================================
         EXISTING APPLICATION SCRIPTS
         ========================================================= -->

    <script src="~/js/Price.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    <script src="~/js/user-crud.js"></script>
    <script src="~/js/imagePreviewHelper.js" asp-append-version="true"></script>
    <!-- Preserved from the other branch -->
    <script src="~/js/imageGallery.js" asp-append-version="true"></script>


    <!-- =========================================================
         SIGNALR / GLOBAL MESSAGING
         ========================================================= -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script src="~/js/global-messaging.js" asp-append-version="true"></script>


    <!-- =========================================================
         PETFEED
         ========================================================= -->

    <script src="~/js/petfeed.js" asp-append-version="true"></script>

    @* =========================================================
       TEMPDATA -> SYSTEM MODAL

       Reads SuccessMessage, ErrorMessage, WarningMessage and
       InfoMessage after the system-modal JavaScript is loaded.
       ========================================================= *@

    @await Html.PartialAsync("_TempDataSystemModal")


    @* Page-specific scripts *@

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>