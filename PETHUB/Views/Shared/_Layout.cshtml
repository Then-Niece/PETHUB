<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PETHUB</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PETHUB.styles.css" asp-append-version="true" />
</head>
<body>
@*     Run the Navigation View Component and render its view. *@    
       @await Component.InvokeAsync("Navigation")

    <div class="app">

        @if (!(ViewData["HideSidebar"] as bool? ?? false)
            && User.Identity?.IsAuthenticated == true)
        {
            <div id="sidebar-wrapper">

                <aside id="sidebar">

                    @if (User.IsInRole("Admin"))
                    {
                        <partial name="_AdminSidebar" />
                    }
                    else if (User.IsInRole("Member"))
                    {
                        <partial name="_MemberSidebar" />
                    }

                </aside>

            </div>
        }

        <main id="mainContent">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin-dashboard.js"></script>

    <!-- Lucide -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        lucide.createIcons();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>