<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PETHUB</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Marketplace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Lost&Found.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/PetFeed.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/MemberProfile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PETHUB.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/price.css" asp-append-version="true" />

    <!-- ==========================================
     PETHUB SIDEBAR - RESTORE STATE
     Runs before the page is displayed so the
     sidebar does not animate on page navigation.
     ========================================== -->
    <script>
        (function () {

        const storageKey = "pethubSidebarCollapsed";
        const savedState = localStorage.getItem(storageKey);

        // Tell CSS that we are restoring the sidebar.
        document.documentElement.classList.add("sidebar-loading");

        // If the user previously collapsed the sidebar,
        // tell CSS to start it at the collapsed width.
        if (savedState === "true") {

        document.documentElement.classList.add(
        "sidebar-collapsed"
        );
        }

        })();
    </script>

    
</head>
<body>
@*     Run the Navigation View Component and render its view. *@    
       @await Component.InvokeAsync("Navigation")

    <div class="app">

        @if (!(ViewData["HideSidebar"] as bool? ?? false)
            && User.Identity?.IsAuthenticated == true)
        {
            <div id="sidebar-wrapper">

                <aside id="sidebar">

                    @if (User.IsInRole("Admin"))
                    {
                        <partial name="_AdminSidebar" />
                    }
                    else if (User.IsInRole("Member"))
                    {
                        <partial name="_MemberSidebar" />
                    }

                </aside>

            </div>
        }

        <main id="mainContent">
            @RenderBody()
        </main>

    </div>

    <!-- Shared report modal used by Marketplace and Lost & Found pages.
     The modal is rendered after the page content so report buttons from
     the rendered views can open this single reusable modal. -->
    <partial name="_ReportModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/report-modal.js" asp-append-version="true"></script>
    <!-- Lucide -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script src="~/js/Price.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    <script src="~/js/user-crud.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>