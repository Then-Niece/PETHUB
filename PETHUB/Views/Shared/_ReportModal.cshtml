<!-- ==========================================================
     REPORT MODAL
=========================================================== -->

<div class="modal fade"
     id="reportModal"
     tabindex="-1"
     aria-labelledby="reportModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-4">

            <form asp-controller="Reports"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold"
                            id="reportModalLabel">
                            Report Post
                        </h5>

                        <small class="text-muted"
                               id="reportPostTitle">
                        </small>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">

                    <!-- Hidden fields are populated by JavaScript from the
                         Report button that opened this modal. -->
                    <input type="hidden"
                           id="reportContentType"
                           name="ContentType" />

                    <input type="hidden"
                           id="reportContentId"
                           name="ContentId" />

                    <div class="mb-3">

                        <label for="reportReason"
                               class="form-label fw-semibold">
                            Reason
                        </label>

                        <select id="reportReason"
                                name="Reason"
                                class="form-select"
                                required>

                            <option value="">
                                Select a reason
                            </option>

                            <option value="0">
                                Scam / Fraud
                            </option>

                            <option value="1">
                                Inappropriate Content
                            </option>

                            <option value="2">
                                False Information
                            </option>

                            <option value="3">
                                Animal Abuse
                            </option>

                            <option value="4">
                                Duplicate Listing
                            </option>

                            <option value="5">
                                Already Sold / Adopted
                            </option>

                            <option value="6">
                                Suspicious Activity
                            </option>

                            <option value="7">
                                Other
                            </option>

                        </select>

                    </div>

                    <!-- This field is hidden until the member selects Other. -->
                    <div class="mb-3 d-none"
                         id="otherReasonContainer">

                        <label for="otherReason"
                               class="form-label fw-semibold">
                            Please specify
                        </label>

                        <input type="text"
                               id="otherReason"
                               name="OtherReason"
                               class="form-control"
                               maxlength="500"
                               placeholder="Tell us why you are reporting this post." />

                    </div>

                    <div class="mb-3">

                        <label for="reportDescription"
                               class="form-label fw-semibold">
                            Description
                        </label>

                        <textarea id="reportDescription"
                                  name="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Provide additional information about the report."></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light rounded-pill px-4"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn text-white rounded-pill px-4"
                            style="background-color:#8ACE79;">
                        Submit Report
                    </button>

                </div>

            </form>

        </div>

    </div>
</div>