<!-- ==========================================================
     REPORT MODAL
=========================================================== -->

<div class="modal fade"
     id="reportModal"
     tabindex="-1"
     aria-labelledby="reportModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered report-dialog">

        <div class="modal-content report-content">

            <form asp-controller="Reports"
                  asp-action="Create"
                  method="post"
                  class="report-form">

                @Html.AntiForgeryToken()

                <!-- ==================================================
                     MODAL HEADER
                =================================================== -->

                <div class="modal-header report-header">

                    <div class="report-header-content">

                        <h5 class="modal-title report-title"
                            id="reportModalLabel">
                            Report Post
                        </h5>

                        <small class="report-post-title"
                               id="reportPostTitle">
                        </small>

                    </div>

                    <button type="button"
                            class="btn-close report-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <!-- ==================================================
                     MODAL BODY
                =================================================== -->

                <div class="modal-body report-body">

                    <!-- Hidden fields are populated by JavaScript from the
                         Report button that opened this modal. -->

                    <input type="hidden"
                           id="reportContentType"
                           name="ContentType" />

                    <input type="hidden"
                           id="reportContentId"
                           name="ContentId" />


                    <!-- ==================================================
     REASON
================================================== -->

                    <div class="report-field">

                        <label for="reportReasonDropdown"
                               class="report-label">
                            Reason
                        </label>

                        <!-- ==================================================
         CUSTOM REASON DROPDOWN
    =================================================== -->

                        <div class="report-custom-dropdown"
                             id="reportReasonDropdown">

                            <button type="button"
                                    class="report-dropdown-trigger"
                                    id="reportReasonTrigger"
                                    aria-haspopup="listbox"
                                    aria-expanded="false">

                                <span id="reportReasonText">
                                    Select a reason
                                </span>

                                <i data-lucide="chevron-down"></i>

                            </button>


                            <div class="report-dropdown-menu"
                                 id="reportReasonMenu"
                                 role="listbox"
                                 aria-labelledby="reportReasonTrigger">

                                <button type="button"
                                        class="report-dropdown-option"
                                        data-value="0"
                                        role="option">
                                    Scam / Fraud
                                </button>

                                <button type="button"
                                        class="report-dropdown-option"
                                        data-value="1"
                                        role="option">
                                    Inappropriate Content
                                </button>

                                <button type="button"
                                        class="report-dropdown-option"
                                        data-value="2"
                                        role="option">
                                    False Information
                                </button>

                                <button type="button"
                                        class="report-dropdown-option"
                                        data-value="3"
                                        role="option">
                                    Animal Abuse
                                </button>

                                <button type="button"
                                        class="report-dropdown-option"
                                        data-value="4"
                                        role="option">
                                    Duplicate Listing
                                </button>

                                <button type="button"
                                        class="report-dropdown-option"
                                        data-value="5"
                                        role="option">
                                    Already Sold / Adopted
                                </button>

                                <button type="button"
                                        class="report-dropdown-option"
                                        data-value="6"
                                        role="option">
                                    Suspicious Activity
                                </button>

                                <button type="button"
                                        class="report-dropdown-option"
                                        data-value="7"
                                        role="option">
                                    Other
                                </button>

                            </div>

                        </div>


                        <!-- ==================================================
         HIDDEN BACKEND SELECT
    =================================================== -->
                        <!--
        This select is kept for the existing ReportsController.
        The custom dropdown above synchronizes its selected value
        with this field before the form is submitted.
    -->

                        <select id="reportReason"
                                name="Reason"
                                class="report-native-select"
                                tabindex="-1"
                                aria-hidden="true">

                            <option value="">Select a reason</option>

                            <option value="0">Scam / Fraud</option>
                            <option value="1">Inappropriate Content</option>
                            <option value="2">False Information</option>
                            <option value="3">Animal Abuse</option>
                            <option value="4">Duplicate Listing</option>
                            <option value="5">Already Sold / Adopted</option>
                            <option value="6">Suspicious Activity</option>
                            <option value="7">Other</option>

                        </select>

                    </div>


                    <!-- ==================================================
                         OTHER REASON
                    =================================================== -->
                    <!-- This field is hidden until the member selects Other. -->

                    <div class="report-field d-none"
                         id="otherReasonContainer">

                        <label for="otherReason"
                               class="report-label">
                            Please specify
                        </label>

                        <input type="text"
                               id="otherReason"
                               name="OtherReason"
                               class="report-input"
                               maxlength="500"
                               placeholder="Tell us why you are reporting this post." />

                    </div>


                    <!-- ==================================================
                         DESCRIPTION
                    =================================================== -->

                    <div class="report-description-field">

                        <label for="reportDescription"
                               class="report-label">
                            Description
                        </label>

                        <textarea id="reportDescription"
                                  name="Description"
                                  class="report-textarea"
                                  rows="4"
                                  placeholder="Provide additional information about the report."></textarea>

                    </div>

                </div>


                <!-- ==================================================
                     MODAL FOOTER
                =================================================== -->

                <div class="modal-footer report-footer">

                    <button type="button"
                            class="report-cancel"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="report-submit">
                        Submit Report
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>