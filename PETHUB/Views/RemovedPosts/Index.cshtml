@model PETHUB.ViewModels.RemovedPostsViewModel

@{
    ViewData["Title"] = "Removed Posts";

    // Creates safe references to the two collections.
    // The null-conditional operator prevents an exception if the ViewModel
    // itself is unexpectedly null, while the ?? operator provides an empty
    // collection as a fallback.
    var removedListings = Model?.RemovedListings
        ?? new List<(PETHUB.Models.Listing Listing, string? AdminActionReason)>();

    var removedLostFound = Model?.RemovedLostFound
        ?? new List<(PETHUB.Models.LostFound Report, string? AdminActionReason)>();
}


<!-- Page heading for the Member's removed content. -->
<div class="mb-4">

    <h2 class="mb-1">
        Removed Posts
    </h2>

    <p class="text-muted mb-0">
        Posts that were removed by an administrator are shown here.
    </p>

</div>


@if (!removedListings.Any() && !removedLostFound.Any())
{
    <!-- Displays the empty state only when neither collection contains
         a removed Marketplace listing nor a removed Lost & Found post. -->
    <div class="card shadow-sm border-0">

        <div class="card-body text-center py-5">

            <h4 class="fw-bold">
                No Removed Posts
            </h4>

            <p class="text-muted mb-0">
                You do not currently have any posts that were removed by an administrator.
            </p>

        </div>

    </div>
}
else
{
    <!-- =========================================================
         REMOVED MARKETPLACE LISTINGS
         ========================================================= -->
    @if (removedListings.Any())
    {
        <h4 class="fw-bold mb-3">
            Marketplace
        </h4>

        <div class="d-flex flex-column gap-3 mb-5">

            @foreach (var item in removedListings)
            {
                // Keeps the tuple values in simple local variables so the
                // Razor markup below remains easier to read.
                var listing = item.Listing;
                var adminReason = item.AdminActionReason;

                <div class="card shadow-sm">

                    <!-- Card body containing the removed Marketplace listing. -->
                    <div class="card-body d-flex justify-content-between align-items-center">

                        <!-- Clicking the existing post opens its Removed Posts
                             Details page instead of creating a separate post. -->
                        <a asp-controller="RemovedPosts"
                           asp-action="Details"
                           asp-route-type="listing"
                           asp-route-id="@listing.ListingId"
                           class="d-flex align-items-center flex-grow-1 text-decoration-none text-dark">


                            <!-- Listing thumbnail. -->
                            <div class="me-4">

                                @if (listing.Images != null &&
                                     listing.Images.Any())
                                {
                                    <!-- Displays the first stored listing image. -->
                                    <img src="@Url.Content(listing.Images.First().ImagePath)"
                                         class="img-fluid rounded"
                                         alt="@listing.Title"
                                         style="width:140px;height:140px;object-fit:cover;" />
                                }
                                else
                                {
                                    <!-- Displays the existing fallback image when
                                         the listing has no stored image. -->
                                    <img src="@Url.Content("~/images/no-image.png")"
                                         class="img-fluid rounded"
                                         alt="No Image"
                                         style="width:140px;height:140px;object-fit:cover;" />
                                }

                            </div>


                            <!-- Listing information. -->
                            <div>

                                <h4 class="fw-bold">
                                    @listing.Title
                                </h4>

                                <p class="mb-1">
                                    <strong>Created:</strong>
                                    @listing.DatePosted.ToString("MMM dd, yyyy")
                                </p>

                                <p class="mb-1">
                                    <strong>Listing Type:</strong>
                                    @listing.Type
                                </p>

                            </div>

                        </a>

                    </div>


                    <!-- Footer containing the moderation information. -->
                    <div class="card-footer">

                        <div class="mb-3">

                            <strong>Approval:</strong>

                            <!-- Removed is intentionally displayed as a separate
                                 moderation state. -->
                            <span class="badge bg-danger">
                                Removed
                            </span>

                        </div>


                        <!-- Administrator's explanation for removing the listing. -->
                        <div class="mb-0">

                            <strong>
                                Reason for Removal:
                            </strong>

                            @if (string.IsNullOrWhiteSpace(adminReason))
                            {
                                <span class="text-muted">
                                    No removal reason was provided.
                                </span>
                            }
                            else
                            {
                                <span>
                                    @adminReason
                                </span>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }


    <!-- =========================================================
         REMOVED LOST & FOUND POSTS
         ========================================================= -->
    @if (removedLostFound.Any())
    {
        <h4 class="fw-bold mb-3">
            Lost &amp; Found
        </h4>

        <div class="d-flex flex-column gap-3">

            @foreach (var item in removedLostFound)
            {
                // Keeps the tuple values in local variables for readability.
                var report = item.Report;
                var adminReason = item.AdminActionReason;

                <div class="card shadow-sm">

                    <!-- Card body containing the removed Lost & Found post. -->
                    <div class="card-body d-flex justify-content-between align-items-center">

                        <!-- Clicking the existing post opens its Removed Posts
                             Details page. -->
                        <a asp-controller="RemovedPosts"
                           asp-action="Details"
                           asp-route-type="lostfound"
                           asp-route-id="@report.LostFoundId"
                           class="d-flex align-items-center flex-grow-1 text-decoration-none text-dark">


                            <!-- Report thumbnail. -->
                            <div class="me-4">

                                @if (report.Images != null &&
                                     report.Images.Any())
                                {
                                    <!-- Displays the first stored Lost & Found image. -->
                                    <img src="@Url.Content(report.Images.First().ImagePath)"
                                         class="img-fluid rounded"
                                         alt="@report.Title"
                                         style="width:140px;height:140px;object-fit:cover;" />
                                }
                                else
                                {
                                    <!-- Displays the existing fallback image when
                                         no Lost & Found image exists. -->
                                    <img src="@Url.Content("~/images/no-image.png")"
                                         class="img-fluid rounded"
                                         alt="No Image"
                                         style="width:140px;height:140px;object-fit:cover;" />
                                }

                            </div>


                            <!-- Lost & Found information. -->
                            <div>

                                <h4 class="fw-bold">
                                    @report.Title
                                </h4>

                                <p class="mb-1">
                                    <strong>Created:</strong>
                                    @report.DateReported.ToString("MMM dd, yyyy")
                                </p>

                                <p class="mb-1">
                                    <strong>Report Type:</strong>
                                    @report.Type
                                </p>

                            </div>

                        </a>

                    </div>


                    <!-- Footer containing the moderation information. -->
                    <div class="card-footer">

                        <div class="mb-3">

                            <strong>Approval:</strong>

                            <!-- Removed indicates that an Administrator
                                 removed this post after moderation. -->
                            <span class="badge bg-danger">
                                Removed
                            </span>

                        </div>


                        <!-- Administrator's explanation for removing the post. -->
                        <div class="mb-0">

                            <strong>
                                Reason for Removal:
                            </strong>

                            @if (string.IsNullOrWhiteSpace(adminReason))
                            {
                                <span class="text-muted">
                                    No removal reason was provided.
                                </span>
                            }
                            else
                            {
                                <span>
                                    @adminReason
                                </span>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }
}