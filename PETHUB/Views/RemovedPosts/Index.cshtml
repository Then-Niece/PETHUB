@model PETHUB.ViewModels.RemovedPostsViewModel

@{
    ViewData["Title"] = "Removed Posts";

    var removedListings = Model?.RemovedListings
        ?? new List<(PETHUB.Models.Listing Listing, string? AdminActionReason)>();

    var removedLostFound = Model?.RemovedLostFound
        ?? new List<(PETHUB.Models.LostFound Report, string? AdminActionReason)>();

    var totalRemovedPosts =
        removedListings.Count +
        removedLostFound.Count;
}


<div class="removed-posts-page">


    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <div class="removed-posts-heading">

        <div>

            <h2>
                Removed Posts
            </h2>

            <p>
                Posts that were removed by an administrator are shown here.
            </p>

        </div>

    </div>


    <!-- =========================================================
         FILTER / TOTAL TOOLBAR
    ========================================================== -->

    <div class="removed-posts-toolbar">


        <!-- =====================================================
             FILTER CONTAINER

             FILTERS WILL BE ADDED HERE BY THE PROGRAMMER.

             Suggested filters:
             - Post Type
                 • All
                 • Marketplace
                 • Lost & Found

             - Status
                 • All
                 • Removed

             Use the same dropdown/filter structure used
             elsewhere in the system.

             DO NOT ADD FILTER LOGIC HERE YET.
        ====================================================== -->

        <div class="removed-posts-filters">

            <!--
            =====================================================
            FILTER PLACEHOLDER

            Example:

            <div class="removed-post-filter">
                ...
            </div>

            =====================================================
            -->

        </div>


        <!-- =====================================================
             TOTAL COUNT
        ====================================================== -->

        <span class="removed-posts-count">

            @totalRemovedPosts
            @(totalRemovedPosts == 1 ? "post" : "posts")

        </span>

    </div>


    <!-- =========================================================
         EMPTY STATE
    ========================================================== -->
    @if (!removedListings.Any() && !removedLostFound.Any())
    {
        <div class="removed-posts-empty">

            <div class="removed-posts-empty-icon">

                <i data-lucide="file-x"></i>

            </div>

            <h3>
                No Removed Posts
            </h3>

            <p>
                You do not currently have any posts that were removed by an administrator.
            </p>

        </div>
    }
    else
    {


        <!-- =====================================================
             REMOVED MARKETPLACE LISTINGS
        ====================================================== -->
        @if (removedListings.Any())
        {
            <div class="removed-posts-section">

              


                <div class="removed-posts-results">

                    @foreach (var item in removedListings)
                    {
                        var listing = item.Listing;
                        var adminReason = item.AdminActionReason;


                        <!-- =================================================
                             REMOVED MARKETPLACE CARD
                        ================================================== -->

                        <a asp-controller="RemovedPosts"
                           asp-action="Details"
                           asp-route-type="listing"
                           asp-route-id="@listing.ListingId"
                           class="removed-post-card">


                            <!-- IMAGE -->

                            <div class="removed-post-card-image-wrapper">

                                @if (listing.Images != null &&
                                     listing.Images.Any())
                                {
                                    <img src="@Url.Content(listing.Images.First().ImagePath)"
                                         class="removed-post-card-image"
                                         alt="@listing.Title" />
                                }
                                else
                                {
                                    <img src="@Url.Content("~/images/no-image.png")"
                                         class="removed-post-card-image"
                                         alt="No Image" />
                                }

                            </div>


                            <!-- POST INFORMATION -->

                            <div class="removed-post-card-content">

                                <h4 class="removed-post-card-title">
                                    @listing.Title
                                </h4>

                                <p class="removed-post-card-type">
                                    Marketplace · @listing.Type
                                </p>

                                <p class="removed-post-card-date">
                                    Created @listing.DatePosted.ToString("MMM dd, yyyy")
                                </p>

                            </div>


                            <!-- STATUS -->

                            <div class="removed-post-card-status">

                                <span class="removed-post-status removed-post-status-removed">
                                    Removed
                                </span>

                            </div>

                        </a>




                    }

                </div>

            </div>
        }


        <!-- =====================================================
             REMOVED LOST & FOUND POSTS
        ====================================================== -->
        @if (removedLostFound.Any())
        {
            <div class="removed-posts-section">

              

                <div class="removed-posts-results">

                    @foreach (var item in removedLostFound)
                    {
                        var report = item.Report;
                        var adminReason = item.AdminActionReason;


                        <!-- =================================================
                             REMOVED LOST & FOUND CARD
                        ================================================== -->

                        <a asp-controller="RemovedPosts"
                           asp-action="Details"
                           asp-route-type="lostfound"
                           asp-route-id="@report.LostFoundId"
                           class="removed-post-card">


                            <!-- IMAGE -->

                            <div class="removed-post-card-image-wrapper">

                                @if (report.Images != null &&
                                     report.Images.Any())
                                {
                                    <img src="@Url.Content(report.Images.First().ImagePath)"
                                         class="removed-post-card-image"
                                         alt="@report.Title" />
                                }
                                else
                                {
                                    <img src="@Url.Content("~/images/no-image.png")"
                                         class="removed-post-card-image"
                                         alt="No Image" />
                                }

                            </div>


                            <!-- POST INFORMATION -->

                            <div class="removed-post-card-content">

                                <h4 class="removed-post-card-title">
                                    @report.Title
                                </h4>

                                <p class="removed-post-card-type">
                                    Lost &amp; Found · @report.Type
                                </p>

                                <p class="removed-post-card-date">
                                    Created @report.DateReported.ToString("MMM dd, yyyy")
                                </p>

                            </div>


                            <!-- STATUS -->

                            <div class="removed-post-card-status">

                                <span class="removed-post-status removed-post-status-removed">
                                    Removed
                                </span>

                            </div>

                        </a>



                    }

                </div>

            </div>
        }

    }

</div>


@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function() {

            if (typeof lucide !== "undefined") {
                lucide.createIcons();
            }

        });

    </script>
}