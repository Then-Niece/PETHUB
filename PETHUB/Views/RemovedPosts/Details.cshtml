@model PETHUB.ViewModels.RemovedPostsViewModel

@{
    ViewData["Title"] = "Removed Post";
}

<div class="removed-details-page">

    <!-- =====================================================
         REMOVED POST NOTICE
         ===================================================== -->
    <div class="removed-details-notice">

        <div class="removed-details-notice-icon">
            <i data-lucide="shield-alert"></i>
        </div>

        <div class="removed-details-notice-content">

            <div class="removed-details-notice-title">
                <h2>This post has been removed</h2>

             
            </div>

            <p>
                This post was taken down after being reviewed by our moderation team
                following reports from community members. It is no longer visible to others.
            </p>

        </div>

    </div>


    <!-- =====================================================
         INVALID POST TYPE
         ===================================================== -->
    @if (Model.PostType != "listing" &&
         Model.PostType != "lostfound")
    {
        <div class="removed-details-empty">

            <div class="removed-details-empty-icon">
                <i data-lucide="file-warning"></i>
            </div>

            <h3>Post Not Found</h3>

            <p>
                The removed post could not be identified.
            </p>

        </div>
    }


    <!-- =====================================================
         MARKETPLACE LISTING
         ===================================================== -->
    @if (Model.PostType == "listing")
    {
        @if (Model.Listing == null)
        {
            <div class="removed-details-empty">

                <div class="removed-details-empty-icon">
                    <i data-lucide="file-warning"></i>
                </div>

                <h3>Post Not Found</h3>

                <p>
                    The removed marketplace post could not be found.
                </p>

            </div>
        }
        else
        {
            <div class="removed-details-layout">

                <!-- =================================================
                     LEFT COLUMN
                     ================================================= -->
                <div class="removed-details-left-column">

                    <!-- =================================================
                         REASON FOR REMOVAL
                         ================================================= -->
                    <div class="removed-details-reason-card">

                        <div class="removed-details-section-heading">

                            <div class="removed-details-section-icon removal">
                                <i data-lucide="triangle-alert"></i>
                            </div>

                            <div>
                                <h2>Reason for Removal</h2>

                                <p>
                                    This post was removed for the following reason.
                                </p>
                            </div>

                        </div>

                        <div class="removed-details-reason-box">

                            @if (string.IsNullOrWhiteSpace(Model.AdminActionReason))
                            {
                                <span class="removed-details-muted">
                                    No removal reason was provided.
                                </span>
                            }
                            else
                            {
                                @Model.AdminActionReason
                            }

                        </div>

                    </div>


                    <!-- =================================================
                         YOUR APPEAL
                         ================================================= -->
                    @if (Model.Appeal != null)
                    {
                        <div class="removed-details-appeal-card">

                            <div class="removed-details-appeal-header">

                                <div class="removed-details-section-heading">

                                    <div class="removed-details-section-icon appeal">
                                        <i data-lucide="scale"></i>
                                    </div>

                                    <div>
                                        <h2>Your Appeal</h2>

                                        <p>
                                            Your submitted appeal for this post.
                                        </p>
                                    </div>

                                </div>


                                <!-- Appeal Status -->
                                <div class="removed-details-appeal-status-wrapper">

                                    @if (Model.Appeal.Status == AppealStatus.Pending)
                                    {
                                        <span class="removed-details-appeal-status pending">
                                            <span></span>
                                            Pending
                                        </span>
                                    }
                                    else if (Model.Appeal.Status == AppealStatus.Approved)
                                    {
                                        <span class="removed-details-appeal-status approved">
                                            <span></span>
                                            Approved
                                        </span>
                                    }
                                    else if (Model.Appeal.Status == AppealStatus.Rejected)
                                    {
                                        <span class="removed-details-appeal-status rejected">
                                            <span></span>
                                            Rejected
                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- Appeal Message -->
                            <div class="removed-details-appeal-message">
                                @Model.Appeal.AppealMessage
                            </div>


                            <!-- Admin Response -->
                            @if (!string.IsNullOrWhiteSpace(Model.Appeal.AdminActionReason))
                            {
                                <div class="removed-details-admin-response">

                                    <span>Admin Response</span>

                                    <p>
                                        @Model.Appeal.AdminActionReason
                                    </p>

                                </div>
                            }

                        </div>
                    }


                    <!-- =================================================
                         ACTIONS
                         ================================================= -->
                    <div class="removed-details-actions-card">

                        <div class="removed-details-actions-text">

                            <h3>What would you like to do?</h3>

                            <p>
                                Choose an action for this removed post.
                            </p>

                        </div>


                        <div class="removed-details-actions">

                            <!-- Edit -->
                            <a asp-controller="Listings"
                               asp-action="Edit"
                               asp-route-id="@Model.Listing.ListingId"
                               class="removed-details-edit">

                                <i data-lucide="pencil"></i>
                                Edit

                            </a>


                            <!-- Submit Appeal / Appeal Submitted -->
                            @if (Model.Appeal == null ||
                                 Model.Appeal.Status == AppealStatus.Rejected)
                            {
                                <a asp-controller="Appeals"
                                   asp-action="Create"
                                   asp-route-type="listing"
                                   asp-route-id="@Model.Listing.ListingId"
                                   class="removed-details-appeal">

                                    <i data-lucide="scale"></i>
                                    Submit an Appeal

                                </a>
                            }
                            else
                            {
                                <button type="button"
                                        class="removed-details-appeal disabled"
                                        disabled>

                                    <i data-lucide="check-circle"></i>
                                    Appeal Submitted

                                </button>
                            }

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     RIGHT COLUMN — REPORTED CONTENT
                     ================================================= -->
                <div class="removed-details-content-card">

                    <!-- Header -->
                    <div class="removed-details-content-heading">

                        <div class="removed-details-section-icon content">
                            <i data-lucide="file-text"></i>
                        </div>

                        <h2>Reported Content</h2>

                    </div>


                    <!-- Image + View Details -->
                    <div class="removed-details-content-image">

                        @if (Model.Listing.Images != null &&
                             Model.Listing.Images.Any())
                        {
                            <img src="@Url.Content(Model.Listing.Images.First().ImagePath)"
                                 alt="@Model.Listing.Title" />
                        }
                        else
                        {
                            <div class="removed-details-no-image">

                                <i data-lucide="image-off"></i>

                                <span>
                                    No image available.
                                </span>

                            </div>
                        }


                        <!-- View Details -->
                        <a asp-controller="Listings"
                           asp-action="MarketplaceDetails"
                           asp-route-id="@Model.Listing.ListingId"
                           class="removed-details-view-button">

                            <i data-lucide="external-link"></i>
                            View Details
                        </a>
                    </div>


                    <!-- Listing Information -->
                    <div class="removed-details-content-info">

                        <!-- Type -->
                        <div class="removed-details-type marketplace">

                            <i data-lucide="store"></i>
                            Marketplace

                        </div>


                        <!-- Title -->
                        <h2 class="removed-details-title">
                            @Model.Listing.Title
                        </h2>


                        <!-- Date -->
                        <p class="removed-details-date">

                            <i data-lucide="calendar"></i>

                            Posted on
                            @Model.Listing.DatePosted.ToString("MMMM dd, yyyy")

                        </p>

                    </div>

                </div>

            </div>
        }
    }


    <!-- =====================================================
         LOST & FOUND
         ===================================================== -->
    @if (Model.PostType == "lostfound")
    {
        @if (Model.LostFound == null)
        {
            <div class="removed-details-empty">

                <div class="removed-details-empty-icon">
                    <i data-lucide="file-warning"></i>
                </div>

                <h3>Post Not Found</h3>

                <p>
                    The removed Lost &amp; Found post could not be found.
                </p>

            </div>
        }
        else
        {
            <div class="removed-details-layout">

                <!-- =================================================
                     LEFT COLUMN
                     ================================================= -->
                <div class="removed-details-left-column">

                    <!-- =================================================
                         REASON FOR REMOVAL
                         ================================================= -->
                    <div class="removed-details-reason-card">

                        <div class="removed-details-section-heading">

                            <div class="removed-details-section-icon removal">
                                <i data-lucide="triangle-alert"></i>
                            </div>

                            <div>
                                <h2>Reason for Removal</h2>

                                <p>
                                    This post was removed for the following reason.
                                </p>
                            </div>

                        </div>

                        <div class="removed-details-reason-box">

                            @if (string.IsNullOrWhiteSpace(Model.AdminActionReason))
                            {
                                <span class="removed-details-muted">
                                    No removal reason was provided.
                                </span>
                            }
                            else
                            {
                                @Model.AdminActionReason
                            }

                        </div>

                    </div>


                    <!-- =================================================
                         YOUR APPEAL
                         ================================================= -->
                    @if (Model.Appeal != null)
                    {
                        <div class="removed-details-appeal-card">

                            <div class="removed-details-appeal-header">

                                <div class="removed-details-section-heading">

                                    <div class="removed-details-section-icon appeal">
                                        <i data-lucide="scale"></i>
                                    </div>

                                    <div>
                                        <h2>Your Appeal</h2>

                                        <p>
                                            Your submitted appeal for this post.
                                        </p>
                                    </div>

                                </div>


                                <!-- Appeal Status -->
                                <div class="removed-details-appeal-status-wrapper">

                                    @if (Model.Appeal.Status == AppealStatus.Pending)
                                    {
                                        <span class="removed-details-appeal-status pending">
                                            <span></span>
                                            Pending
                                        </span>
                                    }
                                    else if (Model.Appeal.Status == AppealStatus.Approved)
                                    {
                                        <span class="removed-details-appeal-status approved">
                                            <span></span>
                                            Approved
                                        </span>
                                    }
                                    else if (Model.Appeal.Status == AppealStatus.Rejected)
                                    {
                                        <span class="removed-details-appeal-status rejected">
                                            <span></span>
                                            Rejected
                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- Appeal Message -->
                            <div class="removed-details-appeal-message">
                                @Model.Appeal.AppealMessage
                            </div>


                            <!-- Admin Response -->
                            @if (!string.IsNullOrWhiteSpace(Model.Appeal.AdminActionReason))
                            {
                                <div class="removed-details-admin-response">

                                    <span>Admin Response</span>

                                    <p>
                                        @Model.Appeal.AdminActionReason
                                    </p>

                                </div>
                            }

                        </div>
                    }


                    <!-- =================================================
                         ACTIONS
                         ================================================= -->
                    <div class="removed-details-actions-card">

                        <div class="removed-details-actions-text">

                            <h3>What would you like to do?</h3>

                            <p>
                                Choose an action for this removed post.
                            </p>

                        </div>


                        <div class="removed-details-actions">

                            <!-- Edit -->
                            <a asp-controller="LostFounds"
                               asp-action="Edit"
                               asp-route-id="@Model.LostFound.LostFoundId"
                               class="removed-details-edit">

                                <i data-lucide="pencil"></i>
                                Edit

                            </a>


                            <!-- Submit Appeal / Appeal Submitted -->
                            @if (Model.Appeal == null ||
                                 Model.Appeal.Status == AppealStatus.Rejected)
                            {
                                <a asp-controller="Appeals"
                                   asp-action="Create"
                                   asp-route-type="lostfound"
                                   asp-route-id="@Model.LostFound.LostFoundId"
                                   class="removed-details-appeal">

                                    <i data-lucide="scale"></i>
                                    Submit an Appeal

                                </a>
                            }
                            else
                            {
                                <button type="button"
                                        class="removed-details-appeal disabled"
                                        disabled>

                                    <i data-lucide="check-circle"></i>
                                    Appeal Submitted

                                </button>
                            }

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     RIGHT COLUMN — REPORTED CONTENT
                     ================================================= -->
                <div class="removed-details-content-card">

                    <!-- Header -->
                    <div class="removed-details-content-heading">

                        <div class="removed-details-section-icon content">
                            <i data-lucide="file-text"></i>
                        </div>

                        <h2>Reported Content</h2>

                    </div>


                    <!-- Image + View Details -->
                    <div class="removed-details-content-image">

                        @if (Model.LostFound.Images != null &&
                             Model.LostFound.Images.Any())
                        {
                            <img src="@Url.Content(Model.LostFound.Images.First().ImagePath)"
                                 alt="@Model.LostFound.Title" />
                        }
                        else
                        {
                            <div class="removed-details-no-image">

                                <i data-lucide="image-off"></i>

                                <span>
                                    No image uploaded for this report.
                                </span>

                            </div>
                        }


                        <!-- View Details -->
                        <a asp-controller="LostFounds"
                           asp-action="BrowseDetails"
                           asp-route-id="@Model.LostFound.LostFoundId"
                           class="removed-details-view-button">

                            <i data-lucide="external-link"></i>
                            View Details

                        </a>

                    </div>


                    <!-- Lost & Found Information -->
                    <div class="removed-details-content-info">

                        <!-- Type -->
                        <div class="removed-details-type lost-found">

                            <i data-lucide="search"></i>
                            Lost &amp; Found

                        </div>


                        <!-- Title -->
                        <h2 class="removed-details-title">
                            @Model.LostFound.Title
                        </h2>


                        <!-- Date -->
                        <p class="removed-details-date">

                            <i data-lucide="calendar"></i>

                            Reported on
                            @Model.LostFound.DateReported.ToString("MMMM dd, yyyy")

                        </p>

                    </div>

                </div>

            </div>
        }
    }

</div>


@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            if (typeof lucide !== "undefined") {
                lucide.createIcons();
            }

        });
    </script>
}