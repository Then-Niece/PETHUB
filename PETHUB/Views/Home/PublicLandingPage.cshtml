@model PETHUB.ViewModels.PublicLandingPageViewModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "PetHub";
}


<div class="landing-page">

    <!-- ==========================================================
         HERO SECTION
    ========================================================== -->

    <section class="landing-hero">

        <div class="landing-hero-container">

            <div class="landing-hero-content">

                <!-- LEFT SIDE -->

                <div class="landing-hero-text">

                    <h1>
                        Helping Pets Find
                        <span>Loving</span> Homes
                    </h1>

                    <p>
                        PetHub is a community platform where members can
                        report lost pets, browse pet listings, and support
                        responsible pet ownership — all in one trusted place.
                    </p>

                    <div class="landing-hero-buttons">

                        <a asp-controller="UserAccount"
                           asp-action="Register"
                           class="landing-primary-button">

                            Join PetHub

                            <i data-lucide="arrow-right"></i>

                        </a>


                    </div>

                </div>


                <!-- RIGHT SIDE -->

                <div class="landing-hero-image-wrapper">

                    <img src="~/images/hero_banner.jpg"
                         asp-append-version="true"
                         class="landing-hero-image"
                         alt="PetHub">

                    <!-- Floating image badge -->

                    <div class="landing-hero-image-badge">

                        <div class="landing-hero-image-badge-icon">
                            <i data-lucide="paw-print"></i>
                        </div>

                        <div>
                            <strong>Pets Reunited</strong>
                            <span>180+ happy stories</span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         OUR MISSION
    ========================================================== -->

    <section id="about"
             class="landing-section landing-mission-section">

        <div class="landing-container">

            <div class="landing-mission">

                <!-- IMAGE -->

                <div class="landing-mission-image-wrapper">

                    <img src="~/images/cutecat.jpg"
                         asp-append-version="true"
                         class="landing-mission-image"
                         alt="PetHub Mission">

                    <div class="landing-mission-label">
                        Every Pet Matters
                    </div>

                </div>


                <!-- CONTENT -->

                <div class="landing-mission-content">

                    <span class="landing-section-badge mission">

                        <i data-lucide="heart"></i>

                        Our Mission

                    </span>

                    <h2>
                        Creating a safe and supportive community
                        for every cat and dog
                    </h2>

                    <p>
                        PetHub is committed to creating a safe and supportive
                        community where pet owners, adopters, and animal lovers
                        can work together to reunite lost pets, promote
                        responsible pet ownership, and help every cat and dog
                        find a loving home.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         WHY PETHUB
    ========================================================== -->

    <section class="landing-section landing-why-section">

        <div class="landing-container">

            <div class="landing-centered-content">

                <span class="landing-eyebrow">
                    WHY PETHUB?
                </span>

                <h2>
                    Because every pet deserves a way home
                </h2>

                <p>
                    Every year, many pets become lost or are abandoned.
                    PetHub provides one trusted platform where pet owners,
                    adopters, and community members can work together to help
                    animals find safe and loving homes.
                </p>

                <div class="landing-section-divider"></div>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         WHAT WE OFFER
    ========================================================== -->

    <section id="services"
             class="landing-section landing-offer-section">

        <div class="landing-container">

            <div class="landing-centered-content landing-offer-heading">

                <span class="landing-eyebrow">
                    WHAT WE OFFER
                </span>

                <h2>
                    Everything you need in one place
                </h2>

            </div>


            <div class="landing-offer-grid">

                <!-- MARKETPLACE -->

                <a asp-controller="Listings"
                   asp-action="Marketplace"
                   class="landing-offer-card">

                    <div class="landing-offer-icon green">
                        <i data-lucide="store"></i>
                    </div>

                    <h3>
                        Marketplace
                    </h3>

                    <p>
                        Buy, sell, or adopt pets in a trusted,
                        moderated community space.
                    </p>

                </a>


                <!-- LOST & FOUND -->

                <a asp-controller="LostFounds"
                   asp-action="Browse"
                   class="landing-offer-card">

                    <div class="landing-offer-icon coral">
                        <i data-lucide="map-pin"></i>
                    </div>

                    <h3>
                        Lost &amp; Found
                    </h3>

                    <p>
                        Report missing pets and help reunite
                        them with their families.
                    </p>

                </a>


                <!-- PET ADOPTION -->

                <a asp-controller="Listings"
                   asp-action="Marketplace"
                   class="landing-offer-card">

                    <div class="landing-offer-icon green">
                        <i data-lucide="heart"></i>
                    </div>

                    <h3>
                        Pet Adoption
                    </h3>

                    <p>
                        Help pets find permanent, loving homes
                        through adoption.
                    </p>

                </a>


                <!-- COMMUNITY -->

                <a href="#petfeed"
                   class="landing-offer-card">

                    <div class="landing-offer-icon coral">
                        <i data-lucide="users"></i>
                    </div>

                    <h3>
                        Member Community
                    </h3>

                    <p>
                        Connect with fellow pet lovers and
                        stay informed through PetHub.
                    </p>

                </a>

            </div>

        </div>

    </section>


    <!-- ==========================================================
     MARKETPLACE
========================================================== -->

    <section id="marketplace"
             class="landing-section landing-marketplace-section">

        <div class="landing-container">

            <div class="landing-section-heading">

                <div>

                    <span class="landing-eyebrow">
                        MARKETPLACE
                    </span>

                    <h2>
                        Find Your Perfect Companion
                    </h2>

                </div>

                <a asp-controller="Listings"
                   asp-action="Marketplace"
                   class="landing-view-all">

                    View All

                    <i data-lucide="arrow-right"></i>

                </a>

            </div>


            <!-- ==================================================
             HORIZONTAL CARD AREA
        ================================================== -->

            <div class="landing-horizontal-scroll">

                @foreach (var item in Model.MarketplaceListings)
                {
                    <div class="landing-scroll-card">

                        <!-- ==================================================
                         LANDING MARKETPLACE CARD

These classes belong ONLY to the
                         public landing page.
                    ================================================== -->

                        <a asp-controller="Listings"
                           asp-action="MarketplaceDetails"
                           asp-route-id="@item.ListingId"
                           class="landing-marketplace-card-link">

                            <div class="landing-marketplace-card">


                                <!-- ==================================================
                                 IMAGE
                            ================================================== -->

                                <div class="landing-marketplace-card-image-wrapper">

                                    @if (item.Images != null && item.Images.Any())
                                    {
                                        <img src="@item.Images.First().ImagePath"
                                             class="landing-marketplace-card-image"
                                             alt="@item.Title" />
                                    }
                                    else
                                    {
                                        <img src="/images/no-image.png"
                                             class="landing-marketplace-card-image"
                                             alt="No image" />
                                    }


                                    <!-- ==================================================
                                     LISTING TYPE BADGE
                                ================================================== -->
                                    @if (item.Type == ListType.For_Sale)
                                    {
                                        <div class="landing-marketplace-listing-badge landing-marketplace-listing-badge-sale">

                                            <i data-lucide="paw-print"></i>

                                            <span>
                                                For Sale
                                            </span>

                                        </div>
                                    }
                                    else if (item.Type == ListType.For_Adoption)
                                    {
                                        <div class="landing-marketplace-listing-badge landing-marketplace-listing-badge-adoption">

                                            <i data-lucide="paw-print"></i>

                                            <span>
                                                Adoption
                                            </span>

                                        </div>
                                    }


                                    <!-- ==================================================
                                     PRICE
                                ================================================== -->
                                    @if (item.Type == ListType.For_Sale)
                                    {
                                        <div class="landing-marketplace-price-badge">

                                            ₱@item.Price.ToString("N0")

                                        </div>
                                    }

                                </div>


                                <!-- ==================================================
                                 CARD BODY

                                 Title
                                 Location
                                 Description
                                 Date
                            ================================================== -->

                                <div class="landing-marketplace-card-body">


                                    <!-- TITLE -->

                                    <h3 class="landing-marketplace-card-title"
                                        title="@item.Title">

                                        @item.Title

                                    </h3>


                                    <!-- LOCATION -->

                                    <div class="landing-marketplace-card-location">

                                        <i data-lucide="map-pin"></i>

                                        <span>

                                            @(string.IsNullOrEmpty(item.City)
                                                ? "Not specified"
                                                : item.City + ", " + item.Province)

                                        </span>

                                    </div>


                                    <!-- DESCRIPTION -->

                                    <p class="landing-marketplace-card-description">

                                        @item.Description

                                    </p>


                                    <!-- DATE -->

                                    <div class="landing-marketplace-card-meta">

                                        <div class="landing-marketplace-card-date">

                                            <i data-lucide="calendar-days"></i>

                                            <span>
                                                @item.DatePosted.ToString("MMM dd, yyyy")
                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </a>

                    </div>
                }


                <!-- ==================================================
                 EXPLORE MARKETPLACE CARD

                 LEFT UNCHANGED
            ================================================== -->

                <div class="landing-scroll-card">

                    <a asp-controller="Listings"
                       asp-action="Marketplace"
                       class="landing-explore-card marketplace">

                        <div class="landing-explore-icon">

                            <i data-lucide="store"></i>

                        </div>

                        <h3>
                            Explore Marketplace
                        </h3>

                        <p>
                            View all available pets
                            and listings.
                        </p>

                        <span>

                            Explore

                            <i data-lucide="arrow-right"></i>

                        </span>

                    </a>

                </div>

            </div>

        </div>

    </section>

    <!-- ==========================================================
     LOST & FOUND
========================================================== -->

    <section id="lostandfound"
             class="landing-section landing-lost-section">

        <div class="landing-container">

            <!-- ==================================================
             SECTION HEADING
        ================================================== -->

            <div class="landing-section-heading">

                <div>

                    <span class="landing-eyebrow">
                        LOST &amp; FOUND
                    </span>

                    <h2>
                        Help Them Reunite With Their Loved Ones
                    </h2>

                </div>

                <a asp-controller="LostFounds"
                   asp-action="Browse"
                   class="landing-view-all">

                    View All

                    <i data-lucide="arrow-right"></i>

                </a>

            </div>


            <!-- ==================================================
             HORIZONTAL CARD AREA
        ================================================== -->

            <div class="landing-horizontal-scroll">

                @foreach (var item in Model.LostFoundReports)
                {
                    var isLost = item.Type.ToString().Equals(
                        "Lost",
                        StringComparison.OrdinalIgnoreCase
                    );

                    var location =
                        string.IsNullOrEmpty(item.City)
                            ? "Not specified"
                            : item.City + ", " + item.Province;


                    <div class="landing-scroll-card">

                        <!-- ==================================================
                         LANDING LOST & FOUND CARD
                    ================================================== -->

                        <a asp-controller="LostFounds"
                           asp-action="BrowseDetails"
                           asp-route-id="@item.LostFoundId"
                           class="landing-lost-found-card-link">

                            <article class="landing-lost-found-card @(isLost ? "landing-lost-card" : "landing-found-card")">


                                <!-- ==================================================
                                 STATUS RAIL
                            ================================================== -->

                                <span class="landing-lost-found-status-rail"></span>


                                <!-- ==================================================
                                 IMAGE
                            ================================================== -->

                                <div class="landing-lost-found-card-image-wrapper">

                                    @if (item.Images != null && item.Images.Any())
                                    {
                                        <img src="@Url.Content(item.Images.First().ImagePath)"
                                             class="landing-lost-found-card-image"
                                             alt="@item.Title" />
                                    }
                                    else
                                    {
                                        <img src="@Url.Content("~/images/no-image.png")"
                                             class="landing-lost-found-card-image"
                                             alt="No image" />
                                    }


                                    <!-- Image gradient -->

                                    <div class="landing-lost-found-card-image-gradient"></div>


                                    <!-- ==================================================
                                     LOST / FOUND BADGE
                                ================================================== -->
                                    @if (isLost)
                                    {
                                        <span class="landing-lost-found-type-badge landing-lost-found-type-badge-lost">

                                            <i data-lucide="search"></i>

                                            LOST

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="landing-lost-found-type-badge landing-lost-found-type-badge-found">

                                            <i data-lucide="heart-handshake"></i>

                                            FOUND

                                        </span>
                                    }


                                    <!-- ==================================================
                                     PET TYPE BADGE
                                ================================================== -->

                                    <span class="landing-lost-found-pet-badge">

                                        <i data-lucide="paw-print"></i>

                                        @item.PetType

                                    </span>

                                </div>


                                <!-- ==================================================
                                 CARD BODY
                            ================================================== -->

                                <div class="landing-lost-found-card-body">


                                    <!-- ==================================================
                                     TITLE
                                ================================================== -->

                                    <h3 class="landing-lost-found-card-title">

                                        @item.Title

                                    </h3>


                                    <!-- ==================================================
                                     LOCATION
                                ================================================== -->

                                    <div class="landing-lost-found-card-location-row">

                                        <i data-lucide="map-pin"></i>

                                        <span>

                                            <span class="landing-lost-found-location-label">

                                                @(isLost
                                                    ? "Last seen: "
                                                    : "Found in ")

                                            </span>

                                            <span class="landing-lost-found-location-value">

                                                @location

                                            </span>

                                        </span>

                                    </div>


                                    <!-- ==================================================
                                     DESCRIPTION
                                ================================================== -->

                                    <p class="landing-lost-found-card-description">

                                        @item.Description

                                    </p>


                                    <!-- ==================================================
                                     DATE
                                ================================================== -->

                                    <div class="landing-lost-found-card-footer">

                                        <span class="landing-lost-found-card-date">

                                            <i data-lucide="clock"></i>

                                            @item.DateReported.ToString("MMM dd, yyyy")

                                        </span>

                                    </div>

                                </div>

                            </article>

                        </a>

                    </div>
                }


                <!-- ==================================================
                 EXPLORE LOST & FOUND CARD
            ================================================== -->

                <div class="landing-scroll-card">

                    <a asp-controller="LostFounds"
                       asp-action="Browse"
                       class="landing-explore-card lost-found">

                        <div class="landing-explore-icon">

                            <i data-lucide="search"></i>

                        </div>

                        <h3>
                            Explore Lost &amp; Found
                        </h3>

                        <p>
                            Help reunite lost pets
                            with their families.
                        </p>

                        <span>

                            Explore

                            <i data-lucide="arrow-right"></i>

                        </span>

                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         PET TIPS & ANNOUNCEMENTS
    ========================================================== -->

    <section id="petfeed"
             class="landing-section landing-petfeed-section">

        <div class="landing-container">

            <div class="landing-section-heading">

                <div>

                    <span class="landing-eyebrow">
                        PET CARE &amp; COMMUNITY
                    </span>

                    <h2>
                        Stay Informed With the Latest Updates
                    </h2>

                </div>

                <a asp-controller="PetFeeds"
                   asp-action="Feed"
                   class="landing-view-all">

                    View All

                    <i data-lucide="arrow-right"></i>

                </a>

            </div>


            <p class="landing-section-description">

                Read the latest pet care tips and community
                announcements from PetHub.

            </p>


            <div class="landing-petfeed-grid">

                @if (Model.PetFeeds.Any())
                {
                    @foreach (var item in Model.PetFeeds)
                    {
                        <div class="landing-petfeed-item">

                            <a asp-controller="PetFeeds"
                               asp-action="Feed"
                               asp-route-postId="@item.PetFeedId"
                               asp-fragment="post-@item.PetFeedId"
                               class="text-decoration-none text-dark">
                                <div class="landing-petfeed-card">

                                    <div class="landing-petfeed-card-image-wrapper">
                                        @if (item.Images != null && item.Images.Any())
                                        {
                                            <img src="@item.Images.First().ImagePath"
                                                 class="landing-petfeed-card-image"
                                                 alt="@item.Title" />
                                        }
                                        else
                                        {
                                            <img src="~/images/no-image.png"
                                                 class="landing-petfeed-card-image"
                                                 alt="No Image Available" />
                                        }
                                    </div>

                                    <div class="landing-petfeed-card-body">

                                        <small class="landing-petfeed-card-date">
                                            @item.DateCreated.ToString("MMMM dd, yyyy")
                                        </small>

                                        <h3 class="landing-petfeed-card-title">
                                            @item.Title
                                        </h3>

                                        <p class="landing-petfeed-card-description">
                                            @(item.Content.Length > 120
                                                ? item.Content.Substring(0, 120) + "..."
                                                : item.Content)
                                        </p>


                                    </div>
                                </div>

                            </a>

                        </div>
                    }
                }

            </div>

        </div>

    </section>


    <!-- ==========================================================
         HOW PETHUB WORKS
    ========================================================== -->

    <section id="how-it-works"
             class="landing-section landing-how-section">

        <div class="landing-container">

            <div class="landing-centered-content">

                <span class="landing-eyebrow">
                    SIMPLE &amp; INTUITIVE
                </span>

                <h2>
                    How PetHub Works
                </h2>

            </div>


            <div class="landing-steps">

                <!-- STEP 1 -->

                <div class="landing-step">

                    <div class="landing-step-circle">

                        <i data-lucide="user-plus"></i>

                        <span>1</span>

                    </div>

                    <h3>
                        Create an account
                    </h3>

                    <p>
                        Join the PetHub community
                        in just a few clicks.
                    </p>

                </div>


                <!-- STEP 2 -->

                <div class="landing-step">

                    <div class="landing-step-circle">

                        <i data-lucide="compass"></i>

                        <span>2</span>

                    </div>

                    <h3>
                        Explore PetHub
                    </h3>

                    <p>
                        Browse listings, lost pets,
                        and community posts.
                    </p>

                </div>


                <!-- STEP 3 -->

                <div class="landing-step">

                    <div class="landing-step-circle">

                        <i data-lucide="file-text"></i>

                        <span>3</span>

                    </div>

                    <h3>
                        Post or browse listings
                    </h3>

                    <p>
                        List a pet for adoption
                        or report a lost pet.
                    </p>

                </div>


                <!-- STEP 4 -->

                <div class="landing-step">

                    <div class="landing-step-circle">

                        <i data-lucide="heart"></i>

                        <span>4</span>

                    </div>

                    <h3>
                        Connect with the community
                    </h3>

                    <p>
                        Meet fellow pet lovers
                        and make a difference.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         WHY CHOOSE PETHUB
    ========================================================== -->

    <section class="landing-section landing-trust-section">

        <div class="landing-container">

            <div class="landing-centered-content">

                <span class="landing-eyebrow">
                    BUILT ON TRUST
                </span>

                <h2>
                    Why Choose PetHub?
                </h2>

            </div>


            <div class="landing-trust-grid">

                <!-- EASY TO USE -->

                <div class="landing-trust-card">

                    <div class="landing-trust-icon green">
                        <i data-lucide="zap"></i>
                    </div>

                    <div>

                        <h3>
                            Easy to Use
                        </h3>

                        <p>
                            Clean and beginner-friendly interface
                            that anyone can navigate with confidence.
                        </p>

                    </div>

                </div>


                <!-- COMMUNITY -->

                <div class="landing-trust-card">

                    <div class="landing-trust-icon green">
                        <i data-lucide="users"></i>
                    </div>

                    <div>

                        <h3>
                            Community Driven
                        </h3>

                        <p>
                            Pet lovers helping pet lovers —
                            a community built on trust and compassion.
                        </p>

                    </div>

                </div>


                <!-- SAFE -->

                <div class="landing-trust-card">

                    <div class="landing-trust-icon green">
                        <i data-lucide="shield"></i>
                    </div>

                    <div>

                        <h3>
                            Safe &amp; Secure
                        </h3>

                        <p>
                            Registered members and active moderation
                            help keep the platform trustworthy.
                        </p>

                    </div>

                </div>


                <!-- LOCAL -->

                <div class="landing-trust-card">

                    <div class="landing-trust-icon green">
                        <i data-lucide="map-pin"></i>
                    </div>

                    <div>

                        <h3>
                            Local Support
                        </h3>

                        <p>
                            Focused on helping nearby communities
                            so help is always close to home.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         FINAL CTA
    ========================================================== -->

    <section class="landing-section landing-cta-section">

        <div class="landing-container">

            <div class="landing-cta">

                <div class="landing-cta-content">

                    <span class="landing-cta-badge">

                        <i data-lucide="paw-print"></i>

                        Join our community

                    </span>

                    <h2>
                        Ready to become part
                        of our community?
                    </h2>

                    <p>
                        Join PetHub today and help make a difference
                        for cats and dogs in your area. It's free to sign
                        up and only takes a minute.
                    </p>

                    <div class="landing-cta-buttons">

                        <a asp-controller="UserAccount"
                           asp-action="Register"
                           class="landing-cta-primary">

                            Create an Account

                            <i data-lucide="arrow-right"></i>

                        </a>

                        <a href="#marketplace"
                           class="landing-cta-secondary">

                            Explore First

                        </a>

                    </div>

                </div>


                <div class="landing-cta-image">

                    <img src="~/images/creeate-banner.jpg"
                         asp-append-version="true"
                         alt="PetHub">

                </div>

            </div>

        </div>

    </section>

    <!-- ==========================================================
     FOOTER
========================================================== -->

    <footer class="landing-footer">

        <div class="landing-footer-content">

            <!-- LEFT -->
            <div class="landing-footer-brand">

                <div class="landing-footer-logo">

                    <img src="~/images/PETHUB-LOGO.png"
                         asp-append-version="true"
                         alt="PetHub Logo" />

                    <span>PetHub</span>

                </div>

                <p>
                    Helping pets find their way home.
                </p>

            </div>


            <!-- RIGHT -->
            <div class="landing-footer-copyright">

                <span>
                    © 2026 PetHub
                </span>

                <span class="landing-footer-separator">•</span>

                <span>
                    Academic Project
                </span>

            </div>

        </div>

    </footer>

</div>