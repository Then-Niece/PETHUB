@model PETHUB.ViewModels.PublicLandingPageViewModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "PetHub";
}

<div class="container-fluid p-0">

    <!-- ============================= -->
    <!-- HERO SECTION -->
    <!-- ============================= -->

    <section style="
        background:#F8FAF7;
        padding:100px 0;">

        <div class="container">

            <div class="row align-items-center">

                <!-- LEFT SIDE -->

                <div class="col-lg-6">

                    <span class="badge rounded-pill mb-4 px-3 py-2"
                          style="
                        background:#EAF8E6;
                        color:#4F8D42;
                        font-size:.9rem;">

                        Trusted Pet Community

                    </span>

                    <h1 class="display-3 fw-bold mb-4"
                        style="
                        color:#2D3748;
                        line-height:1.2;">

                        Helping Every Pet
                        <br />

                        Find a Loving Home.

                    </h1>

                    <p class="fs-5 text-muted mb-5"
                       style="line-height:1.8;">

                        PetHub is a trusted community platform where pet owners,
                        adopters, and animal lovers reconnect lost pets,
                        discover adoption opportunities, and promote
                        responsible pet ownership.

                    </p>

                    <div class="d-flex gap-3">

                        <a asp-controller="UserAccount"
                           asp-action="Register"
                           class="btn btn-lg rounded-pill fw-semibold px-5 py-3 text-white"
                           style="
                            background:#8ACE79;
                            border:none;
                            transition:.3s;"
                           onmouseover="
                            this.style.background='#6FBF5E'"
                           onmouseout="
                            this.style.background='#8ACE79'">

                            Join PetHub

                        </a>

                        <a href="#services"
                           class="btn btn-lg rounded-pill fw-semibold px-5 py-3"
                           style="
                            border:2px solid #8ACE79;
                            color:#2D3748;
                            transition:.3s;"
                           onmouseover="
                            this.style.background='#8ACE79';
                            this.style.color='white';"
                           onmouseout="
                            this.style.background='transparent';
                            this.style.color='#2D3748';">

                            Explore

                        </a>

                    </div>

                </div>


                <!-- RIGHT SIDE -->

                <div class="col-lg-6 text-center">

                    <img src="~/images/hero-dog.png"
                         asp-append-version="true"
                         class="img-fluid"
                         style="
                    max-height:520px;
                    border-radius:30px;"
                         alt="PetHub Hero">

                </div>

            </div>

        </div>

    </section>

</div>

<!-- ============================= -->
<!-- OUR MISSION -->
<!-- ============================= -->

<section id="about" class="bg-white py-5">

    <div class="container">

        <div class="row align-items-start g-5">

            <!-- Left Image -->

            <div class="col-lg-6">

                <img src="~/images/mission-cat.jpg"
                     asp-append-version="true"
                     class="img-fluid shadow"
                     style="
                border-radius:28px;
                width:100%;
                height:500px;
                object-fit:cover;"
                     alt="PetHub Mission">

            </div>

            <!-- Right Content -->

            <div class="col-lg-6 pt-lg-3">

                <!-- Badge -->

                <span class="badge rounded-pill mb-3 px-3 py-2"
                      style="
                    background:#EEF8EC;
                    color:#8ACE79;
                    font-size:14px;">

                    Our Mission

                </span>

                <!-- Heading -->

                <h2 class="fw-bold mb-4"
                    style="
                    color:#2D3748;
                    font-size:3rem;
                    line-height:1.2;">

                    Creating a Safe and Supportive Community
                    for Every Cat and Dog

                </h2>

                <!-- Description -->

                <p class="text-muted"
                   style="
                    font-size:1.15rem;
                    line-height:2;">

                    PetHub is committed to creating a trusted online community
                    where pet owners, adopters, and animal lovers work together
                    to reunite lost pets, encourage responsible pet ownership,
                    and help every cat and dog find a safe and loving home.

                </p>

            </div>

        </div>

    </div>

</section>



<!-- ============================= -->
<!-- OUR SERVICES -->
<!-- ============================= -->

<section id="services"
         class="py-5"
         style="background:#F8FAF7;">

   

    <div class="mb-5 text-center">

        <span class="fw-semibold"
              style="color:#8ACE79; letter-spacing:1px;">

            WHAT WE OFFER

        </span>

        <h2 class="fw-bold mt-3 mb-3"
            style="color:#2D3748;">

            Everything You Need
            in One Pet Community

        </h2>

        <p class="text-muted mx-auto"
           style="max-width:700px; line-height:1.8;">

            PetHub brings together essential features that help pet owners
            and animal lovers connect through a trusted community.
            Browse pets available for adoption or sale in the Marketplace,
            help reunite lost pets through Lost &amp; Found reports,
            and explore educational pet care tips designed to promote
            responsible pet ownership.

        </p>

    </div>

</section>

<!-- ============================= -->
<!-- MARKETPLACE -->
<!-- ============================= -->

<section id="marketplace" class="bg-white py-5">

    <div class="container">

        <div class="mb-5 text-center">

            <span class="fw-semibold"
                  style="color:#8ACE79; letter-spacing:1px;">
                MARKETPLACE
            </span>

            <h2 class="fw-bold mt-3"
                style="color:#2D3748;">
                Find Your Perfect Companion
            </h2>

        </div>

        <div class="row g-4">

            @foreach (var item in Model.MarketplaceListings)
            {
                <div class="col-lg-3 col-md-6">

                    <a asp-controller="Listings"
                       asp-action="Marketplace"
                       class="text-decoration-none text-dark">

                        <div class="card marketplace-card h-100 border-0 shadow-sm">

                            @if (item.Images != null && item.Images.Any())
                            {
                                <img src="@item.Images.First().ImagePath"
                                     class="card-img-top"
                                     alt="@item.Title">
                            }
                            else
                            {
                                <img src="~/images/no-image.png"
                                     class="card-img-top"
                                     alt="No Image">
                            }

                            <div class="card-body">

                                <h5 class="fw-bold mb-2">
                                    @item.Title
                                </h5>

                                <p class="text-muted small description">
                                    @item.Description
                                </p>

                                <p class="price mb-3">
                                    ₱@item.Price
                                </p>

                                <p class="text-muted small mb-1">
                                    <i class="bi bi-calendar3"></i>
                                    @item.DatePosted.ToString("MMM dd, yyyy")
                                </p>

                                <p class="text-muted small mb-0">
                                    <i class="bi bi-geo-alt"></i>
                                    @item.Location
                                </p>

                            </div>

                        </div>

                    </a>

                </div>
            }

        </div>

    </div>

    <div class="mt-5 text-center">

        <a asp-controller="Listings"
           asp-action="Marketplace"
           class="marketplace-link">

            Explore Marketplace ->
            <i class="bi bi-arrow-right"></i>

        </a>

        <p class="marketplace-subtitle mt-2">
            View all available pets and listings.
        </p>

    </div>

</section>


<!-- ============================= -->
<!-- WHY CHOOSE PETHUB -->
<!-- ============================= -->

<section class="pet-feature-strip">

    <div class="container">

        <div class="row justify-content-center text-center">

            <div class="col-lg-4 col-md-6 col-12">

                <i data-lucide="shield-check" class="feature-icon"></i>

                <h5>Verified Listings</h5>

                <p>
                    Every marketplace listing is reviewed before it becomes visible.
                </p>

            </div>

            <div class="col-lg-4 col-md-6 col-12">

                <i data-lucide="paw-print" class="feature-icon"></i>

                <h5>Pet Welfare</h5>

                <p>
                    Supporting responsible pet ownership and better homes for pets.
                </p>

            </div>

            <div class="col-lg-4 col-md-6 col-12">

                <i data-lucide="heart-handshake" class="feature-icon"></i>

                <h5>Lost & Found</h5>

                <p>
                    Helping reunite lost pets with their families.
                </p>

            </div>

            

        </div>

    </div>

</section>

<!-- ============================= -->
<!-- Lost & FOUND -->
<!-- ============================= -->

<section id="lostandfound" class="bg-white py-5">

    <div class="container">

        <div class="mb-5 text-center">

            <span class="fw-semibold"
                  style="color:#8ACE79; letter-spacing:1px;">
                LOST & FOUND
            </span>

            <h2 class="fw-bold mt-3"
                style="color:#2D3748;">
                Help them reunite with their love ones
            </h2>

        </div>

        <div class="row g-4">

            @foreach (var item in Model.LostFoundReports)
            {
                <div class="col-lg-3 col-md-6">

                    <a asp-controller="LostFounds"
                       asp-action="Browse"
                       class="text-decoration-none text-dark">

                        <div class="card marketplace-card h-100 border-0 shadow-sm">

                            @if (item.Images != null && item.Images.Any())
                            {
                                <img src="@item.Images.First().ImagePath"
                                     class="card-img-top"
                                     alt="@item.Title">
                            }
                            else
                            {
                                <img src="~/images/no-image.png"
                                     class="card-img-top"
                                     alt="No Image">
                            }

                            <div class="card-body">

                                <h5 class="fw-bold mb-2">
                                    @item.Title
                                </h5>

                                <p class="text-muted small description">
                                    @item.Description
                                </p>

                                <p class="mb-3">
                                    Type: @item.Type
                                </p>

                                <p class="text-muted small mb-1">
                                    <i class="bi bi-calendar3"></i>
                                    @item.DateReported.ToString("MMM dd, yyyy")
                                </p>

                                <p class="text-muted small mb-0">
                                    <i class="bi bi-geo-alt"></i>
                                    @item.Location
                                </p>

                            </div>

                        </div>

                    </a>

                </div>
            }

        </div>

    </div>

    <div class="mt-5 text-center">

        <a asp-controller="LostFounds"
           asp-action="Browse"
           class="marketplace-link">

            Explore Lost & Found ->
            <i class="bi bi-arrow-right"></i>

        </a>

        <p class="marketplace-subtitle mt-2">
            View all lost and found reports.
        </p>

    </div>

</section>


<!-- ============================= -->
<!-- PET TIPS & ANNOUNCEMENTS -->
<!-- ============================= -->

<section id="petfeed" class="bg-white py-5">

    <div class="container">

        <div class="mb-5 text-center">

            <span class="fw-semibold"
                  style="color:#8ACE79; letter-spacing:1px;">
                PET CARE & COMMUNITY
            </span>

            <h2 class="fw-bold mt-3"
                style="color:#2D3748;">
                Stay Informed with the Latest Updates
            </h2>

            <p class="text-muted mx-auto"
               style="max-width:700px; line-height:1.8;">
                Read the latest pet care tips and community announcements from PetHub.
            </p>

        </div>

        <div class="row g-4">

      @if (Model.PetFeeds.Any())
    {
        @foreach (var item in Model.PetFeeds)
        {
            <div class="col-lg-4 col-md-6">

                <a asp-controller="PetFeeds"
                   asp-action="Feed"
                   class="text-decoration-none text-dark">

                    <div class="card marketplace-card h-100 border-0 shadow-sm">

                        @if (item.Images != null && item.Images.Any())
                        {
                            <img src="@item.Images.First().ImagePath"
                                 class="card-img-top"
                                 alt="@item.Title" />
                        }
                        else
                        {
                            <img src="~/images/no-image.png"
                                 class="card-img-top"
                                 alt="No Image Available" />
                        }

                        <div class="card-body d-flex flex-column">

                            <small class="text-muted mb-2">
                                @item.DateCreated.ToString("MMMM dd, yyyy")
                            </small>

                            <h5 class="fw-bold">
                                @item.Title
                            </h5>

                            <p class="description flex-grow-1">
                                @(item.Content.Length > 120
                                    ? item.Content.Substring(0, 120) + "..."
                                    : item.Content)
                            </p>

                        </div>

                    </div>

                </a>

            </div>
        }
    }

        </div>

    </div>

    <div class="mt-5 text-center">

        <a asp-controller="PetFeeds"
           asp-action="Feed"
           class="marketplace-link">

            Explore Pet Feed ->
            <i class="bi bi-arrow-right"></i>

        </a>

        <p class="marketplace-subtitle mt-2">
            Read more pet care tips and community announcements.
        </p>

    </div>

</section>




<!-- ============================= -->
<!-- CALL TO ACTION -->
<!-- ============================= -->

<section class="cta-section">
    <div class="container">

        <div class="cta-box text-center">

            <h2>Start Your PetHub Journey Today</h2>

            <p>
                Create an account to discover pets for adoption, report lost pets,
                and become part of a trusted community dedicated to responsible
                pet ownership.
            </p>

            <a asp-controller="UserAccount"
               asp-action="Register"
               class="btn cta-btn">
                Create Your Account
            </a>

            <div class="mt-4">
                <span class="text-white-50">
                    Already have an account?
                </span>

                <a asp-controller="UserAccount"
                   asp-action="Login"
                   class="cta-login">
                    Log In
                </a>
            </div>

        </div>

    </div>
</section>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - PETHUB -
        <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>

