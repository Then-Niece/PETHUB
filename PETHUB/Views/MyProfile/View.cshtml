@model PETHUB.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "View my Profile";
}

<div class="container-fluid py-4">

    @* =========================================================
       SUCCESS MESSAGE
       ========================================================= *@

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }





    @* =========================================================
       MAIN PROFILE LAYOUT
       ========================================================= *@

    <div class="profile-page-layout">


        @* =====================================================
           LEFT COLUMN
           ===================================================== *@

        <div class="profile-left-column">


            @* =================================================
               PROFILE CARD
               ================================================= *@

            <div class="profile-member-card">

                @* Profile Header / Cover *@

                <div class="profile-card-cover">
                </div>


                @* Profile Picture *@

                <div class="profile-picture-wrapper">

                    @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                    {
                        <img id="profilePicturePreview"
                             src="@Model.ProfilePicturePath"
                             class="profile-picture"
                             alt="Profile Picture" />
                    }
                    else
                    {
                        <img id="profilePicturePreview"
                             src="~/images/default_profile.jpg"
                             class="profile-picture"
                             alt="Default Profile Picture" />
                    }

                </div>


                @* Member Information *@

                <div class="profile-member-info">

                    <h3 class="profile-member-name">

                        @Model.FirstName

                        @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                        {
                            <span>
                                @Model.MiddleName
                            </span>
                        }

                        @Model.LastName

                    </h3>


                    <div class="profile-member-role">
                        Member
                    </div>


                    <p class="profile-member-joined">
                        Joined
                        @Model.CreatedAt.ToString("MMMM dd, yyyy")
                    </p>


                    @* Edit Profile *@

                    <a asp-action="Edit"
                       class="profile-edit-button">

                        Edit Profile

                    </a>

                </div>

            </div>


            @* =================================================
               ACTIVITY CARD
               ================================================= *@

            <div class="profile-activity-card">

                <div class="profile-section-header">

                    <h4>
                        Activity
                    </h4>

                    <p>
                        Overview of your activity
                    </p>

                </div>


                @* Marketplace Listings *@

                <div class="profile-activity-item">

                    <div class="profile-activity-content">

                        <strong>
                            @Model.MarketplaceListingsCount
                        </strong>

                        <span>
                            Marketplace Listings
                        </span>

                    </div>

                </div>


                @* Lost & Found Reports *@

                <div class="profile-activity-item">

                    <div class="profile-activity-content">

                        <strong>
                            @Model.LostFoundReportsCount
                        </strong>

                        <span>
                            Lost &amp; Found Reports
                        </span>

                    </div>

                </div>


                @* Pets Sold *@

                <div class="profile-activity-item">

                    <div class="profile-activity-content">

                        <strong>
                            @Model.PetsSoldCount
                        </strong>

                        <span>
                            Pets Sold
                        </span>

                    </div>

                </div>


                @* Pets Adopted *@

                <div class="profile-activity-item">

                    <div class="profile-activity-content">

                        <strong>
                            @Model.PetsAdoptedCount
                        </strong>

                        <span>
                            Pets Adopted
                        </span>

                    </div>

                </div>


                @* Resolved Reports *@

                <div class="profile-activity-item">

                    <div class="profile-activity-content">

                        <strong>
                            @Model.ResolvedReportsCount
                        </strong>

                        <span>
                            Resolved Reports
                        </span>

                    </div>

                </div>

            </div>

        </div>


        @* =====================================================
           RIGHT COLUMN
           ===================================================== *@

        <div class="profile-right-column">


            @* =================================================
               PERSONAL INFORMATION
               ================================================= *@

            <div class="profile-information-card">

                <div class="profile-section-header">

                    <h3>
                        Personal Information
                    </h3>

                    <p>
                        Your profile details
                    </p>

                </div>


                @* NAME *@

                <h6 class="profile-subsection-title">
                    Name
                </h6>


                <div class="profile-information-grid">


                    @* First Name *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            First Name
                        </span>

                        <span class="profile-information-value">
                            @Model.FirstName
                        </span>

                    </div>


                    @* Middle Name *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            Middle Name
                        </span>

                        <span class="profile-information-value">

                            @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                            {
                                @Model.MiddleName
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not specified
                                </span>
                            }

                        </span>

                    </div>


                    @* Last Name *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            Last Name
                        </span>

                        <span class="profile-information-value">
                            @Model.LastName
                        </span>

                    </div>

                </div>


                @* CONTACT DETAILS *@

                <h6 class="profile-subsection-title">
                    Contact Details
                </h6>


                <div class="profile-information-grid">


                    @* Email *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            Email Address
                        </span>

                        <span class="profile-information-value">
                            @Model.Email
                        </span>

                    </div>


                    @* Contact Number *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            Contact Number
                        </span>

                        <span class="profile-information-value">
                            @Model.ContactNumber
                        </span>

                    </div>

                </div>


                @* PERSONAL DETAILS *@

                <h6 class="profile-subsection-title">
                    Personal Details
                </h6>


                <div class="profile-information-grid">


                    @* Gender *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            Gender
                        </span>

                        <span class="profile-information-value">
                            @Model.Gender
                        </span>

                    </div>


                    @* Birthdate *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            Birthdate
                        </span>

                        <span class="profile-information-value">

                            @if (Model.Birthdate.HasValue)
                            {
                                @Model.Birthdate.Value.ToString("MMMM dd, yyyy")
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not specified
                                </span>
                            }

                        </span>

                    </div>

                </div>

            </div>


            @* =================================================
               ADDRESS
               ================================================= *@

            <div class="profile-information-card">

                <div class="profile-section-header">

                    <h3>
                        Address
                    </h3>

                    <p>
                        Your residential address
                    </p>

                </div>


                <h6 class="profile-subsection-title">
                    Location
                </h6>


                <div class="profile-information-grid">


                    @* Province *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            Province
                        </span>

                        <span class="profile-information-value">
                            @Model.Province
                        </span>

                    </div>


                    @* City *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            City / Municipality
                        </span>

                        <span class="profile-information-value">
                            @Model.City
                        </span>

                    </div>


                    @* Barangay *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            Barangay
                        </span>

                        <span class="profile-information-value">
                            @Model.Barangay
                        </span>

                    </div>


                    @* Street Address *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            Street Address
                        </span>

                        <span class="profile-information-value">
                            @Model.StreetAddress
                        </span>

                    </div>

                </div>

            </div>


            @* =================================================
               VERIFICATION
               ================================================= *@

            <div class="profile-information-card">

                <div class="profile-section-header">

                    <h3>
                        Verification
                    </h3>

                    <p>
                        Your identity verification document
                    </p>

                </div>


                <h6 class="profile-subsection-title">
                    Verification Document
                </h6>


                <div class="profile-verification-container">

                    <span class="profile-information-label">
                        Current Valid ID
                    </span>


                    @if (User.IsInRole("Member"))
                    {

                        @if (!string.IsNullOrEmpty(Model.IdPhotoPath))
                        {
                            <img src="@Model.IdPhotoPath"
                                 class="profile-id-image"
                                 alt="Current Valid ID" />
                        }
                        else
                        {
                            <div class="profile-id-placeholder">

                                <strong>
                                    No Valid ID Uploaded
                                </strong>

                                <span>
                                    Upload one in Edit Profile to verify your account.
                                </span>

                            </div>
                        }

                    }

                </div>

            </div>


            @* =================================================
               ACCOUNT INFORMATION
               ================================================= *@

            <div class="profile-information-card">

                <div class="profile-section-header">

                    <h3>
                        Account Information
                    </h3>

                    <p>
                        Membership and account status
                    </p>

                </div>


                @* ACCOUNT *@

                <h6 class="profile-subsection-title">
                    Account
                </h6>


                <div class="profile-information-grid">


                    @* Email Address *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            Email Address
                        </span>

                        <span class="profile-information-value">
                            @Model.Email
                        </span>

                    </div>


                    @* Member Since *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            Member Since
                        </span>

                        <span class="profile-information-value">
                            @Model.CreatedAt.ToString("MMMM dd, yyyy")
                        </span>

                    </div>

                </div>


                @* ACCOUNT STATUS *@

                <h6 class="profile-subsection-title">
                    Account Status
                </h6>


                <div class="profile-information-grid">


                    @* Status *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            Status
                        </span>

                        <span class="profile-information-value">
                            @Model.Status
                        </span>

                    </div>


                    @* Accepted Terms *@

                    <div class="profile-information-item">

                        <span class="profile-information-label">
                            Accepted Terms
                        </span>

                        <span class="profile-information-value">

                            @(Model.AcceptedTermsDate?.ToString("MMMM dd, yyyy")
                                ?? "Not Accepted Terms and Agreement")

                        </span>

                    </div>

                </div>

            </div>


        </div>

    </div>

</div>