@model PETHUB.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Edit My Profile";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <!-- ========================================================= -->
            <!-- PAGE HEADER                                                -->
            <!-- ========================================================= -->
            @if (TempData["SuccessMessage"] != null) @* Shows Success Message After Saving Changes *@
            {
                <div class="alert alert-success alert-dismissible fade show">

                    @TempData["SuccessMessage"] @* Call from TempData in MyProfileController *@

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h2 class="mb-1">Edit My Profile</h2>

                    <p class="text-muted mb-0">
                        Manage your personal information and account details.
                    </p>

                </div>

            </div>

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()
                @* Summarize overall error on validation fields *@
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>
                <!-- ========================================================= -->
                <!-- PROFILE CARD                                               -->
                <!-- ========================================================= -->

                <div class="card shadow-sm mb-4 mt-4">

                    <div class="card-body text-center">

                        <!-- Profile Picture -->
                        @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                        {
                            <img id="profilePicturePreview"
                                 src="@Model.ProfilePicturePath"
                                 class="rounded-circle border mb-3"
                                 width="180"
                                 height="180"
                                 style="object-fit:cover;" />
                        }
                        else
                        {
                            <img id="profilePicturePreview"
                                 src="~/images/default-profile.png"
                                 class="rounded-circle border mb-3"
                                 width="180"
                                 height="180"
                                 style="object-fit:cover;" />
                        }
                        <!-- Name -->

                        <h3 class="mb-1">

                            @Model.FirstName

                            @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                            {
                                @Model.MiddleName
                            }

                            @Model.LastName

                        </h3>

                        <!-- User Type -->

                        <p class="text-muted mb-2">

                            Member

                        </p>

                        <!-- Joined Date -->

                        <p class="text-secondary">

                            <strong>Joined:</strong>

                            @Model.CreatedAt.ToString("MMMM dd, yyyy")

                        </p>

                        <!-- Change Profile Picture -->
                        <!-- Hidden file input used for selecting a new profile picture -->
                        <input asp-for="ProfilePictureFile"
                               type="file"
                               id="profilePictureInput"
                               accept=".jpg,.jpeg,.png,.webp"
                               class="d-none" />

                        <!-- Opens the hidden file picker -->
                        <button type="button"
                                id="changeProfilePictureBtn"
                                class="btn btn-outline-success mb-4">

                            Change Profile Picture

                        </button>

                        <span asp-validation-for="ProfilePictureFile"
                              class="text-danger d-block mt-2">
                        </span>
                        <hr />

                        <div class="border-top mt-4 pt-4">

                            <!-- ========================================================= -->
                            <!-- ACTIVITY SUMMARY                                          -->
                            <!-- ========================================================= -->

                            <div class="row g-0 text-center">

                                <div class="col">

                                    <small class="text-muted d-block">
                                        Marketplace Listings
                                    </small>

                                    <h3 class="fw-bold mt-2 mb-0">
                                        0
                                    </h3>

                                </div>

                                <div class="col border-start">

                                    <small class="text-muted d-block">
                                        Lost &amp; Found Reports
                                    </small>

                                    <h3 class="fw-bold mt-2 mb-0">
                                        0
                                    </h3>

                                </div>

                                <div class="col border-start">

                                    <small class="text-muted d-block">
                                        Pets Sold
                                    </small>

                                    <h3 class="fw-bold mt-2 mb-0">
                                        0
                                    </h3>

                                </div>

                                <div class="col border-start">

                                    <small class="text-muted d-block">
                                        Pets Adopted
                                    </small>

                                    <h3 class="fw-bold mt-2 mb-0">
                                        0
                                    </h3>

                                </div>

                                <div class="col border-start">

                                    <small class="text-muted d-block">
                                        Resolved Reports
                                    </small>

                                    <h3 class="fw-bold mt-2 mb-0">
                                        0
                                    </h3>

                                </div>

                            </div>

                        </div>

                        @* ========================================================= *@
                        @* ABOUT ME                                                  *@
                        @* ========================================================= *@

                        <div class="card shadow-sm mb-4 mt-4">

                            <div class="card-body text-start">

                                <h4 class="mb-1">
                                    About Me
                                </h4>

                                <p class="text-muted mb-4">
                                    Share a short introduction about yourself with other members.
                                </p>

                                <h6 class="fw-bold text-success border-bottom pb-2 mb-4">
                                    Biography
                                </h6>

                                <textarea asp-for="Bio"
                                          rows="5"
                                          class="form-control"
                                          placeholder="Tell other members a little about yourself...">
                                    </textarea>
                                <span asp-validation-for="Bio" class="text-danger"></span>
                            </div>

                        </div>

                        @* ========================================================= *@
                        @* PERSONAL INFORMATION                                      *@
                        @* ========================================================= *@

                        <div class="card shadow-sm mb-4 mt-4">

                            <div class="card-body">

                                <h4 class="mb-1 text-start">
                                    Personal Information
                                </h4>

                                <p class="text-muted mb-4 text-start">
                                    Update your personal details below.
                                </p>

                                @* ------------------------------------------------- *@
                                @* NAME                                              *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mb-4 text-start">
                                    Name
                                </h6>

                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label asp-for="FirstName" class="fw-semibold"></label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="FirstName" class="form-control" />
                                        <span asp-validation-for="FirstName" class="text-danger"></span>
                                    </div>

                                </div>

                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label asp-for="MiddleName" class="fw-semibold"></label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="MiddleName" class="form-control" />
                                        <span asp-validation-for="MiddleName" class="text-danger"></span>
                                    </div>

                                </div>

                                <div class="row align-items-center">

                                    <div class="col-md-4">
                                        <label asp-for="LastName" class="fw-semibold"></label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="LastName" class="form-control" />
                                        <span asp-validation-for="LastName" class="text-danger"></span>
                                    </div>

                                </div>

                                @* ------------------------------------------------- *@
                                @* CONTACT DETAILS                                   *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mt-5 mb-4 text-start">
                                    Contact Details
                                </h6>

                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">

                                        <label class="fw-semibold">
                                            Email Address
                                        </label>

                                    </div>

                                    <div class="col-md-8">

                                        <input asp-for="Email"
                                               class="form-control"
                                               readonly />

                                    </div>

                                </div>

                                <div class="row align-items-center">

                                    <div class="col-md-4">

                                        <label asp-for="ContactNumber"
                                               class="fw-semibold">
                                        </label>

                                    </div>

                                    <div class="col-md-8">

                                        <input asp-for="ContactNumber"
                                               class="form-control" />
                                        <span asp-validation-for="ContactNumber" class="text-danger"></span>

                                    </div>

                                </div>

                                @* ------------------------------------------------- *@
                                @* PERSONAL DETAILS                                  *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mt-5 mb-4 text-start">
                                    Personal Details
                                </h6>

                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">

                                        <label asp-for="Gender"
                                               class="fw-semibold">
                                        </label>

                                    </div>

                                    <div class="col-md-8">

                                        <select asp-for="Gender"
                                                class="form-select">

                                            <option value="">
                                                Select Gender
                                            </option>

                                            <option>Male</option>

                                            <option>Female</option>

                                        </select>
                                        <span asp-validation-for="Gender" class="text-danger"></span>
                                    </div>

                                </div>

                                <div class="row align-items-center">

                                    <div class="col-md-4">

                                        <label asp-for="Birthdate"
                                               class="fw-semibold">
                                        </label>

                                    </div>

                                    <div class="col-md-8">

                                        <input asp-for="Birthdate"
                                               type="date"
                                               class="form-control" />
                                        <span asp-validation-for="Birthdate" class="text-danger"></span>
                                    </div>

                                </div>
                            </div>

                        </div>
                        @* ========================================================= *@
                        @* ADDRESS                                                   *@
                        @* ========================================================= *@

                        <div class="card shadow-sm mb-4 mt-4">

                            <div class="card-body text-start">

                                <h4 class="mb-1">
                                    Address
                                </h4>

                                <p class="text-muted mb-4">
                                    Update your residential address below.
                                </p>

                                @* ------------------------------------------------- *@
                                @* LOCATION                                          *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mb-4">
                                    Location
                                </h6>

                                <!-- Province -->
                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label asp-for="Province" class="fw-semibold"></label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="Province" class="form-control" />
                                        <span asp-validation-for="Province" class="text-danger"></span>
                                    </div>

                                </div>

                                <!-- City -->
                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label asp-for="City" class="fw-semibold">
                                            City / Municipality
                                        </label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="City" class="form-control" />
                                        <span asp-validation-for="City" class="text-danger"></span>
                                    </div>

                                </div>

                                <!-- Barangay -->
                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label asp-for="Barangay" class="fw-semibold"></label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="Barangay" class="form-control" />
                                        <span asp-validation-for="Barangay" class="text-danger"></span>
                                    </div>

                                </div>

                                <!-- Street Address -->
                                <div class="row align-items-center">

                                    <div class="col-md-4">
                                        <label asp-for="StreetAddress" class="fw-semibold"></label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="StreetAddress"
                                               class="form-control" />
                                        <span asp-validation-for="StreetAddress" class="text-danger"></span>
                                    </div>

                                </div>

                            </div>

                        </div>
                        @* ========================================================= *@
                        @* VERIFICATION                                              *@
                        @* ========================================================= *@

                        <div class="card shadow-sm mb-4">

                            <div class="card-body text-start">

                                <h4 class="mb-1">
                                    Verification
                                </h4>

                                <p class="text-muted mb-4">
                                    Manage your identity verification document.
                                </p>

                                @* ------------------------------------------------- *@
                                @* VERIFICATION DOCUMENT                            *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mb-4">
                                    Verification Document
                                </h6>

                                <div class="row align-items-start">

                                    <div class="col-md-4">

                                        <label class="fw-semibold">
                                            Current Valid ID
                                        </label>

                                    </div>

                                    <div class="col-md-8">

                                        @* Only Members are allowed to upload and replace Valid IDs *@
                                        @if (User.IsInRole("Member"))
                                        {
                                            @* Display the currently uploaded Valid ID if one exists *@
                                            @if (!string.IsNullOrEmpty(Model.IdPhotoPath))
                                            {
                                                <img src="@Model.IdPhotoPath"
                                                     id="validIdPreview"
                                                     class="img-thumbnail mb-3"
                                                     style="max-width:350px; max-height:220px; object-fit:contain;" />
                                            }
                                            else
                                            {
                                                @* Placeholder shown when no Valid ID has been uploaded *@
                                                <div id="validIdPlaceholder"
                                                     class="border rounded d-flex justify-content-center align-items-center mb-3"
                                                     style="width:350px; height:220px;">

                                                    <span class="text-muted">
                                                        No Valid ID Uploaded
                                                    </span>

                                                </div>

                                                @* Hidden preview image that will be shown after selecting a file *@
                                                <img id="validIdPreview"
                                                     class="img-thumbnail mb-3 d-none"
                                                     style="max-width:350px; max-height:220px; object-fit:contain;" />
                                            }

                                            @* Hidden file input used to upload a replacement Valid ID *@
                                            <input asp-for="IdPhotoFile"
                                                   type="file"
                                                   id="validIdInput"
                                                   accept=".jpg,.jpeg,.png,.webp"
                                                   class="d-none" />

                                            @* Opens the hidden file picker *@
                                            <button type="button"
                                                    id="changeValidIdBtn"
                                                    class="btn btn-outline-success">

                                                Change Valid ID

                                            </button>

                                            <span asp-validation-for="IdPhotoFile"
                                                  class="text-danger d-block mt-2">
                                            </span>

                                            <small class="text-muted d-block mt-2">

                                                Accepted formats:
                                                JPG, JPEG, PNG, WEBP

                                                <br />

                                                Maximum file size:
                                                5 MB

                                            </small>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>

                        @* ========================================================= *@
                        @* ACCOUNT INFORMATION                                       *@
                        @* ========================================================= *@

                        <div class="card shadow-sm mb-4">

                            <div class="card-body text-start">

                                <h4 class="mb-1">
                                    Account Information
                                </h4>

                                <p class="text-muted mb-4">
                                    View your account information and membership details.
                                </p>

                                @* ------------------------------------------------- *@
                                @* ACCOUNT                                           *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mb-4">
                                    Account
                                </h6>

                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label class="fw-semibold">
                                            Email Address
                                        </label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="Email"
                                               class="form-control"
                                               readonly />
                                    </div>

                                </div>

                                <div class="row align-items-center">

                                    <div class="col-md-4">
                                        <label class="fw-semibold">
                                            Member Since
                                        </label>
                                    </div>

                                    <div class="col-md-8">
                                        <input class="form-control"
                                               value="@Model.CreatedAt.ToString("MMMM dd, yyyy")"
                                               readonly />
                                    </div>

                                </div>

                                @* ------------------------------------------------- *@
                                @* ACCOUNT STATUS                                    *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mt-5 mb-4">
                                    Account Status
                                </h6>

                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label class="fw-semibold">
                                            Status
                                        </label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="Status"
                                               class="form-control"
                                               readonly />
                                    </div>

                                </div>

                                <div class="row align-items-center">

                                    <div class="col-md-4">
                                        <label class="fw-semibold">
                                            Accepted Terms
                                        </label>
                                    </div>

                                    <div class="col-md-8">

                                        <input class="form-control"
                                               value="@(Model.AcceptedTermsDate?.ToString("MMMM dd, yyyy") ?? "Not Accepted Terms and Agreement")"
                                               readonly />

                                    </div>

                                </div>

                            </div>
                        </div>
                        @* ========================================================= *@
                        @* ACTIONS                                                   *@
                        @* ========================================================= *@

                        <div class="card shadow-sm mb-4">

                            <div class="card-body">

                                <h4 class="mb-1 text-start">
                                    Actions
                                </h4>

                                <p class="text-muted mb-4 text-start">
                                    Review your changes before saving.
                                </p>

                                <div class="d-flex justify-content-end gap-2">

                                    <a asp-action="Edit"
                                       class="btn btn-outline-secondary">

                                        Cancel

                                    </a>

                                    <button type="submit"
                                            class="btn btn-success">

                                        Save Changes

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        // Wait until the page has fully loaded.
        document.addEventListener("DOMContentLoaded", function () {

            // Get the hidden file input.
            const fileInput = document.getElementById("profilePictureInput");

            // Get the visible button.
            const button = document.getElementById("changeProfilePictureBtn");

            // Clicking the button opens the hidden file selector.
            button.addEventListener("click", function () {

                fileInput.click();

            });

        });

    </script>

    <script>

    // ============================================================
    // Profile Picture Live Preview
    // ============================================================

    document.addEventListener("DOMContentLoaded", function () {

        const profilePictureInput = document.getElementById("profilePictureInput");
        const profilePicturePreview = document.getElementById("profilePicturePreview");

        // Exit safely if the controls are missing.
        if (!profilePictureInput || !profilePicturePreview)
            return;

        profilePictureInput.addEventListener("change", function () {

            if (this.files && this.files[0]) {

                const reader = new FileReader();

                reader.onload = function (e) {

                    profilePicturePreview.src = e.target.result;

                };

                reader.readAsDataURL(this.files[0]);

            }

        });

    });

</script>

<script>

// ============================================================
// Valid ID Upload & Live Preview
// ============================================================

document.addEventListener("DOMContentLoaded", function () {

    // Get the hidden file input.
    const validIdInput = document.getElementById("validIdInput");

    // Get the Change Valid ID button.
    const changeValidIdBtn = document.getElementById("changeValidIdBtn");

    // Get the preview image.
    const validIdPreview = document.getElementById("validIdPreview");

    // Placeholder shown when there is no uploaded ID.
    const validIdPlaceholder = document.getElementById("validIdPlaceholder");

    // Stop if this user is not a Member.
    if (!validIdInput || !changeValidIdBtn || !validIdPreview)
        return;

    // Open the hidden file picker.
    changeValidIdBtn.addEventListener("click", function () {

        validIdInput.click();

    });

    // Display a live preview after selecting a file.
    validIdInput.addEventListener("change", function () {

        if (this.files && this.files[0]) {

            const reader = new FileReader();

            reader.onload = function (e) {

                validIdPreview.src = e.target.result;

                // Show preview.
                validIdPreview.classList.remove("d-none");

                // Hide placeholder if it exists.
                if (validIdPlaceholder) {
                    validIdPlaceholder.classList.add("d-none");
                }

            };

            reader.readAsDataURL(this.files[0]);

        }

    });

});

</script>
}