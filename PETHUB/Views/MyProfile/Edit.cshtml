@model PETHUB.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Edit My Profile";

    ViewData["Province"] = Model.Province;
    ViewData["City"] = Model.City;
    ViewData["Barangay"] = Model.Barangay;
    ViewData["StreetAddress"] = Model.StreetAddress;
}


<div class="container-fluid py-4">

    @* Success message *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <div class="profile-page-layout">


            @* =====================================================
               LEFT SIDE
               ===================================================== *@

            <div class="profile-left-column">


                @* Profile card *@

                <div class="profile-member-card">

                    <div class="profile-card-cover">
                    </div>


                    <div class="profile-picture-wrapper">

                        @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                        {
                            <img id="profilePicturePreview"
                                 src="@Model.ProfilePicturePath"
                                 class="profile-picture"
                                 alt="Profile Picture" />
                        }
                        else
                        {
                            <img id="profilePicturePreview"
                                 src="~/images/default_profile.jpg"
                                 class="profile-picture"
                                 alt="Default Profile Picture" />
                        }

                    </div>


                    <div class="profile-member-info">

                        <h3 class="profile-member-name">

                            @Model.FirstName

                            @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                            {
                                <span>
                                    @Model.MiddleName
                                </span>
                            }

                            @Model.LastName

                        </h3>


                        <div class="profile-member-role">
                            Member
                        </div>


                        <p class="profile-member-joined">

                            Joined
                            @Model.CreatedAt.ToString("MMMM dd, yyyy")

                        </p>


                        @* Profile picture input *@

                        <input asp-for="ProfilePictureFile"
                               type="file"
                               id="profilePictureInput"
                               accept=".jpg,.jpeg,.png,.webp"
                               class="d-none" />


                        <input asp-for="RemoveProfilePicture"
                               type="hidden"
                               id="RemoveProfilePicture" />


                        <button type="button"
                                id="openProfilePhotoModalBtn"
                                class="profile-edit-button">

                            Change Profile Photo

                        </button>


                        @* Existing helper buttons *@

                        <button type="button"
                                id="changeProfilePictureBtn"
                                class="d-none">

                            Change Profile Picture

                        </button>


                        <button type="button"
                                id="removeProfilePictureBtn"
                                class="d-none">

                            Remove Photo

                        </button>


                        <span asp-validation-for="ProfilePictureFile"
                              class="text-danger d-block mt-2">
                        </span>

                    </div>

                </div>



                @* =================================================
                   ACTIVITY
                   ================================================= *@

                <div class="profile-activity-card">

                    <div class="profile-section-header">

                        <h4>
                            Activity
                        </h4>

                        <p>
                            Overview of your activity
                        </p>

                    </div>


                    <div class="profile-activity-item">

                        <div class="profile-activity-content">

                            <strong>
                                @Model.MarketplaceListingsCount
                            </strong>

                            <span>
                                Marketplace Listings
                            </span>

                        </div>

                    </div>


                    <div class="profile-activity-item">

                        <div class="profile-activity-content">

                            <strong>
                                @Model.LostFoundReportsCount
                            </strong>

                            <span>
                                Lost &amp; Found Reports
                            </span>

                        </div>

                    </div>


                    <div class="profile-activity-item">

                        <div class="profile-activity-content">

                            <strong>
                                @Model.PetsSoldCount
                            </strong>

                            <span>
                                Pets Sold
                            </span>

                        </div>

                    </div>


                    <div class="profile-activity-item">

                        <div class="profile-activity-content">

                            <strong>
                                @Model.PetsAdoptedCount
                            </strong>

                            <span>
                                Pets Adopted
                            </span>

                        </div>

                    </div>


                    <div class="profile-activity-item">

                        <div class="profile-activity-content">

                            <strong>
                                @Model.ResolvedReportsCount
                            </strong>

                            <span>
                                Resolved Reports
                            </span>

                        </div>

                    </div>

                </div>

            </div>



            @* =====================================================
               RIGHT SIDE
               ===================================================== *@

            <div class="profile-right-column">


                @* =================================================
                   PERSONAL INFORMATION
                   ================================================= *@

                <div class="profile-information-card">

                    <div class="profile-section-header">

                        <h3>
                            Personal Information
                        </h3>

                        <p>
                            Update your personal details.
                        </p>

                    </div>


                    <h6 class="profile-subsection-title">
                        Name
                    </h6>


                    <div class="profile-information-grid">

                        <div class="profile-information-item">

                            <label asp-for="FirstName"
                                   class="profile-information-label">
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="profile-information-item">

                            <label asp-for="MiddleName"
                                   class="profile-information-label">
                            </label>

                            <input asp-for="MiddleName"
                                   class="form-control" />

                            <span asp-validation-for="MiddleName"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="profile-information-item">

                            <label asp-for="LastName"
                                   class="profile-information-label">
                            </label>

                            <input asp-for="LastName"
                                   class="form-control" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <h6 class="profile-subsection-title">
                        Contact Details
                    </h6>


                    <div class="profile-information-grid">

                        <div class="profile-information-item">

                            <label class="profile-information-label">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   readonly />

                        </div>


                        <div class="profile-information-item">

                            <label asp-for="ContactNumber"
                                   class="profile-information-label">
                            </label>

                            <input asp-for="ContactNumber"
                                   class="form-control" />

                            <span asp-validation-for="ContactNumber"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <h6 class="profile-subsection-title">
                        Personal Details
                    </h6>


                    <div class="profile-information-grid">

                        <div class="profile-information-item">

                            <label asp-for="Gender"
                                   class="profile-information-label">
                            </label>

                            <select asp-for="Gender"
                                    class="form-select">

                                <option value="">
                                    Select Gender
                                </option>

                                <option>
                                    Male
                                </option>

                                <option>
                                    Female
                                </option>

                            </select>

                            <span asp-validation-for="Gender"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="profile-information-item">

                            <label asp-for="Birthdate"
                                   class="profile-information-label">
                            </label>

                            <input asp-for="Birthdate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="Birthdate"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>



                @* =================================================
                   ADDRESS
                   ================================================= *@

                <div class="profile-information-card">

                    <div class="profile-section-header">

                        <h3>
                            Address
                        </h3>

                        <p>
                            Update your residential address.
                        </p>

                    </div>


                    <h6 class="profile-subsection-title">
                        Location
                    </h6>


                    <partial name="Components/_EditProfileAddressFields"
                             model="Model" />

                </div>



                @* =================================================
                   VERIFICATION
                   ================================================= *@

                <div class="profile-information-card">

                    <div class="profile-section-header">

                        <h3>
                            Verification
                        </h3>

                        <p>
                            Manage your identity verification document.
                        </p>

                    </div>


                    <h6 class="profile-subsection-title">
                        Verification Document
                    </h6>


                    <div class="profile-verification-container">

                        @if (User.IsInRole("Member"))
                        {

                            <label class="profile-information-label">
                                Current Valid ID
                            </label>


                            @if (!string.IsNullOrEmpty(Model.IdPhotoPath))
                            {
                                <img src="@Model.IdPhotoPath"
                                     id="validIdPreview"
                                     class="profile-id-image"
                                     alt="Current Valid ID" />
                            }
                            else
                            {
                                <div id="validIdPlaceholder"
                                     class="profile-id-placeholder">

                                    <span>
                                        No Valid ID Uploaded
                                    </span>

                                </div>


                                <img id="validIdPreview"
                                     class="profile-id-image d-none"
                                     alt="Valid ID Preview" />
                            }


                            @* Existing Valid ID input *@

                            <input asp-for="IdPhotoFile"
                                   type="file"
                                   id="validIdInput"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   class="d-none" />


                            @* Existing button with custom UI class *@

                            <button type="button"
                                    id="changeValidIdBtn"
                                    class="profile-valid-id-button">

                                Change Valid ID

                            </button>


                            <span asp-validation-for="IdPhotoFile"
                                  class="text-danger d-block mt-2">
                            </span>


                            <small class="text-muted d-block mt-2">

                                Accepted formats:
                                JPG, JPEG, PNG, WEBP

                                <br />

                                Maximum file size:
                                5 MB

                            </small>

                        }

                    </div>

                </div>



                @* =================================================
                   ACCOUNT INFORMATION
                   ================================================= *@

                <div class="profile-information-card">

                    <div class="profile-section-header">

                        <h3>
                            Account Information
                        </h3>

                        <p>
                            View your account information and membership details.
                        </p>

                    </div>


                    <h6 class="profile-subsection-title">
                        Account
                    </h6>


                    <div class="profile-information-grid">

                        <div class="profile-information-item">

                            <label class="profile-information-label">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   readonly />

                        </div>


                        <div class="profile-information-item">

                            <label class="profile-information-label">
                                Member Since
                            </label>

                            <input class="form-control"
                                   value="@Model.CreatedAt.ToString("MMMM dd, yyyy")"
                                   readonly />

                        </div>

                    </div>


                    <h6 class="profile-subsection-title">
                        Account Status
                    </h6>


                    <div class="profile-information-grid">

                        <div class="profile-information-item">

                            <label class="profile-information-label">
                                Status
                            </label>

                            <input asp-for="Status"
                                   class="form-control"
                                   readonly />

                        </div>


                        <div class="profile-information-item">

                            <label class="profile-information-label">
                                Accepted Terms
                            </label>

                            <input class="form-control"
                                   value="@(Model.AcceptedTermsDate?.ToString("MMMM dd, yyyy") ?? "Not Accepted Terms and Agreement")"
                                   readonly />

                        </div>

                    </div>

                </div>



                @* =================================================
                   ACTIONS
                   ================================================= *@

                <div class="profile-actions-card">

                    <div class="profile-actions">

                        <a asp-action="View"
                           class="profile-cancel-button">

                            Cancel

                        </a>


                        <button type="submit"
                                class="profile-save-button">

                            Save Changes

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>



@* =============================================================
   PROFILE PHOTO MODAL
   ============================================================= *@

<div id="profilePhotoModal"
     class="profile-photo-modal"
     aria-hidden="true">

    <div class="profile-photo-modal-backdrop"
         id="profilePhotoModalBackdrop">
    </div>


    <div class="profile-photo-modal-content"
         role="dialog"
         aria-modal="true"
         aria-labelledby="profilePhotoModalTitle">


        <div class="profile-photo-modal-header">

            <h4 id="profilePhotoModalTitle">
                Change Profile Photo
            </h4>

        </div>


        <div class="profile-photo-modal-body">

            <button type="button"
                    id="modalUploadProfilePhotoBtn"
                    class="profile-photo-modal-button">

                Upload Photo

            </button>


            <button type="button"
                    id="modalRemoveProfilePhotoBtn"
                    class="profile-photo-modal-button profile-photo-remove-button">

                Remove Current Photo

            </button>


            <button type="button"
                    id="closeProfilePhotoModalBtn"
                    class="profile-photo-modal-button profile-photo-cancel-button">

                Cancel

            </button>

        </div>

    </div>

</div>



@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script src="~/js/profilePictureHelper.js"></script>

    <script src="~/js/address-helper.js"
            asp-append-version="true"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* Profile picture */

            setupProfilePicture();


            /* Profile photo modal */

            const modal =
                document.getElementById("profilePhotoModal");

            const openModalButton =
                document.getElementById("openProfilePhotoModalBtn");

            const closeModalButton =
                document.getElementById("closeProfilePhotoModalBtn");

            const backdrop =
                document.getElementById("profilePhotoModalBackdrop");

            const existingChangeButton =
                document.getElementById("changeProfilePictureBtn");

            const existingRemoveButton =
                document.getElementById("removeProfilePictureBtn");

            const modalUploadButton =
                document.getElementById("modalUploadProfilePhotoBtn");

            const modalRemoveButton =
                document.getElementById("modalRemoveProfilePhotoBtn");


            function openProfilePhotoModal() {

                if (!modal) {
                    return;
                }

                modal.classList.add("show");

                modal.setAttribute(
                    "aria-hidden",
                    "false"
                );

            }


            function closeProfilePhotoModal() {

                if (!modal) {
                    return;
                }

                modal.classList.remove("show");

                modal.setAttribute(
                    "aria-hidden",
                    "true"
                );

            }


            if (openModalButton) {

                openModalButton.addEventListener(
                    "click",
                    openProfilePhotoModal
                );

            }


            if (closeModalButton) {

                closeModalButton.addEventListener(
                    "click",
                    closeProfilePhotoModal
                );

            }


            if (backdrop) {

                backdrop.addEventListener(
                    "click",
                    closeProfilePhotoModal
                );

            }


            if (modalUploadButton && existingChangeButton) {

                modalUploadButton.addEventListener(
                    "click",
                    function () {

                        existingChangeButton.click();

                        closeProfilePhotoModal();

                    }
                );

            }


            if (modalRemoveButton && existingRemoveButton) {

                modalRemoveButton.addEventListener(
                    "click",
                    function () {

                        existingRemoveButton.click();

                        closeProfilePhotoModal();

                    }
                );

            }


            /* Valid ID file picker */

            const changeValidIdButton =
                document.getElementById("changeValidIdBtn");

            const validIdInput =
                document.getElementById("validIdInput");


            if (changeValidIdButton && validIdInput) {

                changeValidIdButton.addEventListener(
                    "click",
                    function () {

                        validIdInput.click();

                    }
                );

            }


            /* Valid ID preview */

            const validIdPreview =
                document.getElementById("validIdPreview");

            const validIdPlaceholder =
                document.getElementById("validIdPlaceholder");


            if (validIdInput && validIdPreview) {

                validIdInput.addEventListener(
                    "change",
                    function () {

                        if (!this.files || !this.files[0]) {
                            return;
                        }


                        const file = this.files[0];

                        const reader = new FileReader();


                        reader.onload = function (event) {

                            validIdPreview.src =
                                event.target.result;

                            validIdPreview.classList.remove(
                                "d-none"
                            );


                            if (validIdPlaceholder) {

                                validIdPlaceholder.classList.add(
                                    "d-none"
                                );

                            }

                        };


                        reader.readAsDataURL(file);

                    }
                );

            }


            /* Escape closes modal */

            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Escape" &&
                        modal &&
                        modal.classList.contains("show")
                    ) {

                        closeProfilePhotoModal();

                    }

                }
            );

        });

    </script>
}