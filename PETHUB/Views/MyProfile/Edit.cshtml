@model PETHUB.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Edit My Profile";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <!-- ========================================================= -->
            <!-- PAGE HEADER                                                -->
            <!-- ========================================================= -->

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h2 class="mb-1">Edit My Profile</h2>

                    <p class="text-muted mb-0">
                        Manage your personal information and account details.
                    </p>

                </div>

            </div>

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <!-- ========================================================= -->
                <!-- PROFILE CARD                                               -->
                <!-- ========================================================= -->

                <div class="card shadow-sm mb-4 mt-4">

                    <div class="card-body text-center">

                        <!-- Profile Picture -->
                        @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                        {
                            <img src="@Model.ProfilePicturePath"
                                 class="rounded-circle border mb-3"
                                 width="180"
                                 height="180"
                                 style="object-fit:cover;" />
                        }
                        else
                        {
                            <img src="~/images/default-profile.png"
                                 class="rounded-circle border mb-3"
                                 width="180"
                                 height="180"
                                 style="object-fit:cover;" />
                        }

                        <!-- Name -->

                        <h3 class="mb-1">

                            @Model.FirstName

                            @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                            {
                                @Model.MiddleName
                            }

                            @Model.LastName

                        </h3>

                        <!-- User Type -->

                        <p class="text-muted mb-2">

                            Member

                        </p>

                        <!-- Joined Date -->

                        <p class="text-secondary">

                            <strong>Joined:</strong>

                            @Model.CreatedAt.ToString("MMMM dd, yyyy")

                        </p>

                        <!-- Change Profile Picture -->

                        <button class="btn btn-outline-success mb-4" disabled>

                            Change Profile Picture

                        </button>

                        <hr />

                        <div class="border-top mt-4 pt-4">

                            <!-- ========================================================= -->
                            <!-- ACTIVITY SUMMARY                                          -->
                            <!-- ========================================================= -->

                            <div class="row g-0 text-center">

                                <div class="col">

                                    <small class="text-muted d-block">
                                        Marketplace Listings
                                    </small>

                                    <h3 class="fw-bold mt-2 mb-0">
                                        0
                                    </h3>

                                </div>

                                <div class="col border-start">

                                    <small class="text-muted d-block">
                                        Lost &amp; Found Reports
                                    </small>

                                    <h3 class="fw-bold mt-2 mb-0">
                                        0
                                    </h3>

                                </div>

                                <div class="col border-start">

                                    <small class="text-muted d-block">
                                        Pets Sold
                                    </small>

                                    <h3 class="fw-bold mt-2 mb-0">
                                        0
                                    </h3>

                                </div>

                                <div class="col border-start">

                                    <small class="text-muted d-block">
                                        Pets Adopted
                                    </small>

                                    <h3 class="fw-bold mt-2 mb-0">
                                        0
                                    </h3>

                                </div>

                                <div class="col border-start">

                                    <small class="text-muted d-block">
                                        Resolved Reports
                                    </small>

                                    <h3 class="fw-bold mt-2 mb-0">
                                        0
                                    </h3>

                                </div>

                            </div>

                        </div>

                        @* ========================================================= *@
                        @* ABOUT ME                                                  *@
                        @* ========================================================= *@

                        <div class="card shadow-sm mb-4 mt-4">

                            <div class="card-body text-start">

                                <h4 class="mb-1">
                                    About Me
                                </h4>

                                <p class="text-muted mb-4">
                                    Share a short introduction about yourself with other members.
                                </p>

                                <h6 class="fw-bold text-success border-bottom pb-2 mb-4">
                                    Biography
                                </h6>

                                <textarea asp-for="Bio"
                                          rows="5"
                                          class="form-control"
                                          placeholder="Tell other members a little about yourself...">
                                    </textarea>

                            </div>

                        </div>

                        @* ========================================================= *@
                        @* PERSONAL INFORMATION                                      *@
                        @* ========================================================= *@

                        <div class="card shadow-sm mb-4 mt-4">

                            <div class="card-body">

                                <h4 class="mb-1 text-start">
                                    Personal Information
                                </h4>

                                <p class="text-muted mb-4 text-start">
                                    Update your personal details below.
                                </p>

                                @* ------------------------------------------------- *@
                                @* NAME                                              *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mb-4 text-start">
                                    Name
                                </h6>

                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label asp-for="FirstName" class="fw-semibold"></label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="FirstName" class="form-control" />
                                    </div>

                                </div>

                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label asp-for="MiddleName" class="fw-semibold"></label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="MiddleName" class="form-control" />
                                    </div>

                                </div>

                                <div class="row align-items-center">

                                    <div class="col-md-4">
                                        <label asp-for="LastName" class="fw-semibold"></label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="LastName" class="form-control" />
                                    </div>

                                </div>

                                @* ------------------------------------------------- *@
                                @* CONTACT DETAILS                                   *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mt-5 mb-4 text-start">
                                    Contact Details
                                </h6>

                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">

                                        <label class="fw-semibold">
                                            Email Address
                                        </label>

                                    </div>

                                    <div class="col-md-8">

                                        <input asp-for="Email"
                                               class="form-control"
                                               readonly />

                                    </div>

                                </div>

                                <div class="row align-items-center">

                                    <div class="col-md-4">

                                        <label asp-for="ContactNumber"
                                               class="fw-semibold">
                                        </label>

                                    </div>

                                    <div class="col-md-8">

                                        <input asp-for="ContactNumber"
                                               class="form-control" />

                                    </div>

                                </div>

                                @* ------------------------------------------------- *@
                                @* PERSONAL DETAILS                                  *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mt-5 mb-4 text-start">
                                    Personal Details
                                </h6>

                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">

                                        <label asp-for="Gender"
                                               class="fw-semibold">
                                        </label>

                                    </div>

                                    <div class="col-md-8">

                                        <select asp-for="Gender"
                                                class="form-select">

                                            <option value="">
                                                Select Gender
                                            </option>

                                            <option>Male</option>

                                            <option>Female</option>

                                        </select>

                                    </div>

                                </div>

                                <div class="row align-items-center">

                                    <div class="col-md-4">

                                        <label asp-for="Birthdate"
                                               class="fw-semibold">
                                        </label>

                                    </div>

                                    <div class="col-md-8">

                                        <input asp-for="Birthdate"
                                               type="date"
                                               class="form-control" />

                                    </div>

                                </div>
                            </div>

                        </div>
                        @* ========================================================= *@
                        @* ADDRESS                                                   *@
                        @* ========================================================= *@

                        <div class="card shadow-sm mb-4 mt-4">

                            <div class="card-body text-start">

                                <h4 class="mb-1">
                                    Address
                                </h4>

                                <p class="text-muted mb-4">
                                    Update your residential address below.
                                </p>

                                @* ------------------------------------------------- *@
                                @* LOCATION                                          *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mb-4">
                                    Location
                                </h6>

                                <!-- Province -->
                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label asp-for="Province" class="fw-semibold"></label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="Province" class="form-control" />
                                    </div>

                                </div>

                                <!-- City -->
                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label asp-for="City" class="fw-semibold">
                                            City / Municipality
                                        </label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="City" class="form-control" />
                                    </div>

                                </div>

                                <!-- Barangay -->
                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label asp-for="Barangay" class="fw-semibold"></label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="Barangay" class="form-control" />
                                    </div>

                                </div>

                                <!-- Street Address -->
                                <div class="row align-items-center">

                                    <div class="col-md-4">
                                        <label asp-for="StreetAddress" class="fw-semibold"></label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="StreetAddress"
                                               class="form-control" />
                                    </div>

                                </div>

                            </div>

                        </div>
                        @* ========================================================= *@
                        @* VERIFICATION                                              *@
                        @* ========================================================= *@

                        <div class="card shadow-sm mb-4">

                            <div class="card-body text-start">

                                <h4 class="mb-1">
                                    Verification
                                </h4>

                                <p class="text-muted mb-4">
                                    Manage your identity verification document.
                                </p>

                                @* ------------------------------------------------- *@
                                @* VERIFICATION DOCUMENT                            *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mb-4">
                                    Verification Document
                                </h6>

                                <div class="row align-items-start">

                                    <div class="col-md-4">

                                        <label class="fw-semibold">
                                            Current Valid ID
                                        </label>

                                    </div>

                                    <div class="col-md-8">

                                        @if (!string.IsNullOrEmpty(Model.IdPhotoPath))
                                        {
                                            <img src="@Model.IdPhotoPath"
                                                 class="img-thumbnail mb-3"
                                                 style="max-width:350px; max-height:220px; object-fit:contain;" />
                                        }
                                        else
                                        {
                                            <div class="border rounded d-flex justify-content-center align-items-center mb-3"
                                                 style="width:350px; height:220px;">

                                                <span class="text-muted">
                                                    No Valid ID Uploaded
                                                </span>

                                            </div>
                                        }

                                        <button class="btn btn-outline-success" disabled>

                                            Change Valid ID

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                        @* ========================================================= *@
                        @* ACCOUNT INFORMATION                                       *@
                        @* ========================================================= *@

                        <div class="card shadow-sm mb-4">

                            <div class="card-body text-start">

                                <h4 class="mb-1">
                                    Account Information
                                </h4>

                                <p class="text-muted mb-4">
                                    View your account information and membership details.
                                </p>

                                @* ------------------------------------------------- *@
                                @* ACCOUNT                                           *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mb-4">
                                    Account
                                </h6>

                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label class="fw-semibold">
                                            Email Address
                                        </label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="Email"
                                               class="form-control"
                                               readonly />
                                    </div>

                                </div>

                                <div class="row align-items-center">

                                    <div class="col-md-4">
                                        <label class="fw-semibold">
                                            Member Since
                                        </label>
                                    </div>

                                    <div class="col-md-8">
                                        <input class="form-control"
                                               value="@Model.CreatedAt.ToString("MMMM dd, yyyy")"
                                               readonly />
                                    </div>

                                </div>

                                @* ------------------------------------------------- *@
                                @* ACCOUNT STATUS                                    *@
                                @* ------------------------------------------------- *@

                                <h6 class="fw-bold text-success border-bottom pb-2 mt-5 mb-4">
                                    Account Status
                                </h6>

                                <div class="row align-items-center mb-3">

                                    <div class="col-md-4">
                                        <label class="fw-semibold">
                                            Status
                                        </label>
                                    </div>

                                    <div class="col-md-8">
                                        <input asp-for="Status"
                                               class="form-control"
                                               readonly />
                                    </div>

                                </div>

                                <div class="row align-items-center">

                                    <div class="col-md-4">
                                        <label class="fw-semibold">
                                            Accepted Terms
                                        </label>
                                    </div>

                                    <div class="col-md-8">

                                        <input class="form-control"
                                               value="@(Model.AcceptedTermsDate?.ToString("MMMM dd, yyyy") ?? "Not Accepted Terms and Agreement")"
                                               readonly />

                                    </div>

                                </div>

                            </div>
                        </div>
                        @* ========================================================= *@
                        @* ACTIONS                                                   *@
                        @* ========================================================= *@

                        <div class="card shadow-sm mb-4">

                            <div class="card-body">

                                <h4 class="mb-1 text-start">
                                    Actions
                                </h4>

                                <p class="text-muted mb-4 text-start">
                                    Review your changes before saving.
                                </p>

                                <div class="d-flex justify-content-end gap-2">

                                    <a asp-action="Index"
                                       class="btn btn-outline-secondary">

                                        Cancel

                                    </a>

                                    <button type="submit"
                                            class="btn btn-success">

                                        Save Changes

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>
                </form>
            </div>

        </div>

    </div>

</div>